---
/**
 * /widebeam: the WIDE BEAM page, the projector look (bench/widebeam-projector, Dan's approved mock-up), built section
 * by section on branch feat/widebeam-projector-live. WIDE BEAM = the car-headlight stereo-width plugin
 * (revaudioplugins/WideBeam). On sale since 2026-11-23 (Gil): indexed, on the home TV, /downloads and the cart; the
 * phase and the listing live in src/data/widebeam.ts.
 *
 * Step 1: section 1 (WbpCar: the car film with the glass card, the Buy key and the trial gate) between the house header
 * / sale strip and the house footer. Sections 2 (the projector film and its title card) and 3 (the plugin's face) come
 * next and reuse the gate (WbpGate). The old page (WbHero, WbDrive, WbGet, WbManual, WbCloser, WbStickyBar, their
 * styles in src/styles/widebeam.css and their scripts under src/lib/widebeam/) is left in the repo, no longer imported:
 * going back is one revert of this file.
 * Every word that names the ask, the price, the formats or the trial comes from src/data/widebeam.ts;
 * assertWidebeamConfig() fails the build on a phase the page can't back. The styles are scoped (.wbp-page, wbp- classes,
 * src/styles/widebeam/projector/), the script is dash-free (src/lib/widebeam/projector/init.ts).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { plugins } from '../data/plugins';
import { widebeam, askFor, assertWidebeamConfig } from '../data/widebeam';
import WbpCar from '../components/widebeam/projector/WbpCar.astro';
import '../styles/widebeam/projector/index.css';

// the social card (public/og/widebeam.png, 1200x630): the lit dash beside the WIDE BEAM lockup and the hero line, shot
// from the old page (re-shooting it from the projector look is Dan's call)
// a phase the page can't back fails the build (src/data/widebeam.ts), and so does a Buy key the cart can't check out
// (Cart.astro sells only plugins.ts slugs with a paddlePriceId, at introPriceUsd ?? regularPriceUsd)
assertWidebeamConfig(widebeam, undefined, Object.fromEntries(plugins.map((p) => [p.slug, { paddlePriceId: p.paddlePriceId ?? null, priceUsd: p.introPriceUsd ?? p.regularPriceUsd }])));
// the description follows the phase: a shared link never says "Coming soon" while the trial or the Buy key is live
const description = `WIDE BEAM is a stereo-width plugin fronted by a pair of classic car headlights. Open the image with WIDTH, keep the bass centred with LOW FOCUS, spread a mono source with HIGH BEAM. ${askFor().metaTail}`;
---
<BaseLayout
  title="WIDE BEAM: stereo width you can see"
  description={description}
  ogImage="/og/widebeam.png"
  index={widebeam.listed}
>
  <div class="wbp-page" data-wb-page>
    <WbpCar />
    {/* the look-ahead marker (kept from the old page): anything marked [data-wb-defer] gets [data-wb-near] once it comes
         within 3/4 of a screen (a deferred <img> gets its data-srcset / data-src then), and so does the house footer,
         whose two smoke photos wait for it (base.css, r-cross-g11fv: they stay out of the first view). The look-ahead
         starts with the visitor's first scroll; until then only what is on screen is marked. Inline, not in the page's
         script chunk: a late or failed chunk must not leave deferred art bare. Sections 2 and 3 will hang their films
         and art on it. */}
    <script is:inline>
      (function () {
        var els = [].slice.call(document.querySelectorAll('.wb-part-lamp-l, .wb-part-lamp-r, .wb-part-road, .wb-part-meter, .wb-part-cap, [data-wb-defer]'));
        var io = null;
        // the house footer comes after this script in the document: watched once the parser has reached it
        function foot() { var f = document.querySelector('.site-footer'); if (f) { els.push(f); if (io) io.observe(f); else near(f); } }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', foot); else setTimeout(foot);
        function near(el) {
          el.setAttribute('data-wb-near', '');
          if (el.tagName === 'IMG' && el.dataset.src && !el.getAttribute('src')) {
            el.fetchPriority = 'high';
            if (el.dataset.srcset) el.srcset = el.dataset.srcset;
            el.src = el.dataset.src;
          }
        }
        if (!('IntersectionObserver' in window)) { els.forEach(near); return; }
        function watch(margin) {
          var o = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) { if (e.isIntersecting) { near(e.target); o.unobserve(e.target); } });
          }, { rootMargin: margin });
          els.forEach(function (el) { if (!el.hasAttribute('data-wb-near')) o.observe(el); });
          return o;
        }
        var ahead = scrollY > 2;
        io = watch(ahead ? '75% 0px' : '0px');
        if (!ahead) addEventListener('scroll', function arm() {
          removeEventListener('scroll', arm);
          io.disconnect();
          io = watch('75% 0px');
        }, { passive: true });
      })();
    </script>
  </div>
</BaseLayout>

<script>
  import { initProjector } from '../lib/widebeam/projector/init';
  const el = document.querySelector<HTMLElement>('[data-wb-page]');
  if (el) initProjector(el);
</script>
