---
/**
 * /downloads — the in-house download page (2026-10-21). Replaces the nav's
 * link to the licence worker's /download portal; that portal stays live and
 * untouched (Paddle's post-purchase flow and old emails still use it).
 *
 *   1. pick   a grid of plugin cards with a search box (2026-11-02, replaced
 *             the homepage carousel here): a press on a card opens the panel.
 *   2. email  the same email gate as every popup: POST {email, plugin,
 *             marketing, from:'downloads'} to the worker's /download/register,
 *             so the same emails go out (the download link in direct mode, the
 *             verify link otherwise).
 *   3. ready  a verified browser (the verify link returns here as
 *             #dl=<gate>&p=<gate id> because of from:'downloads', or the
 *             popups' saved `tg:gate:<id>`, shared with TrialGateModal) gets the
 *             Mac / Windows buttons: POST /download {plugin, os, gate} mints a
 *             15-minute /dl link and the worker streams the build from R2 —
 *             whatever /pit-lane last shipped for that platform.
 * ?p=<slug> deep-links straight to a plugin.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { bySlug, dlGateId, trialConversionValueUsd } from '../data/plugins';
import { site } from '../data/site';
import { revfx } from '../data/revfx';
import { pluginImage } from '../lib/images';

// What the worker's /download/register can send (DL_PLUGINS + DL_PORTAL_ORDER
// in the licence worker). RevFX joins once revfx.gateWired.
const DL_SLUGS = ['drift', 'revlimiter', 'gas', 'radio-roulette', ...(revfx.gateWired ? ['revfx'] : [])];
const info = Object.fromEntries(DL_SLUGS.map((slug) => {
  const p = bySlug(slug)!;
  return [slug, { gate: dlGateId(p), name: p.name, free: !!p.isFree, value: trialConversionValueUsd(p) || 0 }];
}));
const cards = DL_SLUGS.map((slug) => {
  const p = bySlug(slug)!;
  const type = p.library?.typeWord || p.category;
  return {
    slug,
    name: p.library?.name || p.name,   // DRIFT in capitals, as on the home TV
    type,
    tagline: p.tagline,
    shot: pluginImage(p.heroImage),
    tag: p.isFree ? 'Free forever' : '30 days free',
    free: !!p.isFree,
    // What the search box matches against.
    search: [p.name, type, p.category, p.tagline, p.oneLiner, p.isFree ? 'free' : 'trial'].join(' ').toLowerCase(),
  };
});
---

<BaseLayout
  title="Downloads"
  description="Download RevAudio plugins: full-version 30-day trials and free plugins, sent straight to your inbox."
>
  <section class="dlg" aria-labelledby="dlg-title">
    <h1 class="dlg-heading" id="dlg-title">Downloads</h1>
    <label class="dlg-search">
      <span class="sr-only">Search plugins</span>
      <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" /><path d="M13 13l4.5 4.5" /></svg>
      <input type="search" data-dlg-q placeholder="Search plugins: limiter, saturation, free…" autocomplete="off" spellcheck="false" />
    </label>
    <ul class="dlg-grid" data-dlg-grid>
      {cards.map((c) => (
        <li class="dlg-item" data-dlg-item data-search={c.search}>
          <button type="button" class="dlg-card" data-dl-pick={c.slug} aria-pressed="false">
            <span class="dlg-shot">
              {c.shot && <Image src={c.shot} alt="" widths={[320, 640]} sizes="(max-width: 640px) 90vw, 320px" loading="lazy" />}
            </span>
            <span class="dlg-body">
              <span class="dlg-name">{c.name}</span>
              <span class="dlg-type">{c.type}</span>
              <span class="dlg-tagline">{c.tagline}</span>
              <span class="dlg-foot">
                <span class:list={['dlg-tag', { 'is-free': c.free }]}>{c.tag}</span>
                <span class="dlg-go">Download &darr;</span>
              </span>
            </span>
          </button>
        </li>
      ))}
    </ul>
    <p class="dlg-empty" data-dlg-empty role="status" aria-live="polite" hidden></p>
  </section>

  <section class="dlp" data-dlp data-worker={site.downloadGate.workerUrl} data-info={JSON.stringify(info)} aria-label="Get your download">
    <p class="dlp-hint" data-dlp-hint><strong>Pick a plugin</strong> to get its download.</p>

    <div class="dlp-card" data-dlp-card hidden tabindex="-1">
      <p class="dlp-kicker" data-dlp-kicker>Free 30-day trial</p>
      <h2 class="dlp-title" data-dlp-title>Download</h2>
      <p class="dlp-sub" data-dlp-sub></p>

      <form class="dlp-form" data-dlp-form novalidate>
        <label class="dlp-field">
          <span>Email</span>
          <input type="email" data-dlp-email name="email" placeholder="you@studio.com" required autocomplete="email" />
        </label>
        <!-- honeypot: real users never fill this; bots do -->
        <input type="text" name="_gotcha" class="dlp-hp" data-dlp-hp tabindex="-1" autocomplete="off" aria-hidden="true" />
        <!-- Same consent wording as TrialGateModal (MARKETING_CONSENT_TEXT in the
             worker stores it verbatim): unticked by default, never a condition
             of the download. -->
        <div class="dlp-consent-block">
          <label class="dlp-consent">
            <input type="checkbox" data-dlp-consent />
            <span>Also send me new-plugin drops and demo codes (optional)</span>
          </label>
          <p class="dlp-notice">We'll send a few short emails about getting started, and a heads-up before a trial ends. Unsubscribe anytime.</p>
        </div>
        <button type="submit" class="dlp-submit rv-btn" data-dlp-submit>Send my download</button>
        <p class="dlp-err" data-dlp-err role="alert" aria-live="polite"></p>
      </form>

      <div class="dlp-sent" data-dlp-sent hidden>
        <p class="dlp-status" data-dlp-status role="status" aria-live="polite" tabindex="-1"></p>
        <p class="dlp-sent-note">Nothing after a few minutes? Check spam and the promotions tab.</p>
        <button type="button" class="dlp-link" data-dlp-reset>Use a different email</button>
      </div>

      <div class="dlp-ready" data-dlp-ready hidden>
        <div class="dlp-dl-row">
          <button type="button" class="dlp-dl rv-btn rv-btn--ghost rv-btn--stack" data-dlp-dl="mac">
            <span class="dlp-dl-os">macOS</span>
            <span class="dlp-dl-fmt rv-btn__sub">.pkg installer</span>
          </button>
          <button type="button" class="dlp-dl rv-btn rv-btn--ghost rv-btn--stack" data-dlp-dl="win">
            <span class="dlp-dl-os">Windows</span>
            <span class="dlp-dl-fmt rv-btn__sub">.exe installer</span>
          </button>
        </div>
        <p class="dlp-dl-note" data-dlp-dl-note role="status" aria-live="polite" hidden></p>
        <button type="button" class="dlp-link" data-dlp-again hidden>Didn&rsquo;t start? Try again</button>
        <p class="dlp-mobile" data-dlp-mobile hidden>
          These are desktop installers. Save one here and move it to your Mac or PC, or open the link from your email there.
        </p>
        <p class="dlp-err" data-dlp-dl-err role="alert" aria-live="polite"></p>
      </div>

      <!-- The plugin's owner's manual, in every state: the worker's /manual/<gate id> (the latest /pit-lane upload),
           listed by its GET /manuals. A plugin with none shows nothing. -->
      <a class="dlp-manual" data-dlp-manual href="#" target="_blank" rel="noopener" hidden>Owner&rsquo;s manual (PDF) &rarr;</a>
    </div>

    <p class="dlp-foot">
      Bought a plugin? The installer link is in the confirmation email sent right after checkout.
      Can&rsquo;t find it? <a href="/support">Support</a> sorts it out.
    </p>
  </section>
</BaseLayout>

<script>
  type Info = { gate: string; name: string; free: boolean; value: number };
  // Set by CookieBanner (gtag, fbq: only after consent) and Cart (raSaleSource).
  const w = window as unknown as { gtag?: (...a: unknown[]) => void; fbq?: (...a: unknown[]) => void; raSaleSource?: () => Record<string, string> };

  const root = document.querySelector<HTMLElement>('[data-dlp]');
  if (root) {
    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
    const worker = root.dataset.worker || '';
    const info: Record<string, Info> = JSON.parse(root.dataset.info || '{}');
    const slugByGate: Record<string, string> = {};
    Object.keys(info).forEach((s) => { slugByGate[info[s].gate] = s; });

    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const hint = $('[data-dlp-hint]');
    const card = $('[data-dlp-card]');
    const kicker = $('[data-dlp-kicker]');
    const title = $('[data-dlp-title]');
    const sub = $('[data-dlp-sub]');
    const form = $<HTMLFormElement>('[data-dlp-form]');
    const email = $<HTMLInputElement>('[data-dlp-email]');
    const hp = $<HTMLInputElement>('[data-dlp-hp]');
    const consent = $<HTMLInputElement>('[data-dlp-consent]');
    const submit = $<HTMLButtonElement>('[data-dlp-submit]');
    const err = $('[data-dlp-err]');
    const sent = $('[data-dlp-sent]');
    const status = $('[data-dlp-status]');
    const ready = $('[data-dlp-ready]');
    const dlNote = $('[data-dlp-dl-note]');
    const dlAgain = $<HTMLButtonElement>('[data-dlp-again]');
    const dlErr = $('[data-dlp-dl-err]');
    const mobile = $('[data-dlp-mobile]');
    const manual = $<HTMLAnchorElement>('[data-dlp-manual]');
    let manuals: Record<string, string> = {};
    fetch(worker + '/manuals')
      .then((r) => r.json())
      .then((d) => { if (d && d.ok) { manuals = d.manuals || {}; if (picked) render(); } })
      .catch(() => { /* no manual links, the downloads still work */ });

    let slug = Object.keys(info)[0];
    let picked = false;
    let inFlight = false;
    let dlInFlight = false;
    let againTimer = 0;
    // Addresses already sent this visit, per gate — coming back to a plugin
    // shows "check your inbox", not a blank form.
    const sentTo: Record<string, string> = {};

    // Verified browsers: the SAME store as TrialGateModal (tg:gate:<id>, 24h),
    // so a visitor verified in a popup is verified here, and the other way round.
    const GATE_TTL_MS = 24 * 3600 * 1000;
    const gateKey = (id: string) => 'tg:gate:' + id;
    const saveGate = (id: string, gate: string) => { try { localStorage.setItem(gateKey(id), JSON.stringify({ gate, exp: Date.now() + GATE_TTL_MS })); } catch { /* private mode */ } };
    const loadGate = (id: string) => {
      try {
        const rec = JSON.parse(localStorage.getItem(gateKey(id)) || 'null');
        if (rec && rec.gate && rec.exp > Date.now()) return rec.gate as string;
        if (rec) localStorage.removeItem(gateKey(id));
      } catch { /* storage blocked */ }
      return '';
    };
    const clearGate = (id: string) => { try { localStorage.removeItem(gateKey(id)); } catch { /* storage blocked */ } };
    const coarse = (() => { try { return matchMedia('(pointer: coarse)').matches; } catch { return false; } })();
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    function show(state: 'form' | 'sent' | 'ready') {
      form.hidden = state !== 'form';
      sent.hidden = state !== 'sent';
      ready.hidden = state !== 'ready';
    }

    function render() {
      const p = info[slug];
      if (!p) return;
      const gate = loadGate(p.gate);
      kicker.textContent = gate ? 'Email verified' : p.free ? 'Free forever' : 'Free 30-day trial';
      title.textContent = 'Download ' + p.name;
      submit.classList.toggle('rv-btn--honey', p.free);
      err.textContent = '';
      dlErr.textContent = '';
      const m = manuals[p.gate];
      manual.hidden = !m;
      if (m) manual.href = m;
      if (gate) {
        sub.textContent = 'Full version, no key needed. Pick your platform. The installer lands in your browser’s Downloads folder. Grab both if you work on two machines.';
        resetDlButtons();
        mobile.hidden = !coarse;
        show('ready');
      } else if (sentTo[p.gate]) {
        sub.textContent = p.free ? 'Free forever. Full version, no trial clock.' : 'Full version for 30 days, no credit card.';
        status.textContent = 'Check your inbox. We sent the ' + p.name + ' download to ' + sentTo[p.gate] + '. Not there in a minute? Look in Promotions or Spam.';
        show('sent');
      } else {
        sub.textContent = p.free
          ? 'Free forever. Full version, no trial clock, no credit card. Enter your email and your download link lands in your inbox.'
          : 'Full version for 30 days, no credit card. Enter your email and your download link lands in your inbox.';
        email.disabled = false;
        submit.disabled = false;
        show('form');
      }
    }

    function open(nextSlug: string, focus: boolean) {
      if (!info[nextSlug]) return;
      slug = nextSlug;
      picked = true;
      document.querySelectorAll<HTMLElement>('[data-dl-pick]').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.dlPick === slug));
      });
      hint.hidden = true;
      card.hidden = false;
      render();
      if (!focus) return;
      card.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
      // Focus the first thing to do, without a second scroll jump. Touch
      // skips it: focusing the email field would throw the keyboard up.
      if (coarse) return;
      const target = !form.hidden ? email : !ready.hidden ? ready.querySelector<HTMLElement>('[data-dlp-dl]') : card;
      target?.focus({ preventScroll: true });
    }

    document.querySelectorAll<HTMLElement>('[data-dl-pick]').forEach((b) => {
      b.addEventListener('click', () => open(b.dataset.dlPick || '', true));
    });

    // ---- search: filter the cards as you type -------------------------------
    const q = document.querySelector<HTMLInputElement>('[data-dlg-q]');
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-dlg-item]'));
    const empty = document.querySelector<HTMLElement>('[data-dlg-empty]');
    q?.addEventListener('input', () => {
      const words = q.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      items.forEach((it) => {
        const hay = it.dataset.search || '';
        const hit = words.every((wd) => hay.includes(wd));
        it.hidden = !hit;
        if (hit) shown++;
      });
      if (empty) {
        empty.hidden = shown > 0;
        empty.textContent = shown ? '' : 'No plugin matches “' + q.value.trim() + '”.';
      }
    });

    // ---- email -> /download/register (the popups' exact request) ----------
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (inFlight) return;
      const p = info[slug];
      const v = email.value.trim();
      if (!EMAIL_RE.test(v)) {
        err.textContent = 'That doesn’t look like an email.';
        email.focus();
        return;
      }
      if (hp.value) { sentTo[p.gate] = v; render(); return; }   // bot: say thanks, send nothing
      inFlight = true;
      submit.disabled = true;
      err.textContent = '';
      const body: Record<string, unknown> = { email: v, plugin: p.gate, marketing: consent.checked, from: 'downloads' };
      try { if (w.raSaleSource) Object.assign(body, w.raSaleSource()); } catch { /* attribution is best-effort */ }
      fetch(worker + '/download/register', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(body),
      })
        .then((res) => res.json())
        .then((data) => {
          if (data && data.ok) {
            sentTo[p.gate] = v;
            if (slug === slugByGate[p.gate]) { render(); status.focus({ preventScroll: true }); }
            document.dispatchEvent(new CustomEvent('tg:registered', { detail: { plugin: p.gate } }));
            // The conversion = an email actually registered (same tags as the
            // trial plates; both only exist after cookie consent).
            try { if (w.fbq) w.fbq('track', 'StartTrial'); } catch { /* no consent */ }
            try { if (w.gtag) w.gtag('event', 'conversion', { send_to: 'AW-18334323184/KDtwCLHa4dIcEPCjvqZE', value: p.value, currency: 'USD' }); } catch { /* no consent */ }
          } else {
            err.textContent = (data && data.error) || 'Something went wrong. Try again.';
          }
        })
        .catch(() => {
          err.innerHTML = 'Couldn’t reach the garage. Try again, or <a href="' + worker + '/download">open the download portal</a>.';
        })
        .finally(() => {
          inFlight = false;
          submit.disabled = false;
        });
    });
    $<HTMLButtonElement>('[data-dlp-reset]').addEventListener('click', () => {
      delete sentTo[info[slug].gate];
      email.value = '';
      render();
      email.focus();
    });

    // ---- verified: Mac / Windows -> POST /download -> /dl ------------------
    // Same terminal "Downloading…" state as TrialGateModal (the attachment
    // response leaves the page where it is, so the button has to say so).
    function resetDlButtons() {
      ready.querySelectorAll<HTMLButtonElement>('[data-dlp-dl]').forEach((b) => {
        const orig = b.dataset.orig;
        if (orig) {
          const [os, fmt] = orig.split('|');
          b.querySelector('.dlp-dl-os')!.textContent = os;
          b.querySelector('.dlp-dl-fmt')!.textContent = fmt;
        }
        b.classList.remove('is-done');
        b.disabled = false;
      });
      if (againTimer) { clearTimeout(againTimer); againTimer = 0; }
      dlAgain.hidden = true;
      dlNote.hidden = true;
      dlNote.textContent = '';
    }
    function markDownloading(btn: HTMLButtonElement) {
      const os = btn.querySelector('.dlp-dl-os')!;
      const fmt = btn.querySelector('.dlp-dl-fmt')!;
      if (!btn.dataset.orig) btn.dataset.orig = os.textContent + '|' + fmt.textContent;
      btn.classList.add('is-done');
      btn.disabled = true;
      os.textContent = 'Downloading…';
      fmt.textContent = 'check your Downloads folder';
      dlNote.textContent = 'Download started. Check your browser’s Downloads folder.';
      dlNote.hidden = false;
      if (againTimer) clearTimeout(againTimer);
      againTimer = window.setTimeout(() => { dlAgain.hidden = false; }, 8000);
    }
    dlAgain.addEventListener('click', () => {
      resetDlButtons();
      ready.querySelector<HTMLElement>('[data-dlp-dl]')?.focus();
    });
    ready.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-dlp-dl]');
      if (!btn || btn.disabled || dlInFlight) return;
      const p = info[slug];
      dlInFlight = true;
      btn.disabled = true;
      dlErr.textContent = '';
      fetch(worker + '/download', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ plugin: p.gate, os: btn.dataset.dlpDl, gate: loadGate(p.gate) }),
      })
        .then((res) => res.json())
        .then((data) => {
          if (data && data.ok && data.url) {
            markDownloading(btn);
            window.location.href = worker + data.url;
          } else if (data && data.locked) {
            // The 24h gate aged out: back to the email form for a fresh link.
            clearGate(p.gate);
            btn.disabled = false;
            render();
            sub.textContent = 'Your verified link expired (they last 24 hours). Enter your email and we’ll send a fresh one.';
            email.focus();
          } else {
            btn.disabled = false;
            dlErr.textContent = (data && data.error) || 'Something went wrong. Try again.';
          }
        })
        .catch(() => {
          btn.disabled = false;
          dlErr.textContent = 'Network hiccup. Try again in a moment.';
        })
        .finally(() => { dlInFlight = false; });
    });

    // ---- arrivals -----------------------------------------------------------
    // Verify-link return leg: /downloads#dl=<gate token>&p=<gate id>. Read
    // once, scrubbed from the address bar (TrialGateModal skips it on this page).
    const hashQ = new URLSearchParams(location.hash.replace(/^#/, ''));
    const searchQ = new URLSearchParams(location.search);
    const fromHash = !!(hashQ.get('dl') && hashQ.get('p'));
    const src = fromHash ? hashQ : searchQ;
    const dlToken = src.get('dl');
    const dlGate = src.get('p') || '';
    let arrive = '';
    if (dlToken && slugByGate[dlGate]) {
      saveGate(dlGate, dlToken);
      arrive = slugByGate[dlGate];
      src.delete('dl');
      src.delete('p');
      const rest = searchQ.toString();
      history.replaceState(null, '', location.pathname + (rest ? '?' + rest : '') + (fromHash && hashQ.toString() ? '#' + hashQ.toString() : ''));
    } else {
      // ?p=<slug or gate id>: straight to one plugin (support replies, emails).
      const want = searchQ.get('p') || '';
      arrive = info[want] ? want : slugByGate[want] || '';
    }
    if (arrive) open(arrive, true);
  }
</script>

<style>
  .dlg {
    width: min(1100px, 100%);
    margin: 0 auto;
    padding: 1rem 1rem 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }
  .dlg-heading {
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 7vw, 4.8rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg);
    text-align: center;
    margin: 0;
    padding-top: 0.5rem;
  }

  .dlg-search {
    position: relative;
    width: min(520px, 100%);
  }
  .dlg-search svg {
    position: absolute;
    left: 0.9rem;
    top: 50%;
    width: 18px;
    height: 18px;
    transform: translateY(-50%);
    fill: none;
    stroke: var(--fg-dim);
    stroke-width: 1.8;
    stroke-linecap: round;
    pointer-events: none;
  }
  .dlg-search input {
    width: 100%;
    box-sizing: border-box;
    background: var(--bg-1);
    border: 1px solid var(--border-bright);
    border-radius: 999px;
    color: var(--fg);
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.75rem 1rem 0.75rem 2.6rem;
  }
  .dlg-search input::placeholder { color: var(--fg-faint); }
  .dlg-search input:focus-visible { outline: 2px solid var(--brass-bright); outline-offset: 0; border-color: var(--brass-dark); }

  .dlg-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }
  .dlg-item[hidden] { display: none; }
  .dlg-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 0;
    text-align: left;
    background: var(--bg-1);
    color: var(--fg);
    border: 1px solid var(--border-bright);
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    font: inherit;
    transition: border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .dlg-card:hover { border-color: var(--brass-dark); transform: translateY(-2px); }
  .dlg-card:focus-visible { outline: 2px solid var(--brass-bright); outline-offset: 2px; }
  .dlg-card[aria-pressed='true'] { border-color: var(--brass); box-shadow: inset 0 3px 0 var(--brass); }
  @media (prefers-reduced-motion: reduce) { .dlg-card:hover { transform: none; } }

  .dlg-shot {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    min-height: 0;
    overflow: hidden;
    padding: 0.75rem;
    background: var(--bg-0);
    border-bottom: 1px solid var(--border);
  }
  .dlg-shot :global(img) { display: block; width: 100%; height: 100%; object-fit: contain; }

  .dlg-body { display: flex; flex-direction: column; gap: 0.3rem; flex: 1; padding: 1rem 1.1rem 1.1rem; }
