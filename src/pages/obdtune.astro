---
/**
 * /obdtune: the OBDTUNE page as a one-pager (Dan 2026-11-26, look A "Sheet" of three, picked on /obdlook; branch
 * feat/obdtune-onepager). Before: Gil's 2026-11-25 page (hero + six readings + bench + parameter table + get card).
 *
 * One screen under the header: the plugin's own live UI hovers on the house background (BaseLayout's bakelite + smoke);
 * beside it one quiet column: the name in the plugin's header print, the reading on a second screen in the tool's own
 * LCD (screen C "Data page", Dan's pick of three, 2026-11-27), an index of the parts with pilot lamps, the two keys. A press on any part of the tool (or the page its screen opens) picks the reading
 * (src/data/obdtune-parts.ts); a press on the index does the same and opens that page on the tool's screen.
 * The tool IS the plugin's UI (Source/ui/public, synced by tools/obdtune-ui/sync.sh into public/obdtune/ui, mounted by
 * src/lib/obdtune/unit.ts); re-sync when the plugin's UI changes.
 *
 * Keys: "Try free" = the site's TrialGateModal (data-trial-gate-open, the licence worker's gate id), "Buy" = the cart
 * (data-add-to-cart, Paddle). Commerce state in src/data/obdtune.ts; its wiring belongs to Yoni / Gil.
 */
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { obdtune, buyable, registerUrl, fmtUsd } from '../data/obdtune';
import { READINGS, INDEX } from '../data/obdtune-parts';
import stillSrc from '../assets/obdtune/unit-still.png';
import '../styles/obdtune.css';

const canBuy = buyable();
const trialRegister = registerUrl();
// the scanner's still (the plugin's home screen, as the page opens): shows until unit.ts mounts the live UI
const still = await getImage({ src: stillSrc, format: 'webp', width: 1080, quality: 82 });
const home = READINGS.home;
---
<BaseLayout
  title="OBDTUNE: plug in, read the note, tune it"
  description="OBDTUNE is vocal pitch correction built like a shop scan tool: it reads every note, finds the key with DETECT, tunes as hard or as human as you want, stacks two harmony voices and adds EQ, compression, echo and reverb. Free 30-day trial."
  index={true}
>
  <div class="obd" data-obd-page>
    <section class="obd-stage" data-obd-stage aria-labelledby="obd-title">
      <header class="obd-name">
        <p class="obd-maker" aria-hidden="true">RevAudio</p>
        <h1 id="obd-title" class="obd-mark">OBDTUNE</h1>
        <p class="obd-tag">Vocal pitch correction</p>
      </header>

      <div class="obd-unitwrap" data-obd-wrap>
        <i class="obd-floor" aria-hidden="true"></i>
        <div class="obd-unit" data-obd-unit role="group" aria-label="OBDTUNE, the plugin's own screen, live. Press any part of it and the reading beside it changes. D = DETECT, P = POWER.">
          <img class="obd-still" src={still.src} width={still.attributes.width} height={still.attributes.height} alt="" decoding="async" />
        </div>
      </div>

      <div class="obd-scr" data-obd-scr>
        <div class="obd-glass">
          {/* the tool's own header row: where you are + the telltales, the scan bar while it reads */}
          <div class="obd-scr-bar" aria-hidden="true">
            <span class="obd-scr-crumb">◂ HOME <b data-scr-crumb></b></span>
            <span class="obd-scr-meter" data-scr-meter><i></i></span>
            <span class="obd-scr-tt"><i>T</i><i>H</i><i>F</i><i>C</i></span>
          </div>
          <div class="obd-read" data-obd-read aria-live="polite">
            <p class="obd-r-label"><span class="obd-r-n" data-r-n>{home.n}</span><span data-r-label>{home.label}</span></p>
            <h2 class="obd-r-h" data-r-h>{home.h}</h2>
            <p class="obd-r-p" data-r-p>{home.p}</p>
            <p class="obd-r-spec" data-r-spec>{home.spec}</p>
          </div>
          <canvas class="obd-scr-fx" data-scr-fx aria-hidden="true"></canvas>
        </div>
      </div>

      <nav class="obd-index" aria-label="The parts of OBDTUNE">
        {INDEX.map((k) => (
          <button type="button" class="obd-ix" data-ix={k}><i aria-hidden="true"></i>{READINGS[k].label}</button>
        ))}
      </nav>

      <div class="obd-get">
        <div class="obd-keys">
          <button
            type="button" class="rv-btn rv-btn--sm"
            data-trial-gate-open data-plugin-name={obdtune.name} data-plugin-slug={obdtune.gateId}
            data-register-url={trialRegister ?? undefined}
          >Try free · {obdtune.trialDays} days</button>
          {canBuy && (
            <button
              type="button" class="rv-btn rv-btn--ghost rv-btn--sm"
              data-add-to-cart data-cart-open
              data-slug={obdtune.slug} data-name={obdtune.name} data-price={obdtune.priceUsd}
            >Buy · {fmtUsd(obdtune.priceUsd!)}</button>
          )}
        </div>
        <p class="obd-fine">{obdtune.formats}</p>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { initObdtune } from '../lib/obdtune/init';
  initObdtune();
</script>
