---
import BaseLayout from '../layouts/BaseLayout.astro';
import WordWall from '../components/WordWall.astro';
import TestimonialBlock from '../components/TestimonialBlock.astro';
import DAWStrip from '../components/DAWStrip.astro';
import PressLogos from '../components/PressLogos.astro';
import EmailCapture from '../components/EmailCapture.astro';
import SubscribeModal from '../components/SubscribeModal.astro';
---

<BaseLayout title="RevAudio">
  {/* No hero (2026-11-02, the user's call): the gauge medallion and "Engineered,
      Then Tuned." came out, so the TV is the first thing on screen. The page
      keeps its one h1, hidden, for search engines and screen readers. The
      closing "Hear it on your own mix" trial section went the same day (old
      site); the TV's own Try keys carry the trial now. */}
  <h1 class="sr-only">RevAudio, boutique audio plugins</h1>

  {/* the TV: every plugin, by category, and the one place to browse them (the carousel and the
      Store nav item went, branch feat/home-library 2026-10-18) */}
  <WordWall />

  <DAWStrip />
  <TestimonialBlock
    heading="Producers on RevAudio"
    ctaHref="/revlimiter"
    ctaLabel="Take RevLimiter for a spin"
    ctaSub="30-day free trial · no credit card"
  />
  <PressLogos />
  <EmailCapture id="subscribe" />

  <SubscribeModal />
</BaseLayout>
