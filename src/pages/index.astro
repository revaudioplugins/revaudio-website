---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PluginShowcase from '../components/PluginShowcase.astro';
import WordWall from '../components/WordWall.astro';
import TestimonialBlock from '../components/TestimonialBlock.astro';
import DAWStrip from '../components/DAWStrip.astro';
import PressLogos from '../components/PressLogos.astro';
import EmailCapture from '../components/EmailCapture.astro';
import SubscribeModal from '../components/SubscribeModal.astro';
import faceImg from '../assets/hero/rev-gauge-face.png';
import needleImg from '../assets/hero/needle-v2.png';
import hubImg from '../assets/hero/hub-v3.png';
import wallImg from '../assets/hero/hero-wall.jpg';
import wallMImg from '../assets/hero/hero-wall-m.jpg';
import { plugins, dlGateId } from '../data/plugins';
import { site } from '../data/site';

// Hero + closing trial CTAs open the TrialGateModal (mounted in BaseLayout)
// in place — same trigger contract as PluginCard / the crane door. The gate
// id MUST be dlGateId(), never the slug (the worker silently falls back to
// revlimiter on unknown ids — wiki gotcha).
const revlimiter = plugins.find((p) => p.slug === 'revlimiter')!;
const trialGateId = dlGateId(revlimiter);
const trialRegisterUrl = site.downloadGate.workerUrl + '/download/register';

/* Gauge geometry — the plugin's 406-viewBox units as % of the square dial box:
   needle <image> x122 y67.69 w162.4 (pivot at 49.877%/83.32% of its own box).
   Needle and hub hang off ONE pivot: the centre of the cap's RIM CIRCLE on
   the plate, least-squares fitted by design-assets/instagram/revaudio-gauge/
   cut-hub.py, which prints both constants below. The Higgsfield plate puts
   the cap off the bezel centre, so the pivot is NOT 50/50 — a needle spun
   about the geometric centre would orbit the hub visibly.
   Why the rim and not the bright-pixel centroid (the first cut, 48.525/49.822):
   a lit dome is brightest toward the lamp, so its centroid sits ~1/4 radius
   up-left of the cap's machined centre-mark — 9 css px at 640, enough that
   the needle visibly pivoted beside the cap instead of under it. HW is the
   cut's own box (rim + 3px feather), not the plugin's 45.5/406 hub box, which
   was a third wider than the cap and laid opaque face pixels over the needle
   root on one side. Re-run cut-hub.py and paste both whenever the plate
   changes. Reused at both dial sizes below — all child positioning is
   %-based, so it scales as one regardless of the dial's own width. */
const PIVOT = { x: 49.900, y: 51.055 };
const NW = 40, NOX = 0.49877, NOY = 0.8332;
const HW = 9.974;
const N = {
  left: `${(PIVOT.x - NW * NOX).toFixed(3)}%`,
  top: `${(PIVOT.y - NW * NOY).toFixed(3)}%`,
  w: `${NW}%`,
  ox: `${(NOX * 100).toFixed(3)}%`,
  oy: `${(NOY * 100).toFixed(2)}%`,
};
const H = { left: `${(PIVOT.x - HW / 2).toFixed(3)}%`, top: `${(PIVOT.y - HW / 2).toFixed(3)}%`, w: `${HW}%` };

/* The back wall behind the hero (hero patina pass, tasks/todo.md Step 3).
   Two photo plates, landscape for desktop and portrait for phones, applied
   as CSS backgrounds (not <img>) so only the one the viewport uses is ever
   fetched. getImage() runs them through the same pipeline as <Image>. */
const wallD = await getImage({ src: wallImg, width: 2560, format: 'webp', quality: 80 });
const wallM = await getImage({ src: wallMImg, width: 1080, format: 'webp', quality: 80 });
---

<BaseLayout title="RevAudio">
  {/* Hero — desktop: centered text column over the REV gauge medallion. No
      store CTA lives here any more (the brass STORE button, then the hanging
      wooden STORE sign, were both removed) — the header nav carries it.
      Mobile keeps its own stacked layout: centered text, small gauge under
      the headline. Entrance: text cascade → dial settle → needle rev-blip →
      idle. Scroll revs toward the redline; pointer micro-deflects (lerp).
      Reduced motion: static needle at idle. */}
  <section class="hero hero-feat" data-hero style={`--plate-d:url(${wallD.src});--plate-m:url(${wallM.src});`}>
    {/* The wall the gauge hangs on: patina steel, one trouble light top-left
        (the hero's light source), studio gear on the shelf. Full-bleed
        behind everything in the hero, above the fixed smoke. The inner
        plate overscans and drifts (data-drift-y, scrub.ts); the ::after
        rake + scrim is the contrast dial. Off in html.hc. */}
    <div class="hero-plate" aria-hidden="true">
      <div class="hero-plate-img" data-drift-y="16"></div>
    </div>
    <div class="hero-grid">
      <div class="hero-head" data-edit="hero.text">
        {/* Plain-English line before the metaphor (stop B): what we sell, in
            words a first visit parses instantly — fluency reads as lower
            risk. The identity stays loud in the headline below. */}
        <div class="hh-tag" data-hero-in data-edit-sub="tag">Boutique plugins</div>
        <h1 class="hh-h1">
          <span class="hh-h1-line" data-edit-sub="line1">Engineered,</span>
          <span class="hh-h1-line" data-edit-sub="line2">Then Tuned.</span>
        </h1>

        <span class="hh-redline" data-hero-sweep data-edit-sub="redline" aria-hidden="true"></span>

        {/* Mobile-only: small gauge under the headline (desktop uses the
            original full-size gauge, to the right of this text column). */}
        <div class="hero-dial hero-dial-mobile" data-dial data-hero-in role="img" aria-label="RevAudio rev gauge, needle at idle">
          <Image class="g-face" src={faceImg} alt="" width={360} format="webp" loading="eager" />
          <div class="g-needle" data-needle style={`left:${N.left}; top:${N.top}; width:${N.w}; transform-origin:${N.ox} ${N.oy};`}>
            <Image src={needleImg} alt="" width={170} format="webp" loading="eager" />
          </div>
          <Image class="g-hub" src={hubImg} alt="" width={60} format="webp" loading="eager" style={`left:${H.left}; top:${H.top}; width:${H.w};`} />
          <div class="g-glass" aria-hidden="true"></div>
        </div>

        <p class="hh-lede" data-hero-in data-edit-sub="lede">
          EASY, LIKE DRIVING A CAR.
        </p>

        {/* No CTA in the hero (2026-08-05, Dan's call): stop B's trial button
            and its "See the plugins" secondary both came out. The hero is
            atmosphere only — tag, headline, sweep, lede, gauge. The trial ask
            still lives in .closing-cta at the page end, on the product pages,
            and in TrialStamp on mobile. */}

      </div>

      {/* Desktop-only: the gauge as a centred backdrop medallion behind the
          headline. The wrapper — not the dial — owns the placement and the
          dimming, on purpose: the entrance timeline animates the dial's own
          opacity to 1 and its y/scale transform, so anything set on the dial
          itself gets overwritten the moment GSAP runs. Wrapping keeps the two
          concerns apart (wrapper = where + how dim, dial = how it animates)
          and means the motion script needs no changes at all. */}
      <div class="hero-medallion" data-edit="hero.gauge">
        <div class="hero-dial hero-dial-desktop" data-dial role="img" aria-label="RevAudio rev gauge, needle at idle">
          <Image class="g-face" src={faceImg} alt="" width={1173} widths={[400, 640, 900, 1173]} sizes="(max-width: 860px) 300px, (min-width: 1392px) 640px, 46vw" format="webp" loading="eager" />
          <div class="g-needle" data-needle style={`left:${N.left}; top:${N.top}; width:${N.w}; transform-origin:${N.ox} ${N.oy};`}>
            <Image src={needleImg} alt="" width={500} format="webp" loading="eager" />
          </div>
          <Image class="g-hub" src={hubImg} alt="" width={200} format="webp" loading="eager" style={`left:${H.left}; top:${H.top}; width:${H.w};`} />
          <div class="g-glass" aria-hidden="true"></div>
        </div>
      </div>
    </div>

    {/* Same seam style as every other section boundary on the page (e.g.
        DAWStrip's border-top below the carousel) — sits right under the
        headline/gauge content, closing the hero. */}
    <div class="hero-divider" aria-hidden="true"></div>
  </section>

  <PluginShowcase />

  {/* the stencil wall: what the sound does, beside the RevLimiter window */}
  <WordWall />

  <DAWStrip />
  <TestimonialBlock
    heading="Producers on RevAudio"
    ctaHref="/revlimiter"
    ctaLabel="Take RevLimiter for a spin"
    ctaSub="14-day free trial · no credit card"
  />
  <PressLogos />
  <EmailCapture id="subscribe" />

  {/* Peak-end (conversion pass stop B, 2026-08-03): the page used to end on
      the newsletter form — a fallback, not a decision. Close on the primary
      action instead; EmailCapture above stays as the true fallback. All
      widths on purpose: this section is normal page flow, not the killed
      mobile hero CTA / buy bar. */}
  <section class="closing-cta" aria-label="Start a free trial">
    <h2 class="cc-head">Hear it on your own mix</h2>
    <button
      type="button"
      class="trial-cta"
      data-trial-gate-open
      data-plugin-name={revlimiter.name}
      data-plugin-slug={trialGateId}
      data-register-url={trialRegisterUrl}
      aria-label="Start the free 30-day trial of RevLimiter, full version, no credit card"
    >
      <span class="tc-verb">Start your 30-day free trial</span>
      <span class="tc-micro">RevLimiter &middot; full version &middot; no credit card</span>
    </button>
    <a class="cc-alt" href="/store">Browse the store &rarr;</a>
  </section>

  <SubscribeModal />
</BaseLayout>

<script>
  import { gsap, ScrollTrigger, reducedMotion } from '../lib/motion';

  // Plugin scale: dB −60…0 maps to −135°…+135°. Idle ≈ −50 dB, redline ≈ −10 dB.
  const A_MIN = -135, A_IDLE = -90, A_RED = 90, A_MAX = 135;
  const root = document.querySelector<HTMLElement>('[data-hero]');
  const dials = root ? Array.from(root.querySelectorAll<HTMLElement>('[data-dial]')) : [];

  if (root) {
    if (reducedMotion()) {
      dials.forEach((dial) => {
        const needle = dial.querySelector<HTMLElement>('[data-needle]');
        if (needle) gsap.set(needle, { rotation: A_IDLE });
      });
    } else {
      // ── Entrance: text cascade + redline sweep + the dial darkening ──
      // The dial itself no longer arrives — it is already hanging on the wall
      // (Dan, 2026-09-07). What was the disc's fade is now the darkening's:
      // the two circles come up from clear glass, which reads as the gauge
      // going under shade rather than as a picture loading in.
      // Desktop arrives slowly. Mobile keeps the original snap: there the hero
      // IS the whole first screen and a ~3.6s arrival reads as the page
      // hanging, not as atmosphere. Matched once at load — the entrance is a
      // one-shot, so resizing across the breakpoint afterwards has nothing
      // left to re-time. Breakpoint is the same 860px the layout switches on.
      const slowIn = !matchMedia('(max-width: 860px)').matches;
      const textDur = slowIn ? 3 : 0.6;
      const circleDur = slowIn ? 1.8 : 0.7;

      const startEntrance = () => {
        const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
        // Dev-only handle for the RevEdit overlay (entrance scrubber + needle
        // controls). Tree-shaken out of prod builds.
        if (import.meta.env.DEV) (window as any).__reveditHero = { tl, dials: [] as object[] };
        tl.fromTo('[data-hero-in]', { y: 24, opacity: 0 }, { y: 0, opacity: 1, duration: textDur, stagger: 0.12 }, 0.05)
          .fromTo('[data-hero-sweep]', { scaleX: 0, opacity: 0 }, { scaleX: 1, opacity: 1, duration: 0.7, ease: 'power3.out' }, 0.75);

        // ── Headline: rides the rev, lands with the settle ──
        // Desktop beat (Dan's call): enter at 1.3s — a touch before the
        // needle crosses the redline (~1.7s, near the end of the power3.in
        // floor-it sweep) — with a long 1.8s rise that finishes ~3.1s, right
        // as the settle parks the needle back at idle. Mobile keeps the early
        // snap arrival: no medallion there, and a late headline on the only
        // first-screen content reads as a hang, not a payoff.
        // The two authored line spans rise and fade as-is — no SplitText
        // masks here, on purpose: the 31px halo bled through the word
        // clip-boxes as stripes of light before arrival, and split.revert()
        // snapped the clipped halo to full bloom in one frame. Opacity
        // carries the glow in smoothly instead, and with no revert there is
        // nothing left to snap.
        const h1 = root.querySelector<HTMLElement>('.hh-h1');
        if (h1) {
          const h1At = slowIn ? 1.3 : 0.15;
          const h1Dur = slowIn ? 1.8 : 0.7;
          const lines = h1.querySelectorAll<HTMLElement>('.hh-h1-line');
          const h1Targets: gsap.TweenTarget = lines.length ? Array.from(lines) : h1;
          gsap.set(h1, { opacity: 1 }); // release the pre-hide; the lines carry the reveal
          // Standalone tween + tl.add so the RevEdit hook below can rebuild it
          // in place; ease is explicit because add() doesn't inherit the
          // timeline's defaults the way tl.fromTo does.
          const buildH1 = (at: number, dur: number, stag: number) => {
            const tw = gsap.fromTo(
              h1Targets,
              { y: 26, opacity: 0 },
              { y: 0, opacity: 1, duration: dur, ease: 'expo.out', stagger: stag },
            );
            tl.add(tw, at);
            return tw;
          };
          let h1Tween = buildH1(h1At, h1Dur, 0.12);

          if (import.meta.env.DEV) {
            // RevEdit hook: the manifest's h1At/h1Dur/h1Stag sliders land here
            // (via the `js` prop branch in applyManifest). Rebuilds the tween
            // at the new beat, then replays from just before it so the new
            // rate is felt immediately — debounced so a slider drag replays
            // once, not per tick.
            const cfg = { h1At, h1Dur, h1Stag: 0.12 };
            let replayT: ReturnType<typeof setTimeout> | undefined;
            (window as any).__reveditHero.retime = (patch: Record<string, number>) => {
              const changed = Object.entries(patch).some(([k, v]) => cfg[k as keyof typeof cfg] !== v);
              Object.assign(cfg, patch);
              if (!changed) return;
              h1Tween.kill();
              tl.remove(h1Tween);
              h1Tween = buildH1(cfg.h1At, cfg.h1Dur, cfg.h1Stag);
              clearTimeout(replayT);
              replayT = setTimeout(() => { tl.pause().seek(Math.max(0, cfg.h1At - 0.4)); tl.play(); }, 250);
            };
          }
        }

        // The darkening, arriving. Starts a beat before the headline (1.3s on
        // desktop) and is essentially home by ~1.6s, so the copy never lands
        // on glass that has not dimmed yet — the measured contrast in the CSS
        // above is the end state, and this makes sure the end state is what
        // the first readable frame shows. GSAP tweens the custom property, so
        // both pseudo-elements follow without either being a target.
        const medallion = root.querySelector<HTMLElement>('.hero-medallion');
        if (medallion) {
          tl.fromTo(medallion, { '--circles': 0 }, { '--circles': 1, duration: circleDur, ease: 'power2.out' }, 0.2);
        }

        // One render path per dial, three signals each — base (load sweep →
        // idle), scroll deflection, pointer micro-deflection (lerped). Only
        // one of the two dials is ever visible at a time (desktop vs mobile
        // breakpoint), but both animate the same way regardless.
        dials.forEach((dial) => {
          const needle = dial.querySelector<HTMLElement>('[data-needle]');
          if (!needle) return;

          const state = { base: A_MIN, scroll: 0, pointer: 0, pointerTarget: 0 };
          if (import.meta.env.DEV) (window as any).__reveditHero?.dials.push(state);
          gsap.ticker.add(() => {
            state.pointer += (state.pointerTarget - state.pointer) * 0.08;
            gsap.set(needle, { rotation: Math.min(state.base + state.scroll + state.pointer, A_MAX) });
          });

          // No y/scale/opacity arrival for the dial — it is already there. The
          // needle still revs: floor it to the stop, then settle back to idle.
          tl.to(state, { base: A_MAX, duration: 0.85, ease: 'power3.in' }, 0.9) // floor it
            .to(state, { base: A_IDLE, duration: 1.1, ease: 'back.out(1.05)' }, '>'); // settle to idle

          // ── Scroll: rev toward the redline as the hero leaves the viewport ──
          ScrollTrigger.create({
            trigger: root,
            start: 'top top',
            end: 'bottom 20%',
            scrub: true,
            onUpdate: (self) => { state.scroll = self.progress * (A_RED - A_IDLE); },
          });

          // ── Pointer: micro-deflection (desktop only) ──
          if (matchMedia('(pointer: fine)').matches) {
            root.addEventListener('pointermove', (e) => {
              const r = dial.getBoundingClientRect();
              state.pointerTarget = ((e.clientX - (r.left + r.width / 2)) / r.width) * 6; // ±3° feel
            });
            root.addEventListener('pointerleave', () => { state.pointerTarget = 0; });
          }
        });
      };

      // ── First-load readiness gate ──
      // The hero pieces are pre-hidden in CSS (html.motion-ok rules below —
      // the same pattern the data-split h1 already rides), and the entrance
      // waits for the display fonts plus the visible dial face to finish
      // decoding. Without the gate a cold cache plays the fade against a
      // mid-swap fallback font and a still-decoding medallion — and worse,
      // the markup paints, vanishes when GSAP's from-state lands, then fades
      // back in. The 150ms floor gives warm-cache visits one settled painted
      // frame before motion starts; the 2.5s race bounds the wait, so a
      // stalled font or image can only delay the entrance, never strand the
      // pre-hide (GSAP's inline styles take over the moment the timeline is
      // built).
      const faces = dials
        .filter((dial) => dial.offsetParent !== null)
        .map((dial) => dial.querySelector<HTMLImageElement>('img.g-face'))
        .filter((img): img is HTMLImageElement => img !== null);
      const settled = Promise.all([
        document.fonts.ready,
        new Promise((resolve) => setTimeout(resolve, 150)),
        ...faces.map((img) => img.decode().catch(() => {})),
      ]);
      Promise.race([settled, new Promise((resolve) => setTimeout(resolve, 2500))]).then(startEntrance);
    }
  }
</script>

<style>
  /* ── Hero — centered text column over the REV gauge medallion. ── */
  /* First-load pre-hide for the entrance pieces, released by the readiness
     gate in the script above (GSAP's inline from-state takes over the moment
     the timeline is built, so no release class is needed). Gated on
     html.motion-ok so no-JS and reduced-motion visitors get the static hero —
     the same pattern the data-split h1 rides in global.css. */
  /* All pre-hides ride opacity — never transform. RevEdit's override
     re-apply rewrites inline opacity (releasing these) but CLEARS inline
     transforms, so a transform-based pre-hide would swallow the element the
     moment the editor re-applies after the entrance. */
  :global(html.motion-ok) [data-hero-in],
  :global(html.motion-ok) .hh-h1,
  :global(html.motion-ok) [data-hero-sweep] { opacity: 0; }
  /* The desktop dial is deliberately NOT pre-hidden: it hangs on the patina
     wall before anything moves, the way an object in the room does. What
     arrives instead is the darkening — --circles takes both gradients from
     clear glass to their tuned alphas, so the gauge is lit brass at first
     paint and dims as the copy lands on it. The mobile dial is unaffected: it
     carries data-hero-in and still rides the text cascade above. */
  :global(html.motion-ok) .hero-medallion { --circles: 0; }
  /* border-bottom: none overrides the global .hero divider — the hero should
     flow straight into the plugin showcase. */
  /* Bottom padding is the whole hero→showcase gap: the seam below the gauge
     used to sit 148px above the carousel (3rem + a +100px block added for
     Gil), which read as dead air on a page whose first two beats are the
     gauge and "Our Plugins". Tightened to 2rem — the showcase heading's own
     top padding carries the rest, and every section below rises as one unit. */
  /* One source of truth for the medallion's size — the gauge's width and the
     row's min-height both derive from it, so the backdrop can never outgrow
     the box that has to contain it. */
  .hero-feat { --medallion: clamp(400px, 46vw, 640px); position: relative; isolation: isolate; padding: var(--space-6) 0; overflow-x: clip; border-bottom: none; }

  /* The back wall. isolation: isolate on .hero-feat keeps these negative
     z-indexes inside the hero, above the fixed .haze layer (same pattern
     as GarageWall). --plate-alpha < 1 lets the smoke read through the
     plate's dark areas. */
  .hero-plate {
    --plate-alpha: 0.88;
    position: absolute;
    inset-block: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    z-index: -2;
    overflow: hidden;
    pointer-events: none;
    opacity: var(--plate-alpha);
  }
  .hero-plate-img {
    position: absolute;
    inset: -24px 0;
    background: var(--plate-d) center / cover no-repeat;
    will-change: transform;
  }
  /* Lamp spill from the top-left corner (light leaks past the object), a
     --bg-0 scrim so the kicker/lede keep AA over the photo, and a fade
     into the page colour at the bottom so the wall meets the divider
     without a hard edge. */
  .hero-plate::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 8% 0%, rgba(255, 196, 120, 0.16), rgba(255, 196, 120, 0) 70%),
      linear-gradient(180deg, rgba(11, 10, 9, 0.3) 0%, rgba(11, 10, 9, 0.3) 72%, rgba(11, 10, 9, 0.95) 100%);
  }
  :global(html.hc) .hero-plate { display: none; }

  /* Reintroduces a seam here (same style as every other section boundary,
     e.g. DAWStrip's border-top) — full width, sitting right under the
     headline/gauge content. */
  .hero-divider { border-top: 1px solid var(--border); margin-top: clamp(2rem, 5vh, 3rem); }

  /* Desktop: one centred text column with the gauge as a backdrop medallion
     centred behind it (picked in /balancelab, option D). The old side-by-side
     row leaned +46px right, because the head box was sized by the lede (58ch)
     while the eye tracks the narrower headline — on a single centre axis that
     mismatch can't express itself at all. Mobile (below) collapses this back
     to its own centred stack with the small in-flow gauge. */
  .hero-grid {
    position: relative; /* containing block for .hero-medallion */
    max-width: var(--maxw);
    margin: 0 auto;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    text-align: center;
    /* Holds the medallion inside the row so it can't bleed into the header
       above or the divider below — vertical overflow isn't clipped here. */
    min-height: calc(var(--medallion) + 3rem);
    gap: clamp(2.5rem, 6vw, 5rem);
    padding: clamp(1.5rem, 4vh, 3rem) clamp(1.5rem, 4vw, 4rem) 0;
  }

  .hero-head {
    position: relative;
    z-index: 2; /* over the medallion */
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Never wider than the disc behind it. Above ~1200px the 52ch measure wins
       and nothing changes; in the narrow desktop band the medallion is the
       smaller of the two, and without this the lede overhangs it either side
       and the "medallion" reading falls apart. */
    max-width: min(52ch, var(--medallion));
    flex: 0 1 auto;
    /* Optical centring nudge: the disc's visual centre sits a hair left of and
       below the box centre, so the type is pushed back the other way. Desktop
       only — reset at the mobile breakpoint, where there is no disc to centre
       against. */
    transform: translate(3px, -10px);
    /* Soft halo, tuned against the medallion. Does NOT count toward the
       contrast ratios below (WCAG scores glyph vs background, and a shadow is
       neither) — it is there to separate the type from the dial's engraving,
       not to carry legibility. Reset on mobile with the transform. */
    text-shadow: 0 0 31px color-mix(in srgb, currentColor 55%, transparent);
  }

  /* Type contrast: two layers anchored to the DIAL, not one ellipse sized off
     the text. The old scrim took its box from .hero-head (inset -120% / -43%),
     which resolved to a ~1330x375px ellipse over a 640px circle: it washed
     ~400px of the wall either side of the bezel, left 12 and 6 o'clock lit,
     buried the needle and the hub, and banded visibly at its own edge. Both
     layers below are circles concentric with the dial, so the darkening reads
     as the glass it is standing on instead of a smudge floating over the set.

     Layer 1, --tint, on .hero-dial-desktop::before. A positioned ::before is
     first in tree order, so it paints ABOVE the in-flow .g-face but BELOW the
     positioned .g-needle / .g-hub / .g-glass — so it can quiet the engraving
     and the numerals without touching the mechanism.
     Layer 2, --veil, on .hero-medallion::after, i.e. over the whole dial,
     needle included. It exists because a letterform landing on the lit brass
     hub measures 1.61:1 with the tint alone. How hard it is driven is the one
     knob that decides whether the needle reads — see the trade noted below.

     Measured from rendered pixels at 1568px — glyph interiors against the
     background underneath them, sampled with the type hidden so its own
     text-shadow cannot count as background — against a 4.5:1 AA requirement:
       old text-shaped ellipse   ->  tag 7.11   h1 12.57   lede 8.89   pass
       tint 0.94, no veil        ->  tag 6.23   h1  1.61   lede 9.02   FAIL
       tint 0.94 + veil 0.46     ->  tag 7.14   h1  4.57   lede 9.15   pass  <-
     Tuned 2026-09-07 in the gauge bench, two passes, measured between them.
     The trap the first pass hit: with a tiny tint (edge 29%) and a veil that
     stopped at 71% of a 0.89 box, nothing reached the plate's baked
     upper-left specular — and the E of ENGINEERED sits right on it.
       tint edge 29%, veil 1.00 / edge 71% / size 0.89  ->  h1 2.48  FAIL
       tint edge 78%, veil 0.86 / edge 88% / size 1     ->  h1 5.20  pass
       tint edge 78%, veil 0.60 / edge 88% / size 1     ->  h1 5.99  pass
       tint edge 78%, veil 1.00 / edge 75% / size 1     ->  h1 7.37  pass  <-
     Shipping is the last: a wide tint carries the face, a full-strength veil
     carries the centre. KNOWN TRADE, Dan's call — at veil 1.00 the needle and
     hub do not read, so the entrance sweep, the scroll-to-redline and the
     pointer deflection are all invisible. Back the veil toward 0.6 to get the
     mechanism back; that is the only knob that decides it.
     h1's worst case IS the hub, and it is the only tight number on the page.
     Re-measure it after any change to either layer, to the dial's size, or to
     the needle's idle angle. Both knobs are custom properties on the parent so
     the RevEdit overlay (npm run edit) can still reach the pseudo-elements. */
  /* Every visual property of both circles is a knob, so the gauge bench
     (npm run dev, then add ?gauge to the URL) can drive them live and hand
     back a block that pastes straight over these lines. The three stops
     between core and edge ride a shared ratio family (0.34 / 0.63 / 0.87),
     so moving core or edge stretches the whole falloff instead of moving one
     stop and kinking the curve. */
  .hero-medallion {
    /* Entrance multiplier on BOTH circles: 0 = clear glass, 1 = the tuned
       values below. The hero timeline tweens it; everything else leaves it
       alone, so the bench's numbers stay the numbers that were measured. */
    --circles: 1;
    --tint: 0.94;      /* peak alpha at the centre */
    --tint-core: 0%;  /* first falloff stop */
    --tint-edge: 78%;  /* where it reaches zero */
    --tint-a2: 0.957;  /* alphas of the four inner stops, as fractions of --tint */
    --tint-a3: 0.96;
    --tint-a4: 0.362;
    --tint-a5: 0.1;
    --tint-cx: 50%;
    --tint-cy: 50%;
    --tint-r: 22;       /* colour, split per channel so a slider can reach it */
    --tint-g: 0;
    --tint-b: 6;

    --veil: 1;
    --veil-core: 38%;
    --veil-edge: 75%;
    --veil-a2: 0.87;
    --veil-a3: 0.5;
    --veil-a4: 0.16;
    --veil-a5: 0.03;
    --veil-cx: 52%;
    --veil-cy: 50%;
    --veil-r: 7;
    --veil-g: 6;
    --veil-b: 5;
    --veil-size: 1;    /* multiple of --medallion */
  }
  .hero-dial-desktop::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
    background: radial-gradient(
      circle at var(--tint-cx) var(--tint-cy),
      rgba(var(--tint-r), var(--tint-g), var(--tint-b), calc(var(--tint) * var(--circles))) 0%,
      rgba(var(--tint-r), var(--tint-g), var(--tint-b), calc(var(--tint) * var(--tint-a2) * var(--circles)))
        var(--tint-core),
      rgba(var(--tint-r), var(--tint-g), var(--tint-b), calc(var(--tint) * var(--tint-a3) * var(--circles)))
        calc(var(--tint-core) + (var(--tint-edge) - var(--tint-core)) * 0.34),
      rgba(var(--tint-r), var(--tint-g), var(--tint-b), calc(var(--tint) * var(--tint-a4) * var(--circles)))
        calc(var(--tint-core) + (var(--tint-edge) - var(--tint-core)) * 0.63),
      rgba(var(--tint-r), var(--tint-g), var(--tint-b), calc(var(--tint) * var(--tint-a5) * var(--circles)))
        calc(var(--tint-core) + (var(--tint-edge) - var(--tint-core)) * 0.87),
      rgba(var(--tint-r), var(--tint-g), var(--tint-b), 0) var(--tint-edge)
    );
  }
  /* Absolute, not a grid item: .hero-medallion is a place-items:center grid
     and a second in-flow child would take its own row instead of stacking. */
  .hero-medallion::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--medallion) * var(--veil-size));
    height: calc(var(--medallion) * var(--veil-size));
    transform: translate(-50%, -50%);
    border-radius: 50%;
    pointer-events: none;
    background: radial-gradient(
      circle at var(--veil-cx) var(--veil-cy),
      rgba(var(--veil-r), var(--veil-g), var(--veil-b), calc(var(--veil) * var(--circles))) 0%,
      rgba(var(--veil-r), var(--veil-g), var(--veil-b), calc(var(--veil) * var(--veil-a2) * var(--circles)))
        var(--veil-core),
      rgba(var(--veil-r), var(--veil-g), var(--veil-b), calc(var(--veil) * var(--veil-a3) * var(--circles)))
        calc(var(--veil-core) + (var(--veil-edge) - var(--veil-core)) * 0.34),
      rgba(var(--veil-r), var(--veil-g), var(--veil-b), calc(var(--veil) * var(--veil-a4) * var(--circles)))
        calc(var(--veil-core) + (var(--veil-edge) - var(--veil-core)) * 0.63),
      rgba(var(--veil-r), var(--veil-g), var(--veil-b), calc(var(--veil) * var(--veil-a5) * var(--circles)))
        calc(var(--veil-core) + (var(--veil-edge) - var(--veil-core)) * 0.87),
      rgba(var(--veil-r), var(--veil-g), var(--veil-b), 0) var(--veil-edge)
    );
  }

  /* The medallion frame. Centres via grid rather than a transform so the
     entrance timeline's y/scale on the dial inside stays untouched, and
     carries the dimming so GSAP's opacity:1 on the dial can't undo it. Was
     0.8 while the text ellipse was doing the darkening and the dial was being
     dimmed twice over; the tint above is local and aimed, so the plate itself
     can sit almost at full strength. */
  .hero-medallion {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    z-index: 1;
    opacity: 0.95;
    pointer-events: none;
  }

  /* Desktop hero text sized up another 10% (tag/headline/lede/fastbuy) —
     mobile pins its own sizes back in the media query below, unaffected. */
  .hh-tag {
    font-family: var(--font-display);
    font-size: max(1.0285rem, 1.2705vw); /* was max(0.935rem, 1.155vw) */
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--brass);
    margin-bottom: 1.1rem;
  }

  /* Two-line headline: "Engineered," / "Then Tuned." — each line its own
     block so it stacks regardless of container width. */
  .hh-h1 {
    font-family: var(--font-display);
    font-size: clamp(3.146rem, 6.776vw, 6.534rem); /* was clamp(2.86rem, 6.16vw, 5.94rem) */
    line-height: 1.05;
    letter-spacing: 0.02em;
    color: var(--fg);
    margin: 0 0 1.15rem;
  }
  .hh-h1-line { display: block; white-space: nowrap; }

  .hh-redline {
    display: block;
    width: min(300px, 60%);
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--brass-bright), var(--redline));
    transform-origin: center;
    margin: 0 auto 1.25rem;
  }

  .hh-lede {
    /* Display face, not body — benched in bench/hero-text-bench.html. Bebas has
       no lowercase, so this line sets all-caps regardless of how the copy is
       typed; the extra leading and the negative tracking are there to hold it
       together at that width. */
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.75;
    letter-spacing: -0.01em;
    /* Lifted off plain --fg-dim, which never had the contrast this lede needs:
       2.95:1 over the medallion's brass ring on desktop, and 3.62:1 over the
       engine-glow backdrop on mobile (worse as --heat rises with scroll). Both
       are AA failures, so the lift is unconditional — it is NOT reset at the
       mobile breakpoint. Mixed from the two existing tokens rather than a new
       hex, so it still moves with a theme change. */
    color: color-mix(in srgb, var(--fg-dim) 55%, var(--fg));
    /* Inert on desktop — .hero-head above caps the column at
       min(52ch, var(--medallion)), so the lede can never reach this. Kept
       because it is what the mobile override below overrides. */
    max-width: 90ch;
    margin: 0 auto;
  }

  /* ── The trial CTA — the salience system's one "action channel" spend on
     this page, now only at the page close (the hero CTA came out 2026-08-05):
     clean flat brass against the worn textured world, dark label, no texture,
     no glow. Brass-bright, NOT race-red — red-on-red is camouflage here. ── */
  .trial-cta {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: 0.95rem 2.1rem;
    border: 0; /* it's a <button> now (opens the trial gate) — reset the UA chrome */
    border-radius: 4px;
    background: var(--brass-bright);
    color: var(--bg-0);
    text-shadow: none; /* cancel .hero-head's halo — enamel doesn't glow */
    cursor: pointer;
    transition: filter 0.2s var(--ease), transform 0.12s var(--ease);
  }
  .trial-cta:hover { filter: brightness(1.12); transform: translateY(-1px); }
  .trial-cta:active { filter: brightness(0.95); transform: translateY(0); }
  .tc-verb {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.06em;
    line-height: 1;
  }
  .tc-micro {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  /* ── Page terminus: end on the decision, not on a form. Same seam style as
     every other section boundary. ── */
  .closing-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
    padding: clamp(3rem, 8vh, 5rem) 1.5rem clamp(3.5rem, 9vh, 5.5rem);
    border-top: 1px solid var(--border);
    text-align: center;
  }
  .cc-head {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    letter-spacing: 0.04em;
    color: var(--fg);
    margin: 0 0 0.4rem;
  }
  .cc-alt {
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.1em;
    color: var(--fg-dim);
    transition: color 0.2s var(--ease);
  }
  .cc-alt:hover { color: var(--brass-bright); }

  /* ── The gauge: photoreal plate (Higgsfield nano_banana_pro pass over the
     plugin capture, needle removed — design-assets/instagram/revaudio-gauge)
     masked round; needle + hub overlay per the plugin's geometry (see N/H
     above), then a glass sheen over everything so the needle sits UNDER the
     glass, not on top of the baked reflection. All children positioned in % so each
     size below scales as one. Desktop dial = original full size
     (clamp(280px,30vw,400px)); mobile dial = 1/2 of it, under the headline. ── */
  .hero-dial {
    position: relative;
    aspect-ratio: 1;
    border-radius: 50%;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.65), 0 6px 18px rgba(0, 0, 0, 0.4);
    flex: 0 0 auto;
  }

  /* Backdrop medallion: no drop shadow — it reads as a lit panel behind the
     type, not an object floating in front of it. */
  .hero-dial-desktop { width: var(--medallion); box-shadow: none; }

  .hero-dial-mobile { display: none; width: min(160px, 40vw); margin: 0.5rem 0 0; }

  .hero-dial :global(img.g-face) {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 50%; /* masks the panel-leather corners of the capture */
  }

  /* One lamp, top-left (the trouble light on the wall): both shadows fall
     down-right. The cap's is tight — it sits a couple of mm over the needle,
     so its shadow lands ON the needle root and is what makes the two read
     as one assembly rather than a blade laid next to a button. */
  .g-needle {
    position: absolute;
    filter: drop-shadow(2px 4px 6px rgba(0, 0, 0, 0.5));
    /* First-paint angle. The dial is visible before any script runs now, so
       an un-rotated needle (0° = straight up) showed for a frame and then
       snapped to the sweep's start — the glitch Dan saw on reload. Static
       visitors (no JS, reduced motion) get idle; the motion path starts the
       needle exactly where the GSAP ticker's first frame puts it (A_MIN), so
       there is nothing to snap. GSAP's inline transform takes over from here. */
    transform: rotate(-90deg);
  }
  :global(html.motion-ok) .g-needle { transform: rotate(-135deg); }
  .g-needle :global(img) { width: 100%; height: auto; display: block; }

  .hero-dial :global(img.g-hub) {
    position: absolute;
    height: auto;
    filter: drop-shadow(1.5px 2.5px 3px rgba(0, 0, 0, 0.6));
  }

  /* Glass: one soft highlight matching the plate's baked upper-left
     reflection, screened over needle + hub. Kept faint — the plate already
     carries the real reflection; this only stops the needle reading as a
     sticker laid over the glass. */
  .g-glass {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
    mix-blend-mode: screen;
    background: radial-gradient(
      ellipse 58% 42% at 34% 24%,
      rgba(255, 250, 235, 0.11) 0%,
      rgba(255, 250, 235, 0.035) 45%,
      transparent 70%
    );
  }

  @media (max-width: 860px) {
    /* Collapse the row back to a stack. Text is already centered at every
       width, so only the column direction/width changes. */
    .hero-grid { flex-direction: column; gap: 2rem; min-height: 0; }
    /* Both the optical nudge and the halo exist only to seat the type against
       the medallion, and there is no medallion at this width. */
    .hero-head { max-width: 62ch; transform: none; text-shadow: none; }
    /* No medallion on mobile — the stack keeps its own small in-flow gauge
       under the headline, and a 400px backdrop behind narrow type would only
       fight it. The tint and the veil are scoped to the desktop dial and the
       medallion, so both leave with it. */
    .hero-medallion { display: none; }
    .hero-plate { --plate-alpha: 0.8; }
    .hero-plate-img { background-image: var(--plate-m); }
    .hh-h1-line { white-space: normal; }

    /* Tag + headline sized up 50%, then another 10% (×1.65 total); gauge
       sized up 25%; mobile only. Headline also lifted 10px. */
    .hh-tag { font-size: 1.4025rem; } /* 0.85rem × 1.5 × 1.1 */
    .hh-h1 { font-size: 4.29rem; margin-top: -10px; } /* 2.6rem × 1.5 × 1.1; lifted 10px */
    .hero-dial-mobile { width: min(200px, 50vw); margin-top: calc(0.5rem - 10px); } /* 160px / 40vw × 1.25; nudged up 10px */

    /* Lede stays at its original size — the desktop-only +10% above (base
       rules) would otherwise leak in here too. Colour is deliberately NOT
       reset here: this text sits over the ambient engine glow, where plain
       --fg-dim measures 3.62:1 (AA fail, 11% of glyph pixels under threshold
       at 390×844) and degrades further as --heat rises on scroll. */
    .hh-lede { font-size: 1.08rem; max-width: 58ch; }

    /* Mobile keeps only its own small under-headline dial. */
    .hero-dial-desktop { display: none; }
    .hero-dial-mobile { display: block; }
  }
