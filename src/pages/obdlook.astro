---
/**
 * /obdlook — LOOK ROUND for the OBDTUNE one-pager (Dan 2026-11-26: "the OBD tune hovering above a blank space ... I press
 * on the plugin itself, and then the presses change what I read about the plugin ... really minimalistic ... smaller
 * fonts ... 3 options, the 3rd your own"). Branch look/obdtune-onepager. NEVER merge as is: after Dan's pick the picked
 * look moves into obdtune.astro and this page goes. noindex.
 *
 * One screen under the header: the plugin's own live UI (unit.ts, FLOATING) hovers on the house background (bakelite +
 * the smoke from BaseLayout); a press on any part of it (or the page its screen opens) picks a reading
 * (src/data/obdtune-parts.ts). Three looks of the same pieces, ?look=a|b|c:
 *   A SHEET     the reading in one quiet column beside the tool, with an index of the parts (pilot lamps);
 *   B CALLOUT   the reading travels to the part, a hairline from the words to the tool's edge;
 *   C PRINTOUT  (Claude's own) every press prints a line on a scan report that rises out of a printer slot.
 * Same background, copy, type scale and keys in all three. Trial = the site's TrialGateModal (as the home TV does);
 * Buy = the cart, the existing data-add-to-cart hooks (Paddle wiring untouched: Yoni / Gil).
 */
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { obdtune, buyable, registerUrl, fmtUsd } from '../data/obdtune';
import { READINGS, INDEX } from '../data/obdtune-parts';
import stillSrc from '../assets/obdtune/unit-still.png';
import '../styles/obdlook.css';

const canBuy = buyable();
const trialRegister = registerUrl();
const still = await getImage({ src: stillSrc, format: 'webp', width: 1080, quality: 82 });
const home = READINGS.home;
---
<BaseLayout
  title="OBDTUNE: plug in, read the note, tune it"
  description="OBDTUNE is vocal pitch correction built like a shop scan tool. Press any part of it to read what it does. Free 30-day trial."
  index={false}
>
  <div class="ol" data-ol data-look="a">
    <script is:inline>
      // the look before the first paint (?look=a|b|c), so nothing jumps
      (function () { var m = /[?&]look=([abc])/.exec(location.search); var el = document.currentScript.parentElement; if (m) el.dataset.look = m[1]; })();
    </script>
    <section class="ol-stage" data-ol-stage aria-labelledby="ol-title">
      <header class="ol-name">
        <p class="ol-maker" aria-hidden="true">RevAudio</p>
        <h1 id="ol-title" class="ol-mark">OBDTUNE</h1>
        <p class="ol-tag">Vocal pitch correction</p>
      </header>

      <div class="ol-unitwrap" data-ol-wrap>
        <i class="ol-floor" aria-hidden="true"></i>
        <div class="ol-unit" data-obd-unit role="group" aria-label="OBDTUNE, the plugin's own screen, live. Press any part of it: the reading beside it changes. D = DETECT, P = POWER.">
          <img class="ol-still" src={still.src} width={still.attributes.width} height={still.attributes.height} alt="" decoding="async" />
        </div>
      </div>

      <p class="ol-hint" data-ol-hint>Press any part of it.</p>

      <div class="ol-read" data-ol-read aria-live="polite">
        <p class="ol-r-label"><span class="ol-r-n" data-r-n>{home.n}</span><span data-r-label>{home.label}</span></p>
        <h2 class="ol-r-h" data-r-h>{home.h}</h2>
        <p class="ol-r-p" data-r-p>{home.p}</p>
        <p class="ol-r-spec" data-r-spec>{home.spec}</p>
      </div>

      <nav class="ol-index" aria-label="The parts of OBDTUNE">
        {INDEX.map((k) => (
          <button type="button" class="ol-ix" data-ix={k}><i aria-hidden="true"></i><span class="ol-ix-n">{READINGS[k].n}</span>{READINGS[k].label}</button>
        ))}
      </nav>

      <svg class="ol-leader" data-ol-leader aria-hidden="true"><line x1="0" y1="0" x2="0" y2="0"></line><circle r="2.5" cx="0" cy="0"></circle></svg>

      <div class="ol-printer" aria-hidden="true">
        <div class="ol-paperwin"><div class="ol-paper" data-ol-paper><i class="ol-tear"></i></div></div>
        <div class="ol-slot"><i></i></div>
      </div>

      <div class="ol-get">
        <div class="ol-keys">
          <button
            type="button" class="rv-btn rv-btn--sm"
            data-trial-gate-open data-plugin-name={obdtune.name} data-plugin-slug={obdtune.gateId}
            data-register-url={trialRegister ?? undefined}
          >Try free · {obdtune.trialDays} days</button>
          {canBuy && (
            <button
              type="button" class="rv-btn rv-btn--ghost rv-btn--sm"
              data-add-to-cart data-cart-open
              data-slug={obdtune.slug} data-name={obdtune.name} data-price={obdtune.priceUsd}
            >Buy · {fmtUsd(obdtune.priceUsd!)}</button>
          )}
        </div>
        <p class="ol-fine">{obdtune.formats}</p>
      </div>
    </section>

    <nav class="ol-looks" aria-label="Look round (review only)">
      <span>LOOK</span>
      <button type="button" data-ol-look="a" aria-label="A, Sheet"><b>A</b><em>Sheet</em></button>
      <button type="button" data-ol-look="b" aria-label="B, Callout"><b>B</b><em>Callout</em></button>
      <button type="button" data-ol-look="c" aria-label="C, Printout"><b>C</b><em>Printout</em></button>
    </nav>
  </div>

  <script define:vars={{ price: obdtune.priceUsd, trialDays: obdtune.trialDays }}>
    window.__olCfg = { price, trialDays };
  </script>
</BaseLayout>

<script>
  import { initLook } from '../lib/obdtune/look';
  initLook();
</script>
