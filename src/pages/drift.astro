---
/**
 * /drift — the DRIFT season page. Its own route (like /gas), NOT the shared
 * [slug].astro product layout: Dan 2026-09-26, "all the style of DRIFT in
 * the page ... don't take RevLimiter and Radio Roulette as a reference, fresh".
 * Architecture: ~/workspace/revaudio/stages/04_website/output/2026-10-01-drift-page-conversion-architecture.md
 *
 * House shell stays (header, footer, cart — decision 1). Everything between is
 * DRIFT: its plate, panels, neon, glass and parts, cut from the plugin's own
 * assets (src/assets/seasons/drift/, MANIFEST.md there). One pan bus
 * (src/lib/drift/bus.ts) ties the wheel, the rails and the TRACKS car
 * together. Copy is checked against Drift v4.28.0 source plus Dan's D2/H1
 * decision (2026-09-30): the wheel, TRACKS and AUTO DRIFT pan the WHOLE
 * sound; LOW/HIGH CUT only set where echo, reverb, tremolo and pitch play.
 * No F1 names or circuits anywhere (Decision 19).
 *
 * Order: hero · [#hear only when demoMode 'real'] · #drive · keep-it menu ·
 * #fx · #get · #creators, plus the phone sticky bar. The rails ride .d-drivezone (hero +
 * #drive) only, so they leave before the form and never reach the footer.
 */
import { existsSync } from 'node:fs';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import DriftRails from '../components/drift/DriftRails.astro';
import DriftHero from '../components/drift/DriftHero.astro';
import DriftHeadUnit from '../components/drift/DriftHeadUnit.astro';
import DriftTracks from '../components/drift/DriftTracks.astro';
import DriftKeep from '../components/drift/DriftKeep.astro';
import DriftFx from '../components/drift/DriftFx.astro';
import DriftGetIn from '../components/drift/DriftGetIn.astro';
import DriftCreators from '../components/drift/DriftCreators.astro';
import DriftStickyBar from '../components/drift/DriftStickyBar.astro';
import { drift, assertDriftConfig } from '../data/drift';
import { plugins } from '../data/plugins';
import '../styles/drift.css';

import tileSrc from '../assets/seasons/drift/plate-tile.png';
import panelSrc from '../assets/seasons/drift/panel-face.png';
import screwSrc from '../assets/seasons/drift/panel-screw.png';
import lcdSrc from '../assets/seasons/drift/val_lcd.png';
import glassSrc from '../assets/seasons/drift/val_glass.png';
import pillSrc from '../assets/seasons/drift/cta-pill.png';
import ctaRestSrc from '../assets/seasons/drift/cta-key-rest.png';
import ctaPressSrc from '../assets/seasons/drift/cta-key-press.png';
import trialPlateSrc from '../assets/seasons/drift/trial-plate.png';
import sectionPlateSrc from '../assets/seasons/drift/section-plate-s1.png';   // renamed per plate: the dev image URL has no content hash, so a new name = no stale cache

// A phase the page can't honour (open without the feedback form, released
// without checkout or audio) fails the build here, never quietly on the page.
assertDriftConfig(plugins.find((p) => p.slug === 'drift')?.checkoutUrl);
// Date-free DRIFT card (gas.astro pattern); the house default until it exists.
const ogImage = existsSync('public/og/drift.png') ? '/og/drift.png' : undefined;

// Textures the stylesheet paints with: getImage() -> WebP -> CSS custom
// properties on .drift-page (the TrialPlates / [slug] pattern), so no raw PNG
// ever ships from a url() in drift.css. --d-img-cta/-press = the plugin's
// current red key (trk_key_rest/press.png); --d-img-pill stays the fallback.
const [tile, panel, screw, lcd, glass, pill, ctaRest, ctaPress, trialPlate, sectionPlate] = await Promise.all([
  getImage({ src: tileSrc, width: 800, format: 'webp', quality: 62 }),
  getImage({ src: panelSrc, width: 720, format: 'webp', quality: 70 }),
  getImage({ src: screwSrc, width: 76, format: 'webp', quality: 85 }),
  getImage({ src: lcdSrc, width: 498, format: 'webp', quality: 80 }),
  getImage({ src: glassSrc, width: 410, format: 'webp', quality: 80 }),
  getImage({ src: pillSrc, width: 1443, format: 'webp', quality: 82 }),
  getImage({ src: ctaRestSrc, width: 720, format: 'webp', quality: 82 }),
  getImage({ src: ctaPressSrc, width: 720, format: 'webp', quality: 82 }),
  // the hero trial plate (AI, tools/gen-drift-trial-panel.sh D): full source width, it shows ~1040 css px wide
  getImage({ src: trialPlateSrc, width: 1393, format: 'webp', quality: 82 }),
  // the #drive section plate (AI, tools/gen-drift-section-panel.sh S roll 1, Dan 10-03): full width, the slices are in
  // source px; q88: the bezel only, its middle is flat (the drawn carbon sits on top)
  getImage({ src: sectionPlateSrc, width: 2308, format: 'webp', quality: 88 }),
]);
const u = (i: { src: string }) => `url(${i.src})`;
const imgVars = [
  `--d-img-tile:${u(tile)}`, `--d-img-panel:${u(panel)}`, `--d-img-screw:${u(screw)}`,
  `--d-img-lcd:${u(lcd)}`, `--d-img-glass:${u(glass)}`, `--d-img-pill:${u(pill)}`,
  `--d-img-cta:${u(ctaRest)}`, `--d-img-cta-press:${u(ctaPress)}`, `--d-img-trial:${u(trialPlate)}`,
  `--d-img-section:${u(sectionPlate)}`,
].join(';');
---
<BaseLayout
  title="DRIFT: let your sound take the wheel"
  description="DRIFT pans your whole sound across the stereo field: by hand with the wheel, or around a shape in time with your song. Echo, reverb, tremolo and pitch play on a band you pick. 14-day free trial from Sat Oct 10. VST3, AU and AAX on Mac, VST3 and AAX on Windows."
  ogImage={ogImage}
>
  <div class="drift-page" data-drift-page style={imgVars}>
    <div class="d-drivezone">
      <DriftRails />
      <DriftHero />
      {drift.demoMode === 'real' && <DriftHeadUnit />}
      <DriftTracks />
    </div>
    <DriftKeep />
    <DriftFx />
    <DriftGetIn />
    {drift.creatorDealOpen && <DriftCreators />}
    <DriftStickyBar />
  </div>
</BaseLayout>

<script>
  import { initDrift } from '../lib/drift/init';
  initDrift();
</script>
