---
/* /store retired 2026-10-18 (home LIBRARY, D3): every plugin lives in the
   TV, on /plugins since 2026-11-02, so this address sends people there. Old links keep
   working this way (the footer and emails of the past, the licence worker's
   https://revaudio.net/store link).

   GitHub Pages can't answer with a 301, so the page does it:
   - a script first: it keeps the query string (utm / gclid / ref reach the
     cart's attribution on the plugins page), and replace() leaves no page for
     Back to bounce off;
   - a meta refresh when there is no JavaScript;
   - for search engines a canonical link to /plugins + noindex (and
     /store/ sits in astro.config.mjs's NOINDEX, so the sitemap drops it).
   Bare on purpose, no BaseLayout: a hop nobody sees fires no analytics
   page_view, popup or consent banner. A real 301 would be a Cloudflare
   Redirect Rule (dashboard), not this repo. */
const plugins = new URL('/plugins', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>RevAudio plugins</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={plugins} />
    <script is:inline>location.replace('/plugins' + location.search);</script>
    <noscript><meta http-equiv="refresh" content="0; url=/plugins" /></noscript>
    <style is:inline>
      html { background: #0b0a09; color: #efe9df; font: 16px/1.5 system-ui, sans-serif; }
      body { margin: 0; padding: 3rem 1rem; text-align: center; }
      a { color: #e8c878; } /* --brass-bright */
    </style>
  </head>
  <body>
    <p><a href="/plugins">The RevAudio plugins &rarr;</a></p>
  </body>
</html>
