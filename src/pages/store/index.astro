---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PluginCard from '../../components/PluginCard.astro';
import DriftCard from '../../components/drift/DriftCard.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import { plugins } from '../../data/plugins';

// Shipping products lead; in-development plugins sit in their own labeled row
// below (conversion pass 2026-08-03) — unbuyable tiles mixed into the main
// grid read "roadmap company" to a first-time visitor.
// A plugin with an open free trial (DRIFT beta) counts as shipping here.
const onBench = (p: (typeof plugins)[number]) => p.status === 'in-development' && !p.trialOpen;
// Store-only order (Yoni 2026-10-11: DRIFT takes GAS's first-row slot); slugs not listed keep catalog order after these.
const STORE_ORDER = ['revlimiter', 'radio-roulette', 'drift', 'gas'];
const rank = (slug: string) => { const i = STORE_ORDER.indexOf(slug); return i < 0 ? STORE_ORDER.length : i; };
const shipping = plugins.filter((p) => !onBench(p)).sort((a, b) => rank(a.slug) - rank(b.slug));
const roadmap = plugins.filter(onBench);
---

<BaseLayout
  title="Store"
  description="Buy RevAudio plugins. Boutique mixing and mastering tools, simple controls, built to feel."
>
  <section class="hero" style="padding: 5rem 0 3rem;">
    <div class="container">
      <div class="tag">Store</div>
      <h1 data-split>The plugins</h1>
      <p class="lede">Single purchase. Lifetime updates within the major version. No subscription, no hassle.</p>
    </div>
  </section>

  <section class="store-grid">
    <div class="container">
      {/* sr-only heading: the cards expose plugin names as <h3>; this gives them
          an <h2> parent so the document outline doesn't jump h1 → h3. */}
      <h2 class="sr-only">Available plugins</h2>
      <div class="cards">
        {shipping.map((p) => <PluginCard plugin={p} showCart />)}
      </div>

      {roadmap.length > 0 && (
        <div class="bench">
          <h2 class="bench-title">On the bench</h2>
          <p class="bench-sub muted">In development now. Join a waitlist and we&rsquo;ll email you at launch.</p>
          <div class="cards cards-bench">
            {roadmap.map((p) => p.slug === 'drift' ? (
              /* DRIFT = the homepage's arcade cabinet, not the coming-soon plate
                 (Dan 2026-10-09). The 520x470 stage is scaled to the tile below. */
              <div class="plugin-card-wrap drift-tile" data-drift-tile>
                <div class="drift-stage sc-slide is-current" data-slide>
                  <a class="drift-hit" href="/drift" aria-label="DRIFT, more details"></a>
                  <DriftCard />
                </div>
              </div>
            ) : <PluginCard plugin={p} showCart />)}
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="store-faq section">
    <div class="container">
      <h2 class="center" data-split>Common questions</h2>
      <div class="faq-grid" data-reveal-group>
        <div data-reveal-item>
          <h3>What do I get?</h3>
          <p class="muted">A VST3 / AU / AAX plugin (Windows &amp; macOS), free updates within the major version, and a licence for one user across up to two machines you own.</p>
        </div>
        <div data-reveal-item>
          <h3>Can I try before I buy?</h3>
          <p class="muted">Yes, a free 30-day trial. It&rsquo;s the full plugin: every feature, no licence key, and no audio interruptions. Drop your email on the product page and the download link arrives in your inbox.</p>
        </div>
        <div data-reveal-item>
          <h3>Mac and Windows?</h3>
          <p class="muted">Available on both macOS and Windows. One licence covers both installers.</p>
        </div>
        <div data-reveal-item>
          <h3>Refund policy?</h3>
          <p class="muted">14-day refund, no questions asked. If a plugin doesn't deliver, take your money back.</p>
        </div>
        <div data-reveal-item>
          <h3>How does payment work?</h3>
          <p class="muted">Checkout is fully secure. Tax and VAT are handled automatically, your licence is delivered by email, and RevAudio never sees your card details.</p>
        </div>
        <div data-reveal-item>
          <h3>Need help?</h3>
          <p class="muted">Email <a href="mailto:support@revaudio.net">support@revaudio.net</a> or read the <a href="/support">support page</a>.</p>
        </div>
      </div>
      <p class="center muted" style="margin-top: 2rem; font-size: 0.85rem;">
        See also <a href="/eula">licence terms</a> &middot; <a href="/support">support &amp; install</a>
      </p>
    </div>
  </section>

  <EmailCapture
    heading="Hear it first"
    subhead="New plugins and demo codes, straight to your inbox. Unsubscribe anytime."
  />
</BaseLayout>

<script>
  /* Scale DRIFT's fixed 520x470 arcade stage to its tile's width. */
  const tile = document.querySelector<HTMLElement>('[data-drift-tile]');
  if (tile) new ResizeObserver(() => tile.style.setProperty('--s', String(tile.clientWidth / 520))).observe(tile);
</script>

<style>
  .store-grid { padding: 3rem 0 4rem; }

  /* DRIFT's arcade cabinet (drift/DriftCard.astro), its body painted as on the carousel */
  .drift-tile { position: relative; aspect-ratio: 520 / 470; align-self: start; }
  .drift-stage {
    position: absolute; left: 0; top: 0; width: 520px; height: 470px;
    transform: scale(var(--s, 0.7)); transform-origin: 0 0;
    border-radius: 18px; border: 1px solid transparent;
    background:
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.018) 0 2px, transparent 2px 5px) padding-box,
      radial-gradient(ellipse 80% 60% at 50% 40%, #1d0a2c 0%, #0f0518 55%, #07040b 100%) padding-box,
      linear-gradient(180deg, #e58bff 0%, #b23cff 26%, #4b1673 62%, #8a2be2 100%) border-box;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.55), 0 0 26px rgba(210, 60, 255, 0.22);
    transition: box-shadow 0.2s ease;
  }
  .drift-stage:hover { box-shadow: 0 12px 48px rgba(0, 0, 0, 0.55), 0 0 34px rgba(210, 60, 255, 0.38); }
  .drift-hit { position: absolute; inset: 0; z-index: 5; }

  /* Showroom row: all three plugins side by side on desktop so the range
     reads at a glance; equal-height cards with aligned price footers. Stacks
     back to the single centred column below 1020px. */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .cards > :global(.plugin-card-wrap) { display: flex; }
  .cards :global(.plugin-card) { flex: 1; }

  @media (max-width: 1020px) {
    .cards {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      max-width: 480px;
      margin: 0 auto;
    }
  }

  /* On the bench — the in-development row. Visibly subordinate to the
     showroom: a rule above, smaller heading, narrower two-up grid. */
  .bench { margin-top: 3.5rem; padding-top: 2.5rem; border-top: 1px solid var(--border); }
  .bench-title {
    font-size: 1.15rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass);
    margin: 0 0 0.35rem;
  }
  .bench-sub { margin: 0 0 1.5rem; font-size: 0.9rem; }
  .cards.cards-bench {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 760px;
  }
  @media (max-width: 1020px) {
    .cards.cards-bench { grid-template-columns: 1fr; max-width: 480px; margin: 0; }
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-top: 2rem;
  }

  @media (max-width: 720px) {
    .faq-grid { grid-template-columns: 1fr; }
  }

  .faq-grid h3 {
    color: var(--brass-bright);
    margin-bottom: 0.5rem;
  }
</style>
