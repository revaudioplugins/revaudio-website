---
import '../styles/fonts.css';
import '../styles/global.css';
// The two faces the first screen paints with; preloaded below so text
// doesn't wait for the CSS to be parsed before its font request starts.
import bebasLatin from '../styles/fonts/bebas-neue-latin.woff2?url';
import interLatin from '../styles/fonts/inter-latin.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cart from '../components/Cart.astro';
import CartFab from '../components/CartFab.astro';
import CookieBanner from '../components/CookieBanner.astro';
import ExitIntentPopup from '../components/ExitIntentPopup.astro';
import WelcomeDiscountPopup from '../components/WelcomeDiscountPopup.astro';
import TrialGateModal from '../components/TrialGateModal.astro';
import { site } from '../data/site';

// Privacy-friendly analytics: only in production, only once a beacon token is set.
const analyticsOn = import.meta.env.PROD && !!site.cfBeaconToken;

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** When false, emit noindex. Default true now the store is live; pass index={false} to hide a single page. */
  index?: boolean;
  /** og:type — 'article' for blog posts. */
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'RevAudio builds boutique VST plugins for producers who want tools that sound expensive and play simple.',
  ogImage = '/og-default.png',
  index = true,
  ogType = 'website',
} = Astro.props;

const fullTitle = title === 'RevAudio'
  ? 'RevAudio: Plugins built like cars'
  : `${title} · RevAudio`;

// Every page names its own URL as canonical, so Google never has to guess
// between /page and /page/ or a tracking-tagged copy.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {!index && <meta name="robots" content="noindex, nofollow" />}
    {index && <link rel="canonical" href={canonical} />}

    <!-- OG / social -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:site_name" content="RevAudio" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    {/* Fonts are self-hosted (src/styles/fonts.css), no Google request. */}
    <link rel="preload" as="font" type="font/woff2" href={bebasLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />

    <title>{fullTitle}</title>

    {/* Gate for reveal pre-hide (global.css html.motion-ok rules). Runs sync in
        head so revealable elements are never visibly hidden-then-shown; without
        JS or with reduced motion the class never lands and content is static. */}
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('motion-ok');
    </script>

    {/* High-contrast pre-paint gate — applies html.hc before first paint so a
        saved choice never flashes the normal theme. No saved choice → follow
        the OS (prefers-contrast: more), so people who asked their system for
        more contrast get it without ever finding the switch; an explicit "0"
        from the switch still wins over the OS. Switch UI is A11yToggle.astro,
        mounted in the footer's Legal column; styles in global.css. */}
    <script is:inline>
      try {
        var raHc = localStorage.getItem('ra-hc');
        if (raHc === '1' || (raHc === null && matchMedia('(prefers-contrast: more)').matches))
          document.documentElement.classList.add('hc');
      } catch (e) {}
    </script>

    {/* Cloudflare Web Analytics. No SRI: CF rotates beacon.min.js and ships it
        without a published hash, so a pinned integrity would break on update.
        Token is a public beacon id, not a secret. */}
    {analyticsOn && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${site.cfBeaconToken}"}`}
      ></script>
    )}

    {/* Page-specific head tags (blog posts put their Article JSON-LD here). */}
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    {/* the smoke: two drifting haze plates + veil, fixed behind the page (src/lib/haze.ts) */}
    <div class="haze" data-haze aria-hidden="true">
      <div class="haze-plate h1" data-haze-1></div>
      <div class="haze-plate h2" data-haze-2></div>
      <div class="haze-veil"></div>
    </div>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Cart />
    <CartFab />
    <CookieBanner />
    <ExitIntentPopup />
    <WelcomeDiscountPopup />
    <TrialGateModal />
    <script>
      import { initMotion } from '../lib/motion';
      import { initHaze } from '../lib/haze';
      import { initReveals } from '../lib/reveal';
      import { initWalkthrough } from '../lib/walkthrough';
      import { initSplitHeadlines } from '../lib/splittext';
      import { initScrubs } from '../lib/scrub';
      initMotion();
      initHaze();
      initReveals();
      initWalkthrough();
      initSplitHeadlines();
      initScrubs();
    </script>
  </body>
</html>
