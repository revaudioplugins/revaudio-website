---
/**
 * SupportChat — the support bot's front end. Mounted on /support ONLY
 * (Dan, 2026-09-07: not site-wide for v1, so product pages stay quiet).
 *
 * Two parts: a launcher docked bottom-right (bordered pill on desktop, 48px
 * FAB on phones — the cart FAB's twin, bottom-left) and the panel: a rounded
 * "dashboard cluster" popover on desktop, a bottom sheet on phones. Six
 * gauge tiles map to the sections of /support and answer locally from the
 * same copy; free text goes to `site.supportChat.workerUrl` (Yoni's backend,
 * POST {message, src, page} → {reply}). While that URL is empty the panel
 * answers tiles only and points free text at the tiles or a human — never a
 * fake "typing…" that leads nowhere.
 *
 * Doors: the launcher, any [data-support-open] element on the page (the
 * "Still stuck?" strip), and `?chat=open` in the URL (Instagram bio link /
 * ManyChat button / purchase email; `src=` rides along to the backend).
 *
 * Honesty: the status LED is amber "Bot on duty" until the backend exposes a
 * real human-presence flag — no green "online" nobody is behind.
 */
import { site } from '../data/site';

const endpoint = site.supportChat?.workerUrl ?? '';
const SUPPORT_EMAIL = 'support@revaudio.net';
---

<button type="button" class="sc-launch" data-support-launch aria-controls="support-chat" aria-expanded="false" aria-label="Open support chat">
  <span class="sc-led" aria-hidden="true"></span>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 13a8 8 0 0 1 16 0v4a2 2 0 0 1-2 2h-1v-6h3M4 13v4a2 2 0 0 0 2 2h1v-6H4" /><path d="M12 21h4" />
  </svg>
  <span class="sc-launch-label">Support</span>
</button>

<section id="support-chat" class="sc" data-support-chat data-endpoint={endpoint} role="dialog" aria-label="Support chat" hidden>
  <div class="sc-grip" aria-hidden="true"></div>
  <header class="sc-head">
    <span class="sc-avatar" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 13a8 8 0 0 1 16 0v4a2 2 0 0 1-2 2h-1v-6h3M4 13v4a2 2 0 0 0 2 2h1v-6H4" /><path d="M12 21h4" />
      </svg>
    </span>
    <div class="sc-title">
      <h2>Support</h2>
      <p class="sc-status"><span class="sc-led" aria-hidden="true"></span>Bot on duty &middot; a human within 1 business day</p>
    </div>
    <button type="button" class="sc-x" data-support-close aria-label="Close support chat">&times;</button>
  </header>

  {/* data-lenis-prevent: the site's Lenis smooth scroll otherwise eats the
      wheel inside the log (same fix as the cart drawer's item list). */}
  <div class="sc-log" data-support-log data-lenis-prevent tabindex="0" aria-live="polite">
    <p class="sc-day" aria-hidden="true">Today</p>
    <div class="sc-msg sc-msg--bot is-first is-last">
      <span class="sc-ava" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 13a8 8 0 0 1 16 0v4a2 2 0 0 1-2 2h-1v-6h3M4 13v4a2 2 0 0 0 2 2h1v-6H4" /><path d="M12 21h4" />
        </svg>
      </span>
      <div class="sc-bubble">
        <p class="sc-text">Hey. Pick what&rsquo;s up, or just type it.<span class="sc-meta" data-support-time></span></p>
      </div>
    </div>
    <div class="sc-gauges" role="group" aria-label="Common questions">
      <button type="button" class="sc-gauge" data-support-topic="install">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M7 10l5 5 5-5M4 20h16" /></svg>
        <span>Install</span>
      </button>
      <button type="button" class="sc-gauge" data-support-topic="licence">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4" /><path d="M10.8 12.2 20 3l1 1-2 2 1 1-2 2 1 1-1.5 1.5" /></svg>
        <span>Licence</span>
      </button>
      <button type="button" class="sc-gauge" data-support-topic="trial">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
        <span>Trial</span>
      </button>
      <button type="button" class="sc-gauge" data-support-topic="daw">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="12" rx="2" /><path d="M8 21h8M12 17v4" /></svg>
        <span>DAW</span>
      </button>
      <button type="button" class="sc-gauge" data-support-topic="order">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 18 0v3a3 3 0 0 1-3 3h-2v-6h5M3 12v3a3 3 0 0 0 3 3h2v-6H3" /></svg>
        <span>Order</span>
      </button>
      <button type="button" class="sc-gauge" data-support-topic="human">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg>
        <span>Human</span>
      </button>
    </div>
  </div>

  <form class="sc-foot" data-support-form>
    <label class="sr-only" for="support-chat-input">Your message</label>
    <input id="support-chat-input" class="sc-in" type="text" name="message" autocomplete="off" maxlength="600" placeholder="Type your message…" />
    <button type="submit" class="sc-send" aria-label="Send">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </button>
  </form>
  <p class="sc-micro">Or email <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></p>
</section>

<script>
  /* Answers mirror the sections of /support above — keep both in step when
     the install paths, seat count or trial length change.

     Answer grammar (also the contract for the worker's replies — plain text
     with no markers still renders as paragraphs):
       **words**      key words, bold oxide-red
       `path`         copyable path plate
       "1. step"      numbered step with a stamped badge
       "! text"       hazard callout (the one thing that breaks it)
       "+ text"       pilot-lamp callout (what you should see when it worked)
       [mac] … [/mac] / [win] … [/win]   shown for the visitor's OS only */
  const SUPPORT_EMAIL = 'support@revaudio.net';
  const ANSWERS: Record<string, { label: string; text: string; mail?: boolean }> = {
    install: {
      label: 'Install',
      text: [
        '[mac]',
        '1. Open the **.pkg** and click through.',
        '2. It lands here: `/Library/Audio/Plug-Ins/VST3/` and `/Library/Audio/Plug-Ins/Components/`',
        '[/mac]',
        '[win]',
        '1. Run the **installer**.',
        '2. It lands here: `C:\\Program Files\\Common Files\\VST3\\`',
        '[/win]',
        '3. **Quit and reopen your DAW**, then rescan plugins.',
        '+ You should see **RevAudio** in the plugin list.',
      ].join('\n'),
    },
    licence: {
      label: 'Licence',
      text: [
        '1. Open the plugin.',
        '2. Paste the key from your **purchase email**.',
        '! **No spaces** before or after the key.',
        '+ Each plugin has its own key. One licence = **2 machines**.',
        'Lost the key, or moving to a new machine? Email us from the **address you bought under** — reissue within one business day.',
      ].join('\n'),
      mail: true,
    },
    trial: {
      label: 'Trial',
      text: [
        '1. Grab the trial from the **Downloads portal** — no key needed.',
        '2. It runs the **full version for 30 days**, no audio interruptions.',
        '3. When it ends, buy and paste the key — the **same install unlocks**, nothing to reinstall.',
        '! Trial email missing? Check **spam and promotions**, then request it again from the Downloads portal.',
      ].join('\n'),
    },
    daw: {
      label: 'DAW',
      text: [
        '1. **Quit the DAW fully** — not just the project.',
        '2. Open it again and **rescan plugins**.',
        '3. Check the file is here:',
        '[mac]',
        '`/Library/Audio/Plug-Ins/VST3/` · AU: `/Library/Audio/Plug-Ins/Components/`',
        '[/mac]',
        '[win]',
        '`C:\\Program Files\\Common Files\\VST3\\`',
        '[/win]',
        '! Rescan alone is not enough. The DAW must be **fully restarted** after it.',
        '+ You should see **RevAudio** in the plugin list.',
      ].join('\n'),
    },
    order: {
      label: 'Order',
      text: [
        '1. Open the **confirmation email** sent right after checkout — the installer link and licence key are inside.',
        '2. Not there? Check **spam** and the **promotions** tab.',
        '! Still nothing after **10 minutes**? Email us with the purchase email and we send it by hand.',
      ].join('\n'),
      mail: true,
    },
    human: {
      label: 'Human',
      text: [
        `Email **${SUPPORT_EMAIL}** and a person answers within **one business day**.`,
        '+ Include the **plugin and version**, your **DAW**, your **OS**, and what happened.',
      ].join('\n'),
      mail: true,
    },
  };
  const FALLBACK =
    'I can help with **install**, **licence keys**, **trials**, **DAW rescans** and **orders** — tap one above. Anything else, tap **Human** and a person picks it up.';

  const root = document.querySelector<HTMLElement>('[data-support-chat]');
  const launch = document.querySelector<HTMLButtonElement>('[data-support-launch]');
  if (root && launch) {
    const log = root.querySelector<HTMLElement>('[data-support-log]')!;
    const form = root.querySelector<HTMLFormElement>('[data-support-form]')!;
    const input = form.querySelector<HTMLInputElement>('input')!;
    const endpoint = root.dataset.endpoint || '';
    const src = new URLSearchParams(location.search).get('src') || '';
    // Thread id from the worker; echoed back so the bot keeps the conversation
    // ("Windows or Mac?" -> "mac"). Session-scoped, nothing personal in it.
    let convId = '';
    try { convId = sessionStorage.getItem('sc-conv') || ''; } catch {}
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let lastFocus: HTMLElement | null = null;

    function isOpen() { return !root!.hidden; }

    function open(from?: HTMLElement) {
      if (isOpen()) return;
      lastFocus = from || (document.activeElement as HTMLElement);
      root!.hidden = false;
      const first = root!.querySelector<HTMLElement>('[data-support-time]');
      if (first && !first.textContent) first.textContent = stamp();
      launch!.setAttribute('aria-expanded', 'true');
      document.body.classList.add('sc-open');
      requestAnimationFrame(() => root!.classList.add('is-open'));
      (root!.querySelector<HTMLElement>('[data-support-topic]') || input).focus();
    }

    function close() {
      if (!isOpen()) return;
      root!.classList.remove('is-open');
      launch!.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('sc-open');
      const done = () => { root!.hidden = true; };
      reduced ? done() : setTimeout(done, 260);
      (lastFocus && lastFocus.isConnected ? lastFocus : launch!).focus();
    }

    // Thread rows, chat-app style: the visitor on the right, Support on the
    // left with its avatar. Consecutive messages from one side form a group
    // (tight gap, squared inner corners); the avatar and the tail sit on the
    // group's last bubble only, like Telegram. Time stamps live inside the
    // bubble, bottom-right, like WhatsApp.
    const AVATAR =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
      '<path d="M4 13a8 8 0 0 1 16 0v4a2 2 0 0 1-2 2h-1v-6h3M4 13v4a2 2 0 0 0 2 2h1v-6H4" /><path d="M12 21h4" /></svg>';
    function stamp() { return new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }); }

    function row(who: 'bot' | 'me') {
      const prev = log.lastElementChild;
      const el = document.createElement('div');
      el.className = `sc-msg sc-msg--${who} is-last`;
      if (prev && prev.classList.contains(`sc-msg--${who}`)) prev.classList.remove('is-last');
      else el.classList.add('is-first');
      if (who === 'bot') {
        const a = document.createElement('span');
        a.className = 'sc-ava';
        a.setAttribute('aria-hidden', 'true');
        a.innerHTML = AVATAR;
        el.appendChild(a);
      }
      const bubble = document.createElement('div');
      bubble.className = 'sc-bubble';
      el.appendChild(bubble);
      log.appendChild(el);
      return { el, bubble };
    }

    // ---- Answer grammar renderer (see ANSWERS above). DOM-built, never
    // innerHTML with reply text, so a worker reply can't inject markup. ----
    const COPY_SVG =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">' +
      '<rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V6a2 2 0 0 1 2-2h9" /></svg>';
    const TICK_SVG =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10" /></svg>';
    // The visitor's OS picks which [mac]/[win] block shows; a chip flips it.
    let os: 'mac' | 'win' = /Win/.test(navigator.platform) || /Windows/.test(navigator.userAgent) ? 'win' : 'mac';

    function plate(path: string) {
      const wrap = document.createElement('span');
      wrap.className = 'sc-plate';
      const code = document.createElement('span');
      code.textContent = path;
      wrap.appendChild(code);
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'sc-copy';
      btn.setAttribute('aria-label', 'Copy path');
      btn.dataset.copy = path;
      btn.innerHTML = COPY_SVG;
      wrap.appendChild(btn);
      return wrap;
    }

    function inlineInto(parent: HTMLElement, text: string) {
      const re = /\*\*(.+?)\*\*|`([^`]+)`/g;
      let last = 0;
      let m: RegExpExecArray | null;
      while ((m = re.exec(text))) {
        if (m.index > last) parent.appendChild(document.createTextNode(text.slice(last, m.index)));
        if (m[1]) {
          const b = document.createElement('strong');
          b.className = 'sc-key';
          b.textContent = m[1];
          parent.appendChild(b);
        } else {
          parent.appendChild(plate(m[2]));
        }
        last = re.lastIndex;
      }
      if (last < text.length) parent.appendChild(document.createTextNode(text.slice(last)));
    }

    function renderAnswer(text: string) {
      const ans = document.createElement('div');
      ans.className = 'sc-ans';
      let sect = '';
      let hasOS = false;
      text.split('\n').forEach((line) => {
        let m: RegExpMatchArray | null;
        if ((m = line.match(/^\[(mac|win)\]$/))) { sect = m[1]; hasOS = true; return; }
        if (/^\[\/(mac|win)\]$/.test(line)) { sect = ''; return; }
        let el: HTMLElement;
        if ((m = line.match(/^(\d+)\.\s+(.*)$/))) {
          el = document.createElement('div');
          el.className = 'sc-step';
          const n = document.createElement('i');
          n.textContent = m[1];
          el.appendChild(n);
          const body = document.createElement('span');
          inlineInto(body, m[2]);
          el.appendChild(body);
        } else if ((m = line.match(/^!\s+(.*)$/))) {
          el = document.createElement('div');
          el.className = 'sc-warn';
          inlineInto(el, m[1]);
        } else if ((m = line.match(/^\+\s+(.*)$/))) {
          el = document.createElement('div');
          el.className = 'sc-ok';
          const body = document.createElement('span');
          inlineInto(body, m[1]);
          el.appendChild(body);
        } else {
          el = document.createElement('p');
          inlineInto(el, line);
        }
        if (sect) el.classList.add(`sc-${sect}`);
        ans.appendChild(el);
      });
      if (hasOS) {
        ans.dataset.os = os;
        const bar = document.createElement('div');
        bar.className = 'sc-os';
        bar.appendChild(document.createTextNode('Showing '));
        const b = document.createElement('b');
        bar.appendChild(b);
        const flip = document.createElement('button');
        flip.type = 'button';
        flip.className = 'sc-os-flip';
        flip.dataset.osFlip = '';
        bar.appendChild(flip);
        ans.insertBefore(bar, ans.firstChild);
        labelOS(ans);
      }
      return ans;
    }

    function labelOS(ans: HTMLElement) {
      ans.dataset.os = os;
      const b = ans.querySelector('.sc-os b');
      const flip = ans.querySelector('.sc-os-flip');
      if (b) b.textContent = os === 'mac' ? 'macOS' : 'Windows';
      if (flip) flip.textContent = os === 'mac' ? 'on Windows?' : 'on a Mac?';
    }

    function say(text: string, who: 'bot' | 'me') {
      const { el, bubble } = row(who);
      const p = document.createElement('div');
      p.className = 'sc-text';
      if (who === 'bot') {
        p.appendChild(renderAnswer(text));
      } else {
        text.split('\n').forEach((line, i) => {
          if (i) p.appendChild(document.createElement('br'));
          p.appendChild(document.createTextNode(line));
        });
      }
      const t = document.createElement('span');
      t.className = 'sc-meta';
      t.textContent = stamp();
      p.appendChild(t);
      bubble.appendChild(p);
      return el;
    }

    // Three amber lamps breathing — only while a real request is in flight.
    function typing() {
      const { el, bubble } = row('bot');
      el.classList.add('sc-msg--pending');
      bubble.innerHTML = '<span class="sc-typing" role="status" aria-label="Support is typing"><i></i><i></i><i></i></span>';
      return el;
    }

    function followups(mail: boolean) {
      const row = document.createElement('div');
      row.className = 'sc-chips';
      if (mail) {
        const a = document.createElement('a');
        a.className = 'sc-chip sc-chip--solid';
        a.href = `mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent('Support: ' + (document.title.split(' · ')[0] || 'RevAudio'))}`;
        a.textContent = `Email ${SUPPORT_EMAIL}`;
        row.appendChild(a);
      } else {
        const ok = document.createElement('button');
        ok.type = 'button';
        ok.className = 'sc-chip sc-chip--solid';
        ok.textContent = 'That fixed it';
        ok.addEventListener('click', () => { row.remove(); say('Good. Go make noise.', 'bot'); scroll(); });
        row.appendChild(ok);
        const human = document.createElement('button');
        human.type = 'button';
        human.className = 'sc-chip';
        human.textContent = 'Talk to a human';
        human.addEventListener('click', () => { row.remove(); answer('human'); });
        row.appendChild(human);
      }
      log.appendChild(row);
    }

    function scroll() { log.scrollTop = log.scrollHeight; }

    function answer(topic: string) {
      const a = ANSWERS[topic];
      if (!a) return;
      say(a.label, 'me');
      say(a.text, 'bot');
      followups(!!a.mail);
      scroll();
    }

    async function ask(text: string) {
      say(text, 'me');
      scroll();
      if (!endpoint) {
        say(FALLBACK, 'bot');
        scroll();
        return;
      }
      const pending = typing();
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: text, src, page: location.pathname, conv_id: convId || undefined }),
        });
        const data = await res.json().catch(() => ({}));
        if (typeof data.conv_id === 'string' && data.conv_id) {
          convId = data.conv_id;
          try { sessionStorage.setItem('sc-conv', convId); } catch {}
        }
        pending.remove();
        say(typeof data.reply === 'string' && data.reply ? data.reply : FALLBACK, 'bot');
        if (data.handoff) followups(true);
      } catch {
        pending.remove();
        say(`The bot is off the air right now. Email ${SUPPORT_EMAIL} and a person picks it up within one business day.`, 'bot');
        followups(true);
      }
      scroll();
    }

    launch.addEventListener('click', () => open(launch));
    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-support-close]')) close();
      const g = t.closest<HTMLElement>('[data-support-topic]');
      if (g) answer(g.dataset.supportTopic!);
      const c = t.closest<HTMLButtonElement>('[data-copy]');
      if (c) {
        navigator.clipboard?.writeText(c.dataset.copy!).catch(() => {});
        const pl = c.closest('.sc-plate')!;
        pl.classList.add('is-copied');
        c.innerHTML = TICK_SVG;
        c.setAttribute('aria-label', 'Copied');
        setTimeout(() => { pl.classList.remove('is-copied'); c.innerHTML = COPY_SVG; c.setAttribute('aria-label', 'Copy path'); }, 1400);
      }
      if (t.closest('[data-os-flip]')) {
        os = os === 'mac' ? 'win' : 'mac';
        log.querySelectorAll<HTMLElement>('.sc-ans[data-os]').forEach(labelOS);
      }
    });
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const door = t.closest<HTMLElement>('[data-support-open]');
      if (door) { e.preventDefault(); open(door); }
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text) return;
      input.value = '';
      ask(text);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) close();
    });
    // One drawer at a time: opening the cart closes the chat.
    document.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-cart-toggle]')) close();
    });

    if (new URLSearchParams(location.search).get('chat') === 'open') open(launch);
  }
</script>

<style is:global>
  /* Global on purpose: the thread rows are built at runtime by the script
     above, so they never carry Astro's scoped attribute (DESIGN.md §9).
     Everything here is namespaced sc-* and lives under #support-chat. */
  /* ---- Log: the thread ----
     Chat-app grammar (WhatsApp / Telegram / Instagram DMs), house materials:
     visitor on the right in brass, Support on the left on dark steel with its
     avatar; grouped bubbles square their inner corners; a curved tail and the
     avatar mark the last bubble of a group; the time sits inside the bubble,
     bottom-right; a "Today" chip heads the thread. */
  .sc-head, .sc-foot, .sc-micro { flex: none; }
  .sc-log {
    flex: 1 1 0;
    min-height: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    /* Brass scrollbar: thin standard props first, WebKit pseudo-elements for
       Safari/Chrome (same dark trough, brass thumb, brighter on hover). */
    scrollbar-width: thin;
    scrollbar-color: var(--brass) var(--bg-0);
    padding: 0.9rem 0.8rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    overscroll-behavior: contain;
    /* Wallpaper: bakelite with a faint brushed diagonal and the warm top
       light — the chat apps' patterned wallpaper, in the house material. */
    background:
      linear-gradient(180deg, rgba(255, 214, 150, 0.05) 0%, rgba(255, 214, 150, 0) 32%),
      repeating-linear-gradient(-45deg, rgba(201, 163, 92, 0.04) 0 1px, transparent 1px 7px),
      var(--bg-0);
  }
