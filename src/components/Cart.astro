---
import { getImage } from 'astro:assets';
import { pluginImage } from '../lib/images';
import { plugins } from '../data/plugins';
import TermsContent from './legal/TermsContent.astro';
import EulaContent from './legal/EulaContent.astro';
import PrivacyContent from './legal/PrivacyContent.astro';
import { TERMS_LAST_UPDATED } from '../data/legal';
/**
 * Global cart: a localStorage-backed mini-cart shared across every page.
 * - [data-add-to-cart] buttons (with data-slug/name/price/price-id/img) add items.
 *   Adding does NOT open the drawer (Dan, 2026-09-07): a modal thrown over the
 *   page on every add interrupts browsing and buries the rest of the catalog.
 *   Confirmation is ambient instead — the red header badge pops with the new
 *   count, and the button itself flips to "In your cart". Pressing it again in
 *   that state opens the drawer, so the cart is always one click away.
 * - the header cart icon ([data-cart-toggle]) + badge ([data-cart-badge]) open the drawer
 * - A required consent checkbox gates Checkout; its links open the legal-reader
 *   modal (Terms / Licence / Privacy) IN A POPUP — no page navigation.
 * - Checkout runs on site.checkoutEngine (2026-08-31: 'paddle' — Paddle
 *   Billing overlay checkout, live). 'ls' and 'fastspring' are dormant
 *   (kept only as an instant rollback — flip the value in src/data/site.ts,
 *   nothing else to undo). 'paddle' opens the Paddle.js overlay
 *   (paddle.js + Paddle.Checkout.open), summing the full cart natively; on
 *   checkout.completed it redirects to site.paddle.purchaseUrl with
 *   ?_ptxn=<transaction id> instead of /thank-you — the revlimiter-license
 *   worker's own webhook (not this page) does the actual key minting/emailing.
 * Rendered once in BaseLayout. No framework — vanilla JS, progressive.
 *
 * Checkout URLs are resolved fresh from this catalog map by slug at checkout
 * time — NEVER from the URL persisted in the cart.
 */
import { site } from '../data/site';
const engine = site.checkoutEngine;
const checkoutMap: Record<string, string> = {};
const cartCatalog: Record<string, { name: string; price: number; img: string; formats: string }> = {};
for (const p of plugins) {
  const target = engine === 'ls' ? p.checkoutUrl : engine === 'fastspring' ? p.fastspringPath : p.paddlePriceId;
  if (target) {
    checkoutMap[p.slug] = target;
    const source = pluginImage(p.heroImage);
    const thumbnail = source ? await getImage({ src: source, width: 288, format: 'webp' }) : null;
    cartCatalog[p.slug] = { name: p.name, price: p.introPriceUsd ?? p.regularPriceUsd ?? 0, img: thumbnail?.src ?? '', formats: p.systemReq.formats };
  }
}
---

<script is:inline type="application/json" data-cart-catalog set:html={JSON.stringify(cartCatalog).replace(/</g, '\\u003c')}></script>

<script
  is:inline
  type="application/json"
  data-checkout-map
  data-engine={engine}
  data-gads-purchase={site.gadsPurchaseSendTo}
  data-paddle-token={site.paddle.clientToken}
  data-paddle-purchase-url={site.paddle.purchaseUrl}
  set:html={JSON.stringify(checkoutMap)}
></script>

{/* Lemon Squeezy overlay checkout — renders the payment screen in a modal over
    the site. No SRI: LS rotates lemon.js and ships it unversioned, so an
    integrity pin would hard-break checkout on their next deploy (same call as
    the CF beacon in BaseLayout). The CSP transform rule scopes what can load. */}
{engine === 'ls' && <script is:inline src="https://assets.lemonsqueezy.com/lemon.js" defer></script>}

{/* Paddle.js overlay checkout. Same no-SRI reasoning as lemon.js above — Paddle
    serves this unversioned from their own CDN, so pinning integrity would
    hard-break checkout on their next release. Requires https://cdn.paddle.com
    on the Cloudflare CSP transform rule's script-src (dashboard-only edit —
    see revaudio-edge-csp-transform-rule reference); the overlay itself may
    need its own frame-src/connect-src entries too, discoverable via the
    browser console's CSP violation messages if checkout doesn't fully open. */}
{engine === 'paddle' && <script is:inline src="https://cdn.paddle.com/paddle/v2/paddle.js" defer></script>}

<!-- Empty-cart tooltip: shown on hover of the cart icon when there's nothing in it yet. -->
<div class="cart-tip" data-cart-tip role="status" aria-live="polite" hidden>No items to show right now. Your cart's empty.</div>

<!-- Cart drawer -->
<dialog class="cart-drawer" data-cart-drawer aria-label="Your cart">
  <div class="cd-head">
    <div><span class="cd-kicker">REVAUDIO / PARTS COUNTER</span><h2>Your cart <span class="cd-count" data-cart-count></span></h2></div>
    <button type="button" class="cd-x" data-cart-close aria-label="Close cart">&times;</button>
  </div>
  <div class="cd-body" data-lenis-prevent>
  <div class="cd-empty" data-cart-empty>
    <h3>Your next sound starts here.</h3>
    <p>Your cart is empty. Explore the plugins and find your next addition.</p>
    <a href="/store" class="cd-browse">Explore the plugins <span aria-hidden="true">→</span></a>
  </div>
  <ul class="cd-items" data-cart-items aria-label="Plugins in your cart"></ul>
  <div class="cd-foot" data-cart-foot hidden>
    <div class="cd-summary">
      <div class="cd-sub"><span>Subtotal <small>USD</small></span><span data-cart-subtotal>$0</span></div>
      <p class="cd-tax">Any applicable tax is calculated at payment.</p>
    </div>
    <p class="cd-next">Next, enter your details and choose a payment method.</p>
    <label class="cd-agree" data-agree-label>
      <input type="checkbox" data-cart-agree data-terms-version={TERMS_LAST_UPDATED} aria-describedby="cd-agree-hint" />
      <span>I have read and agree to RevAudio's
        <a href="/terms" data-open-legal="terms">Terms</a>,
        <a href="/eula" data-open-legal="eula">Licence</a> &amp;
        <a href="/privacy" data-open-legal="privacy">Privacy</a>.</span>
    </label>
    <p class="cd-agree-hint" id="cd-agree-hint" data-agree-hint role="alert" hidden>Please agree to the terms to continue.</p>
    <button type="button" class="cd-checkout" data-checkout>Continue to payment <span aria-hidden="true">→</span></button>
    <p class="cd-payment">{engine === 'paddle' ? 'Payment handled securely by Paddle' : 'Continue to secure payment'}</p>
    <p class="cd-payment-error" data-payment-error role="alert" hidden></p>
    <button type="button" class="cd-cont" data-cart-close>Continue browsing</button>
  </div>
  </div>
  <div class="cd-help"><span>Need a hand?</span> <a href="/support">Talk to RevAudio <span aria-hidden="true">↗</span></a></div>
  <span class="cd-announcement" data-cart-announcement role="status" aria-live="polite"></span>
</dialog>

<!-- Legal reader modal — read-only popup for Terms / Licence / Privacy (no page nav). -->
<dialog class="legal-modal" data-legal-modal aria-label="Legal documents">
  <div class="lm-head">
    <div class="lm-tabs" role="tablist" aria-label="Legal documents">
      <button type="button" class="lm-tab is-active" data-legal-tab="terms" role="tab" aria-selected="true">Terms &amp; Conditions</button>
      <button type="button" class="lm-tab" data-legal-tab="eula" role="tab" aria-selected="false">Licence</button>
      <button type="button" class="lm-tab" data-legal-tab="privacy" role="tab" aria-selected="false">Privacy</button>
    </div>
    <button type="button" class="cd-x" data-legal-close aria-label="Close">&times;</button>
  </div>
  <div class="lm-body" data-legal-scroll tabindex="0" data-lenis-prevent>
    <section data-legal-panel="terms"><TermsContent /></section>
    <section data-legal-panel="eula" hidden><EulaContent /></section>
    <section data-legal-panel="privacy" hidden><PrivacyContent /></section>
  </div>
</dialog>

<script is:inline>
  (function () {
    var KEY = 'revaudio_cart_v2';
    var html = document.documentElement;
    var drawer = document.querySelector('[data-cart-drawer]');
    var itemsEl = drawer && drawer.querySelector('[data-cart-items]');
    var emptyEl = drawer && drawer.querySelector('[data-cart-empty]');
    var footEl = drawer && drawer.querySelector('[data-cart-foot]');
    var subEl = drawer && drawer.querySelector('[data-cart-subtotal]');

    var catalogEl = document.querySelector('[data-cart-catalog]');
    var catalog = {};
    try { catalog = JSON.parse(catalogEl.textContent || '{}'); } catch (e) {}
    // Legacy entries may contain old names/prices. Only their slug is identity;
    // every display field comes from the current catalog, including thumbnails.
    function read() {
      try {
        var saved = JSON.parse(localStorage.getItem(KEY)) || [];
        if (!Array.isArray(saved)) return [];
        var seen = {};
        return saved.reduce(function (items, item) {
          var slug = item && item.slug;
          if (!Object.prototype.hasOwnProperty.call(catalog, slug) || seen[slug]) return items;
          seen[slug] = true;
          items.push(Object.assign({ slug: slug, qty: 1 }, catalog[slug]));
          return items;
        }, []);
      } catch (e) { return []; }
    }
    function write(c) { try { localStorage.setItem(KEY, JSON.stringify(c.map(function (i) { return { slug: i.slug }; }))); } catch (e) {} }
    function money(value) { return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2 }).format(value); }
    function count(c) { return c.reduce(function (n, i) { return n + (i.qty || 1); }, 0); }
    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (m) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
      });
    }

    // ---- Funnel analytics (Meta Pixel) ----
    // No-ops until CookieBanner consent creates window.fbq (declines never track).
    function track(ev, params) {
      try { if (window.fbq) window.fbq('track', ev, params || {}); } catch (e) {}
    }
    // Cart total captured at checkout start, replayed onto the Google Ads
    // conversion after the LS redirect has cleared the cart. (Meta's Purchase
    // is server-side and reads the real total off the LS webhook, not this.)
    var lastCheckoutValue = 0;

    // ---- Lemon Squeezy overlay (engine 'ls') ----
    // lemon.js is included above only when the engine is 'ls'. Setup() wires
    // the overlay's event stream; Checkout.Success clears the cart and lands
    // on /thank-you — the same contract fsCheckoutClosed keeps for FastSpring.
    var lemonReady = false;
    function ensureLemon() {
      if (lemonReady) return !!(window.LemonSqueezy && window.LemonSqueezy.Url);
      if (typeof window.createLemonSqueezy !== 'function') return false;
      try {
        window.createLemonSqueezy();
        window.LemonSqueezy.Setup({
          eventHandler: function (ev) {
            if (ev && ev.event === 'Checkout.Success') {
              write([]); sync();
              // NO client-side Purchase here, deliberately. Meta Purchase is
              // server-side only: the LS webhook fires it from the worker
              // (fireMetaPurchase, event_id "ls-<order id>"), which catches every
              // real order regardless of cookie consent or redirect races. A
              // client replay here would carry no order id, so Meta could not
              // dedupe the pair and every sale would count twice. Don't re-add it.
              // Google Ads purchase conversion — no-op until site.ts sets
              // gadsPurchaseSendTo. Redirect waits for the hit (or 500 ms, the
              // documented gtag event_callback pattern) so it isn't lost mid-nav.
              var mapEl = document.querySelector('[data-checkout-map]');
              var gadsSendTo = (mapEl && mapEl.getAttribute('data-gads-purchase')) || '';
              var redirected = false;
              var go = function () { if (!redirected) { redirected = true; window.location.href = '/thank-you'; } };
              if (gadsSendTo && window.gtag) {
                try {
                  window.gtag('event', 'conversion', {
                    send_to: gadsSendTo, value: lastCheckoutValue, currency: 'USD', event_callback: go
                  });
                } catch (e) { go(); }
                setTimeout(go, 500);
              } else { go(); }
            }
          }
        });
        lemonReady = true;
      } catch (e) {}
      return lemonReady;
    }
    function engineName() {
      var el = document.querySelector('[data-checkout-map]');
      return (el && el.getAttribute('data-engine')) || 'fastspring';
    }

    // ---- Paddle overlay (engine 'paddle') ----
    // paddle.js is included above only when the engine is 'paddle'. Paddle's
    // eventCallback is set once at Initialize() time (unlike LS's per-call
    // Setup handler) — checkout.completed both clears the cart and redirects
    // to the license worker's /purchase page with the transaction id, instead
    // of /thank-you. No client-side Purchase pixel here either, same reasoning
    // as the LS block below: server-side only, fired from the worker's webhook.
    var paddleReady = false;
    function ensurePaddle() {
      if (paddleReady) return !!(window.Paddle && window.Paddle.Checkout);
      if (typeof window.Paddle === 'undefined') return false;
      var mapEl = document.querySelector('[data-checkout-map]');
      var token = mapEl && mapEl.getAttribute('data-paddle-token');
      var purchaseUrl = mapEl && mapEl.getAttribute('data-paddle-purchase-url');
      if (!token || !purchaseUrl) return false;
      try {
        window.Paddle.Initialize({
          token: token,
          eventCallback: function (ev) {
            if (ev && ev.name === 'checkout.completed') {
              write([]); sync();
              var txnId = ev.data && ev.data.transaction_id;
              var gadsSendTo = (mapEl && mapEl.getAttribute('data-gads-purchase')) || '';
              var redirected = false;
              var go = function () {
                if (redirected) return;
                redirected = true;
                window.location.href = txnId ? (purchaseUrl + '?_ptxn=' + encodeURIComponent(txnId)) : '/thank-you';
              };
              if (gadsSendTo && window.gtag) {
                try {
                  window.gtag('event', 'conversion', {
                    send_to: gadsSendTo, value: lastCheckoutValue, currency: 'USD', event_callback: go
                  });
                } catch (e) { go(); }
                setTimeout(go, 500);
              } else { go(); }
            }
          }
        });
        paddleReady = true;
      } catch (e) {}
      return paddleReady;
    }

    function lock() { html.style.overflow = anyModalOpen() ? 'hidden' : ''; }
    function anyModalOpen() {
      return (drawer && drawer.open) || (lModal && lModal.open);
    }

    function add(item) {
      if (!item || !item.slug) return;
      var c = read();
      // One licence per product — a repeat add is a no-op, never stacks qty.
      var exists = c.some(function (i) { return i.slug === item.slug; });
      if (!exists) {
        c.push({ slug: item.slug, name: item.name, price: +item.price || 0, checkoutUrl: item.checkoutUrl || '', img: item.img || '', qty: 1 });
        write(c);
      }
      sync();
    }
    function remove(slug) {
      var oldItems = read();
      var removedIndex = oldItems.findIndex(function (i) { return i.slug === slug; });
      write(read().filter(function (i) { return i.slug !== slug; }));
      sync();
      var remaining = itemsEl.querySelectorAll('[data-remove]');
      var next = remaining[Math.min(Math.max(removedIndex, 0), remaining.length - 1)] || drawer.querySelector('.cd-browse');
      if (next) next.focus();
      var announcement = drawer.querySelector('[data-cart-announcement]');
      if (announcement) announcement.textContent = (catalog[slug] ? catalog[slug].name : 'Plugin') + ' removed from your cart.';
    }

    var IN_CART_LABEL = 'In your cart';
    var lastCount = null;

    /* Mirror the cart onto every [data-add-to-cart] on the page. The class is
       set on all of them (graphic buttons can style themselves off it); the
       LABEL is only swapped on buttons that opt in with [data-cart-label] —
       the crane's BUY NOW square is an image with empty text content, so
       writing into it would drop stray glyphs on top of the artwork. The idle
       label/aria are stashed on first pass so removing the item restores the
       button's own copy rather than a hardcoded guess. */
    function syncAddButtons(c) {
      var inCart = {};
      for (var i = 0; i < c.length; i++) inCart[c[i].slug] = 1;
      var btns = document.querySelectorAll('[data-add-to-cart]');
      for (var b = 0; b < btns.length; b++) {
        var btn = btns[b];
        var on = !!inCart[btn.getAttribute('data-slug')];
        btn.classList.toggle('is-in-cart', on);
        if (!btn.hasAttribute('data-cart-label')) continue;
        if (!btn.hasAttribute('data-label-idle')) {
          btn.setAttribute('data-label-idle', (btn.textContent || '').trim());
          if (btn.hasAttribute('aria-label')) btn.setAttribute('data-aria-idle', btn.getAttribute('aria-label'));
        }
        btn.textContent = on ? IN_CART_LABEL : btn.getAttribute('data-label-idle');
        if (on) btn.setAttribute('aria-label', IN_CART_LABEL + ', open cart');
        else if (btn.hasAttribute('data-aria-idle')) btn.setAttribute('aria-label', btn.getAttribute('data-aria-idle'));
        else btn.removeAttribute('aria-label');
      }
    }

    function sync() {
      var c = read();
      var n = count(c);
      var countEl = drawer && drawer.querySelector('[data-cart-count]');
      if (countEl) countEl.textContent = String(n).padStart(2, '0');
      var badges = document.querySelectorAll('[data-cart-badge]');
      for (var b = 0; b < badges.length; b++) { badges[b].textContent = n; badges[b].hidden = n === 0; }
      // The drawer no longer throws itself open on add, so this pop IS the
      // confirmation that something landed. Remove + reflow + re-add restarts
      // the one-shot animation on consecutive adds. Growth only — a removal
      // already has its own on-screen feedback inside the drawer.
      if (lastCount !== null && n > lastCount &&
          !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        for (var q = 0; q < badges.length; q++) {
          badges[q].classList.remove('is-bump');
          void badges[q].offsetWidth;
          badges[q].classList.add('is-bump');
        }
      }
      lastCount = n;
      syncAddButtons(c);
      if (!itemsEl) return;
      if (!c.length) {
        itemsEl.innerHTML = '';
        if (emptyEl) emptyEl.hidden = false;
        if (footEl) footEl.hidden = true;
        return;
      }
      if (emptyEl) emptyEl.hidden = true;
      if (footEl) footEl.hidden = false;
      var sub = 0;
      itemsEl.innerHTML = c.map(function (i) {
        sub += (i.price || 0) * (i.qty || 1);
        return '<li class="ci">' +
          (i.img ? '<div class="ci-picture"><img class="ci-img" src="' + esc(i.img) + '" alt="" width="144" height="84"></div>' : '') +
          '<div class="ci-main"><span class="ci-name">' + esc(i.name) + '</span>' +
          '<span class="ci-meta">1 licence · Digital download</span>' +
          '<span class="ci-formats">' + esc(i.formats) + '</span></div>' +
          '<div class="ci-actions"><span class="ci-price">' + money(i.price) + '</span>' +
          '<button type="button" class="ci-x" data-remove="' + esc(i.slug) + '" aria-label="Remove ' + esc(i.name) + '">Remove</button></div>' +
          '</li>';
      }).join('');
      if (subEl) subEl.textContent = money(sub);
    }

    function openDrawer() {
      if (!drawer) return;
      if (typeof drawer.showModal === 'function') drawer.showModal(); else drawer.setAttribute('open', '');
      lock();
    }

    function checkoutMap() {
      var el = document.querySelector('[data-checkout-map]');
      try { return el ? JSON.parse(el.textContent || '{}') : {}; } catch (e) { return {}; }
    }
    function checkoutUrlFor(item) {
      var map = checkoutMap();
      return (item && map[item.slug]) || (item && item.checkoutUrl) || '';
    }

    // ---- Consent gate: a required checkbox in the cart, ticked before checkout ----
    function agreeEl() { return drawer && drawer.querySelector('[data-cart-agree]'); }
    function setAgreeError(on) {
      var label = drawer && drawer.querySelector('[data-agree-label]');
      var hint = drawer && drawer.querySelector('[data-agree-hint]');
      if (label) label.classList.toggle('is-error', !!on);
      if (hint) hint.hidden = !on;
      if (agreeEl()) agreeEl().setAttribute('aria-invalid', on ? 'true' : 'false');
    }
    function paymentError(message) {
      var error = drawer && drawer.querySelector('[data-payment-error]');
      if (error) { error.textContent = message || ''; error.hidden = !message; }
    }
    function openCheckout() {
      paymentError('');
      var items = read().filter(function (i) { return checkoutUrlFor(i); });
      if (!items.length) return;
      // Require agreement first — flag the checkbox and stop if unchecked.
      var agree = agreeEl();
      if (agree && !agree.checked) { setAgreeError(true); agree.focus(); return; }
      setAgreeError(false);
      // Funnel: InitiateCheckout once consent is given; stash the total so the
      // post-redirect Google Ads conversion can report it.
      var cart = read();
      lastCheckoutValue = cart.reduce(function (s, i) { return s + (i.price || 0) * (i.qty || 1); }, 0);
      track('InitiateCheckout', { value: lastCheckoutValue, currency: 'USD', num_items: count(cart) });
      var ver = (agree && agree.getAttribute('data-terms-version')) || '';
      // Engine 'ls' — LS hosted-overlay checkout. One hosted URL per order (LS
      // can't sum a multi-item cart — first item wins, same as the original LS
      // era). Overlay when lemon.js is up, plain redirect otherwise — the LS
      // path never fails closed.
      if (engineName() === 'ls') {
        var url = checkoutUrlFor(items[0]);
        url += (url.indexOf('?') === -1 ? '?' : '&') + 'embed=1';
        // Consent record: stamp the accepted legal-bundle version onto the
        // order via LS custom passthrough data. (LS docs: Passing Custom Data.)
        url += '&checkout[custom][terms_accepted]=true';
        if (ver) url += '&checkout[custom][terms_version]=' + encodeURIComponent(ver);
        if (drawer && drawer.open) drawer.close();
        if (ensureLemon()) { window.LemonSqueezy.Url.Open(url); return; }
        window.location.href = url;
        return;
      }
      // Keep the cart visible with recovery guidance if Paddle's SDK is
      // unavailable or opening payment throws synchronously.
      if (engineName() === 'paddle') {
        if (!ensurePaddle()) { paymentError('Payment could not load. Please try again, or contact RevAudio support below.'); return; }
        try {
          window.Paddle.Checkout.open({
            // Paddle sums the full cart natively.
            items: items.map(function (i) { return { priceId: checkoutUrlFor(i), quantity: i.qty || 1 }; }),
            // Preserve the accepted legal-bundle version on the transaction.
            customData: { terms_accepted: 'true', terms_version: ver }
          });
          if (drawer && drawer.open) drawer.close();
        } catch (e) { paymentError('Payment could not open. Please try again, or contact RevAudio support below.'); }
        return;
      }
      // Engine 'fastspring' — dormant, kept only as a rollback option
      // alongside 'ls' (see the file-header comment). Fail closed: no
      // plain-URL fallback exists for SBL.
      if (!(window.fastspring && window.fastspring.builder)) return;
      window.fastspring.builder.push({
        reset: true,
        // Full cart, not just the first item — FastSpring's session natively
        // sums multiple line items (unlike LS's single hosted-checkout URL).
        products: items.map(function (i) { return { path: checkoutUrlFor(i), quantity: i.qty || 1 }; }),
        // Consent record: stamp the accepted legal-bundle version onto the
        // order via FastSpring's custom-tags passthrough (FastSpring docs: tags).
        tags: { terms_accepted: 'true', terms_version: ver }
      });
      if (drawer && drawer.open) drawer.close();
      window.fastspring.builder.checkout();
    }

    // ---- Legal reader modal (read-only; Terms / Licence / Privacy tabs) ----
    var lModal = document.querySelector('[data-legal-modal]');
    var lScroll = lModal && lModal.querySelector('[data-legal-scroll]');
    function setLegalTab(doc) {
      if (!lModal) return;
      var tabs = lModal.querySelectorAll('[data-legal-tab]');
      for (var i = 0; i < tabs.length; i++) {
        var on = tabs[i].getAttribute('data-legal-tab') === doc;
        tabs[i].classList.toggle('is-active', on);
        tabs[i].setAttribute('aria-selected', on ? 'true' : 'false');
      }
      var panels = lModal.querySelectorAll('[data-legal-panel]');
      for (var j = 0; j < panels.length; j++) {
        panels[j].hidden = panels[j].getAttribute('data-legal-panel') !== doc;
      }
      if (lScroll) lScroll.scrollTop = 0;
    }
    function openLegal(doc) {
      if (!lModal) return;
      setLegalTab(doc || 'terms');
      if (typeof lModal.showModal === 'function') lModal.showModal(); else lModal.setAttribute('open', '');
      lock();
    }
    function closeLegal() {
      if (lModal && lModal.open && typeof lModal.close === 'function') lModal.close();
      else if (lModal) { lModal.removeAttribute('open'); lock(); }
    }

    // ---- Empty-cart hover tip ----
    // Hovering (or keyboard-focusing) a [data-cart-toggle] icon while the cart
    // is empty shows a small anchored tooltip instead of silently doing
    // nothing. Clicking still opens the real drawer (which shows its own
    // empty state) — this is just a lighter-weight preview on hover.
    var tipEl = document.querySelector('[data-cart-tip]');
    var tipTimer;
    function showCartTip(anchor) {
      if (!tipEl) return;
      tipEl.hidden = false;
      var r = anchor && anchor.getBoundingClientRect ? anchor.getBoundingClientRect() : null;
      if (r) {
        var cx = Math.min(Math.max(r.left + r.width / 2, 100), window.innerWidth - 100);
        var below = r.top < 96;
        tipEl.classList.toggle('is-below', below);
        tipEl.style.left = cx + 'px';
        tipEl.style.top = (below ? r.bottom + 12 : r.top - 12) + 'px';
      }
      // reflow so re-triggering restarts the fade
      tipEl.classList.remove('is-on'); void tipEl.offsetWidth; tipEl.classList.add('is-on');
      clearTimeout(tipTimer);
      tipTimer = setTimeout(function () { tipEl.classList.remove('is-on'); }, 2800);
    }

    document.addEventListener('click', function (e) {
      var t = e.target;
      var addBtn = t.closest('[data-add-to-cart]');
      if (addBtn) {
        e.preventDefault();
        // Already in the cart: this button is showing "In your cart", so a
        // second press should SHOW the cart rather than silently no-op.
        if (addBtn.classList.contains('is-in-cart')) { openDrawer(); return; }
        var addSlug = addBtn.getAttribute('data-slug');
        var addPrice = addBtn.getAttribute('data-price');
        add({
          slug: addSlug,
          name: addBtn.getAttribute('data-name'),
          price: addPrice,
          checkoutUrl: addBtn.getAttribute('data-checkout-url'),
          img: addBtn.getAttribute('data-img')
        });
        // One call site covers the crane BUY NOW square, the store card, and the mobile buy bar.
        track('AddToCart', { content_ids: [addSlug], content_type: 'product', value: +addPrice || 0, currency: 'USD' });
        return;
      }
      if (t.closest('[data-cart-toggle]')) { e.preventDefault(); openDrawer(); return; }
      var rm = t.closest('[data-remove]');
      if (rm) { remove(rm.getAttribute('data-remove')); return; }
      if (t.closest('[data-checkout]')) { e.preventDefault(); openCheckout(); return; }

      // Open the legal reader from the cart's consent links (popup, not a page).
      var openL = t.closest('[data-open-legal]');
      if (openL) { e.preventDefault(); openLegal(openL.getAttribute('data-open-legal')); return; }
      // Tab switching inside the reader.
      var tabBtn = t.closest('[data-legal-tab]');
      if (tabBtn) { e.preventDefault(); setLegalTab(tabBtn.getAttribute('data-legal-tab')); return; }
      if (t.closest('[data-legal-close]')) { e.preventDefault(); closeLegal(); return; }
      // Internal legal cross-links inside the reader → switch tab, stay in the popup.
      if (lModal && lModal.open && lModal.contains(t)) {
        var xref = t.closest('a[href^="/terms"], a[href^="/eula"], a[href^="/privacy"]');
        if (xref) {
          var href = xref.getAttribute('href');
          var doc = href.indexOf('/privacy') === 0 ? 'privacy' : href.indexOf('/eula') === 0 ? 'eula' : href.indexOf('/terms') === 0 ? 'terms' : '';
          if (doc) { e.preventDefault(); setLegalTab(doc); return; }
        }
      }

      if (t.closest('[data-cart-close]') && drawer && drawer.open) { drawer.close(); return; }
    });

    if (drawer) {
      drawer.addEventListener('click', function (e) {
        if (e.target !== drawer) return;
        var r = drawer.getBoundingClientRect();
        if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) drawer.close();
      });
      drawer.addEventListener('close', lock);
      drawer.addEventListener('change', function (e) {
        if (e.target && e.target.matches('[data-cart-agree]') && e.target.checked) setAgreeError(false);
      });
    }
    if (lModal) {
      lModal.addEventListener('close', lock);
      lModal.addEventListener('click', function (e) { if (e.target === lModal) closeLegal(); }); // backdrop
    }

    // mouseover/focusin bubble (mouseenter/focus don't), so delegation works
    // the same way the click handler above does.
    function maybeShowEmptyTip(e) {
      var toggle = e.target.closest && e.target.closest('[data-cart-toggle]');
      if (!toggle) return;
      if (!count(read())) showCartTip(toggle);
    }
    document.addEventListener('mouseover', maybeShowEmptyTip);
    document.addEventListener('focusin', maybeShowEmptyTip);

    sync();
  })();
</script>

<style>
  /* ---- Empty-cart hover tooltip ---- */
  .cart-tip {
    position: fixed;
    z-index: 200;
    transform: translate(-50%, -100%);
    max-width: min(280px, 80vw);
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--brass);
    border-radius: 8px;
    background: var(--bg-0);
    color: var(--brass-bright);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.35;
    text-align: center;
    box-shadow: 0 6px 22px rgba(0, 0, 0, 0.55);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.18s var(--ease), transform 0.18s var(--ease);
  }
  .cart-tip.is-below { transform: translate(-50%, 0); }
  .cart-tip.is-on { opacity: 1; }
  .cart-tip[hidden] { display: none; }

  /* ---- Cart drawer (slides from the right) ---- */
  .cart-drawer {
    margin: 0 0 0 auto;
    height: 100dvh;
    max-height: 100dvh;
    width: min(480px, 100vw);
    max-width: 100vw;
    padding: 0;
    border: 0;
    border-left: 1px solid var(--border-bright);
    background: radial-gradient(ellipse at 0 0, #30271e 0, #191612 42%, #14110f 100%);
    color: var(--fg);
    box-shadow: -24px 0 80px rgba(0, 0, 0, 0.6);
    transform: translateX(100%);
    transition: transform 0.28s var(--ease), overlay 0.28s ease allow-discrete, display 0.28s ease allow-discrete;
  }
  .cart-drawer[open] { transform: translateX(0); }
  @starting-style { .cart-drawer[open] { transform: translateX(100%); } }

  .cart-drawer::backdrop { background: rgba(8, 7, 6, 0); transition: background 0.28s ease; }
  .cart-drawer[open]::backdrop { background: rgba(8, 7, 6, 0.76); }
  @starting-style { .cart-drawer[open]::backdrop { background: rgba(8, 7, 6, 0); } }

  .cd-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 1.5rem 1.25rem;
    border-bottom: 1px solid var(--border-bright);
    flex: none;
  }
  .cd-kicker { display: block; font-size: 0.625rem; letter-spacing: 0.14em; color: var(--brass); margin-bottom: 0.6rem; }
  .cd-head h2 { display: flex; align-items: center; gap: 0.65rem; margin: 0; font-size: 2.3rem; line-height: 1; color: var(--fg); }
  .cd-count { font-family: var(--font-body); font-size: 0.85rem; font-weight: 500; color: var(--brass); }

  .cd-x {
    width: 44px; height: 44px; border-radius: 50%;
    border: 1px solid var(--border-bright);
    background: var(--bg-0); color: var(--fg);
    font-size: 1.4rem; line-height: 1; cursor: pointer;
    display: grid; place-items: center;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .cd-x:hover { border-color: var(--brass); color: var(--brass-bright); }

  .cd-body { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 0 1.5rem; }
  .cd-empty { padding: 2rem 0; color: #b9b0a2; }
  .cd-empty h3 { color: var(--fg); font-size: 1.65rem; margin: 0 0 0.5rem; }
  .cd-empty p { font-size: 0.95rem; line-height: 1.6; }
  .cd-browse { display: flex; align-items: center; justify-content: space-between; min-height: 48px; color: var(--brass-bright); text-decoration: underline; text-underline-offset: 4px; }
  .cd-empty[hidden], .cd-foot[hidden], .cd-payment-error[hidden], .cd-agree-hint[hidden] { display: none; }

  .cd-items { list-style: none; margin: 0; padding: 0; }
  /* Cart items are injected at runtime, so they need :global to escape Astro scoping. */
  .cd-items :global(.ci) {
    display: grid; grid-template-columns: 96px 1fr auto; align-items: center; gap: 1rem;
    padding: 1.5rem 0; border-bottom: 1px solid var(--border-bright);
  }
  .cd-items :global(.ci-picture) { display: grid; place-items: center; min-height: 76px; }
  .cd-items :global(.ci-img) { display: block; width: 100%; height: 76px; object-fit: contain; filter: drop-shadow(0 5px 5px rgba(0,0,0,.4)); }
  .cd-items :global(.ci-main) { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .cd-items :global(.ci-name) { font-family: var(--font-display); letter-spacing: 0.015em; color: var(--fg); font-size: 1.4rem; line-height: 1.2; }
  .cd-items :global(.ci-meta), .cd-items :global(.ci-formats) { font-size: 0.75rem; line-height: 1.5; color: #b9b0a2; }
  .cd-items :global(.ci-formats) { color: var(--brass); font-size: 0.6875rem; }
  .cd-items :global(.ci-actions) { display: flex; flex-direction: column; align-items: flex-end; }
  .cd-items :global(.ci-price) { font-size: 0.9375rem; font-variant-numeric: tabular-nums; font-weight: 600; }
  .cd-items :global(.ci-x) {
    min-width: 44px; min-height: 44px; padding: 0; border: 0;
    background: transparent; color: #b9b0a2;
    font-size: 0.75rem; text-decoration: underline; text-underline-offset: 3px; cursor: pointer;
  }
  .cd-items :global(.ci-x:hover) { color: var(--fg); }

  .cd-foot {
    padding: 1.5rem 0 1rem;
    display: flex; flex-direction: column; gap: 1rem;
  }
  .cd-sub {
    display: flex; justify-content: space-between; align-items: baseline;
    font-size: 1rem; color: var(--fg); font-weight: 500;
  }
  .cd-sub small { color: #b9b0a2; font-size: 0.6875rem; margin-left: 0.35rem; }
  .cd-sub span:last-child { color: var(--fg); font-size: 1.65rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .cd-tax { font-size: 0.75rem; line-height: 1.5; color: #b9b0a2; margin: 0.45rem 0 0; }
  .cd-next { font-size: 0.8125rem; color: #b9b0a2; line-height: 1.6; margin: 0; padding-top: 0.4rem; }

  /* Consent checkbox — required before checkout; its links open the reader popup. */
  .cd-agree {
    display: flex; align-items: flex-start; gap: 0.55rem;
    min-height: 44px; /* whole label is the tap target */
    font-size: 0.8125rem; line-height: 1.65; color: #b9b0a2; cursor: pointer;
  }
  .cd-agree input {
    flex: none; width: 20px; height: 20px; margin-top: 0.1rem;
    accent-color: var(--brass); cursor: pointer;
  }
  .cd-agree a { color: var(--brass-bright); text-decoration: underline; cursor: pointer; }
  .cd-agree a:hover { color: var(--brass); }
  .cd-agree.is-error { color: #efaf91; }
  .cd-agree.is-error input { outline: 2px solid #efaf91; outline-offset: 2px; }
  .cd-agree-hint, .cd-payment-error { margin: -0.35rem 0 0; font-size: 0.8125rem; line-height: 1.5; color: #efaf91; }

  /* One physical brass key, with a live label and the entire surface clickable. */
  .cd-checkout {
    display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
    width: 100%; min-height: 56px; padding: 0.9rem 1.15rem; border-radius: 5px;
    border: 1px solid #e8c878; background: linear-gradient(165deg, #ebd29d 0%, #c9a35c 52%, #b18b49 100%);
    color: #20180d; font-family: var(--font-body); font-size: 0.9375rem; font-weight: 650;
    box-shadow: inset 0 1px 0 #f3dfb6, 0 3px 0 #70562d, 0 7px 15px rgba(0,0,0,.3);
    cursor: pointer; transition: transform 120ms ease, filter 120ms ease, box-shadow 120ms ease;
  }
  .cd-checkout span { font-size: 1.3rem; }
  .cd-checkout:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .cd-checkout:active { transform: translateY(2px); box-shadow: inset 0 1px 0 #f3dfb6, 0 1px 0 #70562d; }
  .cd-payment { font-size: 0.6875rem; color: #b9b0a2; line-height: 1.5; text-align: center; margin: 0; }
  .cd-cont {
    background: none; border: 0; color: #b9b0a2;
    font-size: 0.8125rem; cursor: pointer; padding: 0.25rem;
    min-height: 44px; /* tap-target floor */
  }
  .cd-cont:hover { color: var(--brass-bright); }
  .cd-help { flex: none; display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; margin: 0 1.5rem; padding: 0.5rem 0 calc(0.5rem + env(safe-area-inset-bottom, 0px)); border-top: 1px solid var(--border-bright); font-size: 0.75rem; color: #b9b0a2; }
  .cd-help a { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; color: var(--brass-bright); }
  .cart-drawer :global(:focus-visible) { outline: 2px solid var(--brass-bright); outline-offset: 3px; }
  .cd-announcement { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 380px) {
    .cd-head { padding: 1.1rem; }
    .cd-body { padding: 0 1.1rem; }
    .cd-help { margin: 0 1.1rem; }
    .cd-items :global(.ci) { grid-template-columns: 64px 1fr auto; gap: 0.65rem; padding: 1.2rem 0; }
    .cd-items :global(.ci-name) { font-size: 1.2rem; }
    .cd-items :global(.ci-meta) { font-size: 0.6875rem; }
    .cd-head h2 { font-size: 2rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cart-drawer, .cart-drawer::backdrop, .cd-checkout { transition: none; }
  }
  :global(html.hc) .cart-drawer { background: var(--bg-0); }

  /* drawer is a flex column so cd-foot can pin to the bottom */
  .cart-drawer { display: flex; flex-direction: column; }
  .cart-drawer:not([open]) { display: none; }

  /* ---- Legal reader modal (centered, tabbed) ---- */
  .legal-modal {
    margin: auto;
    width: min(720px, 94vw);
    max-height: min(88dvh, 900px);
    padding: 0;
    border: 1px solid var(--border-bright);
    border-radius: 14px;
    background: var(--bg-1);
    color: var(--fg);
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.65);
    flex-direction: column;
    overflow: hidden;
  }
  .legal-modal[open] { display: flex; }
  .legal-modal:not([open]) { display: none; }
  .legal-modal::backdrop { background: rgba(8, 7, 6, 0); transition: background 0.28s ease; }
  .legal-modal[open]::backdrop { background: rgba(8, 7, 6, 0.72); backdrop-filter: blur(4px); }
  @starting-style { .legal-modal[open]::backdrop { background: rgba(8, 7, 6, 0); } }

  .lm-head {
    display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
    padding: 0.9rem 1.1rem; border-bottom: 1px solid var(--border); flex: none;
  }
  .lm-tabs { display: flex; gap: 0.3rem; flex-wrap: wrap; }
  .lm-tab {
    padding: 0.4rem 0.8rem; border-radius: 7px; border: 1px solid var(--border);
    background: transparent; color: var(--fg-dim);
    font-family: var(--font-mono); font-size: 0.76rem; letter-spacing: 0.02em; cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .lm-tab:hover { color: var(--brass-bright); border-color: var(--border-bright); }
  .lm-tab.is-active { color: var(--bg-0); background: var(--brass); border-color: var(--brass); }

  /* min-height:0 + an explicit max-height give the body a self-contained scroll
     region, so WebKit doesn't collapse it trying to flex-size against the
     modal's indefinite (max-height-only) height. 4rem leaves room for .lm-head. */
  .lm-body {
    flex: 1 1 auto; min-height: 0;
    max-height: calc(min(88dvh, 900px) - 4rem);
    overflow-y: auto; -webkit-overflow-scrolling: touch;
    padding: 0.4rem 1.35rem 1.2rem;
  }
  .lm-body:focus-visible { outline: 2px solid var(--brass); outline-offset: -3px; }
  /* Content comes from separate components, so style via :global. */
  .lm-body :global(.muted) { color: var(--fg-faint); font-size: 0.8rem; }
  .lm-body :global(h2) { font-size: 1.1rem; color: var(--fg); margin: 1.5rem 0 0.4rem; }
  .lm-body :global(p) { font-size: 0.88rem; line-height: 1.6; color: var(--fg-dim); margin: 0 0 0.6rem; }
  .lm-body :global(ul) { margin: 0 0 0.7rem; padding-left: 1.2rem; }
  .lm-body :global(li) { font-size: 0.88rem; line-height: 1.55; color: var(--fg-dim); margin: 0 0 0.3rem; }
  .lm-body :global(a) { color: var(--brass-bright); text-decoration: underline; }
  .lm-body :global(strong) { color: var(--fg); }
  .lm-body :global(code) { font-family: var(--font-mono); font-size: 0.82em; color: var(--brass-bright); }
</style>
