---
// Black Friday / Cyber Monday 2026: the $69 bundle as a card under the TV (/plugins and home).
// Hidden unless html[data-sale] is set (BaseLayout's head gate), so it comes and goes with the sale, no push.
//   bf: a steel slat lit by the strip's work lamp; the price a stamped plate, the button a brass key.
//   cm: the same card as the scan tool's screen (phosphor allowed: a lit screen is a lamp, DESIGN §2).
// The button is the cart's own [data-add-to-cart] (Cart.astro), so "In your cart" and the swap work as everywhere.
import { Image } from 'astro:assets';
import { plugins } from '../data/plugins';
import { pluginImage } from '../lib/images';
import { saleBundle, saleBundleCount, salePhases } from '../data/sale';

const inBundle = saleBundle.slugs
  .map((s) => plugins.find((p) => p.slug === s))
  .filter((p): p is NonNullable<typeof p> => !!p)
  .map((p) => ({ name: p.library?.name ?? p.name, img: pluginImage(p.heroImage) }));
const bf = salePhases.find((p) => p.id === 'bf')!;
const cm = salePhases.find((p) => p.id === 'cm')!;
---

<section class="bc" aria-label={`The bundle: all ${saleBundleCount} plugins, $${saleBundle.priceUsd}`}>
  <div class="bc-slat">
    <span class="bc-lamp" aria-hidden="true"></span>
    <div class="bc-head">
      <p class="bc-kicker"><span class="bc-bf">Black Friday</span><span class="bc-cm">Cyber Monday</span> · the whole garage</p>
      <h2 class="bc-title">All {saleBundleCount} plugins</h2>
      <p class="bc-keys">{saleBundle.meta}</p>
    </div>
    <ul class="bc-row" role="list">
      {inBundle.map((p) => (
        <li class="bc-item">
          <span class="bc-pic">{p.img && <Image src={p.img} alt="" width={160} format="webp" loading="lazy" />}</span>
          <span class="bc-name">{p.name}</span>
        </li>
      ))}
    </ul>
    <div class="bc-buy">
      <span class="bc-price">${saleBundle.priceUsd}</span>
      <button type="button" class="bc-key" data-add-to-cart data-cart-open data-cart-label data-slug={saleBundle.slug} data-name={saleBundle.name} data-price={saleBundle.priceUsd}>Add all {saleBundleCount} to cart</button>
      <p class="bc-ends"><span class="bc-bf">Ends {bf.endShort}</span><span class="bc-cm">Ends {cm.endShort}</span></p>
    </div>
  </div>
  <p class="bc-drift">DRIFT is in it: today's build now, the release build as a free update when it ships.</p>
</section>

<style>
  .bc { display: none; }
  :global(html[data-sale]) .bc { display: block; padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 4vw, 3rem) 0; }
  .bc-cm { display: none; }
  :global(html[data-sale='cm']) .bc .bc-cm { display: inline; }
  :global(html[data-sale='cm']) .bc .bc-bf { display: none; }

  .bc-slat {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(16rem, 1fr) minmax(0, 2.6fr) auto;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    padding: clamp(1.1rem, 2vw, 1.6rem) clamp(1.2rem, 2.6vw, 2.4rem) clamp(1.1rem, 2vw, 1.6rem) clamp(3rem, 5vw, 4.4rem);
    border-radius: 6px;
    color: var(--fg);
    background:
      radial-gradient(30% 160% at 2% 50%, rgba(255, 172, 84, 0.3), rgba(255, 150, 60, 0.08) 45%, transparent 75%),
      repeating-linear-gradient(180deg, #26211c 0 2px, #191613 2px 4px, #110f0d 4px 6px, #1f1b17 6px 15px);
    border: 1px solid #070606;
    box-shadow: inset 0 1px 0 rgba(232, 200, 120, 0.08), 0 14px 30px -12px rgba(0, 0, 0, 0.9);
  }
  .bc-lamp {
    position: absolute;
    left: clamp(12px, 1.8vw, 24px);
    top: 50%;
    width: 16px;
    height: 22px;
    translate: 0 -50%;
    border-radius: 7px 7px 5px 5px;
    background:
      repeating-linear-gradient(90deg, transparent 0 3px, #3b3128 3px 4.4px),
      radial-gradient(circle at 50% 55%, #fff1cf, #ffc165 45%, #c7731f 80%);
    box-shadow: 0 0 10px 3px rgba(255, 170, 70, 0.55), 0 0 30px 10px rgba(255, 150, 60, 0.18);
  }
  .bc-kicker { margin: 0; font: 600 0.66rem/1.3 var(--font-mono); letter-spacing: 0.2em; text-transform: uppercase; white-space: nowrap; color: var(--brass); }
  .bc-title { margin: 0.25rem 0 0.35rem; font-family: var(--font-display); font-weight: 400; font-size: clamp(2rem, 3.4vw, 2.8rem); line-height: 0.95; letter-spacing: 0.06em; text-shadow: 0 1px 0 rgba(0, 0, 0, 0.8); }
  .bc-keys { margin: 0; font-size: 0.82rem; line-height: 1.4; color: var(--fg-dim); }

  .bc-row { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: clamp(0.4rem, 0.9vw, 0.8rem); }
  .bc-item { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; min-width: 0; }
  .bc-pic { display: flex; align-items: flex-end; justify-content: center; width: 100%; height: clamp(52px, 6.4vw, 84px); }
  .bc-pic :global(img) { display: block; max-width: 100%; max-height: 100%; width: auto; height: auto; filter: drop-shadow(2px 4px 5px rgba(0, 0, 0, 0.75)); }
  /* each name a small stamped plate, the strip's enamel */
  .bc-name {
    max-width: 100%;
    text-align: center;
    font-family: var(--font-display);
    font-size: 0.78rem;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #1d1916;
    padding: 0.2rem 0.4rem 0.14rem;
    border-radius: 3px;
    background: linear-gradient(180deg, #f1e6cb, #dccfae 70%, #cfc09b);
    box-shadow: inset 0 0 0 1px #9c8c66, 0 1px 0 #6e5f42, 0 2px 4px rgba(0, 0, 0, 0.6);
  }

  .bc-buy { display: flex; flex-direction: column; align-items: center; gap: 0.55rem; }
  .bc-price {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    line-height: 1;
    letter-spacing: 0.04em;
    color: #1d1916;
    padding: 0.3rem 1.3rem 0.2rem;
    border-radius: 5px;
    background: linear-gradient(180deg, #f1e6cb, #dccfae 70%, #cfc09b);
    box-shadow: inset 0 0 0 2px #efe3c6, inset 0 0 0 3.5px #9c8c66, 0 2px 0 #6e5f42, 0 6px 12px rgba(0, 0, 0, 0.7);
    text-shadow: 0 1px 0 rgba(255, 248, 230, 0.7);
    rotate: -1.5deg;
  }
  .bc-key {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.1em;
    white-space: nowrap;
    color: #1d1916;
    padding: 0.55rem 1.2rem 0.45rem;
    border: 0;
    border-radius: 5px;
    cursor: pointer;
    background: linear-gradient(180deg, var(--brass-bright), var(--brass) 45%, var(--brass-dark));
    box-shadow: inset 0 1px 0 rgba(255, 240, 200, 0.6), 0 3px 0 #5e4a26, 0 6px 12px rgba(0, 0, 0, 0.7);
    text-shadow: 0 1px 0 rgba(255, 240, 200, 0.55);
  }
  .bc-key:hover { filter: brightness(1.08); }
  .bc-key:active { translate: 0 2px; box-shadow: inset 0 1px 0 rgba(255, 240, 200, 0.6), 0 1px 0 #5e4a26, 0 3px 6px rgba(0, 0, 0, 0.7); }
  .bc-key:focus-visible { outline: 2px solid var(--brass-bright); outline-offset: 3px; }
  .bc-ends { margin: 0; font: 600 0.6rem/1 var(--font-mono); letter-spacing: 0.22em; text-transform: uppercase; color: var(--fg-dim); }
  .bc-drift { max-width: 1200px; margin: 0.6rem auto 0; font-size: 0.78rem; color: var(--fg-dim); text-align: center; }

  /* ── Cyber Monday: the scan tool's screen ── */
  :global(html[data-sale='cm']) .bc-slat {
    background: radial-gradient(120% 140% at 50% 40%, #0d2a1c, #04120b 70%);
    border-color: #1d4a33;
    box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.7), 0 14px 30px -12px rgba(0, 0, 0, 0.9);
    color: #8dffc0;
  }
  :global(html[data-sale='cm']) .bc-lamp { display: none; }
  :global(html[data-sale='cm']) :is(.bc-kicker, .bc-keys, .bc-ends) { color: #4fbf86; }
  :global(html[data-sale='cm']) .bc-title { font-family: 'VT323', var(--font-mono); color: #8dffc0; text-shadow: 0 0 8px rgba(80, 255, 160, 0.5); }
  :global(html[data-sale='cm']) :is(.bc-name, .bc-price) { background: none; box-shadow: inset 0 0 0 1px #2f7a55; color: #8dffc0; text-shadow: 0 0 6px rgba(80, 255, 160, 0.45); font-family: 'VT323', var(--font-mono); rotate: none; }
  :global(html[data-sale='cm']) .bc-key { background: #8dffc0; color: #04120b; box-shadow: 0 0 12px rgba(80, 255, 160, 0.45); text-shadow: none; font-family: 'VT323', var(--font-mono); font-size: 1.35rem; }

  @media (max-width: 860px) {
    .bc-slat { grid-template-columns: 1fr; padding: 1.2rem 1.1rem 1.3rem; text-align: center; }
    .bc-lamp { left: 50%; top: 0; translate: -50% -40%; }
    .bc-row { grid-template-columns: repeat(4, minmax(0, 1fr)); row-gap: 0.9rem; }
    .bc-buy { flex-direction: row; flex-wrap: wrap; justify-content: center; }
    .bc-ends { flex-basis: 100%; text-align: center; }
  }
  :global(html.hc) .bc-slat { background: #000; border-color: #fff; }
  @media (prefers-reduced-motion: reduce) { .bc-key:active { translate: none; } }
</style>
