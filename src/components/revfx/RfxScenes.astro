---
/**
 * #scenes — FOUR SNAPSHOTS. LET THE DAW SWITCH THEM. RevFX's SCENE parameter ("FX Scene": -, A, B, C, D) is
 * host-automatable (PluginProcessor.cpp), so a DAW lane can call a snapshot on the chorus. Drawn as an arrange
 * window on DRIFT's CRT: a vocal region, the FX Scene lane under it, a playhead on a loop; as it crosses a block
 * the matching slot lights and the five lamps show what that (example) scene plays. scenes.ts runs the playhead.
 * Reduced motion: the playhead parks on B (the chorus), lit.
 */
import { pedals } from '../../data/revfx';

// example scenes for the picture (labelled as examples on the page): which strips play
const SCENES = {
  A: { name: 'Verse', on: ['halo', 'reverb', 'glue'] },
  B: { name: 'Chorus', on: ['echo', 'reverb', 'halo', 'glue'] },
  C: { name: 'Bridge', on: ['pitch', 'echo', 'glue'] },
  D: { name: 'Drop', on: ['pitch', 'echo', 'reverb', 'halo', 'glue'] },
} as const;
// the lane: [scene, start, end] in loop fractions
const LANE: [keyof typeof SCENES, number, number][] = [['A', 0, 0.25], ['B', 0.25, 0.5], ['A', 0.5, 0.625], ['C', 0.625, 0.8125], ['D', 0.8125, 1]];
// a vocal region's level shape, 96 bars, deterministic
const bars = Array.from({ length: 96 }, (_, i) => {
  const x = i / 96;
  const env = x < 0.25 ? 0.45 : x < 0.5 ? 0.85 : x < 0.625 ? 0.45 : x < 0.8125 ? 0.6 : 1;
  return Math.round((0.25 + 0.75 * Math.abs(Math.sin(i * 1.7) * Math.cos(i * 0.43))) * env * 100);
});
---
<section class="d-sec rfx-sec rfx-scenes" id="scenes" aria-labelledby="rfx-scenes-h">
  <div class="d-wrap">
    <h2 id="rfx-scenes-h" class="d-headline d-headline--row"><span class="l1">Four snapshots.</span> <span class="l2">Your DAW switches them.</span></h2>
    <p class="rfx-sec-lede">Hold a slot to save the rack as it is. Click it to call it back. <b>FX Scene</b> is an automatable parameter, so one lane in your session can change the whole rack on the chorus.</p>

    <div class="rfx-daw" data-rfx-daw data-lane={JSON.stringify(LANE)} data-scenes={JSON.stringify(SCENES)}>
      <div class="rfx-daw-slots" aria-hidden="true">
        {Object.entries(SCENES).map(([L, s]) => (
          <div class="rfx-daw-slot" data-slot={L}><b>{L}</b><span>{s.name}</span></div>
        ))}
      </div>
      <div class="rfx-daw-lamps" aria-hidden="true">
        {pedals.map((p) => <span data-lamp={p.id} style={`--rgb:${p.rgb};--ink:${p.ink}`}><i></i>{p.name}</span>)}
      </div>
      <div class="rfx-daw-arr" aria-hidden="true">
        <div class="rfx-daw-hd"><span>VOX</span><span>FX Scene</span></div>
        <div class="rfx-daw-tracks">
          <div class="rfx-daw-region">{bars.map((h) => <i style={`--h:${h}%`}></i>)}</div>
          <div class="rfx-daw-lane">
            {LANE.map(([L, a, b]) => <span class={`blk blk-${L}`} style={`left:${a * 100}%;width:${(b - a) * 100}%`}>{L}</span>)}
          </div>
          <i class="rfx-daw-head" data-rfx-head></i>
        </div>
      </div>
      <p class="rfx-daw-now" data-rfx-now aria-hidden="true">SCENE A · VERSE</p>
      <p class="d-fine rfx-daw-fine">Example scenes. Yours are whatever you save.</p>
    </div>
  </div>
</section>
