---
/**
 * #rack — YOUR ORDER. OR THE DICE'S. The RevFX window itself: /drift's live rack (DRIFT 5.2.4 FX view rebuilt from
 * its own pixels, src/lib/drift/rack.ts = the plugin's screens and dice engine), relabelled RevFX where the plugin
 * prints it, and played the way the plugin plays (rackplay.ts):
 *   - drag a strip by its body along the rail: the others make room, the chain follows (GLUE COMP too: in RevFX it
 *     can sit anywhere, ORD_GLUE 0-4);
 *   - RANDOMIZE (the rack's key, or the big die under it) rolls a named scene; GLUE COMP keeps its column;
 *   - SNAPSHOT A-D: click = recall, hold 600 ms = store (the plugin's own rule).
 * Under it the scene CRT (name, the dice engine's own blurb, EXTREME) and the signal chain IN -> ... -> OUT.
 * Phones (<= 600): no rack (as /drift); the die, the CRT and the chain carry it, rolled by the same engine.
 */
import { getImage } from 'astro:assets';
import DriftPanel from '../drift/DriftPanel.astro';
import geo from '../../assets/seasons/drift/rack/rack.json';
import rkFloor from '../../assets/seasons/drift/rack/rack-floor.png';
import rkTop from '../../assets/seasons/drift/rack/rack-top.png';
import rkPitch from '../../assets/seasons/drift/rack/rack-pitch.png';
import rkEcho from '../../assets/seasons/drift/rack/rack-echo.png';
import rkVerb from '../../assets/seasons/drift/rack/rack-reverb.png';
import rkHalo from '../../assets/seasons/drift/rack/rack-halo.png';
import rkGlue from '../../assets/seasons/drift/rack/rack-glue.png';
import gPitch from '../../assets/seasons/drift/rack/rack-grab-pitch.png';
import gEcho from '../../assets/seasons/drift/rack/rack-grab-echo.png';
import gVerb from '../../assets/seasons/drift/rack/rack-grab-reverb.png';
import gHalo from '../../assets/seasons/drift/rack/rack-grab-halo.png';
import gGlue from '../../assets/seasons/drift/rack/rack-grab-glue.png';
import { pedals } from '../../data/revfx';

const art = { pitch: [rkPitch, gPitch], echo: [rkEcho, gEcho], reverb: [rkVerb, gVerb], halo: [rkHalo, gHalo], glue: [rkGlue, gGlue] } as const;
const W = geo.stage.w;
const stageSizes = '(max-width: 600px) 1px, (max-width: 1000px) calc(100vw - 80px), 1100px';
const stripSizes = '(max-width: 600px) 1px, (max-width: 1000px) calc((100vw - 80px) / 5), 230px';
const [floor1200, floor2000, top1200, top2000] = await Promise.all([
  getImage({ src: rkFloor, width: 1200, format: 'webp', quality: 78 }),
  getImage({ src: rkFloor, width: 2000, format: 'webp', quality: 76 }),
  getImage({ src: rkTop, width: 1200, format: 'webp', quality: 80 }),
  getImage({ src: rkTop, width: 2000, format: 'webp', quality: 78 }),
]);
const strips = await Promise.all(pedals.map(async (p) => ({
  ...p,
  s240: await getImage({ src: art[p.id][0], width: 240, format: 'webp', quality: 82 }),
  s420: await getImage({ src: art[p.id][0], width: 420, format: 'webp', quality: 80 }),
  grab: await getImage({ src: art[p.id][1], width: 120, format: 'webp', quality: 85 }),
})));
const box = (b: { x: number; y: number; w: number; h: number }) => `--x:${b.x};--y:${b.y};--w:${b.w};--h:${b.h}`;
const H = geo.header;
const lcdK = H.tiles.w / 276;
// SNAPSHOT A-D, where the plugin draws them (measured off rack-floor.png: 68 x 70 stage px, 81.2 apart)
const slots = ['A', 'B', 'C', 'D'].map((L, i) => ({ L, b: { x: 47.3 + i * 81.2, y: 64.4, w: 68, h: 70 } }));
// the die's six faces: pips on a 3x3 grid (index 0-8)
const PIPS = [[4], [0, 8], [0, 4, 8], [0, 2, 6, 8], [0, 2, 4, 6, 8], [0, 2, 3, 5, 6, 8]];
---
<section class="d-sec rfx-sec" id="rack" aria-labelledby="rfx-rack-h">
  <div class="d-wrap">
    <DriftPanel sticker="順番" checker={false} class="d-fx-panel rfx-rack-panel">
      <h2 id="rfx-rack-h" class="d-headline d-headline--row"><span class="l1">Your order.</span> <span class="l2">Or the dice’s.</span></h2>
      <p class="rfx-rack-lede">This is the RevFX window. <b>Grab a strip and drag it</b> along the rail. <b>Hit RANDOMIZE</b> for a whole new scene. <b>Hold a snapshot</b> to save it, click to call it back.</p>

      <div class="d-rk rfx-rk" data-rack data-boot="off" style={`--rk-k:${lcdK}`}>
        <div class="d-rk-stage" data-rk-stage style={`--sw:${W};--sh:${geo.stage.h}`}>
          <img class="d-rk-floor" src={floor2000.src} srcset={`${floor1200.src} 1200w, ${floor2000.src} 2000w`}
            sizes={stageSizes} width={W} height={Math.round(geo.stage.h)} alt="" loading="lazy" decoding="async" />
          {strips.map((s) => (
            <div class="d-rk-strip" data-rk-strip={s.id} style={box(geo.strips[s.id].crop)}>
              <img src={s.s420.src} srcset={`${s.s240.src} 240w, ${s.s420.src} 420w`} sizes={stripSizes}
                width={Math.round(geo.strips[s.id].crop.w)} height={Math.round(geo.strips[s.id].crop.h)} alt={`RevFX ${s.name} strip`} loading="lazy" decoding="async" draggable="false" />
              <canvas aria-hidden="true" style={box({ ...geo.strips[s.id].screen, x: geo.strips[s.id].screen.x - geo.strips[s.id].crop.x, y: geo.strips[s.id].screen.y - geo.strips[s.id].crop.y })}></canvas>
            </div>
          ))}
          <img class="d-rk-top" src={top2000.src} srcset={`${top1200.src} 1200w, ${top2000.src} 2000w`}
            sizes={stageSizes} width={W} height={Math.round(geo.stage.h)} alt="" loading="lazy" decoding="async" />
          <i class="d-rk-pulse" aria-hidden="true"></i>
          {strips.map((s) => (
            <img class="d-rk-grab" data-rk-grab={s.id} style={box(geo.strips[s.id].grabCrop)} src={s.grab.src}
              width={Math.round(geo.strips[s.id].grabCrop.w)} height={Math.round(geo.strips[s.id].grabCrop.h)} alt="" loading="lazy" decoding="async" />
          ))}
          {/* RevFX prints its own name where DRIFT prints FX RACK (RevFX HANDOFF: the only visual change) */}
          <span class="rfx-rk-hdr" style={box(H.hdr)} aria-hidden="true"><i>////</i>RevFX<i>////</i></span>
          {slots.map((s, i) => (
            <button type="button" class="rfx-rk-slot" data-rfx-slot={i} style={box(s.b)}
              aria-label={`Snapshot ${s.L}: click to recall, hold to save`}>
              <span class="L">{s.L}</span><span class="m" data-m>EMPTY</span><i class="bar"></i>
            </button>
          ))}
          <span class="d-rk-cnt" data-rk-cnt aria-hidden="true" style={box(H.cnt)}>HIT RANDOMIZE</span>
          <div class="d-rk-tiles" data-rk-tiles style={box(H.tiles)}></div>
          <button type="button" class="d-rk-rnd" data-rk-rnd style={box(H.rnd)} aria-label="Randomize: roll a new effects scene">
            <span class="d-rk-rnd-tag" aria-hidden="true">EXTREME</span>
            <span class="d-rk-rnd-txt">RANDOMIZE</span>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 .5V4.2M11.2 .5V5.6" fill="none" stroke="currentColor" stroke-width="1"/><rect x="1.2" y="4.2" width="7.2" height="7.2" rx="1.6" transform="rotate(-9 4.8 7.8)" fill="none" stroke="currentColor" stroke-width="1.3"/><rect x="8" y="5.6" width="6.6" height="6.6" rx="1.5" transform="rotate(11 11.3 8.9)" fill="none" stroke="currentColor" stroke-width="1.3"/><circle cx="3.4" cy="6.4" r=".9" fill="currentColor"/><circle cx="6.1" cy="9.1" r=".9" fill="currentColor"/><circle cx="11.3" cy="8.9" r=".9" fill="currentColor"/></svg>
          </button>
        </div>
        <ul class="d-rk-caps" role="list">
          {strips.map((s) => <li data-rk-cap={s.id} style={`--ink:${s.ink}`}><h3>{s.name}</h3><p>{s.line}</p></li>)}
        </ul>
        <p class="d-sr" aria-live="polite" aria-atomic="true" data-rk-say></p>
      </div>

      {/* the dice deck: the scene CRT + the big die (every width) */}
      <div class="rfx-deck" data-rfx-deck>
        <button type="button" class="rfx-die-btn" data-rfx-die aria-label="Roll the dice: a new effects scene">
          <span class="rfx-die" data-rfx-cube aria-hidden="true">
            {PIPS.map((f, i) => <span class={`rfx-die-f f${i + 1}`}>{Array.from({ length: 9 }, (_, k) => <i class={f.includes(k) ? 'on' : ''}></i>)}</span>)}
          </span>
          <span class="rfx-die-txt">Roll it</span>
        </button>
        <div class="rfx-crt" data-rfx-crt>
          <p class="rfx-crt-top"><span data-rfx-roll>ROLL —</span><span class="rfx-crt-x" data-rfx-x hidden>EXTREME</span></p>
          <p class="rfx-crt-name" data-rfx-name>PRESS THE DICE</p>
          <p class="rfx-crt-blurb" data-rfx-blurb>21 named scenes. Every roll picks one, sets the amounts, and sometimes the order.</p>
          <ol class="rfx-chain" data-rfx-chain aria-label="Signal chain">
            <li class="rfx-chain-io">IN</li>
            {pedals.map((p) => <li class="rfx-chain-fx" data-fx={p.id} style={`--ink:${p.ink};--rgb:${p.rgb}`}><span>{p.name}</span>
              <span class="rfx-chain-mv"><button type="button" data-mv="-1" aria-label={`Move ${p.name} earlier`}>‹</button><button type="button" data-mv="1" aria-label={`Move ${p.name} later`}>›</button></span></li>)}
            <li class="rfx-chain-io">OUT</li>
          </ol>
          <p class="d-sr" aria-live="polite" data-rfx-say></p>
        </div>
      </div>

      <div class="d-fx-foot rfx-hood">
        <span class="d-fx-kicker" aria-hidden="true">Also on the rack</span>
        <dl class="d-spec-plate">
          <div><dt>FX MIX</dt><dd>The whole rack, dry to wet, on one dial</dd></div>
          <div><dt>FX POWER</dt><dd>All five in or out, one switch</dd></div>
          <div><dt>UNDO</dt><dd>One roll, one undo step back</dd></div>
          <div><dt>TEMPO</dt><dd>Echo and reverb sync to your DAW</dd></div>
        </dl>
      </div>
    </DriftPanel>
  </div>
</section>
