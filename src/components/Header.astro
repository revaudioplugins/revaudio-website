---
import { plugins } from '../data/plugins';

const path = Astro.url.pathname;
const isActive = (p: string) => path === p || path === p + '/';
const onProductPage = plugins.some((pl) => isActive(`/${pl.slug}`));
---

<nav class="site-nav" data-site-nav aria-label="Main navigation">
  <div class="nav-inner">
    <a href="/" class="logo" aria-label="RevAudio home">
      {/* Text wordmark — same two-tone REV/AUDIO treatment as the footer,
          set in the display face. */}
      <span class="logo-word">REV<span class="logo-accent">AUDIO</span></span>
    </a>
    <div class="nav-right">
      <ul id="nav-menu" class="nav-links">
        {/* Task nav only — the logo is the home link, and legal lives in the
            footer's Legal column. Keep this list at ~6; past that, Store
            becomes a dropdown rather than the bar growing. */}
        {/* Store is the one non-plain nav item — the site's "action channel"
            (one lit treatment reserved for revenue actions; everything else
            stays plain text so the isolation actually isolates). */}
        <li><a href="/store" class="nav-store" aria-current={isActive('/store') || onProductPage ? 'page' : undefined}>Store</a></li>
        <li><a href="https://revlimiter-license.revaudio.workers.dev/download" target="_blank" rel="noopener noreferrer">Downloads</a></li>
        <li><a href="/about" aria-current={isActive('/about') ? 'page' : undefined}>About</a></li>
        <li><a href="/support" aria-current={isActive('/support') ? 'page' : undefined}>Support</a></li>
        <li><a href="/affiliate" aria-current={isActive('/affiliate') ? 'page' : undefined}>Affiliates</a></li>
      </ul>
      <button type="button" class="cart-toggle" data-cart-toggle aria-label="Open cart">
        {/* Plain line cart in currentColor — the same glyph as the mobile
            CartFab, so header and FAB read as one control. Replaced the 900px
            brass-render PNG (Dan, 2026-09-07): at 30px it was a muddy blob,
            and the badge now has to pop off it. */}
        <svg class="cart-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2.5 3h2.2l2 12.2h11.6l2.2-8.7H6.1" />
          <circle cx="8.6" cy="20" r="1.7" fill="currentColor" stroke="none" />
          <circle cx="17.2" cy="20" r="1.7" fill="currentColor" stroke="none" />
        </svg>
        <span class="cart-badge" data-cart-badge hidden>0</span>
      </button>
      <button
        type="button"
        class="nav-burger"
        data-nav-toggle
        aria-controls="nav-menu"
        aria-expanded="false"
        aria-label="Menu"
      >
        <span class="burger-box"><span class="burger-line"></span></span>
      </button>
    </div>
  </div>
</nav>

<script is:inline>
  (function () {
    var nav = document.querySelector('[data-site-nav]');
    if (!nav) return;
    var burger = nav.querySelector('[data-nav-toggle]');
    var menu = nav.querySelector('#nav-menu');
    if (!burger || !menu) return;

    function setOpen(open) {
      nav.classList.toggle('nav-open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    function isOpen() { return nav.classList.contains('nav-open'); }

    burger.addEventListener('click', function (e) {
      e.stopPropagation();
      setOpen(!isOpen());
    });
    // Tapping a link navigates; collapse so it's tidy on back-nav.
    menu.addEventListener('click', function (e) {
      if (e.target.closest('a')) setOpen(false);
    });
    // Outside click / Escape close.
    document.addEventListener('click', function (e) {
      if (isOpen() && !nav.contains(e.target)) setOpen(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && isOpen()) { setOpen(false); burger.focus(); }
    });
    // Re-show desktop nav if the viewport grows past the breakpoint.
    var mq = window.matchMedia('(min-width: 701px)');
    (mq.addEventListener ? mq.addEventListener.bind(mq, 'change') : mq.addListener.bind(mq))(function (ev) {
      if (ev.matches) setOpen(false);
    });
  })();
</script>

<style>
  .nav-right { display: flex; align-items: center; gap: 1.75rem; }

  /* ---- Text wordmark ---- */
  .logo-word {
    font-family: var(--font-display);
    font-size: 1.55rem;
    letter-spacing: 0.12em;
    line-height: 1;
    color: var(--fg);
    transition: filter 0.2s var(--ease), transform 0.12s var(--ease);
  }
  .logo-word .logo-accent { color: var(--brass-bright); }
  .logo:hover .logo-word { filter: brightness(1.12); transform: translateY(-1px); }

  /* ---- Store — the lit slot ----
     The one non-plain nav item (see the markup comment): a small brass-lit
     chip against the plain-text row. Desktop-only; the mobile menu keeps its
     full-width rows and marks Store by colour alone. */
  @media (min-width: 701px) {
    .nav-links a.nav-store {
      color: var(--brass-bright);
      border: 1px solid var(--brass-dark);
      border-radius: 3px;
      padding: 0.3rem 0.8rem;
      /* Translucent, not --bg-1: an opaque chip on a frosted bar reads as a
         sticker sitting on the glass instead of a part of it. Denser than the
         pane on purpose — brass text needs its own darker backing to clear AA
         where the plain white links get by on the pane alone. */
      background: rgba(11, 10, 9, 0.55);
      transition: background 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
    }
    .nav-links a.nav-store:hover {
      background: var(--brass);
      border-color: var(--brass);
      color: var(--bg-0);
    }
  }
  @media (max-width: 700px) {
    .nav-links a.nav-store { color: var(--brass-bright); }
  }

  .cart-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    line-height: 0;
  }
  .cart-toggle { color: var(--brass-bright); }
  .cart-ico { width: 27px; height: 27px; display: block; transition: color 0.2s var(--ease), transform 0.12s var(--ease); }
  .cart-toggle:hover { color: #f4dda2; }
  .cart-toggle:hover .cart-ico { transform: translateY(-1px); }

  /* Red count circle. Adding no longer opens the drawer, so this badge is the
     whole confirmation — it has to catch the eye against a page that is brass
     on brown everywhere else. --redline on white is the one high-alarm colour
     in the palette (5.3:1, clears WCAG AA for this bold small text); the dark
     ring separates it from the cart glyph it overlaps. */
  .cart-badge {
    position: absolute;
    /* Kept inside the nav's own height: the bar is flush to the top of the
       viewport, so a badge hung above the icon gets sliced off by the window
       edge, not just the bar. */
    top: -3px;
    right: -8px;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 10px;
    background: var(--redline);
    color: #fff;
    border: 2px solid var(--bg-0);
    box-shadow: 0 0 10px rgba(200, 51, 31, 0.55);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 16px;
    text-align: center;
  }
  /* One-shot pop, restarted by Cart.astro's sync() on every count increase. */
  .cart-badge.is-bump { animation: cart-pop 0.42s var(--ease-settle) 1; }
  @keyframes cart-pop {
    0% { transform: scale(1); }
    35% { transform: scale(1.55); box-shadow: 0 0 18px rgba(200, 51, 31, 0.95); }
    100% { transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) { .cart-badge.is-bump { animation: none; } }

  /* ---- Hamburger (mobile only) ---- */
  .nav-burger {
    display: none; /* shown ≤700px */
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--border-bright);
    border-radius: 8px;
    background: var(--bg-1);
    cursor: pointer;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .nav-burger:hover { border-color: var(--brass-dark); }

  /* 3 brass bars built from one element + its ::before/::after, so the middle
     bar can fade and the outer two rotate into an X on open. */
  .burger-box { position: relative; width: 20px; height: 14px; display: block; }
  .burger-line,
  .burger-line::before,
  .burger-line::after {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: var(--brass-bright);
    transition: transform 0.25s var(--ease), opacity 0.2s var(--ease);
  }
  .burger-line { top: 6px; }
  .burger-line::before { content: ''; top: -6px; }
  .burger-line::after { content: ''; top: 6px; }

  .nav-open .burger-line { background: transparent; }
  .nav-open .burger-line::before { transform: translateY(6px) rotate(45deg); background: var(--brass-bright); }
  .nav-open .burger-line::after { transform: translateY(-6px) rotate(-45deg); background: var(--brass-bright); }

  @media (max-width: 700px) {
    .nav-right { gap: 0.85rem; }
    .nav-burger { display: inline-flex; }

    /* Cart leaves the bar on mobile — CartFab (BaseLayout) takes over,
       docked bottom-left. It lives outside the nav for layering (FAB z:60 over
       nav z:50). It used to be for filter reasons too — a backdrop-filter
       ancestor traps fixed descendants — but the bar's filter now sits on
       nav.site-nav::before, so the nav itself no longer traps anything. */
    .cart-toggle { display: none; }

    /* Links collapse into a slide-down panel under the bar. */
    .nav-links {
      /* .nav-inner is the containing block now — it had to become positioned
         so it paints above the bar's ::before pane — and it is --maxw wide,
         i.e. 98vw with a 1vw gutter each side on phones. These two lines pull
         the panel back out to the viewport edges from any centered containing
         block, so it stays full-bleed whatever --maxw becomes. The +1px clears
         the nav's own hairline, which .nav-inner's height excludes.
         (Not position:fixed: --nav-h is 44px, the *desktop* bar height, while
         the mobile bar is taller — a fixed top offset would leave a gap.) */
      position: absolute;
      top: calc(100% + 1px);
      left: calc(50% - 50vw);
      right: calc(50% - 50vw);
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 0 0.75rem;
      /* Its own pane of the same glass — a sibling of the bar's pane in
         backdrop-root terms, so this blur actually samples the page. */
      background: var(--nav-glass-face), var(--nav-glass-panel);
      -webkit-backdrop-filter: var(--nav-glass-panel-blur);
      backdrop-filter: var(--nav-glass-panel-blur);
      border-bottom: 1px solid var(--nav-glass-line);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
      /* collapsed state */
      opacity: 0;
      transform: translateY(-8px);
      pointer-events: none;
      transition: opacity 0.22s var(--ease), transform 0.22s var(--ease);
    }
    .nav-open .nav-links {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
    .nav-links li { width: 100%; }
    /* A light hairline between rows, not --border under each link. #2a2420 is
       a dark line meant for dark solid panels; on glass it disappears. White
       at low alpha reads as a groove etched into the pane. Drawing it as
       li + li also retires the last-child special case. */
    .nav-links li + li { border-top: 1px solid var(--nav-glass-rule); }
    .nav-links a {
      display: block;
      padding: 1rem 1.5rem;
      font-size: 1.05rem;
      color: var(--fg);
    }
    .nav-links a[aria-current='page'] { color: var(--brass-bright); }
    .nav-links a:hover { color: var(--brass-bright); }
  }
</style>
