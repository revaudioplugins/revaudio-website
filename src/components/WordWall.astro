  }
  .ww-panel[data-ww-panel='drift']:is([data-ww-look='neon'], [data-ww-look='both']) .ww-spill.is-hot {
    opacity: 1;
  }
  @media (hover: hover) {
    .ww-panel[data-ww-panel='drift']:is([data-ww-look='neon'], [data-ww-look='both']) li:hover > .ww-spill {
      opacity: 1;
    }
  }

  /* ドリフト: a small vertical tube beside the stack, burning dim */
  .ww-panel[data-ww-panel='drift']:is([data-ww-look='neon'], [data-ww-look='both']) .ww-words {
