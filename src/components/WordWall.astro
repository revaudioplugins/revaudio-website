  :global(html.hc) .ww-panel[data-ww-panel='drift'] .ww-kana { display: none !important; }
  /* hc: the screen wall goes (the hc wall shows), its text loses the glow */
  :global(html.hc) .ww-screen,
  :global(html.hc) .ww-screen-fx,
  :global(html.hc) .ww-snow,
  :global(html.hc) .ww-frame { display: none !important; }
  :global(html.hc) .ww-panel[data-ww-panel='drift'] :is(.ww-tag, figcaption, figcaption strong, .ww-go-name) { text-shadow: none !important; }
  /* hc: the TV keeps its plate, the screen effects and the livery go */
  :global(html.hc) .ww-panel[data-ww-panel='drift'] .ww-tv-ink,
  :global(html.hc) .ww-panel[data-ww-panel='drift'] .ww-tube::before,
  :global(html.hc) .ww-panel[data-ww-panel='drift'] .ww-tube::after { display: none !important; }
