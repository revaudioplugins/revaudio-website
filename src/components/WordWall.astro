    .ww-panel[data-ww-panel='drift']:is([data-ww-look='neon'], [data-ww-look='both']) .ww-kana {
      font-size: clamp(1rem, 5vw, 1.5rem);
      margin-top: 0.3em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ww-panel[data-ww-panel='drift'] .ww-word,
    .ww-panel[data-ww-panel='drift'] .ww-spill,
    .ww-panel[data-ww-panel='drift'] .ww-kana {
      animation: none !important;
      transition: none !important;
    }
    .ww-panel[data-ww-panel='drift'] .ww-skid { display: none !important; }
  }

  /* high contrast: plain words, like the other panels; the light, the rubber
     and the kana are art and go */
  :global(html.hc) .ww-panel[data-ww-panel='drift'] .ww-word {
    color: var(--fg) !important;
    -webkit-text-stroke: 0 !important;
    text-shadow: none !important;
