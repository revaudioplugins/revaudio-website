---
/* WordWall — the homepage TV, and the one place to browse the plugins
   (branch feat/home-library, 2026-10-18; the user: "the switching between
   the plugins moves to the TV, only to the TV, only on the home page").

   One broken CRT set on the garage wall (Dan 2026-10-14: "every plugin on
   the TV, only the screen changes, like changing channels"). On its screen:
     - the categories, as the set's on-screen menu: ALL (the TV opens on it,
       zero clicks) + every category a plugin on the TV sits in
       (src/data/library.ts; an empty category is hidden);
     - the plugins, left: each name in the glowing stencil the five words
       used to be, with a small window thumbnail and a plain type word; the
       lit one is filled;
     - the lit plugin, right: its window (DRIFT's is the live run), the name,
       the short description, the five words as one small line, the price,
       "Try free for N days" (TrialGateModal's email gate; DRIFT: its own
       page's sign-up) and a small "Product page" link.
   Lighting a plugin is a channel change: the screen takes that plugin's
   phosphor colour (--ww-ch-<slug>-h / -s) and the plugins swap by motion
   alone, the old one off the glass before the new one comes on, always the
   same way (--ww-mv-*). Now and then the old set glitches by itself (a name,
   the picture or the whole screen; small, never on what is read: --ww-gl-*).
   The list is real links to the product pages (crawlable,
   works without JS); the script turns them into tabs. URL: ?cat= is one
   history entry per category, ?plugin= updates the current one, so Back
   leaves a category and a reload or a return from a product page comes back
   to the same channel. Phones: one pane at a time (the list, then the lit
   plugin as its own view with a history entry; Back returns to the list).

   The copy is the plugins' `library` entries (plugins.ts); which plugins,
   their order, the price line and the try action are library.ts. Honesty:
   the words describe what the plugin is built to do, not measured results.
   Tune on the dev bench /__wwbench (tools/wwbench): every tunable is a --ww-*
   custom property on .ww. Reduced motion: a quick fade on a change, no
   stagger, no power-on, no glitches, the poster instead of the run. html.hc:
   a plain list. */
import { existsSync, statSync } from 'node:fs';
import { Image, getImage } from 'astro:assets';
import GarageWall from './GarageWall.astro';
import rlImg from '../assets/plugins/revlimiter-hero.png';
import gasImg from '../assets/plugins/gas-hero.png';
import gas2Img from '../assets/plugins/gas2-hero.jpg';
import rrImg from '../assets/plugins/radioroulette-hero.png';
import driftImg from '../assets/showcase/drift-window-init.png';
import brokenMeta from '../assets/seasons/drift/tv-broken.json';
import { drift } from '../data/drift';
import { tvPlugins, tvCats, catsOf, tvName, priceLine, tryAction, type TvAction } from '../data/library';
import type { LibraryWord } from '../data/plugins';

/* What the whole wall is: the garage wood, or one TV every plugin plays on
   (Dan 2026-10-14). Lives on .ww. The bench can flip it. */
const WALL_BG: 'wood' | 'screen' = 'screen';

/* The live window: an HD run of DRIFT (1440 desktop / 800 phone) with its
   first frame as the poster. Only when every file is on disk; otherwise the
   panel keeps the still screenshot (no placeholder video, no fake). */
const wallPosterSrc = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../assets/showcase/drift-window-wall.png', { eager: true }),
)[0]?.default;
const WALL_RUN = ['wall-run-1440.webm', 'wall-run-1440.mp4', 'wall-run-800.webm', 'wall-run-800.mp4'];
const wallRunReady = !!wallPosterSrc && WALL_RUN.every((f) => existsSync(`public/drift/${f}`));
// While DRIFT leads, a missing run fails the BUILD (CI included) instead of
// quietly shipping the still: the path is cwd-relative (repo root, as
// `npm run build` and withastro/action run it).
if (drift.homeLead && !wallRunReady) {
  throw new Error(`WordWall: DRIFT's live window is missing (src/assets/showcase/drift-window-wall.png + public/drift/${WALL_RUN.join(', ')}). Build from the repo root, or restore the files.`);
}
/* The TV's art loads late and lean (checker S4, 2026-10-15: the frame + the
   poster were 380 KB of every first load, the laptop cut on phones too): it
   waits until the wall is a screen away, then the script below puts up the
   smallest cut that is still pixel-sharp on that screen, in AVIF where the
   browser decodes it (equal or better PSNR than the WebP before it, under half
   the bytes), else WebP. 1400 stays the top cut, as before. A cut =
   [width, avif, webp] (+ the frame's slices in that cut's pixels). */
const FRAME_CUTS = [640, 960, 1400];
const POSTER_CUTS = [800, 1100, 1400];
type Cut = [number, string, string, string?];
const cut = async (src: ImageMetadata, width: number, q: { avif: number; webp: number }, v = ''): Promise<Cut> => [
  width,
  (await getImage({ src, width, format: 'avif', quality: q.avif })).src + v,
  (await getImage({ src, width, format: 'webp', quality: q.webp })).src + v,
];
const posterCuts = wallRunReady && wallPosterSrc
  ? await Promise.all(POSTER_CUTS.map((w) => cut(wallPosterSrc, w, { avif: 50, webp: 82 })))
  : null;
const top = (cuts: Cut[]) => cuts[cuts.length - 1];
// a size off an imported image without copying the raw file into dist (reading .width straight off the import does)
const dims = (m: ImageMetadata) => (m as ImageMetadata & { clone?: ImageMetadata }).clone ?? m;
/* The TV's frame (Dan 2026-10-14: "a broken TV frame", then "more neutral"):
   a beat-up CRT cabinet front 9-sliced around the whole screen, in place of
   the brass rails. Three rolls (tools/gen-drift-tv-frame-broken.sh +
   tools/cut-drift-tv-frame-broken.py, tv-broken.json = each one's size, bezel
   and corner patches in its own pixels); the bench picks one. */
const WALL_FRAME: 'rails' | '1' | '2' | '3' = '2';
const brokenRolls = import.meta.glob<{ default: ImageMetadata }>('../assets/seasons/drift/tv-broken-*.png', { eager: true });
// every roll gets its cuts, picked or not: an imported image Astro never transforms ships as the raw PNG (MBs);
// only the roll on show is ever fetched
const frameRolls = await Promise.all(
  Object.entries(brokenMeta).map(async ([n, m]) => {
    const src = brokenRolls[`../assets/seasons/drift/tv-broken-${n}.png`]?.default;
    if (!src) throw new Error(`WordWall: tv-broken-${n}.png is listed in tv-broken.json but missing`);
    // dev serves /_image for a year under a URL that ignores the file's content: a re-cut roll kept showing the
    // old one in the bench, so dev adds the file's mtime (the build's names carry a content hash already)
    const v = import.meta.env.DEV ? `&v=${Math.round(statSync(`src/assets/seasons/drift/tv-broken-${n}.png`).mtimeMs)}` : '';
    const cuts = await Promise.all(FRAME_CUTS.map(async (w): Promise<Cut> => [
      ...(await cut(src, w, { avif: 70, webp: 86 }, v)) as [number, string, string],
      m.slice.map((s) => Math.round((s * w) / m.w)).join(' '), // the slice counts in THIS cut's pixels
    ]));
    return { n, m, cuts };
  }),
);
const frameVars = frameRolls.map(({ n, m, cuts }) => [
  `--wf${n}-img:none`, // the script puts the cut up (the <noscript> style below: the top WebP)
  `--wf${n}-sl:${top(cuts)[3]}`,
  // corner patches + bezel as plain numbers in the cut's own (2x) pixels; CSS x --ww-frame-u (a length)
  ...['t', 'r', 'b', 'l'].map((s, i) => `--wf${n}-${s}:${m.slice[i]}`),
  ...['t', 'r', 'b', 'l'].map((s, i) => `--wf${n}-z${s}:${m.bezel[i]}`),
].join(';')).join(';');
// what the script needs to pick a cut; the roll's width turns --ww-frame-u into its pixels
const wallArt = JSON.stringify({
  frame: Object.fromEntries(frameRolls.map(({ n, m, cuts }) => [n, { w: m.w, cuts }])),
  poster: posterCuts,
});
// no JavaScript: the top WebP cuts, as before the lazy load. The video never plays without JS, so its background is the
// picture; Chromium forces its controls on when scripting is off, and their grey panel would hide it
const noJsArt = [
  ...frameRolls.map(({ n, cuts }) => `.ww[data-wordwall]{--wf${n}-img:url(${top(cuts)[2]}) !important}`),
  posterCuts ? `video[data-ww-run]{background:var(--bg-1) url(${top(posterCuts)[2]}) center / cover no-repeat}` : '',
  posterCuts ? `video[data-ww-run]::-webkit-media-controls{display:none !important}` : '',
].join('');

/* The plugins on the TV (library.ts: a `library` entry AND live or an open
   trial; DRIFT first while drift.homeLead) and each one's window. */
const WINDOWS: Record<string, { img: ImageMetadata; portrait?: boolean }> = {
  drift: { img: driftImg },
  revlimiter: { img: rlImg },
  gas: { img: gasImg, portrait: true },
  gas2: { img: gas2Img, portrait: true },
  'radio-roulette': { img: rrImg },
};
type Item = {
  slug: string;
  name: string;
  type: string;
  words: LibraryWord[];
  img: ImageMetadata;
  alt: string;
  portrait?: boolean;
  thumbTall: boolean; // narrower than the list's 16:10 slot: the thumbnail fits its height, else its width
  blurb: string;
  price: string;
  action: TvAction | null;
  cats: string[];
};
const items: Item[] = tvPlugins()
  .filter((p) => WINDOWS[p.slug] && p.library)
  .map((p) => ({
    slug: p.slug,
    name: tvName(p),
    type: p.library!.typeWord,
    words: p.library!.words,
    img: WINDOWS[p.slug].img,
    alt: p.library!.alt,
    portrait: WINDOWS[p.slug].portrait,
    thumbTall: dims(WINDOWS[p.slug].img).width / dims(WINDOWS[p.slug].img).height < 1.6,
    blurb: p.library!.blurb,
    price: priceLine(p),
    action: tryAction(p),
    cats: catsOf(p),
  }));
const cats = tvCats(tvPlugins().filter((p) => items.some((it) => it.slug === p.slug)));
const first = items[0]?.slug ?? '';
---

<GarageWall id="plugins" ariaLabel="RevAudio plugins">
  <div
    class="ww"
    data-wordwall
    data-ww-bg={WALL_BG}
    data-ww-frame={WALL_FRAME}
    data-ww-art={wallArt}
    data-ww-on={first}
    data-ww-view="list"
    style={`${frameVars};--ww-rows:${items.length}`}
  >
    <noscript><style is:inline set:html={noJsArt}></style></noscript>
    {/* the set: the lit tube behind everything (the last channel's glow fading over the new one), the glass over it,
        the cabinet front */}
    <div class="ww-screen" aria-hidden="true"><div class="ww-screen-glow"></div><div class="ww-screen-was"></div></div>
    <div class="ww-screen-fx" aria-hidden="true"></div>
    <div class="ww-frame" aria-hidden="true"><i class="ww-frame-glass"></i><span class="ww-frame-led"></span></div>

    {/* the on-screen menu: the categories (buttons; shown once the script runs, they do nothing without it) */}
    <div class="ww-osd">
      {/* "Plugins" without the script; with it the keys work, so the title asks for a pick (the heading keeps
          "Plugins" for a screen reader) */}
      <h2 class="ww-tag" tabindex="-1"><span class="ww-tag-name">Plugins</span>{' '}<span class="ww-tag-ask">Pick a category<i aria-hidden="true">▸</i></span></h2>
      <div class="ww-cats" role="group" aria-label="Categories">
        {cats.map((c, k) => (
          <button
            type="button"
            class="ww-cat"
            data-ww-cat={c.id}
            aria-pressed={k === 0 ? 'true' : 'false'}
            aria-label={c.label}
          >{c.short}<sup class="ww-cat-n" aria-hidden="true">{k === 0 ? items.length : items.filter((it) => it.cats.includes(c.id)).length}</sup></button>
        ))}
      </div>
      <p class="sr-only" aria-live="polite" data-ww-say></p>
    </div>

    {/* the plugins: links to their pages; the script makes them the TV's channel buttons (tabs) */}
    <ul class="ww-list" role="list" data-ww-list data-reveal-group data-stagger="0.07">
      {items.map((it, i) => (
        <li class="ww-item" data-ww-item={it.slug} data-ww-cats={it.cats.join(' ')} data-reveal-item>
          <a
            class:list={['ww-row', { 'is-lit': i === 0 }]}
            href={`/${it.slug}`}
            id={`ww-tab-${it.slug}`}
            data-ww-pick={it.slug}
          >
            <span class:list={['ww-thumb', { 'is-tall': it.thumbTall }]} aria-hidden="true">
              <Image src={it.img} alt="" width={320} widths={[160, 320]} sizes="(max-width: 860px) 6rem, 10rem" format="webp" quality={80} loading="lazy" />
            </span>
            <span class="ww-rtext">
              <span class="ww-name">{it.name}</span>
              <span class="ww-type">{it.type}</span>
            </span>
            {it.price && <span class="ww-rprice">{it.price}</span>}
          </a>
        </li>
      ))}
    </ul>

    {/* the lit plugin: one panel per plugin, stacked in one cell (swapping never shifts the page) */}
    {items.map((it, i) => {
      const isDrift = it.slug === 'drift';
      // the window's width / height: the panel caps the window's width by the room's height (CSS --ww-ar)
      const media = dims(isDrift && posterCuts && wallPosterSrc ? wallPosterSrc : it.img);
      return (
        <article
          class:list={['ww-panel', { 'is-active': i === 0, 'is-portrait': it.portrait }]}
          style={`--ww-ar:${(media.width / media.height).toFixed(4)}`}
          id={`ww-ch-${it.slug}`}
          data-ww-panel={it.slug}
          aria-labelledby={`ww-pn-${it.slug}`}
          aria-hidden={i === 0 ? 'false' : 'true'}
        >
          <button type="button" class="ww-back" data-ww-back>All plugins</button>
          <figure class="ww-ui" {...(i === 0 ? { 'data-reveal': 'card' } : {})}>
            {isDrift && posterCuts && wallPosterSrc ? (
              <video
                class="ww-run"
                data-ww-run
                muted
                loop
                playsinline
                preload="none"
                disablepictureinpicture
                width={media.width}
                height={media.height}
                role="img"
                aria-label={it.alt}
              >
                <source src="/drift/wall-run-800.webm" type="video/webm" media="(max-width: 860px)" />
                <source src="/drift/wall-run-800.mp4" type="video/mp4" media="(max-width: 860px)" />
                <source src="/drift/wall-run-1440.webm" type="video/webm" />
                <source src="/drift/wall-run-1440.mp4" type="video/mp4" />
              </video>
            ) : (
              <Image
                src={it.img}
                alt={it.alt}
                width={1400}
                widths={[400, 640, 960, 1400]}
                sizes={it.portrait
                  /* a set height (24rem phones, 30rem laptop) at 1600:2380 */
                  ? '(max-width: 860px) 260px, 324px'
                  : '(max-width: 860px) 92vw, 48vw'}
                format="webp"
                quality={86}
                loading="lazy"
              />
            )}
          </figure>
          <div class="ww-info">
            <div class="ww-phead">
              <h3 class="ww-pname" id={`ww-pn-${it.slug}`} tabindex="-1">{it.name}</h3>
              <p class="ww-ptype">{it.type}</p>
            </div>
            <p class="ww-blurb">{it.blurb}</p>
            <p class="ww-pwords">
              <span class="sr-only">What it does: </span>
              {it.words.map((x, k) => (
                <Fragment><span class="ww-pw-i"><span class:list={['ww-pw', { 'is-hot': x.hot }]}>{x.w}</span>{k < it.words.length - 1 && <span class="ww-pw-dot" aria-hidden="true"> ·</span>}</span>{k < it.words.length - 1 && ' '}</Fragment>
              ))}
            </p>
            <div class="ww-buy">
              {it.price && <span class="ww-price">{it.price}</span>}
              {/* the button family (buttons.css, D9 2026-11-01): Try = brass (honey when free), Product page = ghost */}
              {it.action && (it.action.href ? (
                <a class:list={['ww-try rv-btn rv-btn--stack', it.cats.includes('free') && 'rv-btn--honey']} href={it.action.href}>
                  <span>{it.action.label}</span>
                  {it.action.sub && <span class="rv-btn__sub">{it.action.sub}</span>}
                </a>
              ) : (
                <button type="button" class:list={['ww-try rv-btn rv-btn--stack', it.cats.includes('free') && 'rv-btn--honey']} {...it.action.attrs}>
                  <span>{it.action.label}</span>
                  {it.action.sub && <span class="rv-btn__sub">{it.action.sub}</span>}
                </button>
              ))}
              <a class="ww-more rv-btn rv-btn--ghost rv-btn--sm" href={`/${it.slug}`}><span class="sr-only">{it.name} </span>Product page <span aria-hidden="true">&rarr;</span></a>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</GarageWall>

<script>
  import { lenis, DUR_ANCHOR, gsap } from '../lib/motion'; // the house scroller (null under reduced motion) + GSAP

  const wall = document.querySelector<HTMLElement>('[data-wordwall]');
  if (wall) {
    const panels = Array.from(wall.querySelectorAll<HTMLElement>('[data-ww-panel]'));
    const list = wall.querySelector<HTMLElement>('[data-ww-list]');
    const items = Array.from(wall.querySelectorAll<HTMLElement>('[data-ww-item]'));
    const rows = Array.from(wall.querySelectorAll<HTMLAnchorElement>('[data-ww-pick]'));
    const catBtns = Array.from(wall.querySelectorAll<HTMLButtonElement>('[data-ww-cat]'));
    const say = wall.querySelector<HTMLElement>('[data-ww-say]');
    const section = wall.closest<HTMLElement>('section');
    const phone = window.matchMedia('(max-width: 860px)');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const slugOf = (el: HTMLElement) => el.dataset.wwPanel ?? el.dataset.wwPick ?? el.dataset.wwItem ?? '';

    /* The TV's art, late and lean (checker S4): the frame and DRIFT's poster
       load once the page has loaded and the wall is a screen away, each in
       the smallest cut that is still pixel-sharp here (frame: the roll's
       pixels x --ww-frame-u x DPR, u read off the frame's padding; poster:
       the window's width x DPR), AVIF when this browser decodes it, else
       WebP. A cut is decoded before it goes up (no half-painted bezel) and
       never swapped for a smaller one (resize, rotate, the bench's roll
       switch only upgrade). No JS: the <noscript> style puts the top WebP up. */
    type Cut = [number, string, string, string?]; // width, avif, webp, the frame's slices in this cut's pixels
    const art = JSON.parse(wall.dataset.wwArt || '{}') as { frame?: Record<string, { w: number; cuts: Cut[] }>; poster?: Cut[] | null };
    let avifOk: Promise<boolean> | null = null;
    const avif = () => (avifOk ??= new Promise<boolean>((done) => {
      const probe = new Image(); // a 1x1 AVIF
      probe.onload = () => done(probe.naturalWidth > 0);
      probe.onerror = () => done(false);
      probe.src = 'data:image/avif;base64,';
    }));
    const pick = (cuts: Cut[], need: number) => cuts.find((c) => c[0] >= need) ?? cuts[cuts.length - 1];
    const up: Record<string, number> = {}; // the widest cut asked for, per slot
    const put = async (slot: string, c: Cut, apply: (url: string) => void) => {
      if ((up[slot] ?? 0) >= c[0]) return;
      up[slot] = c[0];
      const url = (await avif()) ? c[1] : c[2];
      const img = new Image();
      img.src = url;
      await img.decode().catch(() => {});
      if (up[slot] === c[0]) apply(url); // a wider cut asked for meanwhile wins
    };
    const frameEl = wall.querySelector<HTMLElement>('.ww-frame');
    const runEl = wall.querySelector<HTMLVideoElement>('video[data-ww-run]');
    let near = false;
    const dress = () => {
      if (!near) return;
      const dpr = window.devicePixelRatio || 1;
      // the roll on show only (the bench's roll switch asks again); u = CSS px per pixel of that roll
      const n = wall.dataset.wwFrame ?? '';
      const roll = art.frame?.[n];
      const u = frameEl ? parseFloat(getComputedStyle(frameEl).paddingLeft) / parseFloat(getComputedStyle(wall).getPropertyValue('--wf-zl')) : NaN;
      if (roll && u > 0) {
        const c = pick(roll.cuts, roll.w * u * dpr);
        put(`frame${n}`, c, (url) => {
          wall.style.setProperty(`--wf${n}-img`, `url(${url})`);
          wall.style.setProperty(`--wf${n}-sl`, c[3] ?? '');
        });
      }
      const w = runEl?.getBoundingClientRect().width ?? 0; // 0 while its panel is display:none (phones): showing it asks again
      if (runEl && art.poster && w > 0) put('poster', pick(art.poster, w * dpr), (url) => { runEl.poster = url; });
    };
    // not before the page's own load (on a phone the wall starts a quarter screen below the fold: it must not race
    // the top), the first scroll or 3 s, whichever comes first (a stalled video can hold the load event back for good)
    let watching = false;
    const watch = () => {
      if (watching) return;
      watching = true;
      new IntersectionObserver((entries, io) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        near = true;
        dress();
      }, { rootMargin: '100% 0px' }).observe(wall);
    };
    if (document.readyState === 'complete') watch();
    else {
      window.addEventListener('load', watch, { once: true });
      window.addEventListener('scroll', watch, { once: true, passive: true });
      window.setTimeout(watch, 3000);
    }
    let resized = 0;
    window.addEventListener('resize', () => { clearTimeout(resized); resized = window.setTimeout(dress, 200); });
    new MutationObserver(dress).observe(wall, { attributes: true, attributeFilter: ['data-ww-frame'] });

    /* ── The library ─────────────────────────────────────────────────────────
       State = the category (cat) + the lit plugin (lit) + on phones the view
       (the list, or the lit plugin's panel). The links become tabs: one
       tabbable at a time, arrows / Home / End move and light, a plain click
       lights instead of leaving (a modified click still opens the page). */
    let cat = 'all';
    let lit = panels.find((p) => p.classList.contains('is-active'))?.dataset.wwPanel ?? slugOf(panels[0] ?? wall);
    const catLabel = (c: string) => catBtns.find((b) => b.dataset.wwCat === c)?.getAttribute('aria-label') ?? c;
    const inCat = (li: HTMLElement, c: string) => c === 'all' || (li.dataset.wwCats ?? '').split(' ').includes(c);
    const shown = () => items.filter((li) => !li.hidden).map(slugOf);

    if (list) {
      list.setAttribute('role', 'tablist');
      list.setAttribute('aria-orientation', 'vertical');
      list.setAttribute('aria-label', 'Plugins');
      items.forEach((li) => li.setAttribute('role', 'presentation'));
      rows.forEach((a) => {
        a.setAttribute('role', 'tab');
        a.setAttribute('aria-controls', `ww-ch-${slugOf(a)}`);
      });
      panels.forEach((p) => {
        p.setAttribute('role', 'tabpanel');
        p.setAttribute('aria-labelledby', `ww-tab-${slugOf(p)}`);
      });
    }
    wall.dataset.wwLib = 'on'; // the categories + the phone's Back show from here (CSS)

    /* DRIFT's live window plays only while its panel is at rest on the glass
       (never while it comes on or leaves: it starts once seated), on screen
       (a quarter of it), the tab is visible and motion is allowed; autoplay
       refused = the poster stays. */
    let runInView = false;
    let seated = ''; // the plugin at rest on the glass ('' while the glass changes, or a phone shows its list)
    const syncRun = () => {
      if (!runEl || reduced.matches) return;
      const live = runInView && seated === 'drift' && !document.hidden;
      if (live) runEl.play().catch(() => {});
      else if (!runEl.paused) runEl.pause();
    };
    if (runEl) {
      new IntersectionObserver(([e]) => { runInView = e.isIntersecting; syncRun(); }, { threshold: 0.25 }).observe(runEl);
      document.addEventListener('visibilitychange', syncRun);
    }

    /* One screen, exactly: the window takes the height its panel's text leaves it. CSS sizes it off --ww-osd-h (the
       menu) and --ww-info-h (the panel minus its window: the Back key on phones, the text, the gaps); their CSS values
       are estimates for no JS, so the real ones are measured here, again whenever a text box changes size (the web
       font landing, a resize, a panel opening on a phone). The text's width never depends on the window, so this
       settles in one pass. */
    const osdEl = wall.querySelector<HTMLElement>('.ww-osd');
    // the layout height, to the sub-pixel: getBoundingClientRect would include the reveal's transform (the first
    // window rises in scaled), offsetHeight rounds
    const tall = (el: HTMLElement) => parseFloat(getComputedStyle(el).height) || 0;
    const fit = () => {
      // rounded UP, + 1 px: a TV one pixel taller than the screen already shifts the lock's landing
      if (osdEl?.offsetParent) wall.style.setProperty('--ww-osd-h', `${Math.ceil(tall(osdEl))}px`);
      panels.forEach((p) => {
        const fig = p.querySelector<HTMLElement>('.ww-ui');
        if (!fig || !p.offsetParent) return; // a closed panel on a phone (display:none): measured when it opens
        const rest = Math.ceil(tall(p) - tall(fig)) + 1;
        if (rest > 1) p.style.setProperty('--ww-info-h', `${rest}px`);
      });
    };
    // a text box resized (the font landing, a resize): measure next frame (writing inside the observer's own
    // delivery is what logs "ResizeObserver loop completed"); a pane opening measures at once (setView)
    let fitRaf = 0;
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(() => { cancelAnimationFrame(fitRaf); fitRaf = requestAnimationFrame(fit); });
      if (osdEl) ro.observe(osdEl);
      wall.querySelectorAll<HTMLElement>('.ww-info').forEach((el) => ro.observe(el));
    }

    /* Changing channel: motion only (the user 2026-10-18, after the static: "no noise at all, just motion"; plan
       Phase 4d), then smaller, shorter and always the same way (the user 2026-10-19, on TUNE: "appears, then slides"
       and "a different direction for each plugin" felt odd; GEAR CHANGE, each plugin along its own axis, went).
       Never two plugins on the glass: the one on it leaves first (inert from the click; the row lights at once),
       drifting a few px the way the motion runs as it fades, then the next comes on from a few px the other side.
       --ww-mv-dir: 1 = everything rises into place (the default), -1 = it comes down into place; never from the
       list's order. The picture fades and travels in ONE tween (one time, one curve), so it is solid only once it is
       in place: a fade quicker than the travel read as a solid picture sliding. The text follows in reading order,
       the same way. The last pick wins, from wherever things are: the leaver picked again comes back; another picked
       while one comes on sends that one out. Picks closer than SKIM, or a held arrow, keep the glass dark until they
       stop: only the last one comes on. The screen's colour changes as the newcomer comes on, the old glow fading
       over the new (a gradient can't transition, and a hue must never interpolate: 280 -> 26 runs through green).
       Times and distances are read off --ww-mv-* at each change (the bench's sliders, SLOW x4). Only the pictures
       and the text blocks move (never .ww-ui: the first window's reveal; never .ww-try: its hover), transform +
       opacity only, cleared at rest (transform: none, so the window lands crisp). Reduced motion: a quick fade. High
       contrast, the wood wall (its own CSS fade), a hidden tab or the wall off screen: a cut. Phones: a tap slides
       the list out left and the pane in from the right; the pane's Back key runs it backwards (the browser's own
       Back cuts: an iOS swipe already animates). */
    const LIST = ':list'; // a phone's list on the glass (anything else: a plugin's slug, its panel)
    const SKIM = 120; // ms: picks closer than this keep the glass dark
    const glowEl = wall.querySelector<HTMLElement>('.ww-screen-glow');
    const wasEl = wall.querySelector<HTMLElement>('.ww-screen-was');
    const panelOf = (s: string) => panels.find((p) => slugOf(p) === s) ?? null;
    const mediaOf = (p: HTMLElement) => p.querySelector<HTMLElement>('.ww-ui img, .ww-ui video');
    const textOf = (p: HTMLElement) => Array.from(p.querySelectorAll<HTMLElement>('.ww-phead, .ww-blurb, .ww-pwords, .ww-buy'));
    const listParts = () => [osdEl, list].filter((el): el is HTMLElement => !!el);
    // what a scene moves: its panel (an exit moves it whole) and the parts an entrance moves one by one
    const movedOf = (s: string): HTMLElement[] => {
      if (s === LIST) return listParts();
      const p = panelOf(s);
      return p ? [p, mediaOf(p), ...textOf(p), p.querySelector<HTMLElement>('.ww-back')].filter((el): el is HTMLElement => !!el) : [];
    };
    const moves = () => {
      const cs = getComputedStyle(wall);
      const n = (p: string, d: number) => {
        const v = parseFloat(cs.getPropertyValue(p));
        return Number.isFinite(v) ? v : d;
      };
      const q = reduced.matches; // a quick fade: nothing travels
      return {
        q,
        dir: Math.sign(n('--ww-mv-dir', 1)), // 1 = everything rises into place, -1 = comes down into place
        outMs: q ? 80 : n('--ww-mv-out-ms', 120),
        outPx: q ? 0 : n('--ww-mv-out-px', 4),
        px: q ? 0 : n('--ww-mv-px', 12),
        inMs: q ? 120 : n('--ww-mv-in-ms', 340),
        textPx: q ? 0 : n('--ww-mv-text-px', 6),
        textMs: q ? 120 : n('--ww-mv-text-ms', 340),
        textGap: q ? 0 : n('--ww-mv-text-gap-ms', 20),
        textAt: q ? 0 : n('--ww-mv-text-at-ms', 40),
        dip: q ? 1 : n('--ww-mv-glow-dip', 0.92),
        panePx: q ? 0 : n('--ww-mv-pane-px', 16),
        paneMs: q ? 80 : n('--ww-mv-pane-ms', 200),
      };
    };
    const sec = (ms: number) => Math.max(0, ms) / 1000; // GSAP counts seconds
    /* How much of a move fits: the share of (x, y) the picture can travel from its resting box before it would slip
       under the bezel or over the list (GAS's tall window on a 665px laptop has 16px of glass under it, not 28). */
    const room = (el: HTMLElement, x: number, y: number) => {
      const pane = wall.querySelector<HTMLElement>('.ww-frame-glass');
      const g = (pane?.offsetParent ? pane : wall.querySelector<HTMLElement>('.ww-screen'))?.getBoundingClientRect();
      if (!g) return 1;
      const r = el.getBoundingClientRect();
      const left = !phone.matches && list ? Math.max(g.left, list.getBoundingClientRect().right) : g.left;
      let k = 1;
      if (x > 0) k = Math.min(k, (g.right - r.right) / x);
      if (x < 0) k = Math.min(k, (r.left - left) / -x);
      if (y > 0) k = Math.min(k, (g.bottom - r.bottom) / y);
      if (y < 0) k = Math.min(k, (r.top - g.top) / -y);
      return Math.max(0, Math.min(1, k));
    };

    let viewWant: 'list' | 'panel' = 'list'; // a phone's view to be (data-ww-view follows as the glass changes)
    let onGlass = phone.matches ? LIST : lit; // the scene on the glass: coming on, at rest or leaving
    let stage: 'rest' | 'out' | 'gap' | 'in' = 'rest';
    let run: ReturnType<typeof gsap.timeline> | null = null; // the exit or the entrance under way
    let glowRun: ReturnType<typeof gsap.to> | null = null; // the screen's colour changing
    let glowMix = 0; // how far that change has got (0 = the old colour, 1 = the new)
    let held = false; // the old colour kept on the was layer (a change sent back near its start settled there)
    let wait = 0; // the commit's timer
    let ticket = 0; // bumped by every new plan, so a late commit knows it is stale
    let lastPick = 0;
    let holding = false; // an arrow key held down: the glass stays dark until it is let go
    let focusView = false; // the view's flip takes focus with it (a tap, the Back key, Back / Forward)
    let urlDue = false; // laptop: ?plugin= is written once the pick lands (a held arrow would write it 30 times a second)
    let backKey = false; // the pane's own Back key: the open runs backwards
    const sceneWant = () => (phone.matches && viewWant === 'list' ? LIST : lit);
    const still = () => {
      if (wall.dataset.wwBg !== 'screen' || document.hidden || document.documentElement.classList.contains('hc')) return true;
      const r = wall.getBoundingClientRect();
      return r.bottom <= 0 || r.top >= window.innerHeight;
    };
    const seat = () => {
      seated = onGlass === LIST ? '' : onGlass;
      syncRun();
    };
    // the glow back to its CSS (lit, or the power-on's)
    const calm = () => {
      glowRun?.kill();
      glowRun = null;
      glowMix = 0;
      held = false;
      glowEl?.style.removeProperty('opacity');
      wasEl?.style.removeProperty('opacity');
    };
    /* The old channel's glow over the new one, fading as the newcomer comes on, while the dip (d) comes back to 1.
       Two layers over the black tube: the old on top at b = d(1 - c), the new under it at a = dc / (1 - b), so the
       light is always d x (old (1 - c) + new c): a straight cross-fade, never a jump. Called before data-ww-on
       flips, while the glow still shows the old channel (or the was layer does: held, see leave()). */
    const glowTo = (ms: number) => {
      if (!glowEl || !wasEl) return;
      glowRun?.progress(1);
      const cs = getComputedStyle(held ? wasEl : glowEl);
      const d0 = parseFloat(cs.opacity);
      if (!held) wasEl.style.backgroundImage = cs.backgroundImage;
      held = false;
      const k = { c: 0, d: Number.isFinite(d0) ? d0 : 1 };
      const paint = () => {
        glowMix = k.c;
        const b = k.d * (1 - k.c);
        wasEl.style.opacity = String(b);
        glowEl.style.opacity = String(b < 1 ? (k.d * k.c) / (1 - b) : 0);
      };
      paint();
      glowRun = gsap.to(k, { c: 1, d: 1, duration: sec(ms), ease: 'power1.inOut', onUpdate: paint, onComplete: calm });
    };

    // the glass's DOM as the pick wants it: the lit plugin's panel up (the rest hidden), its colour, a phone's view
    const apply = () => {
      panels.forEach((p) => {
        const on = slugOf(p) === lit;
        p.classList.toggle('is-active', on);
        p.classList.remove('is-leaving');
        p.inert = false;
        p.setAttribute('aria-hidden', on ? 'false' : 'true');
      });
      wall.dataset.wwOn = lit;
      const v = phone.matches ? viewWant : 'list';
      if (wall.dataset.wwView !== v) setView(v, focusView);
      focusView = false;
      onGlass = sceneWant();
      dress();
      if (urlDue && !phone.matches) writeUrl('replace');
      urlDue = false;
    };
    // no motion: everything at rest and the DOM as wanted, at once
    const cut = () => {
      clearTimeout(wait);
      ticket++;
      glStop();
      run?.kill();
      run = null;
      gsap.set([...listParts(), ...panels.flatMap((p) => movedOf(slugOf(p)))], { clearProps: 'transform,opacity' });
      calm();
      apply();
      stage = 'rest';
      seat();
    };
    // take the glass to what is wanted now, from wherever it is
    const go = (move: boolean) => {
      if (!move || still()) { cut(); return; }
      const want = sceneWant();
      if (stage === 'rest' || stage === 'in') {
        if (want === onGlass) apply(); // same scene (a phone's list: a tab lit by key): the DOM only
        else leave(stage === 'in');
        return;
      }
      if (want === onGlass) back(); // out / gap: the leaver picked again comes back
      else plan(); // anything else lands once the glass is free
    };
    // the scene on the glass goes; one still coming on stops where it is and leaves from there, quicker
    const leave = (quick: boolean) => {
      const m = moves();
      const s = onGlass;
      const p = s === LIST ? null : panelOf(s);
      glStop(); // a glitch never outlives its scene
      run?.kill();
      stage = 'out';
      seated = '';
      syncRun();
      if (p) {
        p.classList.add('is-leaving');
        p.inert = true;
      }
      const opening = s === LIST; // a phone's list making way for a pane: out to the left
      const closing = phone.matches && sceneWant() === LIST; // a phone's pane going back: out to the right
      const ms = opening || closing ? m.paneMs : quick ? Math.min(m.outMs, 160) : m.outMs;
      const to = opening ? { x: -m.panePx / 2 } : closing ? { x: m.panePx } : { y: -m.dir * m.outPx };
      run = gsap.timeline({ onComplete: left });
      run.to(p ? [p] : listParts(), { opacity: 0, ...to, duration: sec(ms), ease: 'power2.in' }, 0);
      // the tube dims while the glass empties (a phone's list / pane swap keeps it lit). Skimming never strobes it:
      // picks under SKIM never land, so this runs once per landed change at most
      const dim = opening || closing ? 1 : m.dip;
      if (glowRun && glowEl && wasEl) {
        // sent back while its colour is still changing: the colour settles on the nearer of the two as it goes (the
        // new one when a phone's pane closes: that plugin stays lit), so it moves as little as it can and the next
        // change starts from one colour (cutting the change short would jump it in a frame)
        const keepNew = opening || closing || glowMix >= 0.5;
        glowRun.kill();
        glowRun = null;
        held = !keepNew;
        run.to(keepNew ? wasEl : glowEl, { opacity: 0, duration: sec(ms), ease: 'power1.inOut' }, 0);
        run.to(keepNew ? glowEl : wasEl, { opacity: dim, duration: sec(ms), ease: 'power1.inOut' }, 0);
      } else if (glowEl && dim < 1) run.to(glowEl, { opacity: dim, duration: sec(ms), ease: 'power1.inOut' }, 0);
    };
    // the glass is empty
    const left = () => {
      run = null;
      stage = 'gap';
      if (onGlass === 'drift' && runEl) {
        runEl.pause();
        try { runEl.currentTime = 0; } catch (e) { /* not loaded: it starts at 0 anyway */ }
      }
      plan();
    };
    // land the pick once the glass is free, the picks have stopped (SKIM) and no arrow is held
    const plan = () => {
      clearTimeout(wait);
      const t = ++ticket;
      if (stage !== 'gap' || holding) return; // the exit's end, or the key's release, asks again
      const now = performance.now();
      wait = window.setTimeout(() => { void commit(t); }, Math.max(0, lastPick + SKIM - now));
    };
    const commit = async (t: number) => {
      if (t !== ticket || stage !== 'gap') return;
      if (sceneWant() === onGlass) { back(); return; }
      // the newcomer's window decoded first (a moment at most): a picture never comes on half painted
      const np = sceneWant() === LIST ? null : panelOf(lit);
      const img = np ? mediaOf(np) : null;
      if (img instanceof HTMLImageElement) {
        img.loading = 'eager';
        await Promise.race([img.decode().catch(() => {}), new Promise((r) => window.setTimeout(r, 150))]);
        if (t !== ticket || stage !== 'gap') return; // a newer pick took over meanwhile
      }
      enter();
    };
    /* The next scene comes on: its start pose set, then the DOM flipped, in one task (its first frame already
       shows the pose), then it travels in. Each part travels FROM its pose to its own CSS (the blurb and the words
       rest dimmer than 1), so clearing it at rest changes nothing. The old scene, hidden by the flip, goes back to
       rest for next time. */
    const enter = () => {
      const m = moves();
      const from = onGlass;
      const s = sceneWant();
      const p = s === LIST ? null : panelOf(s);
      stage = 'in';
      // the colour lands with the picture; held: an old colour still on the was layer cross-fades too, never cut
      if (wall.dataset.wwOn !== lit || held) glowTo(m.inMs);
      const tl = gsap.timeline({ onComplete: landed });
      if (!p) {
        // a phone's list coming back: in from the left
        tl.from(listParts(), { opacity: 0, x: -m.panePx / 2, duration: sec(m.textMs), ease: 'power3.out', stagger: sec(m.textGap) }, 0);
      } else {
        const media = mediaOf(p);
        const text = textOf(p);
        const back = phone.matches ? p.querySelector<HTMLElement>('.ww-back') : null;
        if (back) tl.from(back, { opacity: 0, duration: sec(m.textMs), ease: 'power1.out' }, 0); // fades in where it is
        if (phone.matches && from === LIST) {
          // a phone's pane opening: in from the right, the picture first, the text after it
          const parts = [media, ...text].filter((el): el is HTMLElement => !!el);
          tl.from(parts, { opacity: 0, x: m.panePx, duration: sec(m.textMs), ease: 'power3.out', stagger: sec(m.textGap) }, 0);
        } else {
          // the picture fades and travels as one tween (one time, one curve): solid only once it is in place
          if (media) tl.from(media, { opacity: 0, y: m.dir * m.px * room(media, 0, m.dir * m.px), duration: sec(m.inMs), ease: 'power3.out' }, 0);
          if (text.length) tl.from(text, { opacity: 0, y: m.dir * m.textPx, duration: sec(m.textMs), ease: 'power3.out', stagger: sec(m.textGap) }, sec(m.textAt));
        }
      }
      apply();
      const gone = movedOf(from);
      if (gone.length) gsap.set(gone, { clearProps: 'transform,opacity' });
      run = tl;
    };
    // landed: back to plain CSS (transform: none, so the window rests crisp); DRIFT's run may start
    const rest = () => {
      run = null;
      stage = 'rest';
      const here = movedOf(onGlass);
      if (here.length) gsap.set(here, { clearProps: 'transform,opacity' });
      if (!glowRun) calm();
      seat();
    };
    // the leaver picked again: it comes back from wherever it got to
    const back = () => {
      clearTimeout(wait);
      ticket++;
      run?.kill();
      const m = moves();
      const p = onGlass === LIST ? null : panelOf(onGlass);
      if (p) {
        p.classList.remove('is-leaving');
        p.inert = false;
      }
      stage = 'in';
      run = gsap.timeline({ onComplete: rest });
      // home = its own CSS: the inline opacity set aside for a moment to read it (the blurb rests at .92, not 1)
      const home = (_: number, el: HTMLElement) => {
        const v = el.style.opacity;
        el.style.opacity = '';
        const o = getComputedStyle(el).opacity;
        el.style.opacity = v;
        return o;
      };
      run.to(movedOf(onGlass), { opacity: home, x: 0, y: 0, duration: sec(m.textMs), ease: 'power3.out' }, 0);
      if (glowEl && !glowRun) {
        held = false; // its own colour comes back
        run.to(glowEl, { opacity: 1, duration: sec(m.textMs), ease: 'power1.inOut' }, 0);
        if (wasEl?.style.opacity) run.to(wasEl, { opacity: 0, duration: sec(m.textMs), ease: 'power1.inOut' }, 0); // an old colour still on
      }
    };
    // every plugin's window fetched and decoded after the power-on (laptops; a phone fetches one as it opens), the
    // lit one's neighbours first, so a change never waits on the network
    const warm = () => {
      if (phone.matches) return;
      const s = shown();
      const k = s.indexOf(lit);
      panels
        .map((p) => ({ p, d: Math.abs(s.indexOf(slugOf(p)) - k) }))
        .sort((a, b) => a.d - b.d)
        .forEach(({ p }) => {
          const img = mediaOf(p);
          if (!(img instanceof HTMLImageElement)) return;
          img.loading = 'eager';
          img.decode().catch(() => {});
        });
    };
    // an arrow let go (or the window left): the glass may land the last pick
    const release = () => {
      if (!holding) return;
      holding = false;
      plan();
    };
    window.addEventListener('keyup', release);
    window.addEventListener('blur', release);

    /* ── Glitches: the old set's own small faults, now and then ─────────────
       The user 2026-10-19: "a small glitch now and then, on certain elements, at random, to show it's alive", and
       "also during the channel change". One at a time, a random --ww-gl-min-s to --ww-gl-max-s apart, and only once
       the TV has been left alone for --ww-gl-idle-s (no pointer, finger, key or wheel on it): an unlit name jumps a
       few px with a red / cyan fringe (the house glitch of DRIFT's creators, far smaller), a band of the lit plugin's
       picture tears sideways (a canvas over it copies the picture's own pixels, DRIFT's run included; a picture with
       nothing to copy yet jolts whole), or the whole screen flickers / rolls a band of light down the glass (under
       the text, like the lines). Never on what is read (the blurb, the price, the keys, the links, the menu, the lit
       name), never on what the pointer is on or the focus is in; touching the TV stops one at once. A channel change
       lands with a short tear now and then (--ww-gl-chg-chance), once its picture is in place: the change's motion
       never changes, and the next pick stops it. Stepped, translate + filter only (never transform or opacity: the
       motion's), nothing left behind. No noise, no snow (2026-10-18). Off under reduced motion, high contrast, the
       wood wall, a hidden tab, the TV off screen and before its power-on, and the wait starts over once it is on
       show again (a visitor gliding in gets the full wait, never one as the tube lights). The times are read when
       they come due (the bench's sliders take within 2 s). */
    const RED = '#ff0033';
    const CYAN = '#00e5ff';
    const fxEl = wall.querySelector<HTMLElement>('.ww-screen-fx');
    const tubeEl = wall.querySelector<HTMLElement>('.ww-screen');
    const glN = (p: string, d: number) => {
      const v = parseFloat(getComputedStyle(wall).getPropertyValue(p));
      return Number.isFinite(v) ? v : d;
    };
    let glOff: (() => void) | null = null; // the glitch on the glass: undoes it at once
    let glIdle = false; // ...and it came by itself (touching the TV stops it; a change's tear plays out)
    let glTouched = -Infinity; // the last time the TV was touched
    let glFrom = performance.now(); // when this wait began...
    let glU = Math.random(); // ...and where between the shortest and the longest it ends
    const glShown = () => !reduced.matches && !still() && wall.dataset.wwPower === 'on'; // on show, its tube lit
    const glOk = () => glShown() && stage === 'rest';
    const glStop = () => {
      const off = glOff;
      glOff = null;
      glIdle = false;
      off?.();
    };
    // one glitch: `start` puts it up and returns its undo; it ends by itself after ms
    const glPlay = (kind: string, ms: number, idle: boolean, start: () => () => void) => {
      glStop();
      const undo = start();
      wall.dataset.wwGl = kind;
      const end = window.setTimeout(() => { if (glOff === off) glStop(); }, ms);
      const off = () => {
        clearTimeout(end);
        undo();
        delete wall.dataset.wwGl;
      };
      glOff = off;
      glIdle = idle;
    };
    // a few px sideways and back in three steps, a red then a cyan fringe over its own filter (a name; a picture
    // with nothing to copy)
    const glJump = (el: HTMLElement, px: number, ms: number) => {
      const f = getComputedStyle(el).filter;
      const own = f === 'none' ? '' : `${f} `;
      const step = 'steps(1, end)';
      const a = el.animate([
        { translate: `${px}px 0px`, filter: `${own}drop-shadow(${-px}px 0px 0px ${RED})`, easing: step },
        { offset: 0.4, translate: `${-0.6 * px}px 0px`, filter: `${own}drop-shadow(${px}px 0px 0px ${CYAN})`, easing: step },
        { offset: 0.75, translate: `${0.3 * px}px 0px`, filter: f, easing: step },
        { translate: '0px 0px', filter: f },
      ], { duration: ms, id: 'ww-gl' });
      return () => a.cancel();
    };
    // the picture has pixels to copy (DRIFT's run: once a frame is up)
    const glCopy = (m: HTMLImageElement | HTMLVideoElement) =>
      m instanceof HTMLVideoElement ? m.readyState >= 2 && m.videoWidth > 0 : m.complete && m.naturalWidth > 0;
    // a band or two of the picture torn sideways and tinted, three or four steps, on a canvas laid over it (the
    // picture itself is never touched); the canvas is emptied, unsized and hidden after
    let tearEl: HTMLCanvasElement | null = null;
    const glTear = (m: HTMLImageElement | HTMLVideoElement, px: number, ms: number) => {
      let t = 0;
      let live = true;
      const c = tearEl ?? (tearEl = document.createElement('canvas'));
      const undo = () => {
        live = false;
        clearTimeout(t);
        c.width = 0; // frees the pixels
        c.height = 0;
        c.removeAttribute('style');
        c.hidden = true;
      };
      if (!c.isConnected) {
        c.className = 'ww-gl-tear';
        c.setAttribute('aria-hidden', 'true');
        wall.append(c);
      }
      c.hidden = false;
      const box = c.offsetParent as HTMLElement | null; // .gw-inner
      const ctx = c.getContext('2d');
      const r = m.getBoundingClientRect();
      const nw = m instanceof HTMLVideoElement ? m.videoWidth : m.naturalWidth;
      const nh = m instanceof HTMLVideoElement ? m.videoHeight : m.naturalHeight;
      if (!box || !ctx || !r.width || !r.height || !nw || !nh) { undo(); return undo; }
      // laid exactly over the picture, in the box's own px (k: an ancestor's scale, if any)
      const b = box.getBoundingClientRect();
      const k = b.width / box.offsetWidth || 1;
      const w = r.width / k;
      const h = r.height / k;
      c.style.left = `${(r.left - b.left) / k - box.clientLeft}px`;
      c.style.top = `${(r.top - b.top) / k - box.clientTop}px`;
      c.style.width = `${w}px`;
      c.style.height = `${h}px`;
      c.style.borderRadius = getComputedStyle(m).borderRadius;
      const dpr = window.devicePixelRatio || 1;
      c.width = Math.max(1, Math.round(r.width * dpr));
      c.height = Math.max(1, Math.round(r.height * dpr));
      ctx.setTransform(c.width / w, 0, 0, c.height / h, 0, 0); // drawn in CSS px
      // the picture's px under the canvas: object-fit fill / cover / contain, centred
      const fit = getComputedStyle(m).objectFit;
      const s = fit === 'cover' ? Math.max(w / nw, h / nh) : fit === 'contain' || fit === 'scale-down' ? Math.min(w / nw, h / nh) : 0;
      const kx = s || w / nw;
      const ky = s || h / nh;
      const ox = (w - nw * kx) / 2;
      const oy = (h - nh * ky) / 2;
      const band = (y: number, bh: number, dx: number, tint: string) => {
        const x0 = Math.max(0, -ox / kx);
        const x1 = Math.min(nw, (w - ox) / kx);
        const y0 = Math.max(0, (y - oy) / ky);
        const y1 = Math.min(nh, (y + bh - oy) / ky);
        if (x1 <= x0 || y1 <= y0) return;
        ctx.drawImage(m, x0, y0, x1 - x0, y1 - y0, ox + x0 * kx + dx, oy + y0 * ky, (x1 - x0) * kx, (y1 - y0) * ky);
        ctx.globalCompositeOperation = 'source-atop'; // the tint on the torn band only
        ctx.fillStyle = tint;
        ctx.fillRect(0, y, w, bh);
        ctx.globalCompositeOperation = 'source-over';
      };
      const steps = Math.random() < 0.5 ? 3 : 4;
      let i = 0;
      const frame = () => {
        if (!live) return;
        ctx.clearRect(0, 0, w, h);
        try {
          const n = Math.random() < 0.35 ? 2 : 1;
          for (let j = 0; j < n; j++) {
            const bh = h * (0.03 + Math.random() * 0.09);
            const dx = (Math.random() < 0.5 ? -1 : 1) * px * (1 + Math.random() * 1.5);
            band(Math.random() * (h - bh), bh, dx, (i + j) % 2 ? 'rgba(0, 229, 255, 0.14)' : 'rgba(255, 0, 51, 0.14)');
          }
        } catch (e) { undo(); return; } // nothing to copy after all (a broken picture): no glitch
        if (++i < steps) t = window.setTimeout(frame, ms / steps);
      };
      frame();
      return undo;
    };
    // the whole screen: one small dip of the light over everything...
    const glFlicker = (ms: number) => {
      const a = fxEl?.animate([
        { backgroundColor: 'rgba(0, 0, 0, 0.06)', easing: 'steps(1, end)' },
        { backgroundColor: 'rgba(0, 0, 0, 0)' },
      ], { duration: ms, id: 'ww-gl' });
      return () => a?.cancel();
    };
    // ...or a soft band of light rolling down the glass once, under the text (CSS: .ww-gl-roll)
    const glRoll = (ms: number) => {
      tubeEl?.style.setProperty('--ww-gl-roll-dur', `${ms}ms`);
      tubeEl?.classList.add('ww-gl-roll');
      return () => {
        tubeEl?.classList.remove('ww-gl-roll');
        tubeEl?.style.removeProperty('--ww-gl-roll-dur');
      };
    };
    // what may glitch now: the unlit names on show the pointer is not on and the focus is not in; the plugin's
    // picture at rest on the glass, unless the pointer is on it
    const glNames = () => rows
      .filter((a) => !a.classList.contains('is-lit') && !(a.parentElement as HTMLElement).hidden && a.getClientRects().length > 0 && !a.matches(':hover, :focus-within'))
      .map((a) => a.querySelector<HTMLElement>('.ww-name'))
      .filter((el): el is HTMLElement => !!el);
    const glPic = () => {
      const p = onGlass === LIST ? null : panelOf(onGlass);
      const m = p ? mediaOf(p) : null;
      return (m instanceof HTMLImageElement || m instanceof HTMLVideoElement) && m.getClientRects().length > 0 && !m.matches(':hover') ? m : null;
    };
    // one glitch now: 'name', 'picture', 'screen' (a flicker or a roll), 'flicker' or 'roll'
    const glitch = (kind: string, idle: boolean) => {
      const px = Math.max(0, glN('--ww-gl-px', 3));
      const ms = Math.max(16, glN('--ww-gl-ms', 150));
      if (kind === 'name') {
        const names = glNames();
        const el = names[Math.floor(Math.random() * names.length)];
        if (el) glPlay('name', ms, idle, () => glJump(el, px, ms));
      } else if (kind === 'picture') {
        const m = glPic();
        if (m && glCopy(m)) glPlay('tear', ms, idle, () => glTear(m, px, ms));
        else if (m) glPlay('jolt', ms, idle, () => glJump(m, px, ms));
      } else if (kind === 'roll' || (kind === 'screen' && Math.random() < 0.5)) {
        const rms = Math.max(16, glN('--ww-gl-roll-ms', 900));
        glPlay('roll', rms, idle, () => glRoll(rms));
      } else if (kind === 'screen' || kind === 'flicker') glPlay('flicker', ms, idle, () => glFlicker(ms));
    };
    // by itself: what is on show decides (a phone's list: a name or the screen; its plugin: the picture or the screen)
    const glPick = () => {
      const kinds = ['screen'];
      if (glNames().length) kinds.push('name');
      if (glPic()) kinds.push('picture');
      return kinds[Math.floor(Math.random() * kinds.length)];
    };
    const glDue = () => {
      const min = Math.max(0, glN('--ww-gl-min-s', 12));
      const max = Math.max(min, glN('--ww-gl-max-s', 25));
      return Math.max(glFrom + (min + glU * (max - min)) * 1000, glTouched + Math.max(0, glN('--ww-gl-idle-s', 4)) * 1000);
    };
    let glAway = true; // not on show at the last look: the wait starts over once it is
    const glTick = () => {
      try {
        const shown = glShown();
        if (!shown || glAway) {
          glAway = !shown;
          glFrom = performance.now();
          glU = Math.random();
          return;
        }
        if (performance.now() < glDue()) return;
        glFrom = performance.now();
        glU = Math.random();
        if (!glOff && glOk()) glitch(glPick(), true);
      } finally {
        window.setTimeout(glTick, Math.min(2000, Math.max(50, glDue() - performance.now())));
      }
    };
    window.setTimeout(glTick, 2000);
    const glTouch = () => {
      glTouched = performance.now();
      if (glIdle) glStop();
    };
    ['pointerdown', 'pointermove', 'touchstart', 'wheel', 'keydown', 'focusin'].forEach((t) => wall.addEventListener(t, glTouch, { passive: true }));
    // a change landed: now and then its picture locks in with a short tear (never while it travels)
    const landed = () => {
      rest();
      if (onGlass !== LIST && glOk() && Math.random() < glN('--ww-gl-chg-chance', 0.33)) glitch('picture', false);
    };

    // light a plugin: its tab at once, then the glass (go): the move there, or a cut (move false)
    const light = (slug: string, move = true) => {
      const next = panelOf(slug);
      if (!next) return;
      const was = lit;
      lit = slug;
      rows.forEach((a) => {
        const on = slugOf(a) === slug;
        a.classList.toggle('is-lit', on);
        a.setAttribute('aria-selected', on ? 'true' : 'false');
        a.tabIndex = on ? 0 : -1;
      });
      if (slug === was) return;
      const img = mediaOf(next);
      if (img instanceof HTMLImageElement) img.loading = 'eager'; // its window on its way while the old one leaves
      lastPick = performance.now();
      go(move);
    };
    light(lit, false); // the tabs' starting state

    // pick a category: its plugins stay (one after another), the lit one stays if it is in it, else the first lights
    const setCat = (c: string, announce = true, move = announce) => {
      if (!catBtns.some((b) => b.dataset.wwCat === c)) c = 'all';
      const changed = c !== cat;
      cat = c;
      catBtns.forEach((b) => b.setAttribute('aria-pressed', b.dataset.wwCat === c ? 'true' : 'false'));
      let k = 0;
      items.forEach((li) => {
        li.hidden = !inCat(li, c);
        if (!li.hidden) li.style.setProperty('--k', String(k++));
      });
      if (changed && list && !reduced.matches) {
        list.classList.remove('is-swapping');
        void list.offsetWidth; // restart the stagger
        list.classList.add('is-swapping');
      }
      const on = shown();
      if (!on.includes(lit) && on[0]) light(on[0], move);
      if (changed && announce && say) say.textContent = `${catLabel(c)}: ${on.length} ${on.length === 1 ? 'plugin' : 'plugins'}`;
    };

    // phones: one pane at a time
    const setView = (v: 'list' | 'panel', focus = false) => {
      wall.dataset.wwView = v;
      if (v === 'panel') {
        fit(); // before the first paint of the pane, so its window never jumps
        dress();
        if (focus) panels.find((p) => slugOf(p) === lit)?.querySelector<HTMLElement>('.ww-pname')?.focus({ preventScroll: true });
      } else if (focus) {
        rows.find((a) => slugOf(a) === lit)?.focus({ preventScroll: true });
      }
      syncRun();
    };

    /* URL: ?cat= (one history entry per category) + ?plugin= (the current
       entry); on phones the open panel is its own entry (history.state). The
       rest of the address is kept: utm / gclid (the cart reads them at load),
       the trial gate's #dl= return link. */
    const P_CAT = 'cat';
    const P_PLUGIN = 'plugin';
    const writeUrl = (how: 'push' | 'replace', view: 'list' | 'panel' = 'list') => {
      const u = new URL(window.location.href);
      if (cat === 'all') u.searchParams.delete(P_CAT);
      else u.searchParams.set(P_CAT, cat);
      u.searchParams.set(P_PLUGIN, lit);
      const state = { ...(history.state ?? {}), wwView: view };
      if (how === 'push') history.pushState(state, '', u);
      else history.replaceState(state, '', u);
    };
    // nav = Back / Forward (announce, move focus with the view); move = the glass may move there
    const fromUrl = (nav: boolean, move = nav) => {
      const q = new URLSearchParams(window.location.search);
      viewWant = phone.matches && history.state?.wwView === 'panel' ? 'panel' : 'list'; // first: one go covers both
      focusView = nav && viewWant !== wall.dataset.wwView; // focus follows the pane that opened
      const mv = move && (!phone.matches || backKey); // a phone moves on its own Back key only (the rest cuts)
      backKey = false;
      setCat(q.get(P_CAT) ?? 'all', nav, mv);
      const want = q.get(P_PLUGIN);
      if (want && shown().includes(want)) light(want, mv);
      go(mv);
    };
    fromUrl(false);
    // a browser that already animated the Back (an iOS swipe) gets a cut
    window.addEventListener('popstate', (e) => fromUrl(true, !(e as PopStateEvent & { hasUAVisualTransition?: boolean }).hasUAVisualTransition));

    catBtns.forEach((b) => b.addEventListener('click', () => {
      const c = b.dataset.wwCat ?? 'all';
      if (c === cat) return;
      setCat(c);
      writeUrl('push');
    }));

    list?.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest<HTMLAnchorElement>('[data-ww-pick]');
      if (!a || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      const slug = slugOf(a);
      if (phone.matches) {
        // the pane opens: the list slides out, then the plugin comes on
        viewWant = 'panel';
        focusView = true;
        light(slug);
        writeUrl('push', 'panel');
        go(true); // the lit one tapped again opens too
      } else {
        urlDue = true;
        light(slug);
      }
    });
    list?.addEventListener('keydown', (e) => {
      const a = (e.target as Element | null)?.closest<HTMLAnchorElement>('[data-ww-pick]');
      if (!a) return;
      if (e.key === ' ') { e.preventDefault(); a.click(); return; } // a tab answers Space like Enter
      const on = rows.filter((r) => !(r.parentElement as HTMLElement).hidden);
      const k = on.indexOf(a);
      let n = -1;
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') n = (k + 1) % on.length;
      else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') n = (k - 1 + on.length) % on.length;
      else if (e.key === 'Home') n = 0;
      else if (e.key === 'End') n = on.length - 1;
      if (n < 0 || !on[n]) return;
      e.preventDefault();
      if (e.repeat) holding = true; // held: the glass stays dark, the key's release lands the last one
      urlDue = !phone.matches;
      light(slugOf(on[n]));
      on[n].focus();
    });
    wall.querySelectorAll<HTMLButtonElement>('[data-ww-back]').forEach((b) => b.addEventListener('click', () => {
      if (history.state?.wwView === 'panel') {
        backKey = true; // popstate lands the list, the open run backwards
        history.back();
      } else {
        viewWant = 'list';
        focusView = true;
        go(true);
        writeUrl('replace');
      }
    }));
    // rotating a tablet across the breakpoint: the desktop shows both panes, the phone the list
    phone.addEventListener('change', () => {
      if (!phone.matches) viewWant = 'list';
      cut();
    });

    /* The scroll that parks the TV exactly under the nav, given the TV's
       distance from that line: a whole pixel, rounded up. WebKit drops a
       fractional scroll's fraction, which left a 1px strip of the page above
       showing; up, the TV's top edge tucks <1px under the nav's hairline. */
    const landY = (off: number) => Math.ceil(window.scrollY + off);

    /* Links to the TV on the TV's own page (home's closing CTA "/#plugins"; on /plugins, the
       header's PLUGINS, the footer, the cart's "Explore the plugins") glide to the TV instead of
       navigating: with ?cat= in the address the link would load the page
       again, and the browser's own jump would fire popstate (a channel change).
       Lenis listens on window and ignores preventDefault, so the click stops
       here and this glide is the only one (no Lenis = reduced motion = a
       jump). It lands where the lock lands, on the same whole pixel (another
       page's link lands by #plugins' scroll-margin-top, CSS). Lenis glides
       from its own copy of the scroll, and when frames starve (5 fps in a
       headless WebKit) that copy can miss a native jump: the glide then went
       to the wrong place, or nowhere when Lenis thought it was there already.
       So the copy is synced first and the target is read off the page's real
       scroll. Focus moves into the TV, as the browser's own jump would have
       moved it. */
    document.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest('a[href="/#plugins"], a[href="/plugins"]');
      // "/plugins" from home is a real page change (the plugins page has no hero)
      if (a?.getAttribute('href') === '/plugins' && location.pathname.replace(/\/$/, '') !== '/plugins') return;
      if (!a || !section || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      e.stopPropagation();
      a.closest('dialog')?.close(); // the cart drawer
      if (history.state?.wwView === 'panel') history.back(); // a phone's open plugin: back to the list (popstate)
      const nav = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--site-nav-h')) || 44;
      const y = landY(section.getBoundingClientRect().top - nav);
      if (lenis) {
        if (lenis.isScrolling !== 'smooth') lenis.scrollTo(window.scrollY, { immediate: true }); // sync, no move
        lenis.scrollTo(y, { duration: DUR_ANCHOR, easing: (t: number) => 1 - Math.pow(1 - t, 4) });
      } else window.scrollTo(0, y);
      wall.querySelector<HTMLElement>('.ww-tag')?.focus({ preventScroll: true });
    });

    /* Power-on: the first time the TV comes into view the tube lights from a
       line (a CRT turn-on) and the pilot LED with it: motion as feedback to
       arriving. Only JS arms it, so no JS / reduced motion = lit at rest. */
    const powerOn = () => {
      if (reduced.matches) { wall.dataset.wwPower = 'on'; return; }
      wall.dataset.wwPower = 'armed';
      void wall.offsetWidth; // restart the keyframes on a replay
      wall.dataset.wwPower = 'powering';
      window.setTimeout(() => (wall.dataset.wwPower = 'on'), 750);
    };
    if (!reduced.matches) {
      wall.dataset.wwPower = 'armed';
      // same line as the reveal lib's trigger (top 80%)
      new IntersectionObserver(([e], io) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        window.setTimeout(powerOn, 120);
        window.setTimeout(warm, 1200); // the other windows, once the tube is lit
      }, { rootMargin: '0px 0px -20% 0px' }).observe(wall);
    }

    // bench hooks (harmless in production): light a plugin / pick a category / open a phone's pane / replay the
    // power-on / one glitch now (name, picture, screen, flicker, roll; at rest, motion allowed)
    wall.addEventListener('ww:select', (e) => {
      const d = (e as CustomEvent<{ slug?: string; cat?: string; view?: 'list' | 'panel' }>).detail ?? {};
      if (d.view) viewWant = d.view; // first: one go covers both
      if (d.cat) setCat(d.cat);
      if (d.slug) { if (!shown().includes(d.slug)) setCat('all'); light(d.slug); }
      go(true);
    });
    wall.addEventListener('ww:replay', powerOn);
    wall.addEventListener('ww:glitch', (e) => {
      const kind = (e as CustomEvent<{ kind?: string }>).detail?.kind;
      if (kind && glOk()) glitch(kind, false);
    });

    /* One screen: lock the scroll onto the TV (Dan 2026-10-14). Only after the
       visitor's own scrolling (wheel, a finger that moved, scroll keys; never a
       script's scrollTo, an anchor jump or the bench), once it has gone idle
       and no finger is down; only when the TV fits the screen, and only when
       its top stopped within --ww-snap-zone % of the screen from the nav. The
       target is worked out then, never cached. Lenis glides it there; under
       reduced motion there is no Lenis and no lock. */
    if (section) {
      let armed = false;
      let touching = false;
      let idle = 0;
      let startY = 0; // scrollY when this gesture began
      const trySnap = () => {
        if (touching) return; // touchend asks again
        // Lenis is still gliding (a slow frame rate can outlast the 160 ms idle): not idle yet, ask again
        if (lenis?.isScrolling === 'smooth') { later(); return; }
        armed = false;
        if (!lenis || wall.dataset.wwBg !== 'screen' || document.documentElement.classList.contains('hc')) return;
        // the page itself did not move: a sideways swipe, Space on a button, a wheel inside an open drawer
        const moved = window.scrollY - startY;
        if (Math.abs(moved) < 1 || document.querySelector('dialog[open]')) return;
        const nav = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--site-nav-h')) || 44;
        const r = section.getBoundingClientRect();
        if (r.height > window.innerHeight - nav + 2) return; // taller than the screen: nothing to land
        const off = r.top - nav; // 0 = the TV sits exactly under the nav
        const pct = parseFloat(getComputedStyle(wall).getPropertyValue('--ww-snap-zone')); // 0 = never
        const zone = ((Number.isFinite(pct) ? pct : 30) / 100) * window.innerHeight;
        if (Math.abs(off) < 1 || Math.abs(off) > zone) return;
        // never pull back against the visitor: land only when this gesture brought the TV closer to the line
        if (Math.abs(off) >= Math.abs(off + moved)) return;
        lenis.scrollTo(landY(off), { duration: 0.55, easing: (t: number) => 1 - Math.pow(1 - t, 4) });
      };
      const later = () => {
        clearTimeout(idle);
        idle = window.setTimeout(trySnap, 160);
      };
      const begin = () => {
        if (armed) return;
        armed = true;
        startY = window.scrollY;
      };
      const arm = () => {
        begin();
        later();
      };
      const SCROLL_KEYS = new Set(['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', ' ', 'Home', 'End']);
      window.addEventListener('wheel', arm, { passive: true });
      window.addEventListener('touchstart', () => { touching = true; }, { passive: true });
      window.addEventListener('touchmove', begin, { passive: true }); // a tap alone never locks
      const lift = () => { touching = false; if (armed) later(); };
      window.addEventListener('touchend', lift, { passive: true });
      window.addEventListener('touchcancel', lift, { passive: true });
      window.addEventListener('keydown', (e) => {
        const t = e.target as HTMLElement | null;
        if (SCROLL_KEYS.has(e.key) && !t?.closest('input, textarea, select, [contenteditable], [role="tab"]')) arm();
      });
      // a smooth wheel or a flick keeps scrolling after the input stops: wait it out
      window.addEventListener('scroll', () => { if (armed) later(); }, { passive: true });
    }
  }
</script>

<style>
  /* ==========================================================================
     LAYOUT. Laptop: the menu across the top of the screen, the plugins left,
     the lit plugin right. The panels share one grid cell, so swapping never
     shifts the sections below. Phones: further down.
     ========================================================================== */
  .ww {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 4vw, 2.5rem);
    --ww-list-share: 46;  /* the plugins' share of the screen's width, % (laptop) */
    --ww-name-max: 5.5;   /* rem: the biggest a plugin name gets */
    --ww-thumb-w: 9.8;    /* rem: the thumbnail's width in the list */
    --ww-dim: 1;          /* the unlit names and thumbnails: how much they show */
    --ww-row-gap: clamp(0.9rem, 2.4vh, 1.75rem);
    display: grid;
    grid-template-columns: minmax(0, calc(var(--ww-list-share) * 1%)) minmax(0, 1fr);
    grid-template-areas: 'osd osd' 'list panel';
    column-gap: clamp(1.5rem, 4vw, 4rem);
    row-gap: var(--ww-row-gap);
    align-items: center;
  }
  .ww-osd { grid-area: osd; }
  .ww-list { grid-area: list; }
  .ww-panel { grid-area: panel; }

  /* ---- the on-screen menu ---- */
  .ww-osd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.4rem;
    min-width: 0;
  }
  /* a channel guide (the bench pick of 2026-11-01): the ask in big type, then the categories as big words, the
     picked one in inverse video, each with how many plugins it holds */
  .ww-tag {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ww-ink);
    text-shadow: 0 0 8px var(--ww-glow);
  }
  .ww-tag-ask { display: none; }
  .ww[data-ww-lib='on'] .ww-tag-name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .ww[data-ww-lib='on'] .ww-tag-ask {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.9rem;
    line-height: 1;
    letter-spacing: 0.06em;
    color: var(--ww-ink-text);
    text-shadow: 0 0 12px var(--ww-glow);
    white-space: nowrap;
  }
  .ww-tag-ask i { font-style: normal; color: var(--ww-ink-hot); }
  /* the cursor blinks four times as the tube lights, then holds (a blink that never stops fails WCAG 2.2.2) */
  @media (prefers-reduced-motion: no-preference) {
    .ww[data-ww-power='on'] .ww-tag-ask i { animation: ww-blink 1.1s steps(1, end) 4; }
  }
  @keyframes ww-blink { 50% { opacity: 0; } }
  .ww-cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.4rem;
  }
  .ww:not([data-ww-lib='on']) .ww-cats { display: none; } /* buttons that do nothing without the script */
  .ww-cat {
    appearance: none;
    margin: 0;
    padding: 0.32rem 0.7rem 0.18rem;
    border: 0;
    border-radius: 3px;
    background: transparent;
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ww-ink);
    text-shadow: 0 0 9px var(--ww-glow);
    cursor: pointer;
    transition: color 120ms ease, background-color 120ms ease;
  }
  .ww-cat-n {
    margin-left: 0.2rem;
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    vertical-align: super;
    opacity: 0.85;
  }
  @media (hover: hover) {
    .ww-cat:hover { color: var(--ww-ink-hot); }
  }
  /* the picked one = inverse video, the way a set's menu marks its choice */
  .ww-cat[aria-pressed='true'] {
    background: var(--ww-ink-hot);
    color: var(--ww-ink-on);
    text-shadow: none;
    box-shadow: 0 0 24px var(--ww-glow-hot);
  }
  .ww-cat:focus-visible,
  .ww-row:focus-visible,
  .ww-back:focus-visible {
    outline: 2px solid var(--ww-ink-hot);
    outline-offset: 3px;
  }

  /* ---- the plugins ---- */
  .ww-list {
    list-style: none;
    margin: 0;
    padding: 0;
    container-type: inline-size; /* the names size to the column (cqi) */
    display: grid;
    gap: clamp(0.35rem, 1.4vh, 0.9rem);
    align-content: center;
  }
  .ww-item[hidden] { display: none; }
  .ww-row {
    display: grid;
    /* the thumbnail fits the room's height too, as the name does (16:10; 1.15rem = the row's padding + its share of the
       gaps): at 9.8rem four rows were 21 px too tall for a 1280x665 screen, 45 px for 1141x636 */
    --ww-thumb-col: min(calc(var(--ww-thumb-w) * 1rem), calc((var(--ww-main, 30rem) / var(--ww-rows, 4) - 1.15rem) * 1.6));
    grid-template-columns: var(--ww-thumb-col) minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 1rem;
    padding: 0.3rem 0.4rem 0.3rem 0;
    border-radius: 4px;
    color: inherit;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  /* the whole plugin, never cropped or letterboxed (Dan 2026-11-03: Radio Roulette was cut, GAS had black bars left
     and right): a wide window fills the slot's width, a tall one its height, centred on the bare glass; the edge and
     the glow sit on the picture itself */
  .ww-thumb {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    opacity: var(--ww-dim);
    transition: opacity 120ms ease;
  }
  .ww-thumb :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 3px;
    box-shadow: 0 0 0 1px var(--ww-edge);
    transition:
      transform 180ms cubic-bezier(0.2, 0.9, 0.25, 1.25),
      box-shadow 180ms ease,
      filter 180ms ease;
  }
  /* the slot's height as a length: a percent height doesn't resolve against an aspect-ratio box here */
  .ww-thumb.is-tall :global(img) { width: auto; height: calc(var(--ww-thumb-col) / 1.6); }
  /* the plates baked on near-black with rounded bezels: the panel's own arcs (.ww-ui below) */
  .ww-row[data-ww-pick='gas'] .ww-thumb :global(img) { border-radius: 11% / 7.4%; }
  .ww-row[data-ww-pick='radio-roulette'] .ww-thumb :global(img) { border-radius: 9% 9% 10.6% 10.6% / 16.2% 16.2% 19% 19%; }
  .ww-rtext { display: grid; gap: 0.3rem; min-width: 0; }
  /* the name: stencil on the glass, outlined in the channel's phosphor, the lit one filled */
  .ww-name {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.2vw, 4.2rem);
    font-size: min(
      calc(var(--ww-name-max) * 1rem),
      calc((100cqi - var(--ww-thumb-w) * 1rem - 1.5rem) / 6.4),
      max(1.5rem, calc((var(--ww-main, 30rem) / var(--ww-rows, 4) - 1.9rem) / 0.95)) /* every row fits the room's height */
    );
    line-height: 0.95;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ww-ink);
    opacity: var(--ww-dim);
    filter: drop-shadow(0 0 6px var(--ww-glow));
    transition:
      color 120ms cubic-bezier(0.2, 0.9, 0.25, 1.25),
      opacity 120ms cubic-bezier(0.2, 0.9, 0.25, 1.25),
      -webkit-text-stroke-color 120ms cubic-bezier(0.2, 0.9, 0.25, 1.25),
      filter 160ms ease;
  }
  .ww-type {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ww-ink-text);
    opacity: 0.7;
  }
  .ww-rprice { display: none; }
  /* the pointer on a plugin warms it up, short of lit (Dan 2026-11-03: the old hover only brightened the outline,
     "gas2 is not hovering"): the name glows with a faint fill, the picture comes forward with a hot edge. The lit
     rules below win where both set a value */
  @media (hover: hover) {
    .ww-row:hover .ww-name {
      opacity: 1;
      color: color-mix(in srgb, var(--ww-ink-hot) 40%, transparent);
      -webkit-text-stroke-color: var(--ww-ink-hot);
      filter: drop-shadow(0 0 10px var(--ww-glow-hot)) drop-shadow(0 0 22px var(--ww-glow-soft));
    }
    .ww-row:hover .ww-type { opacity: 1; }
    .ww-row:hover .ww-thumb { opacity: 1; }
    .ww-row:hover .ww-thumb :global(img) {
      transform: scale(1.06);
      filter: brightness(1.12);
      box-shadow: 0 0 0 1px var(--ww-ink-hot), 0 0 22px var(--ww-glow-hot);
    }
  }
  .ww-row.is-lit .ww-name {
    opacity: 1;
    color: var(--ww-ink-hot);
    -webkit-text-stroke-color: var(--ww-ink-hot);
    filter: drop-shadow(0 0 10px var(--ww-glow-hot)) drop-shadow(0 0 26px var(--ww-glow-soft));
  }
  .ww-row.is-lit .ww-thumb { opacity: 1; }
  .ww-row.is-lit .ww-thumb :global(img) { box-shadow: 0 0 0 1px var(--ww-ink-hot), 0 0 18px var(--ww-glow); }
  .ww-row.is-lit .ww-type { opacity: 1; }
  /* a category change: the plugins that stay come up one after another (on the row: the reveal owns the li) */
  .ww-list.is-swapping .ww-item:not([hidden]) .ww-row {
    animation: ww-strike 420ms cubic-bezier(0.2, 0.9, 0.25, 1.1) both;
    animation-delay: calc(40ms + var(--k, 0) * 60ms);
  }
  @keyframes ww-strike {
    from { opacity: 0; transform: translateY(14px) scale(0.98); }
    to   { opacity: 1; transform: none; }
  }

  /* ---- the lit plugin ---- */
  .ww-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    gap: clamp(0.8rem, 2vh, 1.25rem);
    min-width: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 320ms ease, visibility 0s linear 320ms;
  }
  .ww-panel.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 320ms ease 60ms, visibility 0s;
  }
  /* the screen wall changes channel by motion (the script moves them), never two plugins at once; the wood wall keeps
     its fade. The panel on the glass keeps .is-active while it leaves (.is-leaving: inert, under the click) */
  .ww[data-ww-bg='screen'] .ww-panel { transition: none; }
  .ww-panel.is-leaving { pointer-events: none; }
  .ww-back { display: none; }
  .ww-ui { margin: 0; min-width: 0; }
  .ww-ui :global(img),
  .ww-ui video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    box-shadow: 0 1px 0 0 #000, 0 24px 48px rgba(0, 0, 0, 0.55);
  }
  /* the box is there before the picture: a lazy window that arrives late never pushes the text down */
  .ww-ui :global(img) { aspect-ratio: var(--ww-ar); }
  .ww-ui video {
    aspect-ratio: 1725 / 912;
    object-fit: cover;
    background-color: var(--bg-1);
  }
  /* the plates are baked on a near-black ground with rounded bezels: clip to the bezel's own arc (radii measured off
     the PNGs: GAS ~170px of 1600x2380, Radio Roulette ~220 top / ~260 bottom of 2546x1415); percent radii stay
     circular at every size */
  .ww-panel[data-ww-panel='gas'] .ww-ui :global(img) { border-radius: 11% / 7.4%; }
  .ww-panel[data-ww-panel='radio-roulette'] .ww-ui :global(img) { border-radius: 9% 9% 10.6% 10.6% / 16.2% 16.2% 19% 19%; }
  /* GAS's window is one tall knob panel: it stands beside its text instead of over it */
  .ww-panel.is-portrait {
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: clamp(1.25rem, 3vw, 2.5rem);
  }
  /* a set height (not max-height): with width auto, a max-height has no box until the picture loads */
  .ww-panel.is-portrait .ww-ui :global(img) {
    width: auto;
    max-width: 100%;
    height: clamp(18rem, 40vw, 30rem);
  }

  .ww-info { display: grid; gap: 0.6rem; justify-items: start; max-width: 40rem; }
  .ww-phead { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.9rem; }
  .ww-pname {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.9rem, 2.8vw, 2.7rem);
    line-height: 1;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ww-ink-hot);
    text-shadow: 0 0 8px var(--ww-glow);
  }
  .ww-pname:focus { outline: none; }
  .ww-ptype {
    margin: 0;
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ww-ink);
  }
  .ww-blurb {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 1.1rem;
    line-height: 1.45;
    color: hsl(var(--ww-ch-h) 30% 92%);
    text-shadow: 0 0 10px var(--ww-glow-faint);
  }
  /* on the screen the blurb is phosphor too (Dan 2026-11-03: it read as plain white web text, the one thing on the
     glass that didn't glow): the channel's tint, a tight glow round the letters and a wide soft one */
  :global(html:not(.hc)) .ww[data-ww-bg='screen'] .ww-blurb {
    color: hsl(var(--ww-ch-h) min(100%, calc(var(--ww-ch-s) * 1% + 10%)) 82%);
    text-shadow: 0 0 6px var(--ww-glow), 0 0 20px var(--ww-glow-soft);
  }
  /* the five words, now one small line: what the sound does */
  .ww-pwords {
    margin: 0;
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ww-ink);
  }
  .ww-pw-i { white-space: nowrap; } /* a line breaks between words, never before a dot */
  .ww-pw.is-hot { color: var(--ww-ink-hot); text-shadow: 0 0 8px var(--ww-glow); }
  .ww-pw-dot { opacity: 0.6; }

  .ww-buy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.1rem;
    margin-top: 0.3rem;
  }
  .ww-price {
    font-family: var(--font-display);
    font-size: 2.15rem;
    line-height: 1;
    letter-spacing: 0.04em;
    color: var(--ww-ink-hot);
    text-shadow: 0 0 8px var(--ww-glow);
  }
  /* .ww-try + .ww-more: the button family's look (buttons.css, D9 2026-11-01); placement only here */

  /* ==========================================================================
     INK. On the wood: brass, the lit one oxide (the old stencil). On the
     screen: the channel's phosphor. The menu and the list follow the lit
     plugin (--ww-on-*, data-ww-on on .ww); each panel keeps its own channel
     (--ww-ch-*), so an outgoing panel keeps its colour while it fades.
     ========================================================================== */
  .ww,
  .ww-panel {
    --ww-ink: var(--brass);
    --ww-ink-hot: var(--oxide-text);
    --ww-ink-text: var(--fg);
    --ww-ink-on: var(--bg-0);
    --ww-edge: rgba(0, 0, 0, 0.6);
    --ww-glow: transparent;
    --ww-glow-hot: transparent;
    --ww-glow-soft: transparent;
    --ww-glow-faint: transparent;
  }
  :global(html:not(.hc)) .ww[data-ww-bg='screen'] {
    --ww-gs: min(100%, calc(var(--ww-on-s) * 1% + 20%)); /* the glow's saturation */
    --ww-ink: hsl(var(--ww-on-h) min(100%, calc(var(--ww-on-s) * 1% + 25%)) 66%);
    --ww-ink-hot: hsl(var(--ww-on-h) min(100%, calc(var(--ww-on-s) * 1% + 30%)) 74%);
    --ww-ink-text: hsl(var(--ww-on-h) 35% 90%);
    --ww-ink-on: hsl(var(--ww-on-h) 40% 7%);
    --ww-edge: hsl(var(--ww-on-h) var(--ww-gs) 58% / 0.35);
    --ww-glow: hsl(var(--ww-on-h) var(--ww-gs) 58% / 0.45);
    --ww-glow-hot: hsl(var(--ww-on-h) var(--ww-gs) 58% / 0.6);
    --ww-glow-soft: hsl(var(--ww-on-h) var(--ww-gs) 58% / 0.3);
    --ww-glow-faint: hsl(var(--ww-on-h) var(--ww-gs) 58% / 0.3);
  }
  :global(html:not(.hc)) .ww[data-ww-bg='screen'] > .ww-panel {
    --ww-gs: min(100%, calc(var(--ww-ch-s) * 1% + 20%));
    --ww-ink: hsl(var(--ww-ch-h) min(100%, calc(var(--ww-ch-s) * 1% + 25%)) 66%);
    --ww-ink-hot: hsl(var(--ww-ch-h) min(100%, calc(var(--ww-ch-s) * 1% + 30%)) 74%);
    --ww-ink-text: hsl(var(--ww-ch-h) 35% 90%);
    --ww-ink-on: hsl(var(--ww-ch-h) 40% 7%);
    --ww-edge: hsl(var(--ww-ch-h) var(--ww-gs) 58% / 0.35);
    --ww-glow: hsl(var(--ww-ch-h) var(--ww-gs) 58% / 0.45);
    --ww-glow-hot: hsl(var(--ww-ch-h) var(--ww-gs) 58% / 0.6);
    --ww-glow-soft: hsl(var(--ww-ch-h) var(--ww-gs) 58% / 0.3);
    --ww-glow-faint: hsl(var(--ww-ch-h) var(--ww-gs) 58% / 0.3);
  }
  /* the window on the screen: a lit picture with a phosphor edge, not a drop on wood */
  :global(html:not(.hc)) .ww[data-ww-bg='screen'] > .ww-panel .ww-ui :global(img),
  :global(html:not(.hc)) .ww[data-ww-bg='screen'] > .ww-panel .ww-ui video {
    box-shadow:
      0 0 0 1px hsl(var(--ww-ch-h) var(--ww-gs) 58% / 0.4),
      0 0 36px hsl(var(--ww-ch-h) var(--ww-gs) 58% / 0.22),
      0 18px 40px rgba(0, 0, 0, 0.55);
  }

  /* ---- THE CHANNELS -------------------------------------------------------
     Dan 2026-10-14: "every plugin on the TV, only the screen changes ... like
     changing channels"; his pick: each plugin its own screen colour. Hue +
     saturation (unitless %) from the plugin's own UI: RevLimiter amber (its
     gauge + LCDs; kept well clear of race-red, the homepage's one red is
     .hh-redline), GAS brass gold, GAS 2 its pump's oxide red-orange, Radio Roulette the dial glass's pale warm
     cream, DRIFT violet (its screen stays /drift's own tube). A plugin with no
     channel here plays in neutral cream. */
  .ww {
    --ww-ch-revlimiter-h: 26;      --ww-ch-revlimiter-s: 78;
    --ww-ch-gas-h: 46;             --ww-ch-gas-s: 62;
    --ww-ch-gas2-h: 14;            --ww-ch-gas2-s: 58;
    --ww-ch-radio-roulette-h: 38;  --ww-ch-radio-roulette-s: 28;
    --ww-ch-drift-h: 280;          --ww-ch-drift-s: 70;
    --ww-on-h: 38;
    --ww-on-s: 28;
  }
  .ww-panel { --ww-ch-h: 38; --ww-ch-s: 28; }
  .ww-panel[data-ww-panel='revlimiter'] { --ww-ch-h: var(--ww-ch-revlimiter-h); --ww-ch-s: var(--ww-ch-revlimiter-s); }
  .ww-panel[data-ww-panel='gas'] { --ww-ch-h: var(--ww-ch-gas-h); --ww-ch-s: var(--ww-ch-gas-s); }
  .ww-panel[data-ww-panel='gas2'] { --ww-ch-h: var(--ww-ch-gas2-h); --ww-ch-s: var(--ww-ch-gas2-s); }
  .ww-panel[data-ww-panel='radio-roulette'] { --ww-ch-h: var(--ww-ch-radio-roulette-h); --ww-ch-s: var(--ww-ch-radio-roulette-s); }
  .ww-panel[data-ww-panel='drift'] { --ww-ch-h: var(--ww-ch-drift-h); --ww-ch-s: var(--ww-ch-drift-s); }
  .ww[data-ww-on='revlimiter'] { --ww-on-h: var(--ww-ch-revlimiter-h); --ww-on-s: var(--ww-ch-revlimiter-s); }
  .ww[data-ww-on='gas'] { --ww-on-h: var(--ww-ch-gas-h); --ww-on-s: var(--ww-ch-gas-s); }
  .ww[data-ww-on='gas2'] { --ww-on-h: var(--ww-ch-gas2-h); --ww-on-s: var(--ww-ch-gas2-s); }
  .ww[data-ww-on='radio-roulette'] { --ww-on-h: var(--ww-ch-radio-roulette-h); --ww-on-s: var(--ww-ch-radio-roulette-s); }
  .ww[data-ww-on='drift'] { --ww-on-h: var(--ww-ch-drift-h); --ww-on-s: var(--ww-ch-drift-s); }

  /* ---- THE SCREEN (WALL_BG 'screen') --------------------------------------
     /drift's digital screen (the keep-it TV's phosphor tube, .d-crt.d-keep-
     screen): dark glass lit from the centre with scanlines + aperture grille
     ON the glass, UNDER everything on it, and the glass's reflection + curved
     falloff OVER everything, so the menu, the names and the window read as ON
     the screen. The lines stay off what is read (the user 2026-10-19: the
     reading suffered "because of the pixels"): over the text, a 1 px line
     every 3 px crossed every letter, and on a phone (3 device px per CSS px)
     each was a band; the plugin's picture is clean too (the user's pick). The
     layers sit on .ww, outside the panels, so a panel's fade never traps them
     in its stacking context. */
  .ww {
    --ww-scr-bright: 1.37;  /* phosphor glow */
    --ww-scr-scan: 0.2;     /* scanline darkness on the glass (under the text and the pictures) */
  }
  .ww-screen,
  .ww-screen-fx {
    position: absolute;
    inset-block: var(--rail-h, 0px);
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 320ms ease;
  }
  .ww-screen {
    z-index: -1; /* over the wood + scrim, under the rails (painted after it) and the content */
    overflow: hidden;
    background: #040107;
  }
  .ww-screen-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 62% 80% at 50% 46%, #2e1347 0%, #1a0b2c 40%, #0b0414 76%, #040107 100%);
    filter: brightness(var(--ww-scr-bright));
  }
  /* the last channel's glow, fading over the new one on a change (the script copies the old gradient in: a gradient
     can't transition, and the hue must not interpolate) */
  .ww-screen-was {
    position: absolute;
    inset: 0;
    opacity: 0;
    filter: brightness(var(--ww-scr-bright));
    pointer-events: none;
  }
  .ww:not([data-ww-on='drift']) .ww-screen-glow {
    background: radial-gradient(ellipse 62% 80% at 50% 46%,
      hsl(var(--ww-on-h) calc(var(--ww-on-s) * 1%) 18%) 0%,
      hsl(var(--ww-on-h) calc(var(--ww-on-s) * 1%) 11%) 40%,
      hsl(var(--ww-on-h) calc(var(--ww-on-s) * 1%) 5%) 76%,
      hsl(var(--ww-on-h) calc(var(--ww-on-s) * 1%) 2%) 100%);
  }
  /* the lines on the glass, over its glow, under the content (a pseudo-element: the script reads .ww-screen's own
     children) */
  .ww-screen::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(0deg, rgba(0, 0, 0, var(--ww-scr-scan)) 0 1px, transparent 1px 3px), /* scanlines */
      repeating-linear-gradient(90deg, rgba(255, 40, 90, 0.05) 0 1px, rgba(40, 255, 140, 0.035) 1px 2px, rgba(70, 90, 255, 0.05) 2px 3px), /* aperture grille */
      linear-gradient(transparent, rgba(255, 255, 255, var(--ww-gl-roll-light)) 50%, transparent) 0 -20% / 100% 14% no-repeat; /* the roll's band, parked above the glass */
  }
  /* a glitch (the script): the band rolls down the glass once, under the text like the lines (a CRT's hum bar) */
  .ww-screen.ww-gl-roll::after { animation: ww-gl-roll var(--ww-gl-roll-dur, 900ms) linear; }
  @keyframes ww-gl-roll {
    from { background-position: 0 0, 0 0, 0 -20%; }
    to   { background-position: 0 0, 0 0, 0 120%; }
  }
  .ww-screen-fx {
    z-index: 2; /* over the content: it is on the screen (smooth light only: nothing here crosses a letter) */
    background:
      linear-gradient(158deg, rgba(255, 255, 255, 0.07) 0%, rgba(255, 255, 255, 0.02) 16%, transparent 30%), /* glass reflection */
      radial-gradient(ellipse 70% 22% at 50% 0%, rgba(255, 255, 255, 0.05), transparent 70%),                 /* the glass catching the room light */
      radial-gradient(130% 120% at 50% 50%, transparent 55%, rgba(0, 0, 0, 0.6) 100%);                        /* tube curvature */
    box-shadow:
      inset 0 3px 0 #040206, inset 0 -3px 0 #040206, /* the screen's seat under the rails */
      inset 0 0 0 1px rgba(190, 90, 255, 0.22);
  }
  .ww[data-ww-bg='screen'] > :is(.ww-screen, .ww-screen-fx) { opacity: 1; }

  /* Power-on (the script arms it the first time the TV comes into view): dark
     glass, then a bright line that opens into the picture; the LED lights with it */
  .ww[data-ww-power='armed'] .ww-screen-glow { opacity: 0; }
  .ww[data-ww-power='powering'] .ww-screen-glow {
    animation: ww-scr-on 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes ww-scr-on {
    0%   { opacity: 1; transform: scale(1, 0.004); filter: brightness(calc(var(--ww-scr-bright) * 6)); }
    25%  { opacity: 1; transform: scale(1, 0.004); filter: brightness(calc(var(--ww-scr-bright) * 5)); }
    60%  { opacity: 1; transform: scale(1, 1); filter: brightness(calc(var(--ww-scr-bright) * 1.8)); }
    100% { opacity: 1; transform: none; filter: brightness(var(--ww-scr-bright)); }
  }

  /* Changing channel: motion only (the user 2026-10-18: "no noise at all, just motion"; plan Phase 4d), smaller,
     shorter and always the same way (2026-10-19). The script reads these at every change (plain numbers: ms, px; the
     bench's sliders). The old plugin leaves before the new one comes on, about 0.55 s from the click to rest. The
     exit and the text's stagger are quicker than the house's 300 / 90 ms on purpose: a 300 ms ease-in hardly moves
     for its first 100 ms, and 90 ms x 4 blocks would seat the Try key past a second. They stay local to the TV (the
     global --dur-out and STAGGER serve the rest of the site). */
  .ww {
    --ww-mv-dir: 1;           /* the one way everything moves: 1 = rises into place, -1 = comes down into place */
    --ww-mv-px: 24;           /* the new picture comes from this far... */
    --ww-mv-in-ms: 560;       /* ...fading and travelling as one (power3.out); the screen's colour changes meanwhile */
    --ww-mv-out-px: 4;        /* the old one drifts this far the same way as it fades */
    --ww-mv-out-ms: 120;      /* the old one's exit */
    --ww-mv-text-px: 6;       /* the text blocks come this far, in reading order, after the picture */
    --ww-mv-text-ms: 340;
    --ww-mv-text-gap-ms: 20;  /* between the blocks */
    --ww-mv-text-at-ms: 40;   /* after the entrance starts */
    --ww-mv-glow-dip: 0.92;   /* the screen's glow while the glass is empty (1 = no dip) */
    --ww-mv-pane-px: 16;      /* phones: the pane comes in this far from the right (the list leaves half as far left) */
    --ww-mv-pane-ms: 200;     /* phones: the list's / the pane's exit */
  }

  /* Glitches: the old set's own small faults, now and then, to show it is alive (the user 2026-10-19; the script).
     Plain numbers (s, px, ms; the bench's sliders), read when they come due. */
  .ww {
    --ww-gl-min-s: 12;        /* the shortest wait between two glitches, s... */
    --ww-gl-max-s: 25;        /* ...the longest (each wait is random between them) */
    --ww-gl-idle-s: 4;        /* and only once the TV has been left alone this long (pointer, finger, key, wheel) */
    --ww-gl-px: 3;            /* how far a name jumps and a band of the picture tears */
    --ww-gl-ms: 150;          /* a name's jump, a tear, a flicker */
    --ww-gl-roll-ms: 900;     /* a band of light rolling down the glass... */
    --ww-gl-roll-light: 0.1;  /* ...and the light it adds (white, at its middle) */
    --ww-gl-chg-chance: 0.33; /* a channel change landing with a short tear: 0 = never, 1 = every time */
  }
  /* the tear: a canvas over the lit plugin's picture while a band of it tears (the script lays it there) */
  .ww > :global(.ww-gl-tear) {
    position: absolute;
    z-index: 1; /* over the picture, under the glass's light (2) */
    pointer-events: none;
  }

  /* ---- THE BROKEN TV FRAME (WALL_FRAME, with the screen) ------------------
     Dan 2026-10-14: "a broken TV frame", then "more neutral, fewer colours"
     (every plugin plays on this set, only the screen changes). A beat-up CRT
     cabinet front instead of the brass rails, 9-sliced from the roll's
     numbers (tv-broken.json, vars on .ww from the frontmatter); the long runs
     TILE (round): stretched they streak, tiled they keep the photo's grain.
     --ww-frame-u = CSS px per cut pixel: the bench's size, capped so the
     roll's side bezel always fits the wall's own gutter (.ww's margin +
     padding-inline) and never covers the menu, a name or the window. The
     frame anchors to the content box, not 100vw: a classic scrollbar must
     not eat the right bezel. The house pilot light (--emerald) in the chin. */
  .ww {
    --ww-frame-size: 0.25;  /* CSS px per cut pixel, desktop */
    --ww-frame-gap: 0px;    /* garage wood showing around the set (laptop and up) */
    --ww-frame-g: var(--ww-frame-gap);
    --ww-out: max(2.5vw, 50vw - 720px); /* --maxw's margin: .ww's edge from the screen's (the frame spans the screen) */
    /* the side gutter (--maxw's margin + .ww's padding-inline) minus the wood and 6 px, over the roll's side bezel */
    --ww-frame-cap: calc(max(2px, var(--ww-out) + clamp(1rem, 4vw, 2.5rem) - var(--ww-frame-g) - 6px) / max(var(--wf-zl), var(--wf-zr)));
    --ww-frame-u: min(calc(var(--ww-frame-size) * 1px), var(--ww-frame-cap));
  }
  @media (max-width: 900px) {
    /* phones: a ~20 px gutter has no room for wood round the set */
    .ww {
      --ww-frame-g: 0px;
      --ww-out: 1vw;
      --ww-frame-cap: calc((var(--ww-out) + clamp(1rem, 4vw, 2.5rem) - 4px) / max(var(--wf-zl), var(--wf-zr)));
    }
  }
  .ww[data-ww-frame='1'] {
    --wf-img: var(--wf1-img); --wf-sl: var(--wf1-sl);
    --wf-t: var(--wf1-t); --wf-r: var(--wf1-r); --wf-b: var(--wf1-b); --wf-l: var(--wf1-l);
    --wf-zt: var(--wf1-zt); --wf-zr: var(--wf1-zr); --wf-zb: var(--wf1-zb); --wf-zl: var(--wf1-zl);
  }
  .ww[data-ww-frame='2'] {
    --wf-img: var(--wf2-img); --wf-sl: var(--wf2-sl);
    --wf-t: var(--wf2-t); --wf-r: var(--wf2-r); --wf-b: var(--wf2-b); --wf-l: var(--wf2-l);
    --wf-zt: var(--wf2-zt); --wf-zr: var(--wf2-zr); --wf-zb: var(--wf2-zb); --wf-zl: var(--wf2-zl);
  }
  .ww[data-ww-frame='3'] {
    --wf-img: var(--wf3-img); --wf-sl: var(--wf3-sl);
    --wf-t: var(--wf3-t); --wf-r: var(--wf3-r); --wf-b: var(--wf3-b); --wf-l: var(--wf3-l);
    --wf-zt: var(--wf3-zt); --wf-zr: var(--wf3-zr); --wf-zb: var(--wf3-zb); --wf-zl: var(--wf3-zl);
  }
  .ww-frame {
    position: absolute;
    inset: var(--ww-frame-g);
    z-index: 3; /* over the glass fx (2): the bezel is in front of the tube */
    pointer-events: none;
    opacity: 0;
    transition: opacity 320ms ease;
    border: 0 solid transparent;
    border-image: var(--wf-img) var(--wf-sl) / calc(var(--wf-t) * var(--ww-frame-u)) calc(var(--wf-r) * var(--ww-frame-u))
      calc(var(--wf-b) * var(--ww-frame-u)) calc(var(--wf-l) * var(--ww-frame-u)) round;
    filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.55)); /* the bezel's lip over the glass */
  }
  /* the opening, as a box (the script reads it to pick the roll's cut) */
  .ww-frame {
    padding: calc(var(--wf-zt) * var(--ww-frame-u)) calc(var(--wf-zr) * var(--ww-frame-u))
      calc(var(--wf-zb) * var(--ww-frame-u)) calc(var(--wf-zl) * var(--ww-frame-u));
  }
  .ww-frame-glass { display: block; height: 100%; }
  .ww[data-ww-bg='screen']:not([data-ww-frame='rails']) > .ww-frame { opacity: 1; }
  /* the screen fills the cabinet: from under the bezel's middle, inside the content box */
  .ww[data-ww-bg='screen']:not([data-ww-frame='rails']) > :is(.ww-screen, .ww-screen-fx) {
    left: calc(var(--ww-frame-g) + var(--wf-zl) * var(--ww-frame-u) / 2);
    right: calc(var(--ww-frame-g) + var(--wf-zr) * var(--ww-frame-u) / 2);
    top: calc(var(--ww-frame-g) + var(--wf-zt) * var(--ww-frame-u) / 2);
    bottom: calc(var(--ww-frame-g) + var(--wf-zb) * var(--ww-frame-u) / 2);
    width: auto;
    transform: none;
  }
  .ww[data-ww-bg='screen']:not([data-ww-frame='rails']) > .ww-screen-fx { box-shadow: none; }
  /* the set replaces the brass rails while it is up */
  :global(.garage-wall:has(.ww-frame))::after { transition: opacity 320ms ease; }
  :global(.garage-wall:has(> .gw-inner > .ww[data-ww-bg='screen']:not([data-ww-frame='rails'])))::after { opacity: 0; }
  /* the power LED, in the chin left of the broken corner */
  .ww-frame-led {
    position: absolute;
    right: calc(var(--wf-r) * var(--ww-frame-u) + 1.5rem);
    bottom: calc(var(--wf-zb) * var(--ww-frame-u) * 0.5);
    width: max(5px, calc(26 * var(--ww-frame-u)));
    aspect-ratio: 1;
    translate: 0 50%;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #d2f7df 0 18%, #4fbf82 45%, var(--emerald) 100%);
    box-shadow: 0 0 6px 1px rgba(79, 191, 130, 0.75), 0 0 16px 3px rgba(79, 191, 130, 0.3);
  }
  .ww[data-ww-power='armed'] .ww-frame-led {
    background: radial-gradient(circle at 40% 35%, #3c4a42 0 18%, #18241d 60%, #0b120e 100%);
    box-shadow: none;
  }

  /* The anchor: /#plugins from another page (home's closing CTA, old links)
     is the browser's own
     jump, and it must park the TV where the scroll lock and the script's
     glide park it: exactly under the nav. global.css pads every anchor jump
     by --nav-h + 0.75rem (html scroll-padding-top, for focus); this takes
     that back and adds the real bar (--site-nav-h, from the header script: a
     phone's bar is taller than --nav-h). Negative on a laptop, which
     scroll-margin allows. */
  :global(section#plugins) {
    scroll-margin-top: calc(var(--site-nav-h, var(--nav-h)) - var(--nav-h) - 0.75rem);
  }

  /* ---- ONE SCREEN (Dan 2026-10-14: "when I scroll, the site fits the screen
     exactly, not past the edges top and bottom") ---------------------------
     The TV is one screen tall under the nav and its content is sized to the
     glass: the names and the window shrink on a short screen, never past
     their full size, centred in the opening. svh = the screen with the
     browser's bars shown, so nothing moves when they slide away. min-height,
     not height: whatever still can't fit grows the TV instead of clipping
     (and the lock then leaves it alone). The scroll lock is in the script. */
  .ww {
    --ww-nav: calc(var(--site-nav-h, var(--nav-h)) + var(--sale-h, 0px)); /* + the BF/CM strip while it's up */
    --ww-breath: 15px;         /* glass showing above and below the content */
    --ww-snap-zone: 30;        /* the lock catches when the TV's top stops within this % of the screen */
    --ww-bez-t: var(--rail-h); /* the opening's top / bottom edge, from the wall's inner box */
    --ww-bez-b: var(--rail-h);
    --ww-osd-h: 2.2rem;        /* the menu's row (measured: 34-35 px at 1141-1728) */
    --ww-info-h: 12.5rem;      /* the lit plugin's text under its window (measured, laptop) */
    --ww-side-min: 16rem;      /* the narrowest the text beside GAS's tall window gets (laptop) */
  }
  .ww[data-ww-bg='screen']:not([data-ww-frame='rails']) {
    --ww-bez-t: calc(var(--ww-frame-g) + var(--wf-zt) * var(--ww-frame-u));
    --ww-bez-b: calc(var(--ww-frame-g) + var(--wf-zb) * var(--ww-frame-u));
    /* the sides clear the bezel by a breath too (Dan 2026-11-03: the content ran 7 px from the glass at 1141, 4 px
       on a phone, into the opening's rounded corners) */
    --ww-breath-x: clamp(12px, 2vw, 28px);
    padding-inline: max(
      clamp(1rem, 4vw, 2.5rem),
      calc(var(--ww-frame-g) + max(var(--wf-zl), var(--wf-zr)) * var(--ww-frame-u) - var(--ww-out) + var(--ww-breath-x))
    );
  }
  @supports (height: 100svh) {
    .ww[data-ww-bg='screen'] {
      /* .gw-inner pads the rails (rail-h + 0.5rem a side); .ww pads from there to the opening, + the breath */
      --ww-pad-t: max(var(--ww-breath), calc(var(--ww-bez-t) - var(--rail-h) - 0.5rem + var(--ww-breath)));
      --ww-pad-b: max(var(--ww-breath), calc(var(--ww-bez-b) - var(--rail-h) - 0.5rem + var(--ww-breath)));
      --ww-room: calc(100svh - var(--ww-nav) - 2 * var(--rail-h) - 1rem - var(--ww-pad-t) - var(--ww-pad-b));
      --ww-main: calc(var(--ww-room) - var(--ww-osd-h) - var(--ww-row-gap));
      min-height: calc(100svh - var(--ww-nav) - 2 * var(--rail-h) - 1rem);
      padding-block: var(--ww-pad-t) var(--ww-pad-b);
      align-content: center;
    }
    @media (min-width: 861px) {
      /* the window: as wide as its column, unless that makes it taller than the room left over by its text */
      .ww[data-ww-bg='screen'] .ww-panel:not(.is-portrait) .ww-ui :global(img),
      .ww[data-ww-bg='screen'] .ww-panel:not(.is-portrait) .ww-ui video {
        max-width: calc((var(--ww-main) - var(--ww-info-h)) * var(--ww-ar, 2));
      }
      /* GAS's tall window yields width before the text beside it gets narrower than --ww-side-min: with the list
         at half the screen (the bench pick of 2026-10-18) a 1141x636 laptop squeezed that text to 145 px, 473 px
         tall, and the TV outgrew the screen. The panel is the container (cqi); a browser without container units
         drops the second height and keeps the first. */
      .ww[data-ww-bg='screen'] .ww-panel.is-portrait { container-type: inline-size; }
      .ww[data-ww-bg='screen'] .ww-panel.is-portrait .ww-ui :global(img) {
        height: min(clamp(18rem, 40vw, 30rem), var(--ww-main));
        height: min(
          clamp(18rem, 40vw, 30rem),
          var(--ww-main),
          calc((100cqi - var(--ww-side-min) - clamp(1.25rem, 3vw, 2.5rem)) / var(--ww-ar))
        );
      }
    }
  }

  /* ==========================================================================
     PHONES + small tablets (<= 860px): one pane at a time. The list (the
     menu, then full-width rows: thumbnail, name, type word, price); a tap
     opens the lit plugin as its own view (a history entry), Back returns.
     No hover-only states. No JS: the list only, each row a link to its page.
     ========================================================================== */
  @media (max-width: 860px) {
    .ww {
      padding-top: 2rem;
      padding-bottom: 2.5rem;
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'osd' 'list';
      --ww-thumb-w: 6;
      --ww-osd-h: 4.6rem; /* two rows of keys */
    }
    .ww[data-ww-view='panel'] { grid-template-areas: 'panel'; }
    .ww[data-ww-view='panel'] > :is(.ww-osd, .ww-list) { display: none; }
    .ww:not([data-ww-view='panel']) > .ww-panel,
    .ww > .ww-panel:not(.is-active) { display: none; }
    .ww[data-ww-lib='on'] .ww-tag-ask { font-size: 1.45rem; }
    .ww-cat { font-size: 1.32rem; padding: 0.3rem 0.5rem 0.16rem; }
    .ww-list { gap: 0.25rem; }
    .ww-row {
      column-gap: 0.85rem;
      padding: 0.45rem 0.25rem 0.45rem 0;
    }
    .ww-name {
      font-size: clamp(1.45rem, 7.4vw, 2.5rem);
      -webkit-text-stroke-width: 1.25px;
    }
    .ww-type { font-size: 0.66rem; letter-spacing: 0.14em; }
    .ww-rprice {
      display: block;
      font-family: var(--font-display);
      font-size: 1.25rem;
      letter-spacing: 0.04em;
      color: var(--ww-ink);
    }
    .ww-row.is-lit .ww-rprice { color: var(--ww-ink-hot); }
    /* the panel as its own view */
    .ww-panel,
    .ww-panel.is-portrait {
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      gap: 1rem;
      transition: none;
    }
    .ww[data-ww-lib='on'] .ww-back {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      justify-self: start;
      appearance: none;
      margin: 0;
      padding: 0.45rem 0.1rem;
      border: 0;
      background: none;
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ww-ink);
      cursor: pointer;
    }
    .ww-back::before { content: '\2039'; font-size: 1.4em; line-height: 0.6; }
    .ww-ui { justify-self: center; width: 100%; }
    .ww-panel.is-portrait .ww-ui { width: auto; }
    .ww-info { gap: 0.55rem; }
    .ww-blurb { font-size: 1.06rem; }
    .ww-buy { gap: 0.6rem 1rem; }
  }
  /* A tight screen (a small laptop, 1141x636; a short phone, 375x667 / 360x740) has no glass to spare: the window
     takes the height the text leaves it, so the text keeps its look but steps down to about its old size. The small
     laptop also keeps the price row on one line in its ~456 px column (wrapped, DRIFT's window went 195 -> 54 px
     tall). Measured on the bench, 2026-11-01. */
  @media (min-width: 861px) and (max-width: 1200px) {
    .ww { --ww-side-min: 17rem; }
    .ww[data-ww-lib='on'] .ww-tag-ask { font-size: 1.6rem; }
    .ww-cat { font-size: 1.52rem; padding: 0.3rem 0.55rem 0.16rem; }
    .ww-price { font-size: 1.75rem; }
  }
  @media (max-width: 860px) and (max-height: 760px) {
    .ww-pname { font-size: 1.75rem; }
    .ww-price { font-size: 1.9rem; }
  }
  @media (min-width: 861px) and (max-width: 1200px), (max-width: 860px) and (max-height: 760px) {
    .ww-blurb { font-size: 1rem; line-height: 1.4; }
    .ww-pwords { font-size: 0.9rem; }
  }
  @supports (height: 100svh) {
    @media (max-width: 860px) {
      .ww[data-ww-bg='screen'] {
        --ww-info-h: 15rem; /* back + name + blurb + words + price + key + link (measured, 390) */
        /* the screen starts full (Dan 2026-11-03): centred, a 390x844 phone showed ~140 px of bare glass over the
           menu and over the back key. The menu sits at the top; the list takes the glass left under it and spaces
           its rows over it, one slot per plugin on the TV, so a category with fewer keeps the same spacing from the
           top instead of spreading two rows over the whole glass */
        align-content: start;
      }
      .ww[data-ww-bg='screen']:not([data-ww-view='panel']) { grid-template-rows: auto 1fr; }
      .ww[data-ww-bg='screen'] .ww-list {
        align-self: stretch;
        grid-template-rows: repeat(var(--ww-rows, 5), auto);
        align-content: space-evenly;
      }
      .ww[data-ww-bg='screen'] .ww-panel:not(.is-portrait) .ww-ui :global(img),
      .ww[data-ww-bg='screen'] .ww-panel:not(.is-portrait) .ww-ui video {
        max-width: calc(max(8rem, var(--ww-room) - var(--ww-info-h)) * var(--ww-ar, 2));
        margin-inline: auto;
      }
      .ww[data-ww-bg='screen'] .ww-panel.is-portrait .ww-ui :global(img) {
        height: max(8rem, min(24rem, calc(var(--ww-room) - var(--ww-info-h))));
        margin-inline: auto;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ww-name,
    .ww-thumb,
    .ww-thumb :global(img),
    .ww-panel,
    .ww-screen,
    .ww-screen-fx,
    .ww-frame { transition: none; }
    .ww-list.is-swapping .ww-item:not([hidden]) .ww-row { animation: none; }
  }

  /* high contrast: a plain list. The screen, its glass and the frame go (the hc wall shows), the names are plain
     type, the lit one in oxide */
  :global(html.hc) .ww-screen,
  :global(html.hc) .ww-screen-fx,
  :global(html.hc) .ww-frame { display: none !important; }
  :global(html.hc) .ww-name {
    color: var(--fg);
    -webkit-text-stroke: 0;
    opacity: 1;
    filter: none;
  }
  :global(html.hc) .ww-row.is-lit .ww-name { color: var(--oxide-text); }
  :global(html.hc) .ww-thumb { opacity: 1; }
  :global(html.hc) :is(.ww-tag, .ww-tag-ask, .ww-cat, .ww-pname, .ww-blurb, .ww-pw, .ww-price) { text-shadow: none; }
</style>
