---
/* WordWall — what the sound does, sprayed on the back wall.
   Five stencil words in the house display face, outlined in brass and
   fading outward from the one filled word, beside the RevLimiter window.
   The layout is the "adjective stack next to the UI" beat from the garage
   homepage pass (2026-09-06, reference: kaelalden.com/products/vibe-rewind)
   rebuilt in the RevAudio garage: paint on wood, not type on a gradient.

   Honesty: the words describe what the chain is built to do (PRODUCT.md /
   CLAUDE.md: loudness, depth, punch, warmth, glue), not measured results.
   The filled word is --oxide-text, never race-red — the red sweep in the
   hero is this page's one red element.

   The graded opacity lives on the inner span, NOT on the reveal item: the
   reveal lib animates the item's opacity to 1 and would erase the fade.

   The DRIFT panel (first while drift.homeLead is on) has its own looks,
   picked by DRIFT_LOOK below and tuned on the dev bench /__wwbench
   (tools/wwbench, Dan 2026-10-14: the brass stencil said nothing about DRIFT):
     current  today's brass stencil, untouched
     neon     a neon shop sign bolted to the wood: every word is a glass tube,
              SLIDING is lit in DRIFT magenta (a sign is a lamp, so it may
              glow, and its light spills onto the wall), a dim vertical
              ドリフト tube beside the stack. The lit tube powers on with a
              short flicker the first time the panel is shown; hover a word
              and its tube strikes on.
     steer    your hand is the wheel: on a mouse, pointer X over the wall
              steers the words, each on its own damped spring (lower word =
              heavier, like low bands lagging the highs), SLIDING furthest,
              leaning with its speed and leaving a fading skid smear. On touch
              there is no hover: one drift-in entrance when the panel is first
              shown.
     both     neon tubes that steer (the lit tube's spill rides with it)
   Every tunable is a --ww-* custom property on the panel (defaults in the
   style block), read by src/lib/wordwallDrift.ts when a gesture starts, so
   the bench retunes it live. Motion is feedback only (the flicker answers
   "the panel came on", the springs answer the hand); reduced motion = lit
   and still; html.hc = plain words like the other panels. The window is the
   live DRIFT video (public/drift/wall-run-*), playing only while the DRIFT
   panel is the active one and on screen; the poster stays for reduced motion.
   Animation never touches the reveal item (the li): words, spills and the
   skid are inner spans. */
import { existsSync } from 'node:fs';
import { Image, getImage } from 'astro:assets';
import GarageWall from './GarageWall.astro';
import rlImg from '../assets/plugins/revlimiter-hero.png';
import gasImg from '../assets/plugins/gas-hero.png';
import rrImg from '../assets/plugins/radioroulette-hero.png';
import driftImg from '../assets/showcase/drift-window-init.png';
import { drift } from '../data/drift';

/* The DRIFT panel's look (see the header): 'current' | 'neon' | 'steer' | 'both'.
   Tune on /__wwbench (npm run dev), then "apply ww bench" bakes the numbers
   into the --ww-* defaults below and this constant. */
const DRIFT_LOOK: 'current' | 'neon' | 'steer' | 'both' = 'both';

/* The live window: an HD run of DRIFT (1440 desktop / 800 phone) with its
   first frame as the poster. Only when every file is on disk; otherwise the
   panel keeps the still screenshot (no placeholder video, no fake). */
const wallPosterSrc = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../assets/showcase/drift-window-wall.png', { eager: true }),
)[0]?.default;
const WALL_RUN = ['wall-run-1440.webm', 'wall-run-1440.mp4', 'wall-run-800.webm', 'wall-run-800.mp4'];
const wallRunReady = !!wallPosterSrc && WALL_RUN.every((f) => existsSync(`public/drift/${f}`));
const wallPoster = wallRunReady && wallPosterSrc
  ? await getImage({ src: wallPosterSrc, width: 1400, format: 'webp', quality: 82 })
  : null;

/* One panel per plugin in the carousel rotation. The panel whose slug matches
   the centred slide is the visible one; PluginShowcase dispatches
   `showcase:change` {slug} on every move and the script below swaps panels.
   First panel = the carousel's first slide (RevLimiter), visible at load with
   the scroll-reveal stagger; the others enter with a CSS stagger on swap.
   Keep the order in sync with SLIDES in PluginShowcase.astro (DRIFT goes
   first while drift.homeLead is on, same as the carousel). */
type Word = { w: string; o: number; hot?: boolean };
type Panel = {
  slug: string;
  name: string;
  words: Word[];
  img: ImageMetadata;
  alt: string;
  portrait?: boolean;
  blurb: string;
};
const panels: Panel[] = [
  // DRIFT: only while it leads the carousel (drift.homeLead). The window is
  // rendered from Drift main 6144b8c (preset Init, no race loaded: no F1
  // names, Decision 19), the same shot as the carousel card's arcade screen.
  // Words = what a panner does.
  ...(drift.homeLead
    ? [{
        slug: 'drift',
        name: 'DRIFT',
        words: [
          { w: 'Moving',  o: 0.5 },
          { w: 'Steered', o: 0.72 },
          { w: 'Sliding', o: 1, hot: true },
          { w: 'Wide',    o: 0.72 },
          { w: 'Alive',   o: 0.5 },
        ],
        img: driftImg,
        alt: 'DRIFT plugin window: the steering wheel over the gauges, BAND SELECT and STEREO IMAGER on the left, the effects and the TRACKS screen on the right',
        blurb:
          `A panner you steer like a drift car. Steer by hand with the wheel, or hand it to a track shape locked to your tempo. ` +
          (drift.phase === 'preopen' ? `Free ${drift.trialDays}-day trial, by email ${drift.trialOpensDay}.`
            : drift.phase === 'open' ? `Free ${drift.trialDays}-day trial, by email.`
            : `On sale ${drift.releaseLabel}.`),
      }]
    : []),
  {
    slug: 'revlimiter',
    name: 'RevLimiter',
    words: [
      { w: 'Loud',   o: 0.5 },
      { w: 'Warm',   o: 0.72 },
      { w: 'Punchy', o: 1, hot: true },
      { w: 'Glued',  o: 0.72 },
      { w: 'Deep',   o: 0.5 },
    ],
    img: rlImg,
    alt: 'RevLimiter plugin window: the rev gauge with its redline, the band controls and the meters',
    blurb:
      // Chain spot + redline meaning match the product page (Yoni 2026-10-07:
      // last on the master bus; redline = threshold, as in the plugin's DESIGN.md).
      'Multiband compression, saturation and an adaptive limiter in one chain, built to sit last on your master bus. The redline is the threshold.',
  },
  {
    slug: 'gas',
    name: 'GAS',
    words: [
      { w: 'Gritty', o: 0.5 },
      { w: 'Warm',   o: 0.72 },
      { w: 'Driven', o: 1, hot: true },
      { w: 'Thick',  o: 0.72 },
      { w: 'Raw',    o: 0.5 },
    ],
    img: gasImg,
    alt: 'GAS plugin window: one DRIVE knob with the Tube, Tape and Fuzz selector and the heat lamp',
    portrait: true,
    blurb:
      'One DRIVE knob, three voices: Tube, Tape, Fuzz. Turn it and the character changes, never the volume. Free, and it stays free.',
  },
  {
    slug: 'radio-roulette',
    name: 'Radio Roulette',
    words: [
      { w: 'Random',  o: 0.5 },
      { w: 'Twisted', o: 0.72 },
      { w: 'Lucky',   o: 1, hot: true },
      { w: 'Weird',   o: 0.72 },
      { w: 'Alive',   o: 0.5 },
    ],
    img: rrImg,
    alt: 'Radio Roulette plugin window: the tuning dial, the lit effect names on the glass, five station keys and the VU',
    blurb:
      'Ten effects on one dial, set by a single station number. Tune it, or let it scan and land somewhere you would never have picked yourself.',
  },
];
---

<GarageWall id="sound" ariaLabel="What the plugin does">
  <div class="ww" data-wordwall>
    {panels.map((p, i) => {
      // DRIFT only: the look attribute + the light/skid/kana spans the looks
      // switch on (hidden in 'current'); every other panel renders as before
      const isDrift = p.slug === 'drift';
      return (
      <div
        class:list={['ww-panel', { 'is-active': i === 0, 'is-portrait': p.portrait }]}
        data-ww-panel={p.slug}
        data-ww-look={isDrift ? DRIFT_LOOK : undefined}
        aria-hidden={i === 0 ? 'false' : 'true'}
      >
        <div class="ww-words">
          <p class="ww-tag">What it does</p>
          <ul
            class="ww-list"
            role="list"
            {...(i === 0 ? { 'data-reveal-group': true, 'data-stagger': '0.07' } : {})}
          >
            {p.words.map((x, k) => (
              <li {...(i === 0 ? { 'data-reveal-item': true } : {})} style={`--i:${k}`}>
                {isDrift && <span class:list={['ww-spill', { 'is-hot': x.hot }]} aria-hidden="true"></span>}
                {isDrift && x.hot && <span class="ww-skid" aria-hidden="true">{x.w}</span>}
                <span class:list={['ww-word', { 'is-hot': x.hot }]} style={`--o:${x.o}`}>{x.w}</span>
              </li>
            ))}
          </ul>
          {isDrift && <span class="ww-kana" lang="ja" aria-hidden="true">ドリフト</span>}
        </div>

        <figure class="ww-ui" {...(i === 0 ? { 'data-reveal': 'card' } : {})}>
          {isDrift && wallPoster && wallPosterSrc ? (
            <video
              class="ww-run"
              data-ww-run
              muted
              loop
              playsinline
              preload="none"
              disablepictureinpicture
              poster={wallPoster.src}
              width={wallPosterSrc.width}
              height={wallPosterSrc.height}
              role="img"
              aria-label={p.alt}
            >
              <source src="/drift/wall-run-800.webm" type="video/webm" media="(max-width: 860px)" />
              <source src="/drift/wall-run-800.mp4" type="video/mp4" media="(max-width: 860px)" />
              <source src="/drift/wall-run-1440.webm" type="video/webm" />
              <source src="/drift/wall-run-1440.mp4" type="video/mp4" />
            </video>
          ) : (
          <Image
            src={p.img}
            alt={p.alt}
            width={1400}
            widths={[400, 640, 960, 1400]}
            sizes={p.portrait
              /* height-capped (24rem phone / 34rem desktop) at 1600:2380 → ≤258 / ≤366px wide */
              ? '(max-width: 860px) 280px, 400px'
              : '(max-width: 860px) 92vw, 50vw'}
            format="webp"
            quality={86}
            loading="lazy"
          />
          )}
          <figcaption>
            <strong>{p.name}.</strong> {p.blurb}
          </figcaption>
          {/* phone only: the name centred under the window + one way in to
              the plugin's page (Dan, 2026-09-08). Desktop shows the caption
              above instead; the two never render together. */}
          <div class="ww-go">
            <span class="ww-go-name">{p.name}</span>
            <a class="ww-go-btn" href={`/${p.slug}`}>See {p.name} &rarr;</a>
          </div>
        </figure>
      </div>
      );
    })}
  </div>
</GarageWall>

<script>
  import { initDriftWall } from '../lib/wordwallDrift';

  /* Follow the carousel: PluginShowcase fires showcase:change {slug} on every
     move. Swap the matching panel in; the CSS below crossfades and re-runs
     the word stagger. Unknown slug (a slide with no panel) = keep the current
     panel rather than blank the wall. */
  const wall = document.querySelector<HTMLElement>('[data-wordwall]');
  if (wall) {
    const panels = Array.from(wall.querySelectorAll<HTMLElement>('[data-ww-panel]'));
    const section = wall.closest<HTMLElement>('section');
    document.addEventListener('showcase:change', (e) => {
      const slug = (e as CustomEvent<{ slug?: string }>).detail?.slug;
      const next = panels.find((p) => p.dataset.wwPanel === slug);
      if (!next || next.classList.contains('is-active')) return;
      panels.forEach((p) => {
        const on = p === next;
        p.classList.toggle('is-active', on);
        p.setAttribute('aria-hidden', on ? 'false' : 'true');
      });
      const name = next.querySelector('figcaption strong')?.textContent?.replace(/\.$/, '') ?? 'the plugin';
      section?.setAttribute('aria-label', `What ${name} does`);
    });
    // DRIFT's looks: neon power-on, steering springs, the live window video
    const driftPanel = panels.find((p) => p.dataset.wwPanel === 'drift');
    if (driftPanel) initDriftWall(driftPanel);
  }
</script>

<style>
  .ww {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 4vw, 2.5rem);
    /* all panels stacked in one cell: the wall keeps the tallest panel's
       height so swapping never shifts the sections below */
    display: grid;
  }
  .ww-panel {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 320ms ease, visibility 0s linear 320ms;
  }
  .ww-panel.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 320ms ease 60ms, visibility 0s;
  }
  /* swap-in stagger for the non-first panels (the first one rides the
     scroll-reveal lib instead); one word after another, top to bottom */
  .ww-panel:not(:first-child).is-active .ww-list li {
    animation: ww-strike 420ms cubic-bezier(0.2, 0.9, 0.25, 1.1) both;
    animation-delay: calc(60ms + var(--i, 0) * 70ms);
  }
  @keyframes ww-strike {
    from { opacity: 0; transform: translateY(18px) scale(0.97); }
    to   { opacity: 1; transform: none; }
  }

  .ww-tag {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--brass);
    text-shadow: var(--engrave-fine);
  }
  .ww-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ww-list li { line-height: 0; }

  /* stencil: outlined brass, one word filled in oxide, ~120ms house strike on hover */
  .ww-word {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(3.6rem, 9vw, 8.4rem);
    line-height: 0.92;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 2px var(--brass);
    opacity: var(--o, 0.5);
    filter: drop-shadow(0 2px 0 rgba(0, 0, 0, 0.9));
    transition:
      color 120ms cubic-bezier(0.2, 0.9, 0.25, 1.25),
      opacity 120ms cubic-bezier(0.2, 0.9, 0.25, 1.25),
      -webkit-text-stroke-color 120ms cubic-bezier(0.2, 0.9, 0.25, 1.25);
    cursor: default;
  }
  .ww-word.is-hot {
    color: var(--oxide-text);
    -webkit-text-stroke-color: var(--oxide-text);
  }
  .ww-word:hover {
    color: var(--brass-bright);
    -webkit-text-stroke-color: var(--brass-bright);
    opacity: 1;
  }
  .ww-word.is-hot:hover {
    color: var(--oxide-text);
    -webkit-text-stroke-color: var(--oxide-text);
  }

  /* the plugin window, hung on the wall (DRIFT's is the live video) */
  .ww-ui { margin: 0; }
  .ww-ui img,
  .ww-panel[data-ww-panel='drift'] .ww-ui video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    box-shadow:
      0 1px 0 0 #000,
      0 24px 48px rgba(0, 0, 0, 0.55);
  }
  /* GAS's window is a tall single-knob panel: cap it and centre it so it
     hangs like the others instead of towering over the words */
  .ww-panel.is-portrait .ww-ui img {
    width: auto;
    max-width: 100%;
    max-height: clamp(22rem, 46vw, 34rem);
    margin: 0 auto;
  }
  /* Both plates are baked on a black/near-black ground with rounded bezels,
     so the raw <img> rectangle shows dark corners against the wood. Clip to
     the bezel's own arc (radii measured off the PNGs: GAS ≈170px of 1600×2380,
     Radio Roulette ≈220px top / ≈260px bottom of 2546×1415), nudged a hair
     larger so the 1–2px black rim goes with them. Percent radii = x/w, y/h,
     so the arc stays circular at every rendered size. The shadow follows. */
  .ww-panel[data-ww-panel='gas'] .ww-ui img {
    border-radius: 11% / 7.4%;
  }
  .ww-panel[data-ww-panel='radio-roulette'] .ww-ui img {
    border-radius: 9% 9% 10.6% 10.6% / 16.2% 16.2% 19% 19%;
  }
  .ww-panel.is-portrait .ww-ui figcaption {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .ww-go { display: none; }

  .ww-ui figcaption {
    margin-top: 1.1rem;
    max-width: 36rem;
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--fg);
    opacity: 0.86;
    text-shadow: var(--engrave-fine);
  }
  .ww-ui figcaption strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.25em;
    letter-spacing: 0.04em;
    color: var(--brass-bright);
  }

  /* Phone: the "stencil stack over the window" beat from the reference
     (kaelalden.com/products/vibe-rewind, 2026-09-08). One column, words
     start at the top and the window hangs right under them. align-content
     start matters: the panels share one grid cell and the tallest (GAS,
     portrait) sets the cell height, so the default stretch + align-items
     center opened a ~400px hole between the words and the plugin. The
     kicker goes, the words grow to the wall's width, the caption shrinks. */
  @media (max-width: 860px) {
    .ww { padding-top: 2rem; padding-bottom: 2.5rem; }
    .ww-panel {
      grid-template-columns: 1fr;
      align-content: start;
      align-items: start;
      gap: 2.25rem;
    }
    .ww-tag { display: none; }
    /* on the phone the inactive panels leave the flow entirely: the shared
       cell would otherwise keep the tallest panel's height and leave a run
       of empty wall under the caption. The swap becomes a cut + the word
       stagger (no crossfade); nothing below the section shifts noticeably. */
    .ww-panel:not(.is-active) { display: none; }
    .ww-word {
      font-size: clamp(4rem, 19vw, 6.4rem);
      line-height: 0.9;
      letter-spacing: 0.03em;
      -webkit-text-stroke-width: 1.5px;
    }
    .ww-panel.is-portrait .ww-ui img { max-height: 24rem; }
    /* no caption on the phone (Dan, 2026-09-08): the window speaks, the
       blurb repeats the product page. Stays in the DOM for desktop + SR. */
    .ww-ui figcaption { display: none; }
    .ww-go {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.9rem;
      margin-top: 1.4rem;
      text-align: center;
    }
    .ww-go-name {
      font-family: var(--font-display);
      font-size: clamp(1.6rem, 7vw, 2.2rem);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--brass-bright);
      text-shadow: var(--engrave);
    }
    /* same enamel as the closing trial button (index.astro .trial-cta) */
    .ww-go-btn {
      display: inline-block;
      padding: 0.85rem 1.9rem;
      border-radius: 4px;
      background: var(--brass-bright);
      color: var(--bg-0);
      font-family: var(--font-display);
      font-size: 1.05rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      text-decoration: none;
      text-shadow: none;
    }
    .ww-go-btn:active { filter: brightness(1.12); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ww-word { transition: none; }
    .ww-panel { transition: none; }
    .ww-panel:not(:first-child).is-active .ww-list li { animation: none; }
  }

  :global(html.hc) .ww-word {
    color: var(--fg);
    -webkit-text-stroke: 0;
    opacity: 1;
    filter: none;
  }
  :global(html.hc) .ww-word.is-hot { color: var(--oxide-text); }

  /* ==========================================================================
     DRIFT panel looks (2026-10-14, Dan: "needs a more interesting design").
     Picked by DRIFT_LOOK (frontmatter) -> data-ww-look; tuned on /__wwbench.
     Every rule hangs off .ww-panel[data-ww-panel='drift'] so RevLimiter, GAS
     and Radio Roulette render exactly as before. 'current' = none of this
     except the live window video.
     ========================================================================== */
  @font-face {
    /* the DRIFT season page's Japanese subset (drift.css), ドリフト included */
    font-family: 'Drift JP';
    src: url('/fonts/drift/NotoSansJP-var.subset-v2.woff2') format('woff2');
    font-weight: 700 900;
    font-display: swap;
  }

  .ww-panel[data-ww-panel='drift'] {
    /* NEON. One hue drives the sign; the offsets below land on the /drift
       tokens at the default 301 (tube = --d-lcd #f24cf0, halo = --d-neon
       #d23cff, kana = --d-crt #d98bff, glass = --d-fg-dim #a58cc4, core =
       --d-pink-ink #ffd1f8 at 91). Additive and local to this panel. */
    --ww-neon-h: 301;        /* tube hue, degrees */
    --ww-neon-core: 91;      /* lit core lightness, % (never 100 = #fff) */
    --ww-neon-glow: 1;       /* glow radius scale */
    --ww-neon-spill: 0.45;   /* the lit tube's light on the wood, alpha */
    --ww-neon-off: 0.5;      /* unlit glass tubes, visibility */
    /* STEER. Read by src/lib/wordwallDrift.ts when a gesture starts. */
    --ww-steer-travel: 56px; /* how far SLIDING slides at full lock (others less) */
    --ww-steer-k: 140;       /* spring stiffness (1/s^2): higher = snappier */
    --ww-steer-damp: 0.6;    /* damping ratio: 1 = no overshoot, lower = more bounce */
    --ww-steer-spread: 0.6;  /* how differently the words lag (0 = all the same) */
    --ww-steer-skew: 0.8;    /* SLIDING's lean, degrees per 100 px/s */
    --ww-skid: 0.6;          /* skid smear strength (0 = none) */
    --ww-steer-entry: 140px; /* touch: how far off the side SLIDING drifts in from */
  }

  /* the extra spans exist only in the DRIFT panel; each look switches its own on */
  .ww-panel[data-ww-panel='drift'] .ww-spill,
  .ww-panel[data-ww-panel='drift'] .ww-skid,
  .ww-panel[data-ww-panel='drift'] .ww-kana { display: none; }

  /* the live window keeps the screenshot's box: same ratio, same radius + shadow */
  .ww-panel[data-ww-panel='drift'] .ww-ui video {
    aspect-ratio: 1725 / 912;
    object-fit: cover;
    background-color: var(--bg-1);
  }

  /* every new look: the item hugs its word (the spill + skid size off it) and
     the window hangs above the words' light */
  .ww-panel[data-ww-panel='drift']:not([data-ww-look='current']) .ww-list li {
    position: relative;
    width: fit-content;
  }
  .ww-panel[data-ww-panel='drift']:not([data-ww-look='current']) .ww-ui {
    position: relative;
    z-index: 1;
  }

  /* ---- NEON: a neon shop sign bolted to the garage wood ------------------- */
  .ww-panel[data-ww-panel='drift']:is([data-ww-look='neon'], [data-ww-look='both']) {
    --ww-tube: hsl(var(--ww-neon-h) 86% 62%);
    --ww-core: hsl(calc(var(--ww-neon-h) + 8) 100% calc(var(--ww-neon-core) * 1%));
    --ww-halo-a: hsl(calc(var(--ww-neon-h) - 15) 100% 62% / 0.9);
    --ww-halo-b: hsl(calc(var(--ww-neon-h) - 15) 100% 62% / 0.5);
    --ww-glass-edge: hsl(calc(var(--ww-neon-h) - 34) 32% 72% / var(--ww-neon-off));
    --ww-glass-body: hsl(calc(var(--ww-neon-h) - 34) 32% 66% / calc(var(--ww-neon-off) * 0.12));
    --ww-glass-spec: hsl(calc(var(--ww-neon-h) - 34) 40% 92% / calc(var(--ww-neon-off) * 0.7));
    --ww-spill-c: hsl(calc(var(--ww-neon-h) - 15) 100% 62% / var(--ww-neon-spill));
    --ww-spill-c2: hsl(calc(var(--ww-neon-h) - 15) 100% 62% / calc(var(--ww-neon-spill) * 0.45));
    --ww-kana-c: hsl(calc(var(--ww-neon-h) - 21) 100% 77%);
    /* the two states of a tube, as value sets the flicker keyframes switch
       between (same shadow count, so hover can also interpolate) */
    --ww-on-glow:
      0 0 calc(0.015em * var(--ww-neon-glow)) var(--ww-core),
      0 0 calc(0.05em * var(--ww-neon-glow)) var(--ww-tube),
      0 0 calc(0.13em * var(--ww-neon-glow)) var(--ww-halo-a),
      0 0 calc(0.3em * var(--ww-neon-glow)) var(--ww-halo-b);
    --ww-off-glow: 0 0 0 transparent, 0 0 0 transparent, 0 0 0 transparent, 0 0 0 transparent;
    /* glass catches the upper-left light on its top lip, and sits 2px off the wood */
    --ww-off-filter: drop-shadow(-0.5px -0.75px 0 var(--ww-glass-spec)) drop-shadow(0 2px 1.5px rgba(8, 6, 5, 0.7));
  }

  /* unlit tube: pale violet-grey glass, a hair of the outward fade kept */
  .ww-panel[data-ww-panel='drift']:is([data-ww-look='neon'], [data-ww-look='both']) .ww-word {
    position: relative;
    color: var(--ww-glass-body);
    -webkit-text-stroke: 1.5px var(--ww-glass-edge);
    text-shadow: var(--ww-off-glow);
    filter: var(--ww-off-filter);
    opacity: calc(0.75 + 0.25 * var(--o, 0.5));
    transition:
      color 120ms cubic-bezier(0.2, 0.9, 0.25, 1.25),
      -webkit-text-stroke-color 120ms cubic-bezier(0.2, 0.9, 0.25, 1.25),
      text-shadow 120ms cubic-bezier(0.2, 0.9, 0.25, 1.25),
      filter 120ms cubic-bezier(0.2, 0.9, 0.25, 1.25),
      opacity 120ms cubic-bezier(0.2, 0.9, 0.25, 1.25);
  }
  /* lit tube: warm near-white core, tube-colour skin, the glow it throws */
  .ww-panel[data-ww-panel='drift']:is([data-ww-look='neon'], [data-ww-look='both']) .ww-word.is-hot {
    color: var(--ww-core);
    -webkit-text-stroke-color: var(--ww-tube);
    text-shadow: var(--ww-on-glow);
    filter: none;
    opacity: 1;
  }
  /* hover strikes an unlit tube on: the house ~120ms snap plus one stutter.
     Real hover only: a phone's sticky tap-hover would leave a second tube lit. */
  @media (hover: hover) {
    .ww-panel[data-ww-panel='drift']:is([data-ww-look='neon'], [data-ww-look='both']) li:hover > .ww-word {
      color: var(--ww-core);
      -webkit-text-stroke-color: var(--ww-tube);
      text-shadow: var(--ww-on-glow);
      filter: none;
      opacity: 1;
    }
    .ww-panel[data-ww-panel='drift']:is([data-ww-look='neon'], [data-ww-look='both']) li:hover > .ww-word:not(.is-hot) {
      animation: ww-neon-strike 170ms steps(1, end);
    }
  }

  /* the light leaks: a soft spill on the wood behind a lit tube (a lamp's
     light, Law 4). Screen-blended against the wall, so the grain brightens. */
  .ww-panel[data-ww-panel='drift']:is([data-ww-look='neon'], [data-ww-look='both']) .ww-spill {
    display: block;
    position: absolute;
    inset: -60% -16%;
    pointer-events: none;
    background: radial-gradient(closest-side, var(--ww-spill-c), var(--ww-spill-c2) 55%, transparent);
    mix-blend-mode: screen;
    opacity: 0;
    transition: opacity 120ms cubic-bezier(0.2, 0.9, 0.25, 1.25);
  }
  .ww-panel[data-ww-panel='drift']:is([data-ww-look='neon'], [data-ww-look='both']) .ww-spill.is-hot {
    opacity: 1;
  }
  @media (hover: hover) {
    .ww-panel[data-ww-panel='drift']:is([data-ww-look='neon'], [data-ww-look='both']) li:hover > .ww-spill {
      opacity: 1;
    }
  }

  /* ドリフト: a small vertical tube beside the stack, burning dim */
  .ww-panel[data-ww-panel='drift']:is([data-ww-look='neon'], [data-ww-look='both']) .ww-words {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 0.75rem;
  }
  .ww-panel[data-ww-panel='drift']:is([data-ww-look='neon'], [data-ww-look='both']) .ww-tag {
    grid-column: 1 / -1;
    grid-row: 1;
  }
  .ww-panel[data-ww-panel='drift']:is([data-ww-look='neon'], [data-ww-look='both']) .ww-list {
    grid-column: 1;
    grid-row: 2;
  }
  .ww-panel[data-ww-panel='drift']:is([data-ww-look='neon'], [data-ww-look='both']) .ww-kana {
    display: block;
    grid-column: 2;
    grid-row: 2;
    align-self: start;
    margin-top: 0.4em;
    writing-mode: vertical-rl;
    text-orientation: upright;
    font-family: 'Drift JP', 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', 'Yu Gothic UI', Meiryo, sans-serif;
    font-weight: 700;
    font-size: clamp(1.05rem, 2.1vw, 1.9rem);
    line-height: 1;
    letter-spacing: 0.14em;
    /* one tube: WebKit sizes an orthogonal (vertical) grid item against a short
       guess and would break it into two columns on a phone */
    white-space: nowrap;
    color: var(--ww-kana-c);
    opacity: 0.6;
    text-shadow:
      0 0 0.1em var(--ww-halo-a),
      0 0 0.45em var(--ww-halo-b);
    pointer-events: none;
    user-select: none;
  }

  /* power-on (JS only: no JS / reduced motion = simply lit). armed = the sign
     is off until the panel is first seen; powering = 600ms, three stutters,
     then steady. The kana catches with the last strike. */
  .ww-panel[data-ww-panel='drift']:is([data-ww-look='neon'], [data-ww-look='both'])[data-ww-power='armed'] .ww-word.is-hot {
    color: var(--ww-glass-body);
    -webkit-text-stroke-color: var(--ww-glass-edge);
    text-shadow: var(--ww-off-glow);
    filter: var(--ww-off-filter);
    transition: none;
  }
  .ww-panel[data-ww-panel='drift']:is([data-ww-look='neon'], [data-ww-look='both'])[data-ww-power='armed'] .ww-spill.is-hot {
    opacity: 0;
    transition: none;
  }
  .ww-panel[data-ww-panel='drift']:is([data-ww-look='neon'], [data-ww-look='both'])[data-ww-power='armed'] .ww-kana {
    color: var(--ww-glass-edge);
    text-shadow: none;
  }
  .ww-panel[data-ww-panel='drift']:is([data-ww-look='neon'], [data-ww-look='both'])[data-ww-power='powering'] .ww-word.is-hot {
    animation: ww-neon-power 600ms steps(1, end) both;
  }
  .ww-panel[data-ww-panel='drift']:is([data-ww-look='neon'], [data-ww-look='both'])[data-ww-power='powering'] .ww-spill.is-hot {
    animation: ww-spill-power 600ms steps(1, end) both;
  }
  .ww-panel[data-ww-panel='drift']:is([data-ww-look='neon'], [data-ww-look='both'])[data-ww-power='powering'] .ww-kana {
    animation: ww-kana-power 600ms steps(1, end) both;
  }
  @keyframes ww-neon-power {
    0%, 15%, 37%, 61% {
      color: var(--ww-glass-body);
      -webkit-text-stroke-color: var(--ww-glass-edge);
      text-shadow: var(--ww-off-glow);
      filter: var(--ww-off-filter);
    }
    9%, 31%, 54%, 70%, 100% {
      color: var(--ww-core);
      -webkit-text-stroke-color: var(--ww-tube);
      text-shadow: var(--ww-on-glow);
      filter: none;
    }
  }
  @keyframes ww-spill-power {
    0%, 15%, 37%, 61% { opacity: 0; }
    9%, 31%, 54%, 70%, 100% { opacity: 1; }
  }
  @keyframes ww-kana-power {
    0%, 61% { color: var(--ww-glass-edge); text-shadow: none; }
    70%, 100% { color: var(--ww-kana-c); text-shadow: 0 0 0.1em var(--ww-halo-a), 0 0 0.45em var(--ww-halo-b); }
  }
  /* the strike: lit, one dip back to glass, lit */
  @keyframes ww-neon-strike {
    35% {
      color: var(--ww-glass-body);
      -webkit-text-stroke-color: var(--ww-glass-edge);
      text-shadow: var(--ww-off-glow);
    }
    0%, 60%, 100% {
      color: var(--ww-core);
      -webkit-text-stroke-color: var(--ww-tube);
      text-shadow: var(--ww-on-glow);
    }
  }

  /* ---- STEER: your hand is the wheel ------------------------------------ */
  /* JS writes the words' transform (translate + SLIDING's lean); they pivot
     on their feet, where the tyres would be */
  .ww-panel[data-ww-panel='drift']:is([data-ww-look='steer'], [data-ww-look='both']) .ww-word {
    transform-origin: 50% 100%;
  }
  /* burnt rubber: a blurred dark ghost of SLIDING left on the wood where it
     slid, fading over ~1.2s (opacity + position from JS) */
  .ww-panel[data-ww-panel='drift']:is([data-ww-look='steer'], [data-ww-look='both']) .ww-skid {
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-display);
    font-size: clamp(3.6rem, 9vw, 8.4rem);
    line-height: 0.92;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(14, 9, 6, 0.9);
    filter: blur(3px);
    mix-blend-mode: multiply;
    transform-origin: 0 50%;
    opacity: 0;
    pointer-events: none;
    user-select: none;
  }

  /* phone sizes: after the base rules above (same specificity, source order wins) */
  @media (max-width: 860px) {
    .ww-panel[data-ww-panel='drift']:is([data-ww-look='steer'], [data-ww-look='both']) .ww-skid {
      font-size: clamp(4rem, 19vw, 6.4rem);
      line-height: 0.9;
      letter-spacing: 0.03em;
