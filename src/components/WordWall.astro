  :global(html.hc) .ww-panel[data-ww-panel='drift'] .ww-spill,
  :global(html.hc) .ww-panel[data-ww-panel='drift'] .ww-skid,
  :global(html.hc) .ww-panel[data-ww-panel='drift'] .ww-kana { display: none !important; }
