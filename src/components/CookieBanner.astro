---
/* Cookie consent banner — shown once per browser, stored in localStorage.
   Accepting also initialises Meta Pixel and the Google Ads tag (gtag.js,
   with Consent Mode v2 signals); declining skips all tracking cookies.
   The footer's "Cookie settings" link reopens it; declining after accepting
   clears the ad cookies and reloads. Cloudflare Web Analytics is cookieless
   and fires unconditionally. */
---

<div
  class="cb"
  id="cookie-banner"
  role="region"
  aria-label="Cookie consent"
  aria-live="polite"
  hidden
>
  <div class="cb-inner">
    <div class="cb-text">
      <p class="cb-body">
        <span class="cb-full">We use cookies and similar tracking technologies to understand how you interact with our site
        and to improve our marketing. By clicking <em>Accept All</em> you consent to our use of
        analytics and advertising cookies. You can also decline; the site works either way.
        See our <a href="/privacy" class="cb-link" data-open-legal="privacy">Privacy Policy</a> for details.</span>
        <span class="cb-short">We use cookies to improve your experience and our marketing.
        <a href="/privacy" class="cb-link" data-open-legal="privacy">Privacy</a>.</span>
      </p>
      <strong class="cb-title"><span class="cb-emoji" aria-hidden="true">🍪</span> We use cookies</strong>
    </div>
    <div class="cb-actions">
      <button type="button" class="cb-btn cb-btn--decline" id="cookie-decline" aria-label="Decline cookies">
        Decline
      </button>
      <button type="button" class="cb-btn cb-btn--accept" id="cookie-accept" aria-label="Accept all cookies">
        Accept All
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'ra-cookie-consent';
    var banner = document.getElementById('cookie-banner');
    if (!banner) return;

    function initMetaPixel() {
      if (window.fbq) return;
      !function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments); };
        if (!f._fbq) f._fbq = n;
        n.push = n; n.loaded = !0; n.version = '2.0';
        n.queue = []; t = b.createElement(e); t.async = !0;
        t.src = v; s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '2907572756308697');
      fbq('track', 'PageView');
    }

    // Google Consent Mode v2, basic: gtag.js loads only after Accept. Default
    // denied, then the update to granted, both queued ahead of the library so
    // its first hit already carries the visitor's choice.
    function consent(value) {
      return { ad_storage: value, analytics_storage: value, ad_user_data: value, ad_personalization: value };
    }
    // A gtag that exists before this script ran was put there by the edge
    // (Cloudflare Google tag gateway, if it is ever switched back on). That
    // tag loads and configures itself, so here it only gets consent signals.
    var edgeGtag = typeof window.gtag === 'function';
    var googleStarted = false;

    function initGoogleAds() {
      if (googleStarted) return;
      googleStarted = true;
      if (edgeGtag) { window.gtag('consent', 'update', consent('granted')); return; }
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      gtag('consent', 'default', consent('denied'));
      gtag('consent', 'update', consent('granted'));
      var t = document.createElement('script');
      t.async = true;
      // Straight from Google, not the Cloudflare tag gateway's /nojr/ path:
      // the gateway also injects its own tag on every page before consent,
      // and it has no switch to keep the path while dropping the injection.
      t.src = 'https://www.googletagmanager.com/gtag/js?id=AW-18334323184';
      document.head.appendChild(t);
      gtag('js', new Date());
      gtag('config', 'AW-18334323184');
    }

    // Undecided or declined: our own loader never runs, so this only matters
    // while an edge-injected tag is present.
    function denyGoogle() {
      if (edgeGtag) window.gtag('consent', 'update', consent('denied'));
    }

    function showBanner() {
      banner.hidden = false;
      requestAnimationFrame(function () { banner.classList.add('cb--visible'); });
      // Move focus to the banner for a11y
      var acceptBtn = document.getElementById('cookie-accept');
      if (acceptBtn) acceptBtn.focus();
    }

    function hideBanner() {
      banner.classList.remove('cb--visible');
      banner.addEventListener('transitionend', function hide() {
        banner.hidden = true;
        banner.removeEventListener('transitionend', hide);
      });
    }

    // Withdrawing consent: drop the Google / Meta first-party cookies on every
    // domain form they may have been set with.
    function clearAdCookies() {
      var host = location.hostname.replace(/^www\./, '');
      document.cookie.split(';').forEach(function (c) {
        var name = c.split('=')[0].trim();
        if (!/^(_gcl|_fbp|_fbc|_ga)/.test(name)) return;
        ['', '; domain=' + host, '; domain=.' + host].forEach(function (d) {
          document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + d;
        });
      });
    }

    var stored = '';
    try { stored = localStorage.getItem(KEY) || ''; } catch (e) {}

    if (stored === 'accepted') {
      initMetaPixel();
      initGoogleAds();
    } else {
      denyGoogle();
      // No decision yet: show the banner once the page settles.
      if (stored !== 'declined') setTimeout(showBanner, 800);
    }

    var acceptBtn = document.getElementById('cookie-accept');
    var declineBtn = document.getElementById('cookie-decline');

    if (acceptBtn) {
      acceptBtn.addEventListener('click', function () {
        try { localStorage.setItem(KEY, 'accepted'); } catch (e) {}
        stored = 'accepted';
        hideBanner();
        initMetaPixel();
        initGoogleAds();
      });
    }

    if (declineBtn) {
      declineBtn.addEventListener('click', function () {
        try { localStorage.setItem(KEY, 'declined'); } catch (e) {}
        var wasAccepted = stored === 'accepted';
        stored = 'declined';
        hideBanner();
        // Tags already running on this page can't be unloaded: clear their
        // cookies and reload so the page comes back without them.
        if (wasAccepted) { clearAdCookies(); location.reload(); }
      });
    }

    // Footer "Cookie settings" link: reopen the banner to change the choice.
    document.addEventListener('click', function (e) {
      var link = e.target && e.target.closest && e.target.closest('[data-cookie-settings]');
      if (!link) return;
      e.preventDefault();
      showBanner();
    });
  })();
</script>

<style>
  .cb {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9000;
    background: var(--bg-0);
    border-top: 1px solid var(--brass);
    box-shadow: 0 -8px 40px rgba(0, 0, 0, 0.55);
    transform: translateY(100%);
    transition: transform 0.4s var(--ease);
    will-change: transform;
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  .cb--visible {
    transform: translateY(0);
  }

  .cb-inner {
    padding: 1.1rem 2.5rem;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2rem;
  }

  .cb-text {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .cb-title {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: 2rem;
    letter-spacing: 0.08em;
    color: var(--brass-bright);
    margin-left: 200px;
  }

  .cb-emoji {
    display: inline-block;
    animation: cb-wobble 2.4s ease-in-out infinite;
    transform-origin: center bottom;
  }

  @keyframes cb-wobble {
    0%,  100% { transform: rotate(0deg) scale(1); }
    15%        { transform: rotate(-12deg) scale(1.15); }
    30%        { transform: rotate(10deg) scale(1.1); }
    45%        { transform: rotate(-8deg) scale(1.05); }
    60%        { transform: rotate(6deg) scale(1.02); }
    75%        { transform: rotate(-3deg) scale(1); }
  }

  .cb-body {
    flex: 1;
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--fg-dim);
  }

  .cb-link {
    color: var(--brass);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cb-link:hover { color: var(--brass-bright); }

  .cb-actions {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
    align-items: center;
  }

  .cb-btn {
    cursor: pointer;
    border-radius: 4px;
    font-family: var(--font-display);
    letter-spacing: 0.06em;
    font-size: 0.85rem;
    padding: 0.55rem 1.3rem;
    transition: background 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
    white-space: nowrap;
  }

  .cb-btn--decline {
    background: transparent;
    border: 1px solid var(--border-bright);
    color: var(--fg-dim);
  }
  .cb-btn--decline:hover {
    border-color: var(--fg-dim);
    color: var(--fg);
  }

  .cb-btn--accept {
    background: var(--brass);
    border: 1px solid var(--brass);
    color: #0a0908;
  }
  .cb-btn--accept:hover {
    background: var(--brass-bright);
    border-color: var(--brass-bright);
  }

  /* Desktop shows the full copy; the short line is phone-only. */
  .cb-short { display: none; }

  /* Original small-screen stack (601–640px unchanged from before Phase B). */
  @media (max-width: 640px) {
    .cb-inner {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1rem 1.1rem 1.2rem;
    }
    .cb-text {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .cb-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .cb-btn {
      text-align: center;
    }
    .cb-title {
      margin-left: 0;
    }
  }

  /* ── Phones (≤600px): slim bottom sheet. Tighter padding + condensed copy so
     it never buries the hero on first paint; buttons padded to ≥44px. ── */
  @media (max-width: 600px) {
    .cb-inner {
      grid-template-columns: 1fr;
      gap: 0.6rem;
      padding: 0.75rem 1rem 0.85rem;
    }
    .cb-text {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2rem;
    }
    /* Title first, then the short line — reads as a compact sheet header. */
    .cb-title {
      order: -1;
      margin-left: 0;
      font-size: 1.15rem;
      letter-spacing: 0.06em;
    }
    .cb-full { display: none; }
    .cb-short { display: inline; }
    .cb-body { font-size: 0.78rem; line-height: 1.4; }
    .cb-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
    }
    .cb-btn {
      text-align: center;
      min-height: 44px;
      padding: 0.5rem 1rem;
    }
  }
</style>
