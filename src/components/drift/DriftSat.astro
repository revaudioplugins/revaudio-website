---
/**
 * Section 6 — SATURATE. The real SATURATE bay cut from the plugin render
 * (power dome, TYPE selector, DRIVE flame knob) beside the SAT_TYPE window's
 * four legends. Copy = the plugin's own tooltip for Saturation Type, word for
 * word in meaning (TAPE / TUBE / XFMR / DIGITAL). 熱 = heat: the TEMP gauge
 * on the dash is this stage's heat readout.
 */
import { getImage } from 'astro:assets';
import DriftPanel from './DriftPanel.astro';
import baySrc from '../../assets/seasons/drift/sat-bay.png';

const bay = await getImage({ src: baySrc, width: 930, format: 'webp', quality: 80 });
const types = [
  { id: 'tape', label: 'TAPE', desc: 'Warm, rounded compression.' },
  { id: 'tube', label: 'TUBE', desc: 'Brighter odd-harmonic bite.' },
  { id: 'xfmr', label: 'XFMR', desc: 'Iron-core transformer: the bass rounds off first.' },
  { id: 'digital', label: 'DIGITAL', desc: 'Bit crush and sample-rate decimation.' },
];
---
<section class="d-sec" aria-labelledby="d-sat-h">
  <div class="d-wrap">
    <div class="d-sechead">
      <h2 id="d-sat-h">Saturate</h2>
      <span class="d-ja" lang="ja" aria-hidden="true">熱</span>
      <span class="d-rule" aria-hidden="true"></span>
    </div>

    <div class="d-sat">
      <img class="d-sat-bay" src={bay.src} width="465" alt="DRIFT's saturation bay: power light, type selector and the DRIVE knob with its flame pointer" loading="lazy" decoding="async" />
      <DriftPanel sticker="熱" checker={false}>
        <p class="d-lede">Four drive circuits on one detented selector. DRIVE feeds them harder: ride it like a throttle. Small moves colour, big moves crush.</p>
        <div class="d-sattypes" role="group" aria-label="Saturation type">
          {types.map((t, i) => (
            <button class="d-sattype" type="button" data-sattype={t.id} data-desc={t.desc} aria-pressed={i === 0 ? 'true' : 'false'}>{t.label}</button>
          ))}
        </div>
        <p class="d-lede d-satdesc" data-satdesc aria-live="polite">{types[0].desc}</p>
        <p class="d-small">QUALITY runs the saturator at 2x up to 32x oversampling. 4x is the sweet spot.</p>
      </DriftPanel>
    </div>
  </div>
</section>
