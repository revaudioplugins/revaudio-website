---
/**
 * Section 2 — LET IT DRIVE (#drive). Left: the TRAKS attract-mode menu (the
 * plugin's v4.7 arcade select screen: PressStart2P head, VT323 phosphor chips)
 * with 8 of the plugin's 40 circuits (Dan 2026-10-02: iconic circuits, real
 * shapes, COUNTRY names only: no circuit or F1 names on the site; this replaces
 * the 09-26 shapes-only call). Outlines are the plugin's own points, built into
 * pure SVG at build time (circuits.data.ts). Right: the mini GPS cabinet (mm_plate.png)
 * with the real green/yellow/red caps UNDER the plate's punched wells (the
 * plate is the bezel, the wells are alpha 0, so the caps must stay), the
 * track + car drawn on the glass. The car laps silently while the GPS is in
 * view and drives the page's pan bus (trackui.ts): the WHOLE sound (D2/H1).
 * STOP is desaturated at rest (drift.css) so the CTA stays the one red.
 * Geometry = Drift bench/assets/minitrack/layout_ref.json (panel 402x448):
 * caps at 58.8/123.7/186.9 x 63.9, r 22.2 · glass 53.1,154 - 348.2,382.4 ·
 * LCD 231.5,44.7 - 382.7,93.4.
 * The plate and caps sit a screen below the phone fold, and native
 * loading="lazy" still fetched them before any scroll (70 KB of the first
 * paint): they load through init.ts's deferred observer (data-src / data-bg,
 * 500 px ahead) like the #fx photos; the <noscript> twin keeps the plate.
 */
import { getImage } from 'astro:assets';
import DriftPanel from './DriftPanel.astro';
import plateSrc from '../../assets/seasons/drift/mm_plate.png';
import capGreen from '../../assets/seasons/drift/mm_cap_green.png';
import capYellow from '../../assets/seasons/drift/mm_cap_yellow.png';
import capRed from '../../assets/seasons/drift/mm_cap_red.png';
import { CIRCUIT_SHAPES } from '../../lib/drift/circuits.data';
import { carR } from '../../lib/drift/circuits';

// the plate renders at ≤352 css px (440 col minus the panel pads): 720w covers DPR2, 900w DPR3
const [plate720, plate] = await Promise.all([720, 900].map((width) => getImage({ src: plateSrc, width, format: 'webp', quality: 76 })));
const [g, y, r] = await Promise.all([capGreen, capYellow, capRed].map((src) => getImage({ src, width: 136, format: 'webp', quality: 82 })));
const first = CIRCUIT_SHAPES[0];   // JAPAN: the default pick
// transparent placeholder with the plate's own aspect, so the cabinet never jumps (CSP img-src allows data:)
const blank = `data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 402 448'/%3E`;
const plateSizes = '(max-width: 1000px) calc(100vw - 76px), 352px';
const caps = [
  { id: 'play', label: 'Play the car', img: g, left: 8.91 },
  { id: 'pause', label: 'Pause the car', img: y, left: 25.04 },
  { id: 'stop', label: 'Stop the car and park it at centre', img: r, left: 40.78 },
];
---
<section class="d-sec" id="drive" aria-labelledby="d-trk-h" data-tracks>
  <div class="d-wrap">
    <div class="d-sechead">
      <span class="d-marquee" aria-hidden="true">LET IT DRIVE</span>
      <span class="d-ja" lang="ja" aria-hidden="true">速度</span>
      <span class="d-rule" aria-hidden="true"></span>
    </div>
    <h2 id="d-trk-h" class="d-headline"><span class="l1">Pick a</span> <span class="l2">track.</span></h2>
    <p class="d-catch d-drive-lede">Pick one. DRIFT drives your <em>whole sound</em> around it.</p>

    <div class="d-tracks">
      <DriftPanel checker={false} class="d-attract-panel">
        <div class="d-crt d-attract" data-drift-fab-watch>
          <div class="d-attract-hdr">
            <span class="d-attract-title">SELECT TRACKS</span>
          </div>
          <ul class="d-cards">
            {CIRCUIT_SHAPES.map((t) => (
              <li>
                <button class="d-chip" type="button" data-track={t.id} data-name={t.label} aria-pressed={t === first ? 'true' : 'false'} aria-label={`${t.label} circuit`}>
                  <svg viewBox={t.vb} aria-hidden="true"><path d={t.d} /></svg>
                  <span class="d-chip-name">{t.label}</span>
                </button>
              </li>
            ))}
          </ul>
          <p class="d-fine d-chips-note">8 of DRIFT's 40 circuits. Plus 8 shapes in the plugin.</p>
        </div>
      </DriftPanel>

      <div class="d-gps-col">
        <DriftPanel checker={false} class="d-gps-panel">
          <div class="d-gps">
            {caps.map((c) => (
              <button class:list={['d-cap', c.id === 'stop' && 'd-cap--stop']} type="button" data-gps={c.id} aria-label={c.label}
                aria-pressed={c.id === 'stop' ? undefined : 'false'}
                data-bg={c.img.src}
                style={`position:absolute;left:${c.left}%;top:9.12%;width:11.44%;height:auto;aspect-ratio:1;z-index:1`}></button>
            ))}
            <img src={blank} data-src={plate.src} data-srcset={`${plate720.src} 720w, ${plate.src} 900w`} sizes={plateSizes}
              width="402" height="448" alt="" aria-hidden="true" decoding="async" style="z-index:2;pointer-events:none" />
            <noscript><img src={plate.src} srcset={`${plate720.src} 720w, ${plate.src} 900w`} sizes={plateSizes}
              width="402" height="448" alt="" aria-hidden="true" loading="lazy" decoding="async" style="z-index:2;pointer-events:none" /></noscript>
            <div class="d-gps-lcd" style="z-index:3;left:57.59%;top:9.98%;width:37.61%;height:10.87%" aria-live="off">
              <span data-gps-name>{first.label}</span>
              <span data-gps-time>LAP 00.0s</span>
            </div>
            <div class="d-gps-glass" style="z-index:3;left:13.21%;top:34.38%;width:73.41%;height:50.98%;padding:9% 10%">
              <svg viewBox={first.vb} aria-hidden="true">
                <path class="trk" data-gps-path d={first.d} />
                <circle class="car" data-gps-car r={carR(first.vb)} cx="0" cy="0" />
              </svg>
            </div>
          </div>
          <div class="d-lcd d-balance-box">
            <div class="d-balance-lr" aria-hidden="true"><span>L</span><span class="d-balance-read" data-pan-readout="bare">C</span><span>R</span></div>
            <div class="d-balance" data-balance aria-hidden="true"></div>
          </div>
        </DriftPanel>
      </div>
    </div>
    <p class="d-catch d-auto-line"><strong>AUTO DRIFT:</strong> harder hits, faster car. Quiet, it parks at centre.</p>
  </div>
</section>
