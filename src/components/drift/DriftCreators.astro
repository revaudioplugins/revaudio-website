---
/**
 * Section 5 — ON AIR (#creators), route 1 of the offer in full and the
 * landing spot for the streamer reel (/drift#creators). The page ends on this
 * CTA. The 配信 lamp is the block's one lamp and one kana: lit while
 * drift.creatorDealOpen, so it reports the deal's state, not decoration.
 * Deal facts (Dan, 2026-09-30): apply at /affiliate and write DRIFT BETA in
 * the "Why do you want to promote RevAudio?" box (affiliate.astro's textarea
 * label); a public video, at least 2 minutes, up at least 30 days, tagged
 * @revaudioplugins, marked as an ad; then a free licence + a 20% affiliate
 * link. The button is violet, never race-red (one red per viewport), and the
 * DRIFT BETA reminder sits right under it: the last line read before leaving.
 * The steps get a VIDEO CHECK dash readout (the video's checks as LCD rows on
 * sunk glass with lit LEDs): beside them from 1000 px, a compact two-column
 * strip between step 4 and the button below that, so the reel's phone
 * landing spot shows DRIFT chrome too, not four numerals and an outlined
 * button (brand review 10-01, rounds 1 and 2). The Apply link is a violet
 * keycap (.d-btn-violet): DRIFT's key chrome in the violet family.
 */
import { drift } from '../../data/drift';
import DriftPanel from './DriftPanel.astro';
---
<section class="d-sec d-creators" id="creators" data-drift-cta-zone aria-labelledby="d-cr-h">
  <div class="d-wrap">
    <div class="d-sechead">
      <span class="d-marquee" aria-hidden="true">ON AIR</span>
      <span class:list={['d-onair', { on: drift.creatorDealOpen }]} lang="ja" aria-hidden="true">配信</span>
      <span class="d-rule" aria-hidden="true"></span>
    </div>
    <h2 id="d-cr-h" class="d-headline"><span class="l1">Stream it.</span> <span class="l2">Get DRIFT free.</span></h2>
    <p class="d-catch">Film a session with DRIFT. <span class="d-nw">Post it.</span> <em>Anyone on the trial</em> can.</p>

    <div class="d-cr-grid">
      <DriftPanel checker={false} class="d-cr-panel">
        <ol class="d-steps-cr" role="list">
          <li>Apply at <a class="d-cr-typed" href="/affiliate">revaudio.net/affiliate</a>.</li>
          <li>We email you the beta download.</li>
          <li>Post your DRIFT video{drift.videoDeadlineLabel && `, posted by ${drift.videoDeadlineLabel}`}. It must pass the video check.</li>
          <li>Tag seen: your free licence, plus your own affiliate link paying 20% of every sale.</li>
        </ol>
      </DriftPanel>

      <!-- VIDEO CHECK: the video's rules as a dash readout, the one place they
           are listed (step 3 points here), so it is read by AT too; the LEDs are
           lit lamps. Grid-placed: right column from 1000 px, between the steps
           and the button below. -->
      <div class="d-lcd d-lcd--big d-cr-checks">
        <span class="d-cr-checks-hdr">▶ VIDEO CHECK</span>
        <ul>
          <li>PUBLIC</li>
          <li>2 MIN OR MORE</li>
          <li>UP 30 DAYS OR MORE</li>
          <li>TAGGED @REVAUDIOPLUGINS</li>
          <li>MARKED AD / AFFILIATE</li>
        </ul>
      </div>

      <div class="d-cr-cta" data-drift-fab-watch>
        <a class="d-btn-violet" href="/affiliate">Apply as a creator <span class="d-stamp-arrow" aria-hidden="true">&#9656;</span></a>
        <p class="d-btn-note">Write <strong>DRIFT BETA</strong> in the “Why do you want to promote RevAudio?” box.</p>
        <p class="d-fine d-cr-mail">Already an affiliate? Email <a href="mailto:info@revaudio.net?subject=DRIFT%20BETA">info@revaudio.net</a>, subject DRIFT BETA.</p>
      </div>
    </div>
  </div>
</section>
