---
/**
 * Phone-only (≤900 px) DRIFT sticky bar: a full-width red keycap with the
 * phase label (the hero key's Oswald face) over one Oswald fine-print line, on a strip of panel steel. Measured
 * 2026-09-30: the CTA was in view on only 15.4% of phone scroll positions.
 * No desktop sticky (Dan built and deleted one on 07-22).
 *
 * MobileBuyBar.astro's mechanics (fixed bottom, safe-area padding, is-away
 * transitions, cookie-banner hide, cart-FAB lift, footer margin, scroll
 * padding, height sync, bfcache backstop), copied here because the shared bar
 * must not change and its observer watches ONE target. This one hides while
 * ANY [data-drift-cta-zone] intersects (hero CTA panel, #get, #creators), so
 * there is never a second red or a competing ask in the viewport. It starts
 * away: the hero CTA zone is on screen at load.
 * It also slides the cart FAB (≤700 px, bottom-left) off the edge while any
 * [data-drift-fab-watch] block scrolls through that corner: #drive's chip
 * grid (the FAB was winning the tap over the BREEZE chip, 10-01), #get's
 * ladder + sign-up (the 'How it works' link, the email field) and #creators'
 * Apply button, the reel's landing spot, which it sat on at 390x844 (10-01).
 */
import { ctaFor } from '../../data/drift';

const cta = ctaFor();
---
<div class="d-stickybar is-away" data-drift-sticky>
  <a class="d-cta d-cta--bar d-stamp-key" href={cta.action === 'cart' ? '#get' : '#try'} data-drift-jump
    aria-label={cta.action !== 'cart' && cta.label === 'Get it' ? 'Get it: go to the trial form' : undefined}>{cta.label} <span class="d-stamp-arrow" aria-hidden="true">&#9656;</span></a>
  <span class="d-stickybar-micro">{cta.sticky}</span>
</div>

<style>
  :global(:root) { --d-sb-h: 64px; }
  .d-stickybar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
    display: none; flex-direction: column; align-items: stretch; gap: 0.3rem;
    min-height: var(--d-sb-h);
    padding: 0.5rem max(1rem, env(safe-area-inset-right))
             calc(0.45rem + env(safe-area-inset-bottom)) max(1rem, env(safe-area-inset-left));
    /* a strip of panel steel (the panels' face, already loaded), dimmed */
    background: linear-gradient(rgba(12, 5, 18, .55), rgba(12, 5, 18, .55)), var(--d-img-panel) center / cover, #150a1f;
    border-top: 1px solid rgba(180, 107, 255, .3);
    box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.5);
    transition: transform 0.28s var(--ease-settle), visibility 0s 0s; will-change: transform;
  }
  .d-stickybar.is-away { transform: translateY(105%); visibility: hidden;
    transition: transform 0.24s var(--ease-exit), visibility 0s 0.24s; }
  @media (prefers-reduced-motion: reduce) { .d-stickybar, .d-stickybar.is-away { transition: none; } }
  /* cookie banner (z9000) owns the bottom edge while visible */
  :global(body:has(#cookie-banner.cb--visible)) .d-stickybar { transform: translateY(105%); visibility: hidden; }
  @media (max-width: 900px) {
    .d-stickybar { display: flex; }
    /* Bar UP: the cart FAB rides just above it (same specificity trick as MobileBuyBar). */
    :global(body .cart-fab.cart-fab) { bottom: calc(16px + var(--d-sb-h) + env(safe-area-inset-bottom, 0px)); }
    :global(body:has(.d-stickybar.is-away) .cart-fab.cart-fab),
    :global(body:has(#cookie-banner.cb--visible) .cart-fab.cart-fab) { bottom: 16px; }
    /* a watched block under the FAB: slide it off the left edge until it has passed */
    :global(body .cart-fab.cart-fab) { transition: bottom 0.28s var(--ease-settle), transform 0.24s var(--ease-exit); }
    :global(body:has([data-drift-fab-watch].is-underfab) .cart-fab.cart-fab),
    :global(body:has(.drift-page .is-underfab) .cart-fab.cart-fab),
    :global(body:has(.d-hero-trial.is-underfab) .cart-fab.cart-fab),
    :global(body:has(.site-footer.is-underfab) .cart-fab.cart-fab) { transform: translateX(calc(-100% - 24px)); pointer-events: none; }
    /* while the red bar is up the FAB stays off the edge: its red count badge was a second red beside GET IT, on the text (ux r2 10-02) */
    :global(body:has(.d-stickybar:not(.is-away)) .cart-fab.cart-fab) { transform: translateX(calc(-100% - 24px)); pointer-events: none; }
    /* an empty cart has nothing to open: off the edge until the badge shows a count (it sat on the heads and the plates, ux r1 10-02) */
    :global(body:has(.cart-fab-badge[hidden]) .cart-fab.cart-fab) { transform: translateX(calc(-100% - 24px)); pointer-events: none; }
    @media (prefers-reduced-motion: reduce) { :global(body .cart-fab.cart-fab) { transition: none; } }
    /* the footer clears the bar only while the bar is up; at the page end
       #creators is in view, the bar is away, and the margin showed as a strip */
    :global(body:has(.d-stickybar:not(.is-away)) .site-footer) { margin-bottom: calc(var(--d-sb-h) + env(safe-area-inset-bottom, 0px)); }
    :global(html) { scroll-padding-bottom: calc(var(--d-sb-h) + 16px); }
  }
  .d-stickybar .d-cta--bar { --h: 48px; width: 100%; }
  @media (min-width: 600px) {
    .d-stickybar { align-items: center; }
    .d-stickybar .d-cta--bar { width: min(100%, 420px); }   /* a key, not a 716 px banner */
  }
  .d-stickybar-micro {
    font: 500 12px/1 var(--d-f-head); letter-spacing: .05em; text-transform: uppercase;
    text-align: center; color: var(--d-fg-dim);
  }
  /* PHONE PASS 2026-10-02 (S4): the page's most important fine print, at the 13+ floor and bright */
  @media (max-width: 600px) {
    .d-stickybar-micro { font-size: 14px; color: var(--d-fg); }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-drift-sticky]');
  const phoneMq = matchMedia('(max-width: 600px)');
  // 601-900 (today's logic): the hero's red GET IT key lives in .d-hero-trial (not a CTA zone): hide the bar beside it too,
  // and beside the house footer, so the bar never slides up over it at the page end
  const wideZones = Array.from(document.querySelectorAll<HTMLElement>('[data-drift-cta-zone], .d-hero-trial, .site-footer'));
  // ≤600 (S1, 10-02): the real asks only, edge to edge (no -25%): the red key of the hero form and of #try's form,
  // #creators and the footer. So there is no red-less band between #fx and #try (the key, not the form: #try's
  // field enters first and sits under the bar for ~100 px of scroll) and none beside the price line, which has no key
  const tryAsk = document.querySelector<HTMLElement>('#try .d-capture-form .d-stamp-key') ?? document.querySelector<HTMLElement>('#try, #get .d-buyslot');
  const phoneZones = [document.querySelector<HTMLElement>('.d-stamp-form .d-stamp-key'), tryAsk,
    document.querySelector<HTMLElement>('#creators'), document.querySelector<HTMLElement>('.site-footer')]
    .filter((z): z is HTMLElement => !!z);
  if (bar) {
    // publish the real height so the FAB/footer/scroll offsets that read
    // --d-sb-h stay exact (display:none above 900px -> 0, inert there).
    const syncH = () => document.documentElement.style.setProperty('--d-sb-h', bar.offsetHeight + 'px');
    syncH();
    window.addEventListener('resize', syncH);
  }
  if (bar && (wideZones.length || phoneZones.length)) {
    const hits = new Set<Element>();
    let zones: HTMLElement[] = [];
    // phone only: also away while a DRIFT email field has focus (the keyboard is up) and after a sign-up (G3)
    let typing = false;
    const html = document.documentElement;
    const set = () => bar.classList.toggle('is-away',
      hits.size > 0 || (phoneMq.matches && (typing || html.hasAttribute('data-drift-joined'))));
    let io: IntersectionObserver | null = null;
    const observe = () => {
      io?.disconnect();
      hits.clear();
      const phone = phoneMq.matches;
      zones = phone ? phoneZones : wideZones;
      io = new IntersectionObserver((entries) => {
        for (const e of entries) { if (e.isIntersecting) hits.add(e.target); else hits.delete(e.target); }
        set();
      }, { rootMargin: phone ? '0px' : '0px 0px -25% 0px', threshold: 0 });
      zones.forEach((z) => io!.observe(z));
    };
    observe();
    phoneMq.addEventListener('change', observe);   // crossing 600: the other zone set and margin
    const field = (t: EventTarget | null) => t instanceof HTMLInputElement && t.type === 'email' && !!t.closest('.drift-page');
    document.addEventListener('focusin', (e) => { typing = field(e.target); set(); });
    document.addEventListener('focusout', () => { typing = false; set(); });
    new MutationObserver(set).observe(html, { attributes: true, attributeFilter: ['data-drift-joined'] });
    window.addEventListener('pageshow', (e) => {   // Safari bfcache backstop (house pattern)
      if (!e.persisted) return;
      hits.clear();
      const edge = window.innerHeight * (phoneMq.matches ? 1 : 0.75);
      for (const z of zones) {
        const r = z.getBoundingClientRect();
        if (r.top < edge && r.bottom > 0) hits.add(z);
      }
      set();
    });
  }
  // The cart FAB lives in the bottom-left corner on ≤700 px (48 px, 16 px up,
  // or 16 px above this bar). Watch every [data-drift-fab-watch] block against
  // that bottom band only (a root shrunk to it: the bar's height counts even
  // while it is away, so the band is the same at #get and #creators), and
  // slide the FAB off while any of them overlaps it.
  // plus every head, catch line, the keep panel and the VIDEO CHECK glass: the FAB leaves wherever a line passes under it (ux r2 10-02)
  const watched = Array.from(document.querySelectorAll<HTMLElement>('[data-drift-fab-watch], .d-hero-trial, .drift-page h2.d-headline, .drift-page .d-catch, .d-keep, .d-cr-checks, .site-footer'));
  if (watched.length && matchMedia('(max-width: 700px)').matches) {
    let fabIo: IntersectionObserver | null = null;
    const watch = () => {
      fabIo?.disconnect();
      const band = 16 + (bar?.offsetHeight ?? 0) + 48 + 12;
      fabIo = new IntersectionObserver((entries) => {
        for (const e of entries) (e.target as HTMLElement).classList.toggle('is-underfab', e.isIntersecting);
      }, { rootMargin: `${-(window.innerHeight - band)}px 0px 0px 0px` });
      watched.forEach((el) => fabIo!.observe(el));
    };
    watch();
    window.addEventListener('resize', watch);
  }
</script>
