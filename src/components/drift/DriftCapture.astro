---
/**
 * DRIFT trial sign-up (#get-capture, the #get console's right column). A drift-local twin of EmailCapture.astro's
 * contract (same endpoints, same one-per-email relay, same honest 'not wired'
 * guard), NOT a reuse: that component hard-codes id="newsletter-email", wraps
 * its own <section>/<h2>, has a brass button, and its subhead promises demo
 * codes and intro pricing.
 *
 * The compat rows render beside it, in DriftGetIn's left column (the console's
 * label side), so the formats are read before anyone types an email; the jump
 * CTAs (data-drift-jump) land #try = the whole #get console (DriftGetIn's
 * .d-getin wrapper), then focus this field on pointer: fine. The id prop keeps
 * the label/input pair unique (`${id}-email`).
 * The visible label is sr-only (the placeholder + the head say it); the fine
 * line leads with "Nothing to pay today." in the capture phases.
 * The download is never linked here: it goes out by email. What the form
 * promises, and the source it files under, come from captureCopyFor() per
 * phase (preopen: the Oct 10 mail; open: the download by email; closed: a
 * notify-me for the Nov 1 release), so a flip can't promise a past date.
 * JS posts {form:'newsletter', email, source, _gotcha} to the worker's
 * /form-once; without JS the form posts to Formspree.
 */
import { site } from '../../data/site';
import { drift, ctaFor, captureCopyFor } from '../../data/drift';

interface Props {
  id?: string;
  source?: string;
}
const copy = captureCopyFor();
if (!copy) throw new Error(`[DriftCapture] phase '${drift.phase}' has no capture copy (captureCopyFor).`);
const { id = 'get-capture', source = copy.source } = Astro.props;
const onceUrl = site.downloadGate.workerUrl + '/form-once';
const cta = ctaFor();
// H5 (10-02): the key's accessible name says what the press does, but only while the face reads "Get it"
// and a trial is on offer (preopen / open); the closed phase's face is "Get notified", so no label (WCAG 2.5.3)
const keyLabel = (drift.phase === 'preopen' || drift.phase === 'open') && cta.label === 'Get it'
  ? `Get it: free ${drift.trialDays}-day trial by email` : undefined;
---
<div class="d-capture" id={id}>
  <form class="d-capture-form" action={site.formspreeEndpoint} method="POST"
    data-drift-capture data-once-url={onceUrl} data-msg-ok={copy.ok} data-msg-already={copy.already}>
    <label for={`${id}-email`} class="d-sr">Your email</label>
    <div class="d-field-row">
      <input id={`${id}-email`} class="d-field" type="email" name="email" required autocomplete="email"
        inputmode="email" enterkeyhint="go" spellcheck="false" autocapitalize="off" placeholder="your@email.com" />
      <input type="hidden" name="source" value={source} />
      <!-- honeypot: real users never fill this; bots do -->
      <input type="text" name="_gotcha" class="d-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button type="submit" class="d-cta d-stamp-key" aria-label={keyLabel}><span data-face>{cta.label} <span class="d-stamp-arrow" aria-hidden="true">&#9656;</span></span></button>
    </div>
  </form>
  <p class="d-cta-fine d-fine"><span class="d-fine-full">{ctaFor().action === 'capture' && <span class="d-get-chip">Nothing to pay today.</span>} {copy.fine}</span><span class="d-fine-ph">{copy.fineShort}</span></p>
  <!-- the live region is always in the tree (drift.css hides it while empty), so the first message is announced -->
  <p class="d-capture-status" role="status" aria-live="polite" tabindex="-1"></p>
  {drift.creatorDealOpen && <a class="d-capture-next" href="#creators" hidden>Keep it free with a video ›</a>}
</div>

<!-- submit handling: src/lib/drift/capture.ts, started by init.ts (shared with the hero stamp) -->
