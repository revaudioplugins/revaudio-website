---
/**
 * DRIFT trial sign-up (#try). A drift-local twin of EmailCapture.astro's
 * contract (same endpoints, same one-per-email relay, same honest 'not wired'
 * guard), NOT a reuse: that component hard-codes id="newsletter-email", wraps
 * its own <section>/<h2>, has a brass button, and its subhead promises demo
 * codes and intro pricing.
 *
 * Order is the conversion fix (Visitor C): the compat line comes FIRST, so
 * 'No Pro Tools (AAX) yet' is read before anyone types an email; the hero
 * keycap's data-drift-jump lands #try's top edge, then focuses the field.
 * The download is never linked here: it goes out by email. What the form
 * promises, and the source it files under, come from captureCopyFor() per
 * phase (preopen: the Oct 10 mail; open: the download by email; closed: a
 * notify-me for the Nov 1 release), so a flip can't promise a past date.
 * JS posts {form:'newsletter', email, source, _gotcha} to the worker's
 * /form-once; without JS the form posts to Formspree.
 */
import { site } from '../../data/site';
import { drift, ctaFor, compatLine, captureCopyFor } from '../../data/drift';

interface Props {
  id?: string;
  source?: string;
}
const copy = captureCopyFor();
if (!copy) throw new Error(`[DriftCapture] phase '${drift.phase}' has no capture copy (captureCopyFor).`);
const { id = 'try', source = copy.source } = Astro.props;
const onceUrl = site.downloadGate.workerUrl + '/form-once';
---
<div class="d-capture" id={id}>
  <p class="d-compat">{compatLine()}</p>
  <form class="d-capture-form" action={site.formspreeEndpoint} method="POST"
    data-drift-capture data-once-url={onceUrl} data-msg-ok={copy.ok} data-msg-already={copy.already}>
    <label for={`${id}-email`} class="d-field-label">Your email</label>
    <div class="d-field-row">
      <input id={`${id}-email`} class="d-field" type="email" name="email" required autocomplete="email" placeholder="you@studio.com" />
      <input type="hidden" name="source" value={source} />
      <!-- honeypot: real users never fill this; bots do -->
      <input type="text" name="_gotcha" class="d-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button type="submit" class="d-cta d-cta--edge">{ctaFor().label}</button>
    </div>
  </form>
  <p class="d-cta-fine">{copy.fine}</p>
  <!-- the live region is always in the tree (drift.css hides it while empty), so the first message is announced -->
  <p class="d-capture-status" role="status" aria-live="polite" tabindex="-1"></p>
  {drift.creatorDealOpen && <a class="d-capture-next" href="#creators" hidden>Want to keep DRIFT free? See how ↓</a>}
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-drift-capture]').forEach((form) => {
    const box = form.parentElement;
    const status = box?.querySelector<HTMLElement>('.d-capture-status');
    const next = box?.querySelector<HTMLElement>('.d-capture-next');
    // Build-time placeholder still in the action = not wired to a real backend yet.
    const wired = !form.action.includes('REPLACE_WITH_FORM_ID');

    const show = (msg: string, ok: boolean) => {
      if (!status) return;
      status.textContent = msg;
      status.classList.toggle('ok', ok);
      status.classList.toggle('err', !ok);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!wired) {
        show('Almost there. Sign-up goes live shortly. Your email wasn’t sent yet.', false);
        return;
      }
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;
      try {
        const res = await fetch(form.dataset.onceUrl!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ form: 'newsletter', ...Object.fromEntries(new FormData(form)) }),
        });
        const j = await res.json().catch(() => null);
        if (j && j.ok) {
          form.hidden = true;
          show(j.already ? form.dataset.msgAlready! : form.dataset.msgOk!, true);
          if (!j.already && next) next.hidden = false;
          status?.focus({ preventScroll: true });   // the focused submit button just went with the form
        } else {
          show((j && j.error) || 'Something went wrong. Try again, or email info@revaudio.net.', false);
        }
      } catch {
        show('Network hiccup. Try again in a moment.', false);
      }
      if (submitBtn) submitBtn.disabled = false;
    });
  });
</script>
