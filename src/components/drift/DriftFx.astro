---
/**
 * Section 3 — EFFECTS (#fx): the FX RACK. The plugin's FX view, so it wears
 * #drive's chassis (plate S1 9-sliced + the vector twill face, drift.css
 * SECTION 3) with the 周波数 sticker; phones get the CSS DriftPanel. The one
 * honest place for the band: the whole sound moves; LOW CUT / HIGH CUT only
 * set the slice where echo, reverb, tremolo and pitch play. A static
 * annotated strip explains it (log axis placed at BUILD time, the old band.ts
 * mapping; no drag, nothing to hear yet) with "FX PLAY HERE" lit in the
 * slice, then four real strips cut from the plugin's FX window rendered at
 * DPR 2 (website rule: product images come from the real UI), then the
 * SATURATE bay + the spec rows, with no band claim for SATURATE/AUTOTUNE.
 * fx-autotune.png is off the page: it shows the BAND|ALL bank removed in
 * 4.26.0 (DESIGN.md:1290) until it's re-shot from the Oct 10 build.
 * No hover on a strip (law: attention motion is the text, never the box).
 * The strips are cropped to their heads (screen, selectors, first knob row:
 * the dark gap under that row's labels is the one cut that lands between
 * parts in all four) and sink behind the rack's front rail (.d-strip-well);
 * the bay is framed to its own bezel in drift.css.
 * The five photos sit 2-3 screens below the fold, and native loading="lazy"
 * still fetched them before any scroll (Chromium's proximity window on a
 * fast connection: ~300 KB of a phone's first paint). They load through
 * init.ts's deferred-image observer instead (data-src, 500 px ahead); the
 * <noscript> twins keep them for no-JS.
 */
import { getImage } from 'astro:assets';
import DriftPanel from './DriftPanel.astro';
import pitch from '../../assets/seasons/drift/fx-pitch.png';
import echo from '../../assets/seasons/drift/fx-echo.png';
import verb from '../../assets/seasons/drift/fx-reverb.png';
import trem from '../../assets/seasons/drift/fx-tremolo.png';
import baySrc from '../../assets/seasons/drift/sat-bay.png';
// the phone carousel's pedals: TRUE-ALPHA shots of the plugin's own FX strips (tools/shoot-drift-fx-pedals.mjs, Dan 10-04)
import pedPitch from '../../assets/seasons/drift/pedal-pitch.png';
import pedEcho from '../../assets/seasons/drift/pedal-echo.png';
import pedVerb from '../../assets/seasons/drift/pedal-reverb.png';
import pedTrem from '../../assets/seasons/drift/pedal-tremolo.png';
import { drift } from '../../data/drift';

const strips = [
  { cls: 's-pitch', src: pitch, ped: pedPitch, name: 'Pitch', desc: 'Up or down. Up to an octave.' },
  { cls: 's-echo', src: echo, ped: pedEcho, name: 'Echo', desc: 'Synced or not. Tape-dark to clean.' },
  { cls: 's-verb', src: verb, ped: pedVerb, name: 'Reverb', desc: 'Room, plate, hall. Plus shimmer.' },
  { cls: 's-trem', src: trem, ped: pedTrem, name: 'Tremolo', desc: 'Chops in time with your song.' },
];
// a strip renders at ~228 css px on desktop (4 across the plate) and ~151 on
// a phone (2x2): 512w is the source's full width, 340w serves phone DPR2 at
// ~40% of the bytes. The bay renders at 340 css px on desktop and up to ~900
// on a tablet (hidden on phones): 1060w (the source's full width) covers DPR2,
// 600w the rest.
// phone carousel: a pedal renders ~150-230 css px wide (3x = ~690): 400w + 700w, alpha kept (webp)
const [peds400, peds700] = await Promise.all([
  Promise.all(strips.map((s) => getImage({ src: s.ped, width: 400, format: 'webp', quality: 84 }))),
  Promise.all(strips.map((s) => getImage({ src: s.ped, width: 700, format: 'webp', quality: 82 }))),
]);
const pedSizes = '(max-width: 600px) 56vw, 1px';
const [imgs, imgs340, bay, bay600] = await Promise.all([
  Promise.all(strips.map((s) => getImage({ src: s.src, width: 512, format: 'webp', quality: 80 }))),
  Promise.all(strips.map((s) => getImage({ src: s.src, width: 340, format: 'webp', quality: 80 }))),
  getImage({ src: baySrc, width: 1060, format: 'webp', quality: 80 }),
  getImage({ src: baySrc, width: 600, format: 'webp', quality: 80 }),
]);

// Staging rule for the window shot (Decision 19): a SIMPLE track, preset
// 'Default', circuit screen closed. Rendered only when drift.screenshotReady;
// the glob keeps the build green while the file doesn't exist yet.
const shotSrc = drift.screenshotReady
  ? (Object.values(import.meta.glob<{ default: ImageMetadata }>('../../assets/seasons/drift/drift-window.png', { eager: true }))[0]?.default ?? null)
  : null;
const shot = shotSrc ? await getImage({ src: shotSrc, width: 1200, format: 'webp', quality: 80 }) : null;

// band strip: log frequency axis, 20 Hz .. 20 kHz across 1000 units. The SVG
// stretches to the column (non-scaling strokes); the labels are HTML so they
// stay ≥14 px at 390 px wide.
const x = (f: number) => (Math.log(f / 20) / Math.log(1000)) * 1000;
const ticks = [
  { f: 20, t: '20 Hz' }, { f: 100, t: '100 Hz' }, { f: 1000, t: '1 kHz' }, { f: 10000, t: '10 kHz' }, { f: 20000, t: '20 kHz' },
];
const pc = (f: number) => `${(x(f) / 10).toFixed(2)}%`;
const LOW = 6000, HIGH = 16000;
// transparent placeholder with the photo's own aspect, so the box never jumps (CSP img-src allows data:)
const blank = (w: number, h: number) => `data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 ${w} ${h}'/%3E`;
const stripSizes = '(max-width: 1000px) calc(50vw - 40px), 228px';
const baySizes = '(max-width: 1000px) calc(100vw - 80px), 340px';
const baySrcset = `${bay600.src} 600w, ${bay.src} 1060w`;
---
<section class="d-sec" id="fx" aria-labelledby="d-fx-h">
  <div class="d-wrap">
    <DriftPanel sticker="周波数" checker={false} class="d-fx-panel">
      <h2 id="d-fx-h" class="d-headline d-headline--row"><span class="l1">Whole sound pans.</span> <span class="l2">FX on one slice.</span></h2>

      {shot && (
        <figure class="d-shot">
          <img src={shot.src} width={shot.attributes.width ?? 1200} alt="The whole DRIFT plugin window" loading="lazy" decoding="async" />
          <figcaption class="d-fine">The DRIFT window, as it opens in your DAW.</figcaption>
        </figure>
      )}

      <figure class="d-bandfig">
        <div class="d-lcd d-lcd--big d-bandglass">
        {/* HIGH CUT on the top row: its line runs down past the LOW CUT row on
            the right of that label (16k > 6k), so the lines never cross a label
            at any width (at 390 px the other order cut through "HIGH CUT") */}
        <div class="d-band-cuts" aria-hidden="true">
          <span class="d-band-cut" style={`--at:${pc(HIGH)}`}>HIGH CUT 16k</span>
          <span class="d-band-cut" style={`--at:${pc(LOW)}`}>LOW CUT 6k</span>
        </div>
        <div class="d-band-win">
          <svg class="d-bandstrip" viewBox="0 0 1000 100" preserveAspectRatio="none" role="img" aria-label="LOW CUT at 6 kilohertz and HIGH CUT at 16 kilohertz: the effects play only in this slice">
            <rect class="axis" x="0" y="8" width="1000" height="80" />
            {ticks.map((t) => <line class="tick" x1={x(t.f)} x2={x(t.f)} y1="88" y2="100" />)}
            <rect class="lit" x={x(LOW)} y="8" width={x(HIGH) - x(LOW)} height="80" />
            <line class="cut" x1={x(LOW)} x2={x(LOW)} y1="0" y2="100" />
            <line class="cut" x1={x(HIGH)} x2={x(HIGH)} y1="0" y2="100" />
          </svg>
          {/* the lit slice is a lamp: its label glows; ≤600 px only "FX" fits the slice */}
          <span class="d-fx-slice" aria-hidden="true" style={`--l:${pc(LOW)};--r:${pc(HIGH)}`}>FX<span class="d-fx-slice-w"> PLAY HERE</span></span>
        </div>
        <div class="d-band-ticks" aria-hidden="true">
          {ticks.map((t) => <span class:list={[t.f === 10000 && 'd-tick-10k']} style={`left:${pc(t.f)}`}>{t.t}</span>)}
        </div>
        </div>
      </figure>

      <noscript><style>.drift-page img[data-src] { display: none; }</style></noscript>   {/* no JS: only the twins render */}
      <div class="d-rack">
        {strips.map((s, i) => (
          <figure class:list={['d-strip', s.cls]}>
            <div class="d-strip-well">
              <img src={blank(512, 588)} data-src={imgs[i].src} data-srcset={`${imgs340[i].src} 340w, ${imgs[i].src} 512w`} sizes={stripSizes}
                width="256" height="294" alt={`DRIFT ${s.name} strip`} decoding="async" />
              <noscript><img src={imgs[i].src} srcset={`${imgs340[i].src} 340w, ${imgs[i].src} 512w`} sizes={stripSizes}
                width="256" height="294" alt={`DRIFT ${s.name} strip`} loading="lazy" decoding="async" /></noscript>
            </div>
            <figcaption>
              <h3>{s.name}</h3>
              <p set:html={s.desc.replace('Tape-dark', '<span class="d-nw">Tape-dark</span>')} />
            </figcaption>
          </figure>
        ))}
      </div>

      {/* PHONE ONLY (drift.css: hidden ≥601, the rack hidden ≤600). Dan 10-04: the four effects as a coverflow carousel
          like the home page's plugin showcase (PluginShowcase.astro): the pedal centred in a framed card, its neighbours
          peeking tilted and dimmed, the gear-shift snap, swipe / peek-tap / dots / arrow keys. Each frame wears its
          pedal's hue (the plugin's FX VIBE law). Pedals = true-alpha shots of the plugin's own strips. */}
      <div class="d-fxc" data-fxc tabindex="0" role="group" aria-roledescription="carousel" aria-label="DRIFT effects">
        <p class="d-sr" aria-live="polite" aria-atomic="true" data-fxc-say></p>
        <div class="d-fxc-vp">
          {strips.map((s, i) => (
            <figure class:list={['d-fxc-slide', s.cls, i === 0 ? 'is-current' : i === 1 ? 'is-peek-next' : i === strips.length - 1 ? 'is-peek-prev' : '']}
              data-fxc-slide role="group" aria-roledescription="slide" aria-label={`${s.name}, ${i + 1} of ${strips.length}`}>
              <h3 class="d-fxc-name">{s.name}</h3>
              <p class="d-fxc-desc" set:html={s.desc.replace('Tape-dark', '<span class="d-nw">Tape-dark</span>')} />
              <img class="d-fxc-ped" src={blank(1056, 1908)} data-src={peds700[i].src} data-srcset={`${peds400[i].src} 400w, ${peds700[i].src} 700w`}
                sizes={pedSizes} width="528" height="954" alt={`DRIFT ${s.name} pedal`} decoding="async" />
            </figure>
          ))}
        </div>
        <div class="d-fxc-dots">
          {strips.map((s, i) => <button type="button" class:list={['d-fxc-dot', { active: i === 0 }]} data-fxc-dot={i} aria-label={`Show ${s.name}`}></button>)}
        </div>
      </div>

      <div class="d-fx-foot">
        <div class="d-bay">
          <img src={blank(1060, 382)} data-src={bay.src} data-srcset={baySrcset} sizes={baySizes} width="530" height="191" alt="DRIFT's saturation bay" decoding="async" />
          <noscript><img src={bay.src} srcset={baySrcset} sizes={baySizes} width="530" height="191" alt="DRIFT's saturation bay" loading="lazy" decoding="async" /></noscript>
        </div>
        <div class="d-fx-spec">
          <span class="d-fx-kicker" aria-hidden="true">Also under the hood</span>
          <dl class="d-spec-plate">
            <div><dt>SATURATE</dt><dd>Tape, tube, transformer, digital</dd></div>
            <div><dt>AUTOTUNE</dt><dd>Your key and scale</dd></div>
            <div><dt>PRESETS</dt><dd>60 · vocal, keys, guitar, drums, bass, mix bus</dd></div>
            {drift.randomizeInBuild && <div><dt>RANDOMIZE</dt><dd>One roll, new effects. One undo, back.</dd></div>}
          </dl>
        </div>
      </div>
    </DriftPanel>
  </div>
</section>

<script>
  // one cue: the cut flags + the lit slice flicker on once like phosphor when
  // the band display comes into view (drift.css SECTION 3). Rest = lit, so no
  // JS / no IO / reduced motion all show the labels on.
  const glass = document.querySelector<HTMLElement>('#fx .d-bandglass');
  if (glass && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        (e.target as HTMLElement).dataset.lit = '';
        io.unobserve(e.target);
      }
    }, { threshold: 0.5 });
    io.observe(glass);
  }
</script>

<script>
  /* the phone #fx carousel (Dan 10-04): PluginShowcase's coverflow logic, trimmed to four slides */
  document.querySelectorAll<HTMLElement>('[data-fxc]').forEach((fc) => {
    const slides = Array.from(fc.querySelectorAll<HTMLElement>('[data-fxc-slide]'));
    const dots = Array.from(fc.querySelectorAll<HTMLElement>('[data-fxc-dot]'));
    const say = fc.querySelector<HTMLElement>('[data-fxc-say]');
    const vp = fc.querySelector<HTMLElement>('.d-fxc-vp');
    const n = slides.length;
    if (!vp || n < 2) return;
    let idx = 0;
    const dist = (k: number) => { let d = (k - idx) % n; if (d > n / 2) d -= n; if (d < -n / 2) d += n; return d; };
    const go = (t: number) => {
      const next = ((t % n) + n) % n;
      if (next === idx) return;
      idx = next;
      slides.forEach((s, k) => {
        s.classList.remove('is-current', 'is-peek-prev', 'is-peek-next');
        const d = dist(k);
        if (d === 0) s.classList.add('is-current'); else if (d === 1) s.classList.add('is-peek-next'); else if (d === -1) s.classList.add('is-peek-prev');
      });
      dots.forEach((d, k) => d.classList.toggle('active', k === idx));
      if (say) say.textContent = slides[idx].getAttribute('aria-label') ?? '';
    };
    dots.forEach((d, k) => d.addEventListener('click', () => go(k)));
    slides.forEach((s, k) => s.addEventListener('click', () => { if (!s.classList.contains('is-current')) go(k); }));
    fc.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { go(idx - 1); e.preventDefault(); }
      if (e.key === 'ArrowRight') { go(idx + 1); e.preventDefault(); }
    });
    let x0: number | null = null, moved = false;
    vp.addEventListener('pointerdown', (e) => { x0 = e.clientX; moved = false; });
    vp.addEventListener('pointermove', (e) => { if (x0 !== null && Math.abs(e.clientX - x0) > 10) moved = true; });
    vp.addEventListener('pointerup', (e) => { if (x0 !== null) { const dx = e.clientX - x0; if (Math.abs(dx) > 40) go(dx < 0 ? idx + 1 : idx - 1); } x0 = null; });
    vp.addEventListener('pointercancel', () => { x0 = null; });
    vp.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
  });
</script>
