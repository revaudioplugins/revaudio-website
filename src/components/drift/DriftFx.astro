---
/**
 * Section 3 — EFFECTS (#fx): the FX RACK. The plugin's FX view, so it wears
 * #drive's chassis (plate S1 9-sliced + the vector twill face, drift.css
 * SECTION 3) with the 周波数 sticker; phones get the CSS DriftPanel.
 * 601 px up (Dan 2026-10-09, "Live rack"): the DRIFT 5.2.4 FX view itself,
 * rebuilt from its own pixels (tools/shoot-drift-fx-rack.mjs: floor + LCD,
 * five strips, chassis + deck, five carriages) and run by the plugin's own
 * code (src/lib/drift/rack.ts): live strip screens, the page's RANDOMIZE on the
 * plugin's dice engine, the DICE LOG, strips that ride the rail to a new chain
 * order and go dark when a roll sits them out. It powers on when the crane
 * lands. A caption per strip rides under it.
 * Phones (<= 600 px) keep the 10-04 page: the band strip, the coverflow
 * carousel of TRUE-ALPHA pedals and the spec rows. Dan 10-08 ("in phone ONLY
 * change the fx that was replaced"): HALO for TREMOLO, GLUE COMP for AUTOTUNE.
 * The images sit 2-3 screens below the fold, and native loading="lazy" still
 * fetched them before any scroll (Chromium's proximity window on a fast
 * connection: ~300 KB of a phone's first paint). They load through init.ts's
 * deferred-image observer instead (data-src, 500 px ahead); the <noscript>
 * twins keep them for no-JS.
 */
import { getImage } from 'astro:assets';
import DriftPanel from './DriftPanel.astro';
import baySrc from '../../assets/seasons/drift/sat-bay.png';
// the phone carousel's pedals: TRUE-ALPHA shots of the plugin's own FX strips (tools/shoot-drift-fx-pedals.mjs, Dan 10-04)
import pedPitch from '../../assets/seasons/drift/pedal-pitch.png';
import pedEcho from '../../assets/seasons/drift/pedal-echo.png';
import pedVerb from '../../assets/seasons/drift/pedal-reverb.png';
import pedHalo from '../../assets/seasons/drift/pedal-halo.png';   // DRIFT 5.2.4: HALO replaces TREMOLO (Dan 10-08)
// the live rack (601 px up): layers shot from DRIFT 5.2.4 by tools/shoot-drift-fx-rack.mjs, geometry in rack.json
import geo from '../../assets/seasons/drift/rack/rack.json';
import rkFloor from '../../assets/seasons/drift/rack/rack-floor.png';
import rkTop from '../../assets/seasons/drift/rack/rack-top.png';
import rkPitch from '../../assets/seasons/drift/rack/rack-pitch.png';
import rkEcho from '../../assets/seasons/drift/rack/rack-echo.png';
import rkVerb from '../../assets/seasons/drift/rack/rack-reverb.png';
import rkHalo from '../../assets/seasons/drift/rack/rack-halo.png';
import rkGlue from '../../assets/seasons/drift/rack/rack-glue.png';
import gPitch from '../../assets/seasons/drift/rack/rack-grab-pitch.png';
import gEcho from '../../assets/seasons/drift/rack/rack-grab-echo.png';
import gVerb from '../../assets/seasons/drift/rack/rack-grab-reverb.png';
import gHalo from '../../assets/seasons/drift/rack/rack-grab-halo.png';
import gGlue from '../../assets/seasons/drift/rack/rack-grab-glue.png';
import { drift } from '../../data/drift';

const strips = [
  { cls: 's-pitch', ped: pedPitch, name: 'Pitch', desc: 'Up or down. Up to an octave.' },
  { cls: 's-echo', ped: pedEcho, name: 'Echo', desc: 'Synced or not. Tape-dark to clean.' },
  { cls: 's-verb', ped: pedVerb, name: 'Reverb', desc: 'Room, plate, hall. Plus shimmer.' },
  { cls: 's-halo', ped: pedHalo, name: 'Halo', desc: 'Wide, airy glow. No tails.' },
];
// the rack's five strips, in the plugin's default chain (= its markup order); short lines: a caption is one strip wide
const rack = [
  { id: 'pitch', src: rkPitch, grab: gPitch, name: 'Pitch', desc: 'Up or down an octave', ink: '#d7dde8' },
  { id: 'echo', src: rkEcho, grab: gEcho, name: 'Echo', desc: 'Synced, tape-dark to clean', ink: '#ff5fd9' },
  { id: 'reverb', src: rkVerb, grab: gVerb, name: 'Reverb', desc: 'Room, plate, hall, shimmer', ink: '#c79bff' },
  { id: 'halo', src: rkHalo, grab: gHalo, name: 'Halo', desc: 'Wide, airy glow. No tails', ink: '#6dff9a' },
  { id: 'glue', src: rkGlue, grab: gGlue, name: 'Glue Comp', desc: 'Bus glue, last in line', ink: '#6fe8ff' },
] as const;
// phone carousel: a pedal renders ~150-230 css px wide (3x = ~690): 400w + 700w, alpha kept (webp)
const [peds400, peds700] = await Promise.all([
  Promise.all(strips.map((s) => getImage({ src: s.ped, width: 400, format: 'webp', quality: 84 }))),
  Promise.all(strips.map((s) => getImage({ src: s.ped, width: 700, format: 'webp', quality: 82 }))),
]);
const pedSizes = '(max-width: 600px) 56vw, 1px';
// the rack renders 600-1020 css px wide (stage 1725 px): the floor + top at 1200w / 2000w (DPR 2 on the widest laptop
// panel); a strip is ~1/5 of that: 240w / 420w. Alpha kept (webp).
const W = geo.stage.w;
const stageSizes = '(max-width: 600px) 1px, (max-width: 1000px) calc(100vw - 80px), 1020px';
const stripSizes = '(max-width: 600px) 1px, (max-width: 1000px) calc((100vw - 80px) / 5), 206px';
const [floor1200, floor2000, top1200, top2000, rk240, rk420, grabs] = await Promise.all([
  getImage({ src: rkFloor, width: 1200, format: 'webp', quality: 78 }),
  getImage({ src: rkFloor, width: 2000, format: 'webp', quality: 76 }),
  getImage({ src: rkTop, width: 1200, format: 'webp', quality: 80 }),
  getImage({ src: rkTop, width: 2000, format: 'webp', quality: 78 }),
  Promise.all(rack.map((s) => getImage({ src: s.src, width: 240, format: 'webp', quality: 82 }))),
  Promise.all(rack.map((s) => getImage({ src: s.src, width: 420, format: 'webp', quality: 80 }))),
  Promise.all(rack.map((s) => getImage({ src: s.grab, width: 120, format: 'webp', quality: 85 }))),
]);
const [bay, bay600] = await Promise.all([
  getImage({ src: baySrc, width: 1060, format: 'webp', quality: 80 }),
  getImage({ src: baySrc, width: 600, format: 'webp', quality: 80 }),
]);
/** stage px -> the CSS custom props a rack part is placed with */
const box = (b: { x: number; y: number; w: number; h: number }) => `--x:${b.x};--y:${b.y};--w:${b.w};--h:${b.h}`;
const H = geo.header;
const lcdK = H.tiles.w / 276;   // the plugin's LCD is drawn in its own px (tiles 276 wide), scaled up in the FX view

const shotSrc = drift.screenshotReady
  ? (Object.values(import.meta.glob<{ default: ImageMetadata }>('../../assets/seasons/drift/drift-window.png', { eager: true }))[0]?.default ?? null)
  : null;
const shot = shotSrc ? await getImage({ src: shotSrc, width: 1200, format: 'webp', quality: 80 }) : null;

// band strip: log frequency axis, 20 Hz .. 20 kHz across 1000 units. The SVG
// stretches to the column (non-scaling strokes); the labels are HTML so they
// stay ≥14 px at 390 px wide.
const x = (f: number) => (Math.log(f / 20) / Math.log(1000)) * 1000;
const ticks = [
  { f: 20, t: '20 Hz' }, { f: 100, t: '100 Hz' }, { f: 1000, t: '1 kHz' }, { f: 10000, t: '10 kHz' }, { f: 20000, t: '20 kHz' },
];
const pc = (f: number) => `${(x(f) / 10).toFixed(2)}%`;
const LOW = 6000, HIGH = 16000;
// transparent placeholder with the photo's own aspect, so the box never jumps (CSP img-src allows data:)
const blank = (w: number, h: number) => `data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 ${w} ${h}'/%3E`;
const baySizes = '(max-width: 1000px) calc(100vw - 80px), 340px';
const baySrcset = `${bay600.src} 600w, ${bay.src} 1060w`;
---
<section class="d-sec" id="fx" aria-labelledby="d-fx-h">
  <div class="d-wrap">
    <DriftPanel sticker="周波数" checker={false} class="d-fx-panel">
      <h2 id="d-fx-h" class="d-headline d-headline--row"><span class="l1">Five effects.</span> <span class="l2">Any order.</span></h2>

      {shot && (
        <figure class="d-shot">
          <img src={shot.src} width={shot.attributes.width ?? 1200} alt="The whole DRIFT plugin window" loading="lazy" decoding="async" />
          <figcaption class="d-fine">The DRIFT window, as it opens in your DAW.</figcaption>
        </figure>
      )}

      <figure class="d-bandfig">
        <div class="d-lcd d-lcd--big d-bandglass">
        {/* HIGH CUT on the top row: its line runs down past the LOW CUT row on
            the right of that label (16k > 6k), so the lines never cross a label
            at any width (at 390 px the other order cut through "HIGH CUT") */}
        <div class="d-band-cuts" aria-hidden="true">
          <span class="d-band-cut" style={`--at:${pc(HIGH)}`}>HIGH CUT 16k</span>
          <span class="d-band-cut" style={`--at:${pc(LOW)}`}>LOW CUT 6k</span>
        </div>
        <div class="d-band-win">
          <svg class="d-bandstrip" viewBox="0 0 1000 100" preserveAspectRatio="none" role="img" aria-label="LOW CUT at 6 kilohertz and HIGH CUT at 16 kilohertz: the effects play only in this slice">
            <rect class="axis" x="0" y="8" width="1000" height="80" />
            {ticks.map((t) => <line class="tick" x1={x(t.f)} x2={x(t.f)} y1="88" y2="100" />)}
            <rect class="lit" x={x(LOW)} y="8" width={x(HIGH) - x(LOW)} height="80" />
            <line class="cut" x1={x(LOW)} x2={x(LOW)} y1="0" y2="100" />
            <line class="cut" x1={x(HIGH)} x2={x(HIGH)} y1="0" y2="100" />
          </svg>
          {/* the lit slice is a lamp: its label glows; ≤600 px only "FX" fits the slice */}
          <span class="d-fx-slice" aria-hidden="true" style={`--l:${pc(LOW)};--r:${pc(HIGH)}`}>FX<span class="d-fx-slice-w"> PLAY HERE</span></span>
        </div>
        <div class="d-band-ticks" aria-hidden="true">
          {ticks.map((t) => <span class:list={[t.f === 10000 && 'd-tick-10k']} style={`left:${pc(t.f)}`}>{t.t}</span>)}
        </div>
        </div>
      </figure>

      <noscript><style>.drift-page img[data-src] { display: none; }</style></noscript>   {/* no JS: only the twins render */}
      {/* 601 px up: THE LIVE RACK (rack.ts). A stage in the plugin's own px (1725 wide, --u = one of them), stacked in
          the plugin's order: floor + LCD < strips < chassis + deck < carriages < the page's LCD parts. A strip and its
          carriage move together (--dx). Images wait for init.ts's deferred loader like the rest of #fx. */}
      <div class="d-rk" data-rack style={`--rk-k:${lcdK}`}>
        <div class="d-rk-stage" data-rk-stage style={`--sw:${W};--sh:${geo.stage.h}`}>
          <img class="d-rk-floor" src={blank(W, geo.stage.h)} data-src={floor2000.src} data-srcset={`${floor1200.src} 1200w, ${floor2000.src} 2000w`}
            sizes={stageSizes} width={W} height={Math.round(geo.stage.h)} alt="" decoding="async" />
          {rack.map((s, i) => (
            <div class="d-rk-strip" data-rk-strip={s.id} style={box(geo.strips[s.id].crop)}>
              <img src={blank(Math.round(geo.strips[s.id].crop.w), Math.round(geo.strips[s.id].crop.h))} data-src={rk420[i].src}
                data-srcset={`${rk240[i].src} 240w, ${rk420[i].src} 420w`} sizes={stripSizes}
                width={Math.round(geo.strips[s.id].crop.w)} height={Math.round(geo.strips[s.id].crop.h)} alt={`DRIFT ${s.name} strip`} decoding="async" />
              <canvas aria-hidden="true" style={box({ ...geo.strips[s.id].screen, x: geo.strips[s.id].screen.x - geo.strips[s.id].crop.x, y: geo.strips[s.id].screen.y - geo.strips[s.id].crop.y })}></canvas>
            </div>
          ))}
          <img class="d-rk-top" src={blank(W, geo.stage.h)} data-src={top2000.src} data-srcset={`${top1200.src} 1200w, ${top2000.src} 2000w`}
            sizes={stageSizes} width={W} height={Math.round(geo.stage.h)} alt="" decoding="async" />
          <i class="d-rk-pulse" aria-hidden="true"></i>
          {rack.map((s, i) => (
            <img class="d-rk-grab" data-rk-grab={s.id} style={box(geo.strips[s.id].grabCrop)} src={blank(83, 31)} data-src={grabs[i].src}
              width={Math.round(geo.strips[s.id].grabCrop.w)} height={Math.round(geo.strips[s.id].grabCrop.h)} alt="" decoding="async" />
          ))}
          {/* the page's own LCD parts, where the plugin draws them (the X key stays out: nothing to close here) */}
          <span class="d-rk-cnt" data-rk-cnt aria-hidden="true" style={box(H.cnt)}>HIT RANDOMIZE</span>
          <div class="d-rk-tiles" data-rk-tiles style={box(H.tiles)}></div>
          <button type="button" class="d-rk-rnd" data-rk-rnd style={box(H.rnd)} aria-label="Randomize the effects: DRIFT's own dice roll a new scene">
            <span class="d-rk-rnd-tag" aria-hidden="true">EXTREME</span>
            <span class="d-rk-rnd-txt">RANDOMIZE</span>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 .5V4.2M11.2 .5V5.6" fill="none" stroke="currentColor" stroke-width="1"/><rect x="1.2" y="4.2" width="7.2" height="7.2" rx="1.6" transform="rotate(-9 4.8 7.8)" fill="none" stroke="currentColor" stroke-width="1.3"/><rect x="8" y="5.6" width="6.6" height="6.6" rx="1.5" transform="rotate(11 11.3 8.9)" fill="none" stroke="currentColor" stroke-width="1.3"/><circle cx="3.4" cy="6.4" r=".9" fill="currentColor"/><circle cx="6.1" cy="9.1" r=".9" fill="currentColor"/><circle cx="11.3" cy="8.9" r=".9" fill="currentColor"/></svg>
          </button>
        </div>
        <ul class="d-rk-caps" role="list">
          {rack.map((s) => (
            <li data-rk-cap={s.id} style={`--ink:${s.ink}`}>
              <h3>{s.name}</h3>
              <p>{s.desc}</p>
            </li>
          ))}
        </ul>
        <p class="d-sr" aria-live="polite" aria-atomic="true" data-rk-say></p>
      </div>

      {/* PHONE ONLY (drift.css: hidden ≥601, the rack hidden ≤600). Dan 10-04: the four effects as a coverflow carousel
          like the home page's plugin showcase (PluginShowcase.astro): the pedal centred in a framed card, its neighbours
          peeking tilted and dimmed, the gear-shift snap, swipe / peek-tap / dots / arrow keys. Each frame wears its
          pedal's hue (the plugin's FX VIBE law). Pedals = true-alpha shots of the plugin's own strips. */}
      <div class="d-fxc" data-fxc tabindex="0" role="group" aria-roledescription="carousel" aria-label="DRIFT effects">
        <p class="d-sr" aria-live="polite" aria-atomic="true" data-fxc-say></p>
        <div class="d-fxc-vp">
          {strips.map((s, i) => (
            <figure class:list={['d-fxc-slide', s.cls, i === 0 ? 'is-current' : i === 1 ? 'is-peek-next' : i === strips.length - 1 ? 'is-peek-prev' : '']}
              data-fxc-slide role="group" aria-roledescription="slide" aria-label={`${s.name}, ${i + 1} of ${strips.length}`}>
              <h3 class="d-fxc-name">{s.name}</h3>
              <p class="d-fxc-desc" set:html={s.desc.replace('Tape-dark', '<span class="d-nw">Tape-dark</span>')} />
              <img class="d-fxc-ped" src={blank(1056, 1908)} data-src={peds700[i].src} data-srcset={`${peds400[i].src} 400w, ${peds700[i].src} 700w`}
                sizes={pedSizes} width="528" height="954" alt={`DRIFT ${s.name} pedal`} decoding="async" />
            </figure>
          ))}
        </div>
        <div class="d-fxc-dots">
          {strips.map((s, i) => <button type="button" class:list={['d-fxc-dot', { active: i === 0 }]} data-fxc-dot={i} aria-label={`Show ${s.name}`}></button>)}
        </div>
      </div>

      <div class="d-fx-foot">
        <div class="d-bay">
          <img src={blank(1060, 382)} data-src={bay.src} data-srcset={baySrcset} sizes={baySizes} width="530" height="191" alt="DRIFT's saturation bay" decoding="async" />
          <noscript><img src={bay.src} srcset={baySrcset} sizes={baySizes} width="530" height="191" alt="DRIFT's saturation bay" loading="lazy" decoding="async" /></noscript>
        </div>
        <div class="d-fx-spec">
          <span class="d-fx-kicker" aria-hidden="true">Also under the hood</span>
          <dl class="d-spec-plate">
            <div><dt>SATURATE</dt><dd>Tape, tube, transformer, digital</dd></div>
            <div><dt>GLUE COMP</dt><dd>Console bus glue</dd></div>   {/* DRIFT 5.0.0: GLUE COMP replaces AUTOTUNE (Dan 10-08) */}
            <div><dt>PRESETS</dt><dd>60 · vocal, keys, guitar, drums, bass, mix bus</dd></div>
            {drift.randomizeInBuild && <div><dt>RANDOMIZE</dt><dd>One roll, new effects. One undo, back.</dd></div>}
          </dl>
        </div>
      </div>
    </DriftPanel>
  </div>
</section>

<script>
  // one cue: the cut flags + the lit slice flicker on once like phosphor when
  // the band display comes into view (drift.css SECTION 3). Rest = lit, so no
  // JS / no IO / reduced motion all show the labels on.
  const glass = document.querySelector<HTMLElement>('#fx .d-bandglass');
  if (glass && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        (e.target as HTMLElement).dataset.lit = '';
        io.unobserve(e.target);
      }
    }, { threshold: 0.5 });
    io.observe(glass);
  }
</script>

<script>
  /* the phone #fx carousel (Dan 10-04): the shared coverflow engine */
  import { initCoverflow } from '../../lib/drift/coverflow';
  document.querySelectorAll<HTMLElement>('#fx [data-fxc]').forEach(initCoverflow);
</script>

<script>
  /* the live rack (601 px up, Dan 10-09): rack.ts. Phones never start it (the rack is display:none there, so its
     images never load either). */
  import { initRack } from '../../lib/drift/rack';
  const rk = document.querySelector<HTMLElement>('#fx [data-rack]');
  if (rk && matchMedia('(min-width: 601px)').matches) initRack(rk);
</script>
