---
/**
 * Section 4 — TEST DRIVE (#get), the main close. Left: the keep-it ladder
 * (condition first, value on sunk glass, only the FREE route links). Right,
 * on DRIFT panel chrome: the one working sign-up (DriftCapture #try, compat
 * line first). Below: the specs that are left, folded into <details>, and a
 * plain maker line (no exits at the conversion point).
 * Everything reads from src/data/drift.ts, so each flip is one line + flags:
 * 'open' with gateWired swaps the capture for TrialGateModal (still email
 * delivery, no download link on the page); 'released' swaps it for the
 * designed .d-buyslot (unreachable in preopen; the build refuses 'released'
 * without checkoutUrl, see assertDriftConfig).
 */
import DriftPanel from './DriftPanel.astro';
import DriftCapture from './DriftCapture.astro';
import { drift, ctaFor, routesFor, formatsShort, compatLine } from '../../data/drift';
import { plugins } from '../../data/plugins';
import { site } from '../../data/site';

const cta = ctaFor();
const routes = routesFor();
const checkoutUrl = plugins.find((p) => p.slug === 'drift')?.checkoutUrl ?? undefined;
const registerUrl = site.downloadGate.workerUrl + '/download/register';
---
<section class="d-sec" id="get" data-drift-cta-zone aria-labelledby="d-get-h">
  <div class="d-wrap">
    <div class="d-sechead">
      <span class="d-marquee" aria-hidden="true">TEST DRIVE</span>
      <span class="d-ja" lang="ja" aria-hidden="true">試乗</span>
      <span class="d-rule" aria-hidden="true"></span>
    </div>
    <h2 id="d-get-h" class="d-headline"><span class="l1">Test drive DRIFT</span> <span class="l2">free for {drift.trialDays} days.</span></h2>

    <div class="d-getin" data-drift-fab-watch>
      <div>
        {routes.length > 0 && (
          <Fragment>
            <p class="d-ladder-label">
              {routes.length === 3 ? `After your ${drift.trialDays} days, keep it one of three ways:` : 'Keep it:'}
            </p>
            <ol class="d-ladder" role="list">
              {routes.map((r) => (
                <li class:list={['d-route', `d-route--${r.id}`]}>
                  <span class="d-route-cond">{r.cond}</span>
                  <span class="d-route-note">{r.note}{r.href && <Fragment> <a href={r.href}>How it works ›</a></Fragment>}</span>
                  {r.value && <span class="d-lcd d-route-val">{r.value}</span>}
                </li>
              ))}
            </ol>
          </Fragment>
        )}
      </div>

      <DriftPanel sticker="試乗" class="d-get-panel">
        {cta.action === 'cart' ? (
          <div class="d-buyslot">
            <button type="button" class="d-cta" data-add-to-cart data-cart-label data-slug="drift" data-name="Drift"
              data-price={drift.listPriceUsd} data-checkout-url={checkoutUrl}>Buy DRIFT · ${drift.listPriceUsd}</button>
            <p class="d-cta-sub">{formatsShort()}</p>
          </div>
        ) : cta.action === 'gate' ? (
          <div class="d-capture" id="try">
            <p class="d-compat">{compatLine()}</p>
            <button type="button" class="d-cta" data-trial-gate-open data-plugin-name="DRIFT"
              data-plugin-slug={drift.gateId} data-register-url={registerUrl}>{cta.label}</button>
            <p class="d-cta-fine">The download comes by email: open it on your computer. Nothing to pay today.</p>
          </div>
        ) : (
          <DriftCapture />
        )}
      </DriftPanel>
    </div>

    <div class="d-more" data-drift-fab-watch>
      <details>
        <summary>Specs</summary>
        <dl class="d-more-dl">
          <div><dt>Window</dt><dd>resizable</dd></div>
          <div><dt>Saturation oversampling</dt><dd>2x to 32x</dd></div>
        </dl>
      </details>
      <details>
        <summary>Which DAWs?</summary>
        <p>{drift.aaxReady
          ? 'Any host that loads VST3, AU or AAX on a Mac, or VST3 or AAX on Windows, Pro Tools included.'
          : 'Any host that loads VST3 or AU on a Mac, or VST3 on Windows. Not Pro Tools yet.'}</p>
      </details>
      {drift.afterTrialAnswer && (
        <details>
          <summary>What happens after {drift.trialDays} days?</summary>
          <p>{drift.afterTrialAnswer}</p>
        </details>
      )}
    </div>
    <p class="d-small d-maker">From RevAudio, the makers of RevLimiter.</p>
  </div>
</section>
