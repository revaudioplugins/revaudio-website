---
/**
 * BAND SELECT (#band). Dan 2026-10-09: show the filter that picks where the effects and the plugin work; "very
 * minimized"; then "bring the real spectrum of drift and the imager from real drift, show a spectrum of a vocal on the
 * band selection, remove the factory presets, 'Below and above the band, your mix stays as it was.' give it more love"
 * (his pick: a big line under the screens).
 * The two screens are DRIFT's left cabinet, shot from the plugin (tools/shoot-drift-band-screens.mjs) and cut at the
 * seam: BAND SELECT (the live spectrum + the LOW / HIGH CUT lines) and STEREO IMAGER (lissajous + CORR). Their live
 * layers are the plugin's own drawing code (src/lib/drift/bandscreens.ts) fed by a real lead vocal baked to analysis
 * data (tools/bake-drift-band-vocal.mjs -> public/drift/band-vocal.bin; no audio ships). Drag a cut and the imager
 * shows it: the band swings with the page's pan, the rest stays a still mono line.
 * The truth (Drift 5.2.7): ONE band from a 3-way LR4 split, not multiband; pan, DRIVE and the FX run on it; below and
 * above pass untouched. GLUE COMP in its default last slot is the one whole-output stage, so the copy never says
 * "everything". Sits between the hero and #drive: the wheel pans -> what it pans -> the tracks drive it -> the FX rack.
 */
import { getImage } from 'astro:assets';
import geo from '../../assets/seasons/drift/band/band.json';
import bandSrc from '../../assets/seasons/drift/band/band-glass.png';
import imagerSrc from '../../assets/seasons/drift/band/imager-glass.png';

const LO = 250, HI = 4000;   // the slice the page opens on: a vocal's body and presence
const [band, imager] = await Promise.all([
  getImage({ src: bandSrc, width: 800, format: 'webp', quality: 80 }),
  getImage({ src: imagerSrc, width: 800, format: 'webp', quality: 80 }),
]);
const pos = (f: number) => Math.round((Math.log10(f / 20) / 3) * 1000);   // the a11y sliders: 0..1000 on the log axis
const eq = geo.band.eq, sc = geo.imager.scope;
---
<section class="d-sec d-bs" id="band" aria-labelledby="d-bs-h">
  <div class="d-wrap">
    <h2 id="d-bs-h" class="d-headline d-headline--row"><span class="l1">Pick the slice.</span> <span class="l2">DRIFT plays only there.</span></h2>
    <div class="d-bs-cab" data-bs data-lo={LO} data-hi={HI} data-vocal="/drift/band-vocal.bin">
      <figure class="d-bs-piece d-bs-band" style={`--pw:${geo.w};--ph:${geo.band.h}`}>
        <img src={band.src} width={geo.w} height={Math.round(geo.band.h)} alt="DRIFT's BAND SELECT screen: a vocal's live spectrum between the LOW CUT and HIGH CUT lines" loading="lazy" decoding="async" />
        <div class="d-bs-eq" data-bs-eq style={`--x:${eq.x};--y:${eq.y};--sx:${eq.sx};--sy:${eq.sy}`}>
          <canvas data-bs-spec aria-hidden="true"></canvas>
          <svg data-bs-svg viewBox="0 0 410 156" aria-hidden="true"></svg>
        </div>
        <label class="d-sr">Low cut <input type="range" min="0" max="1000" value={pos(LO)} data-bs-range="LOW" /></label>
        <label class="d-sr">High cut <input type="range" min="0" max="1000" value={pos(HI)} data-bs-range="HIGH" /></label>
      </figure>
      <figure class="d-bs-piece d-bs-imager" style={`--pw:${geo.w};--ph:${geo.imager.h}`}>
        <img src={imager.src} width={geo.w} height={Math.round(geo.imager.h)} alt="DRIFT's STEREO IMAGER: only the band moves left and right" loading="lazy" decoding="async" />
        <canvas data-bs-scope aria-hidden="true" style={`--x:${sc.x};--y:${sc.y}`}></canvas>
      </figure>
    </div>
    <p class="d-bs-line"><span class="l1">Below and above the band,</span> <span class="l2">your mix stays as it was.</span></p>
  </div>
</section>

<script>
  import { initBandScreens } from '../../lib/drift/bandscreens';
  document.querySelectorAll<HTMLElement>('[data-bs]').forEach(initBandScreens);
</script>
