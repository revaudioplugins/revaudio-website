---
/**
 * Section 3 — the left cabinet: BAND SELECT over STEREO IMAGER, the plugin's
 * own arcade2_left_plate.png. The screens are re-made for the web (review H19:
 * never lift anything bound to Juce.*): an SVG band window whose LOW CUT /
 * HIGH CUT lines really drag (and really re-window the test deck's audio),
 * and a canvas goniometer fed by the deck's actual left/right output.
 * Window rects measured off the plate (1024x1417): EQ glass 140,215 765x315,
 * imager glass 142,685 728x612, CORR slot 932,905 30x290.
 */
import { getImage } from 'astro:assets';
import plateSrc from '../../assets/seasons/drift/arcade2_left_plate.png';

const plate = await getImage({ src: plateSrc, width: 880, format: 'webp', quality: 76 });

// log-frequency x axis, 20 Hz .. 20 kHz across the 765-unit window
const W = 765, H = 315, F0 = 20, F1 = 20000;
const fx = (f: number) => (Math.log(f / F0) / Math.log(F1 / F0)) * W;
const ticks = [50, 100, 200, 500, 1000, 2000, 5000, 10000];
const tickLabel = (f: number) => (f >= 1000 ? `${f / 1000}k` : `${f}`);
const LOW = 250, HIGH = 5000;   // demo window; the plugin itself defaults to the full 20 Hz - 20 kHz
---
<section class="d-sec" aria-labelledby="d-band-h">
  <div class="d-wrap">
    <div class="d-sechead">
      <h2 id="d-band-h">Pick the band</h2>
      <span class="d-ja" lang="ja" aria-hidden="true">周波数</span>
      <span class="d-rule" aria-hidden="true"></span>
    </div>

    <div class="d-band">
      <div class="d-cabinet" data-band>
        <img src={plate.src} width="440" height="609" alt="" aria-hidden="true" loading="lazy" decoding="async" />
        <div class="d-cab-eq">
          <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="group" aria-label="Band window">
            {ticks.map((f) => (
              <g aria-hidden="true">
                <line x1={fx(f)} x2={fx(f)} y1="18" y2={H - 30} stroke="rgba(190,90,255,.14)" stroke-width="1.5" />
                <text class="d-cutlabel" x={fx(f)} y={H - 10} text-anchor="middle" style="font-size:18px;fill:#8b62b8">{tickLabel(f)}</text>
              </g>
            ))}
            <rect data-band-fill x={fx(LOW)} y="0" width={fx(HIGH) - fx(LOW)} height={H - 30} fill="rgba(180,107,255,.13)" />
            <path data-band-spec d={`M0 ${H - 60} ` + Array.from({ length: 48 }, (_, i) => `L${((i + 1) / 48) * W} ${H - 60 - 34 * Math.sin(i * 0.9) * Math.exp(-i / 30)}`).join(' ')}
              fill="none" stroke="#b46bff" stroke-width="3" style="filter:drop-shadow(0 0 5px rgba(180,107,255,.8))" />
            {[{ id: 'low', f: LOW, label: 'LOW CUT' }, { id: 'high', f: HIGH, label: 'HIGH CUT' }].map((h) => (
              <g class="d-cut" data-cut={h.id} data-f={h.f} tabindex="0" role="slider"
                 aria-label={h.label} aria-valuemin="20" aria-valuemax="20000" aria-valuenow={h.f}
                 aria-valuetext={`${h.label} ${h.f >= 1000 ? h.f / 1000 + ' kHz' : h.f + ' Hz'}`}
                 transform={`translate(${fx(h.f)} 0)`} style="cursor:ew-resize">
                <rect x="-16" y="0" width="32" height={H - 30} fill="transparent" />
                <line x1="0" x2="0" y1="0" y2={H - 30} stroke="#f24cf0" stroke-width="3.2" style="filter:drop-shadow(0 0 6px rgba(242,76,240,.9))" />
                <text data-cut-label x={h.id === 'low' ? 8 : -8} y="26" text-anchor={h.id === 'low' ? 'start' : 'end'}
                  style="font-family:VT323,monospace;font-size:22px;fill:#ffd1f8">{h.label}</text>
                <text data-cut-val x={h.id === 'low' ? 8 : -8} y="48" text-anchor={h.id === 'low' ? 'start' : 'end'}
                  style="font-family:VT323,monospace;font-size:22px;fill:#d98bff">{h.f >= 1000 ? `${h.f / 1000}k Hz` : `${h.f} Hz`}</text>
                <text x="0" y={H - 44} text-anchor="middle" style="font-family:VT323,monospace;font-size:24px;fill:#f24cf0">‹ ›</text>
              </g>
            ))}
          </svg>
        </div>
        <div class="d-cab-img"><canvas data-imager width="728" height="612" aria-hidden="true"></canvas></div>
        <div class="d-cab-corr" data-corr aria-hidden="true"></div>
      </div>

      <div class="d-band-copy">
        <div>
          <h3>Band select</h3>
          <p class="d-lede">Drag LOW CUT and HIGH CUT to window the slice you want moving. SOLO plays only that slice while you set it, and everything outside the window stays where it was.</p>
          <div class="d-route" role="group" aria-label="Route (display only on this page)">
            <button class="d-slot" type="button" data-route="stereo" aria-pressed="true">STEREO</button>
            <button class="d-slot" type="button" data-route="mid" aria-pressed="false">MID</button>
            <button class="d-slot" type="button" data-route="side" aria-pressed="false">SIDE</button>
          </div>
          <p class="d-small" style="margin-top:10px" data-route-note>STEREO moves the band as it is. MID works the centre, SIDE only the stereo edges.</p>
        </div>
        <div>
          <h3>Stereo imager</h3>
          <p class="d-lede">Watch it move. Tall means mono energy, wide means side energy. Play the deck above and drag the cut lines: the part that swings is the part you windowed.</p>
        </div>
      </div>
    </div>
  </div>
</section>
