---
/**
 * BAND SELECT (#band, Dan 2026-10-09: "add that there is a filter where you choose the area the effects and the whole
 * plugin work on", then "it needs to be very minimized"). One headline, one slim strip, three chips.
 * The truth it shows (Drift 5.2.7 PluginProcessor.cpp): ONE band, cut out by a 3-way LR4 crossover (LOW CUT 20 Hz-20 kHz,
 * HIGH CUT 70 Hz-20 kHz). Band gain, TAPE/DRIVE, the FX chain, the PAN wheel / TRACKS and the width run on that band;
 * below and above it pass untouched (latency-matched). Not "multiband": no per-band settings. GLUE COMP in its default
 * last slot is the one stage on the whole output, so the copy names pan, drive and FX, not "everything".
 * The chips are real factory presets' bands (PresetManager.cpp): Undercut Bass 800 Hz-6 kHz, Banking Keys 3-16 kHz
 * (sides only), Paul Ricard 6 kHz up. Drag a cut (or arrow keys on it) = band.ts. No JS: the Undercut Bass band, static.
 * Sits between the hero and #drive: the wheel pans -> what it pans -> the tracks drive it -> the FX rack plays on it.
 */
const presets = [
  { name: 'Undercut Bass', lo: 800, hi: 6000, note: 'grit only, the sub never moves' },
  { name: 'Banking Keys', lo: 3000, hi: 16000, note: 'the air, on the sides' },
  { name: 'Paul Ricard', lo: 6000, hi: 20000, note: 'everything above 6k' },
];
const [start] = presets;
const x = (f: number) => (Math.log(f / 20) / Math.log(1000)) * 100;   // log axis, 20 Hz .. 20 kHz = 0 .. 100 %
const hz = (f: number) => (f >= 1000 ? `${+(f / 1000).toFixed(f % 1000 ? 1 : 0)} kHz` : `${Math.round(f)} Hz`);
const ticks = [20, 100, 1000, 10000, 20000];
---
<section class="d-sec d-bs" id="band" aria-labelledby="d-bs-h">
  <div class="d-wrap">
    <h2 id="d-bs-h" class="d-headline d-headline--row"><span class="l1">Pick the slice.</span> <span class="l2">DRIFT plays only there.</span></h2>
    <div class="d-lcd d-lcd--big d-bs-glass" data-bs style={`--lo:${x(start.lo)}%;--hi:${x(start.hi)}%`}>
      <p class="d-bs-read" aria-hidden="true"><span>BAND SELECT</span> <b data-bs-read>{hz(start.lo)} – {hz(start.hi)}</b></p>
      <div class="d-bs-track" data-bs-track>
        <i class="d-bs-slice" aria-hidden="true"><span>PAN · DRIVE · FX</span></i>
        <button type="button" class="d-bs-cut" data-cut="lo" role="slider" aria-label="Low cut" aria-valuemin="20" aria-valuemax="19950"
          aria-valuenow={start.lo} aria-valuetext={hz(start.lo)}></button>
        <button type="button" class="d-bs-cut" data-cut="hi" role="slider" aria-label="High cut" aria-valuemin="70" aria-valuemax="20000"
          aria-valuenow={start.hi} aria-valuetext={hz(start.hi)}></button>
      </div>
      <div class="d-bs-ticks" aria-hidden="true">
        {ticks.map((f) => <span class:list={[f === 10000 && 'd-tick-10k']} style={`left:${x(f)}%`}>{hz(f)}</span>)}
      </div>
    </div>
    <div class="d-bs-foot">
      <span class="d-bs-kicker" aria-hidden="true">Factory presets</span>
      {presets.map((p, i) => (
        <button type="button" class="d-bs-chip" data-lo={p.lo} data-hi={p.hi} aria-pressed={String(i === 0)}
          aria-label={`${p.name}: ${hz(p.lo)} to ${hz(p.hi)}, ${p.note}`}>{p.name}</button>
      ))}
      <p class="d-fine d-bs-fine">Below and above the band, your mix stays as it was.</p>
    </div>
  </div>
</section>

<script>
  import { initBand } from '../../lib/drift/band';
  document.querySelectorAll<HTMLElement>('[data-bs]').forEach((el) => initBand(el, el.closest('section')!));
</script>
