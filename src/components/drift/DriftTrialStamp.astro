---
/**
 * Hero trial stamp: RevLimiter's TrialStamp format (label · email + GET IT ▸),
 * worn in DRIFT's materials (Dan 10-01: "copy the revlimiter
 * format ... put it on the design of drift and ditch the try it free").
 * Post-language label (Oswald, FREE in the purple line-2 glow), the email
 * well is the sunk readout glass, the key is the plugin's red key.
 *
 * Backend: NOT RevLimiter's /download/register (the worker has no DRIFT gate
 * yet, drift.gateWired) but DriftCapture's contract, shared through
 * src/lib/drift/capture.ts: /form-once with this phase's source, and the
 * phase's honest status lines (preopen: the download mail on Oct 10).
 * Dan 10-01 cut the micro lines under the key; the list line came back as one
 * tiny consent line (the sign-up joins the newsletter list).
 */
import { site } from '../../data/site';
import { drift, captureCopyFor } from '../../data/drift';

const copy = captureCopyFor();
if (!copy) throw new Error(`[DriftTrialStamp] phase '${drift.phase}' has no capture copy (captureCopyFor).`);
const onceUrl = site.downloadGate.workerUrl + '/form-once';
const closed = drift.phase === 'closed';
---
<div class="d-stamp">
  <p class="d-stamp-label" id="d-stamp-label">
    {closed
      ? <Fragment>Get <em>notified</em></Fragment>
      : <Fragment><span>Get your <em>free</em></span> <span>{drift.trialDays}&#8209;day trial</span></Fragment>}
  </p>
  <form class="d-stamp-form" action={site.formspreeEndpoint} method="POST" aria-labelledby="d-stamp-label"
    data-drift-capture data-once-url={onceUrl} data-msg-ok={copy.ok} data-msg-already={copy.already}>
    <label for="d-stamp-email" class="d-sr">Your email: we send the DRIFT download here</label>
    <input id="d-stamp-email" class="d-field d-stamp-field" type="email" name="email" required
      autocomplete="email" inputmode="email" enterkeyhint="go" spellcheck="false" placeholder="your@email.com" />
    <input type="hidden" name="source" value={copy.source} />
    <!-- honeypot: real users never fill this; bots do -->
    <input type="text" name="_gotcha" class="d-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <button type="submit" class="d-cta d-stamp-key"><span data-face>Get it <span class="d-stamp-arrow" aria-hidden="true">&#9656;</span></span></button>
  </form>
  <p class="d-capture-status" role="status" aria-live="polite" tabindex="-1"></p>
  <!-- consent: the sign-up joins the newsletter list, so it is said at the point of capture (Dan 10-01, option a) -->
  <p class="d-stamp-fine">You join our list · unsubscribe anytime</p>
</div>
