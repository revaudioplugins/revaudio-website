---
/* Company address + a small embedded Google map.
   Keyless embed: the URL Google 301s `maps?q=…&output=embed` to — no API key,
   no billing, no script on our page. `caption` prints the address line above
   the map; /contact turns it off because its spec-row already carries it.

   PRODUCTION CSP (Cloudflare Transform Rule "Security Headers", dashboard-only):
   frame-src must list https://www.google.com or the frame renders blank on
   revaudio.net. The "Open in Google Maps" link below works regardless. */
import { site } from '../data/site';
const { caption = true } = Astro.props;
const q = encodeURIComponent(site.address);
const embedSrc = `https://www.google.com/maps/embed?origin=mfe&pb=!1m3!2m1!1s${q}!6i16`;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${q}`;
---
<div class="addr">
  {caption && <address class="addr-text">{site.address}</address>}
  <div class="addr-map">
    <iframe
      src={embedSrc}
      title={`Map: RevAudio, ${site.address}`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </div>
  <a class="addr-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Open in Google Maps (opens in new tab)</a>
</div>

<style>
  .addr { margin-top: 1.25rem; }
  .addr-text {
    font-style: normal;
    color: var(--fg);
    margin: 0 0 0.75rem;
  }
  .addr-map {
    height: 240px;
    border: 1px solid var(--border-bright);
    border-radius: 6px;
    overflow: hidden;
    background: var(--bg-2);
  }
  .addr-map iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    /* Warm, slightly faded print so the white map sits in the brass/oxide page.
       Off in high-contrast mode — the map must read as printed. */
    filter: grayscale(0.3) sepia(0.2) brightness(0.9);
  }
  :global(html.hc) .addr-map iframe { filter: none; }
  .addr-link {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: 0.9rem;
  }
  @media (max-width: 600px) {
    .addr-map { height: 200px; }
  }
</style>
