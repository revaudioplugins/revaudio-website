---
interface Props {
  heading?: string;
  subhead?: string;
  buttonLabel?: string;
  id?: string;
}

const {
  // Offer-first defaults (conversion pass 2026-08-03): "Subscribe to the
  // newsletter" is the weakest framing in the category, and live competitor
  // audit found zero brands saying "No spam" — permission language instead.
  heading = 'Join the pit crew',
  subhead = 'Early plugin drops, demo codes, and intro pricing, straight to your inbox. Unsubscribe anytime.',
  buttonLabel = 'Sign me up',
  id,
} = Astro.props;

import { site } from '../data/site';

// JS and no-JS submits both go through the license worker's one-per-email
// relay, which holds the Formspree id (never print it in a page: bots post
// straight to it, 2026-11-02).
const onceUrl = site.downloadGate.workerUrl + '/form-once';
// "Unsubscribe anytime." can sit under the form as fine print (the phone layouts below); one of the two shows, never both
const split = subhead.match(/^(.*?)\s*(Unsubscribe anytime\.?)$/);
const lead = split ? split[1] : subhead, tail = split ? split[2] : '';
const DEV = import.meta.env.DEV;
const endpoint = onceUrl + '?form=newsletter';
---

<section class="signup" id={id}>
  {DEV && (
    <div class="pit-pick" aria-label="Pit crew layout (dev only)">
      <button type="button" data-pit-set="">Today</button><button type="button" data-pit-set="a">A Clipboard</button><button type="button" data-pit-set="b">B Sign</button><button type="button" data-pit-set="c">C Ledger</button>
    </div>
  )}
  <div class="container" data-reveal>
    <p class="signup-kicker">Newsletter</p>
    <h2>{heading}</h2>
    <p class="signup-lead">{lead}{tail && <span class="signup-unsub"> {tail}</span>}</p>
    <form class="signup-form" action={endpoint} method="POST" data-newsletter data-once-url={onceUrl}>
      <label for="newsletter-email" class="sr-only">Email address</label>
      <input
        id="newsletter-email"
        type="email"
        name="email"
        placeholder="you@studio.com"
        required
        autocomplete="email"
      />
      <!-- honeypot: real users never fill this; bots do -->
      <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button type="submit" class="signup-submit rv-btn rv-btn--sm">
        <span class="rv-btn__label">{buttonLabel}</span><span class="ss-arrow" aria-hidden="true">&#9656;</span>
      </button>
    </form>
    {tail && <p class="signup-fine">{tail}</p>}
    <p class="signup-status" role="status" aria-live="polite" hidden></p>
  </div>
</section>
{DEV && (
  <script is:inline>
    // dev only: the three phone layouts on buttons (?pit=a|b|c opens on one); never in a build
    (function () {
      var H = document.documentElement, q = new URLSearchParams(location.search).get('pit'), set = function (v) { if (v) H.dataset.pit = v; else delete H.dataset.pit;
        document.querySelectorAll('[data-pit-set]').forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.pitSet === (v || ''))); }); };
      set(q === 'today' ? '' : q && /^[abc]$/.test(q) ? q : 'a');
      document.addEventListener('click', function (e) { var b = e.target.closest && e.target.closest('[data-pit-set]'); if (b) set(b.dataset.pitSet); });
    })();
  </script>
)}

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-newsletter]').forEach((form) => {
    const status = form.parentElement?.querySelector<HTMLElement>('.signup-status');
    // Build-time placeholder still in the action ⇒ not wired to a real backend yet.
    const wired = !form.action.includes('REPLACE_WITH_FORM_ID');

    const show = (msg: string, ok: boolean) => {
      if (!status) return;
      status.textContent = msg;
      status.hidden = false;
      status.classList.toggle('ok', ok);
      status.classList.toggle('err', !ok);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!wired) {
        show('Almost there. Newsletter signup goes live shortly. Your email wasn’t sent yet.', false);
        return;
      }
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;
      try {
        const res = await fetch(form.dataset.onceUrl!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ form: 'newsletter', ...Object.fromEntries(new FormData(form)) }),
        });
        const j = await res.json().catch(() => null);
        if (j && j.ok) {
          form.hidden = true;
          show(j.already ? 'You’re already on the list.' : 'You’re on the list. Watch your inbox for the first build.', true);
        } else {
          show((j && j.error) || 'Something went wrong. Try again, or email info@revaudio.net.', false);
        }
      } catch {
        show('Network hiccup. Try again in a moment.', false);
      }
      if (submitBtn) submitBtn.disabled = false;
    });
  });
</script>

<style>
  /* The submit is the button family's small brass (src/styles/buttons.css,
     Dan 2026-10-18), level with the input on the row. Only placement here. */
  .signup form { align-items: stretch; gap: 0.5rem; }

  .signup .signup-form .signup-submit { flex: none; }
  .signup .signup-form .ss-arrow { opacity: 0.7; }

  /* honeypot — visually and semantically hidden, still submittable by bots */
  .signup form .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .signup .signup-status {
    margin: 1.25rem auto 0;
    max-width: 480px;
    font-size: 0.95rem;
  }
  .signup .signup-status.ok { color: var(--brass-bright); }

  /* The one allowed confirmation accent (motion plan): soft settle-pop on the
     success message. Gated on motion-ok so reduced-motion/no-JS stay static.
     Overshoot bezier ≈ back.out, kept under the 8% bible ceiling. */
  :global(html.motion-ok) .signup .signup-status.ok {
    animation: status-pop 0.45s cubic-bezier(0.34, 1.35, 0.64, 1) both;
  }

  @keyframes status-pop {
    from { opacity: 0; transform: scale(0.92) translateY(6px); }
    to { opacity: 1; transform: none; }
  }
  .signup .signup-status.err { color: var(--fg-dim); }
  /* Under 480px the global rule stacks the form; centre the button there so it
     doesn't stretch the full input width. */
  @media (max-width: 480px) {
    .signup .signup-form .signup-submit { align-self: center; min-width: 180px; }
  }

  /* the kicker and the fine print: only the phone layouts below use them */
  .signup-kicker, .signup-fine { display: none; }

  /* ---- Phones: three compositions to pick from (Dan 2026-11-24: "the join the pit crew need to be redesigned as well.
     It's supposed to be like way polished composition"). Same words, same form; only the layout. html[data-pit]
     picks one (dev buttons); once Dan picks, his stays as the phone layout and the other two go. ---- */
  @media (max-width: 860px) {
    :global(html[data-pit]) .signup-kicker {
      display: block; margin: 0 0 0.55rem; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.3em;
      text-transform: uppercase; color: var(--brass);
    }
    :global(html[data-pit]) .signup .signup-unsub { display: none; }
    :global(html[data-pit]) .signup-fine { display: block; margin: 0.75rem 0 0; font-size: 0.72rem; color: var(--fg-faint); }
    :global(html[data-pit]) .signup h2 { margin: 0; line-height: 0.95; }
    :global(html[data-pit]) .signup .signup-lead { margin: 0.7rem 0 1.25rem; font-size: 0.95rem; line-height: 1.5; color: var(--fg-dim); }
    /* the field and the key as one part: the same height and corner, the key seated in the field's right end */
    :global(html[data-pit]) .signup form { flex-direction: row; gap: 0; max-width: none; margin: 0; align-items: stretch; }
    :global(html[data-pit]) .signup input[type='email'] {
      min-width: 0; height: 48px; padding: 0 0.9rem; font-size: 0.95rem; border-radius: 12px 0 0 12px; border-right: 0;
      background: var(--bg-0); box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.55);
    }
    :global(html[data-pit]) .signup .signup-form .signup-submit { align-self: stretch; min-width: 0; border-radius: 0 12px 12px 0; padding: 0 1rem; }

    /* A, the clipboard (DESIGN.md's map: the pit-crew clipboard): a board on the wall with a brass clip, the sheet's
       words set left on it */
    :global(html[data-pit='a']) .signup { padding: 3.25rem 0 3rem; }
    :global(html[data-pit='a']) .signup .container {
      position: relative; width: calc(100% - 2rem); max-width: 23rem; margin: 0 auto; padding: 2.35rem 1.25rem 1.4rem; text-align: left; /* (a gutter round the board on the narrowest phones) */
      background: linear-gradient(180deg, rgba(255, 214, 150, 0.06), rgba(255, 214, 150, 0) 38%), var(--bg-1);
      border: 1px solid var(--border-bright); border-radius: 8px;
      box-shadow: 0 1px 0 #000, 0 14px 34px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(232, 200, 120, 0.07);
    }
    :global(html[data-pit='a']) .signup .container::before { /* the clip: brass, dark-brass-bright (the 3-stop rule), two screws */
      content: ''; position: absolute; top: -0.7rem; left: 50%; width: 5.5rem; height: 1.4rem; transform: translateX(-50%); border-radius: 4px;
      background:
        radial-gradient(circle at 18% 50%, #5f4311 0 2px, transparent 2.6px), radial-gradient(circle at 82% 50%, #5f4311 0 2px, transparent 2.6px),
        linear-gradient(180deg, var(--brass-bright), var(--brass) 55%, var(--brass-dark));
      box-shadow: 0 1px 0 #000, 0 4px 8px rgba(0, 0, 0, 0.5);
    }
    :global(html[data-pit='a']) .signup h2 { font-size: 2.2rem; }

    /* B, the sign: centred, the title between two brass rules, the field and key one bar under a short line */
    :global(html[data-pit='b']) .signup { padding: 3rem 0 3rem; }
    :global(html[data-pit='b']) .signup .container { max-width: 23rem; text-align: center; }
    :global(html[data-pit='b']) .signup h2 { display: flex; align-items: center; justify-content: center; gap: 0.75rem; font-size: 2.1rem; }
    :global(html[data-pit='b']) .signup h2::before, :global(html[data-pit='b']) .signup h2::after {
      content: ''; flex: 1; max-width: 3rem; height: 2px; background: linear-gradient(90deg, transparent, var(--brass-dark), var(--brass));
    }
    :global(html[data-pit='b']) .signup h2::after { background: linear-gradient(270deg, transparent, var(--brass-dark), var(--brass)); }
    :global(html[data-pit='b']) .signup .signup-lead { max-width: 19rem; margin-inline: auto; }

    /* C, the ledger: set left like a page, the title big on two lines with a short brass bar under it, the key full
       width under the field */
    :global(html[data-pit='c']) .signup { padding: 3.25rem 0 3.25rem; }
    :global(html[data-pit='c']) .signup .container { max-width: 23rem; text-align: left; }
    :global(html[data-pit='c']) .signup h2 { font-size: 3.2rem; line-height: 0.9; max-width: 9ch; } /* two lines: JOIN THE / PIT CREW */
    :global(html[data-pit='c']) .signup h2::after { content: ''; display: block; width: 2.75rem; height: 3px; margin-top: 0.85rem; background: var(--brass); }
    :global(html[data-pit='c']) .signup form { flex-direction: column; gap: 0.55rem; }
    :global(html[data-pit='c']) .signup input[type='email'] { flex: none; border-radius: 12px; border-right: 1px solid var(--border-bright); }
    :global(html[data-pit='c']) .signup .signup-form .signup-submit { border-radius: 12px; min-height: 48px; }
  }

  /* dev only: the layout buttons */
  .pit-pick { position: absolute; right: 8px; top: 8px; z-index: 5; display: flex; gap: 4px; }
  .pit-pick button { font: 600 11px/1 var(--font-body); padding: 7px 8px; border-radius: 999px; border: 1px solid var(--border-bright); background: var(--bg-1); color: var(--fg-dim); }
  .pit-pick button[aria-pressed='true'] { background: var(--brass-bright); color: #1e1710; border-color: var(--brass-bright); }
  .signup { position: relative; }
</style>
