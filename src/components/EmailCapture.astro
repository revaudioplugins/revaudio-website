---
interface Props {
  heading?: string;
  subhead?: string;
  buttonLabel?: string;
  id?: string;
}

const {
  // Offer-first defaults (conversion pass 2026-08-03): "Subscribe to the
  // newsletter" is the weakest framing in the category, and live competitor
  // audit found zero brands saying "No spam" — permission language instead.
  heading = 'Join the pit crew',
  subhead = 'Early plugin drops, demo codes, and intro pricing, straight to your inbox. Unsubscribe anytime.',
  buttonLabel = 'Sign me up',
  id,
} = Astro.props;

import { site } from '../data/site';

// JS and no-JS submits both go through the license worker's one-per-email
// relay, which holds the Formspree id (never print it in a page: bots post
// straight to it, 2026-11-02).
const onceUrl = site.downloadGate.workerUrl + '/form-once';
// "Unsubscribe anytime." can sit under the form as fine print (the phone layouts below); one of the two shows, never both
const split = subhead.match(/^(.*?)\s*(Unsubscribe anytime\.?)$/);
const lead = split ? split[1] : subhead, tail = split ? split[2] : '';
const endpoint = onceUrl + '?form=newsletter';
---

<section class="signup" id={id}>
  <div class="container" data-reveal>
    <p class="signup-kicker">Newsletter</p>
    <h2>{heading}</h2>
    <p class="signup-lead">{lead}{tail && <span class="signup-unsub"> {tail}</span>}</p>
    <form class="signup-form" action={endpoint} method="POST" data-newsletter data-once-url={onceUrl}>
      <label for="newsletter-email" class="sr-only">Email address</label>
      <input
        id="newsletter-email"
        type="email"
        name="email"
        placeholder="you@studio.com"
        required
        autocomplete="email"
      />
      <!-- honeypot: real users never fill this; bots do -->
      <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button type="submit" class="signup-submit rv-btn rv-btn--sm">
        <span class="rv-btn__label">{buttonLabel}</span><span class="ss-arrow" aria-hidden="true">&#9656;</span>
      </button>
    </form>
    {tail && <p class="signup-fine">{tail}</p>}
    <p class="signup-status" role="status" aria-live="polite" hidden></p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-newsletter]').forEach((form) => {
    const status = form.parentElement?.querySelector<HTMLElement>('.signup-status');
    // Build-time placeholder still in the action ⇒ not wired to a real backend yet.
    const wired = !form.action.includes('REPLACE_WITH_FORM_ID');

    const show = (msg: string, ok: boolean) => {
      if (!status) return;
      status.textContent = msg;
      status.hidden = false;
      status.classList.toggle('ok', ok);
      status.classList.toggle('err', !ok);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!wired) {
        show('Almost there. Newsletter signup goes live shortly. Your email wasn’t sent yet.', false);
        return;
      }
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;
      try {
        const res = await fetch(form.dataset.onceUrl!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ form: 'newsletter', ...Object.fromEntries(new FormData(form)) }),
        });
        const j = await res.json().catch(() => null);
        if (j && j.ok) {
          form.hidden = true;
          show(j.already ? 'You’re already on the list.' : 'You’re on the list. Watch your inbox for the first build.', true);
        } else {
          show((j && j.error) || 'Something went wrong. Try again, or email info@revaudio.net.', false);
        }
      } catch {
        show('Network hiccup. Try again in a moment.', false);
      }
      if (submitBtn) submitBtn.disabled = false;
    });
  });
</script>

<style>
  /* The submit is the button family's small brass (src/styles/buttons.css,
     Dan 2026-10-18), level with the input on the row. Only placement here. */
  .signup form { align-items: stretch; gap: 0.5rem; }

  .signup .signup-form .signup-submit { flex: none; }
  .signup .signup-form .ss-arrow { opacity: 0.7; }

  /* honeypot — visually and semantically hidden, still submittable by bots */
  .signup form .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .signup .signup-status {
    margin: 1.25rem auto 0;
    max-width: 480px;
    font-size: 0.95rem;
  }
  .signup .signup-status.ok { color: var(--brass-bright); }

  /* The one allowed confirmation accent (motion plan): soft settle-pop on the
     success message. Gated on motion-ok so reduced-motion/no-JS stay static.
     Overshoot bezier ≈ back.out, kept under the 8% bible ceiling. */
  :global(html.motion-ok) .signup .signup-status.ok {
    animation: status-pop 0.45s cubic-bezier(0.34, 1.35, 0.64, 1) both;
  }

  @keyframes status-pop {
    from { opacity: 0; transform: scale(0.92) translateY(6px); }
    to { opacity: 1; transform: none; }
  }
  .signup .signup-status.err { color: var(--fg-dim); }
  /* Under 480px the global rule stacks the form; centre the button there so it
     doesn't stretch the full input width. */
  @media (max-width: 480px) {
    .signup .signup-form .signup-submit { align-self: center; min-width: 180px; }
  }

  /* the kicker and the fine print: only the phone layouts below use them */
  .signup-kicker, .signup-fine { display: none; }

  /* ---- Phones: the sign (Dan 2026-11-24: "the join the pit crew need to be redesigned as well. It's supposed to be like
     way polished composition"; of three compositions on the page he picked B, the sign, over a clipboard board and a
     left-set ledger). Centred: a mono kicker, the title between two brass rules, a short line, the field and the key as
     one bar, "Unsubscribe anytime." as fine print under it. 453 -> 311 px on a 390 px phone. Laptops unchanged. ---- */
  @media (max-width: 860px) {
    .signup { padding: 3rem 0 3rem; }
    .signup .container { max-width: 23rem; text-align: center; }
    .signup-kicker {
      display: block; margin: 0 0 0.55rem; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.3em;
      text-transform: uppercase; color: var(--brass);
    }
    .signup h2 { display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin: 0; font-size: 2.1rem; line-height: 0.95; }
    .signup h2::before, .signup h2::after {
      content: ''; flex: 1; max-width: 3rem; height: 2px; background: linear-gradient(90deg, transparent, var(--brass-dark), var(--brass));
    }
    .signup h2::after { background: linear-gradient(270deg, transparent, var(--brass-dark), var(--brass)); }
    .signup .signup-lead { max-width: 19rem; margin: 0.7rem auto 1.25rem; font-size: 0.95rem; line-height: 1.5; color: var(--fg-dim); }
    .signup .signup-unsub { display: none; }
    .signup-fine { display: block; margin: 0.75rem 0 0; font-size: 0.72rem; color: var(--fg-faint); }
    /* the field and the key as one part: the same height and corner, the key seated in the field's right end */
    .signup form { flex-direction: row; gap: 0; max-width: none; margin: 0; align-items: stretch; }
    .signup input[type='email'] {
      min-width: 0; height: 48px; padding: 0 0.9rem; font-size: 0.95rem; border-radius: 12px 0 0 12px; border-right: 0;
      background: var(--bg-0); box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.55);
    }
    .signup .signup-form .signup-submit { align-self: stretch; min-width: 0; border-radius: 0 12px 12px 0; padding: 0 1rem; }
  }
</style>
