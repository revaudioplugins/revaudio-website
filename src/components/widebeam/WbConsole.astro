---
/** /widebeam console (lane D, D.2 = Dan's pick D5 A): a column beside the face at >= 1100 px, a plate under it below.
 *  Built from the plugin's own parts (DESIGN Law 7, the parts kit: src/styles/widebeam/parts.css): the plate with its
 *  strap, the road window as the rear-view mirror (the live stereo picture, CORR in the window's own LCD), the plugin's bat
 *  switch strip as ORIGINAL | WIDE BEAM (= POWER), the MONO cap as MONO CHECK and the preset box's LCD with 44 px keys.
 *  The player went (Dan, 2026-11-21: "remove the player"): no TRACK, no VOLUME, no engine key. The sound starts on a touch
 *  of the demo or the SOUND key (WbSound.astro) and plays the synth loop, or the visitor's own track (WbDrive.astro).
 *  On a phone held upright PRESET lives in the deck above (WbDeck.astro). Behaviour: src/lib/widebeam/console.ts; the
 *  mirror and CORR: sound.ts. */
---
<div class="wb-con wb-plate wb-plate--strap" data-wb-console>
  <div class="wb-con-mirror wb-mirror">
    <div class="wb-part-road wb-con-road">
      <div class="wb-part-road-glass wb-con-glass"><canvas data-wb-scope aria-hidden="true"></canvas></div>
      <p class="wb-part-road-lcd wb-con-corr"><span>CORR <b data-wb-corr>--</b></span></p>
    </div>
    <p class="wb-plate-label wb-con-label">Rear view · stereo</p>
  </div>

  <div class="wb-con-row">
    {/* one choice of two, so a radio group (console.ts: one Tab stop, the arrows move it; r-dash-abrole) */}
    <div class="wb-con-ab" role="radiogroup" aria-label="Before and after">
      <span class="wb-con-bat" aria-hidden="true" data-wb-bat><span class="wb-con-bat-strip"></span></span>
      <button type="button" role="radio" class="wb-con-ab-key wb-con-ab-key--on" data-wb-ab="on" data-wb-demo aria-checked="true"><span class="wb-plate-label">Wide Beam</span></button>
      <button type="button" role="radio" class="wb-con-ab-key wb-con-ab-key--off" data-wb-ab="off" data-wb-demo aria-checked="false" tabindex="-1"><span class="wb-plate-label">Original</span></button>
    </div>
    <button type="button" class="wb-con-mono" data-wb-mono-check data-wb-demo aria-pressed="false">
      <span class="wb-con-cap" aria-hidden="true"><span class="wb-part-cap"></span></span>
      <span class="wb-plate-label">Mono check</span>
    </button>
  </div>

  <div class="wb-con-preset">
    <p class="wb-plate-label wb-con-k" id="wb-con-preset-k">Preset</p>
    <div class="wb-con-lcd" role="group" aria-labelledby="wb-con-preset-k">
      <button type="button" class="wb-con-step" data-wb-step="-1" data-wb-demo aria-label="Previous preset"><svg viewBox="0 0 9 16" aria-hidden="true"><path d="M7.5 1.5L1.5 8l6 6.5" /></svg></button>
      <span class="wb-con-name" data-wb-preset-name>DEFAULT</span>
      <button type="button" class="wb-con-step" data-wb-step="1" data-wb-demo aria-label="Next preset"><svg viewBox="0 0 9 16" aria-hidden="true"><path d="M1.5 1.5L7.5 8l-6 6.5" /></svg></button>
    </div>
  </div>

  <span class="sr-only" data-wb-coach aria-live="polite"></span>
</div>
