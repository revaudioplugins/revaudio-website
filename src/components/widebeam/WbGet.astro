---
/**
 * /widebeam ask plate under the hero (lane A, D4 C): a plate cut from the plugin's own photo (.wb-plate--badge, the
 * parts kit) carrying the one ask from askFor(phase) and the buy side from buyFor() (src/data/widebeam.ts).
 * Hooks read elsewhere: [data-wb-trial] / [data-wb-trial-status] / #wb-trial-email (capture.ts, the gate kit),
 * [data-wb-ask] (capture.ts: the done state on every surface), [data-wb-cta] on the form (furniture.ts: the phone
 * bar steps away while the form is on screen).
 * Without JS (or if the page script fails before capture.ts binds it): pre-open the form posts itself, urlencoded, to the
 * worker's /form-once?form=newsletter, which relays source 'widebeam-notify' to the list and answers with a page (the
 * house forms' no-JS route). Once the trial is open (ask.registerUrl) there is no such route: the download goes out
 * only from /download/register, which reads JSON, and the worker logs a '-trial' source on /form-once without relaying
 * it, then answers "You're on the list" (r-asks-nojstrial). So there the form has no action and its key stays
 * disabled until capture.ts binds it ([data-wb-needs-script]); with JS off a <noscript> line says why.
 */
import { widebeam, askFor, buyFor, formatsLine, onceUrl as formOnceUrl } from '../../data/widebeam';

const onceUrl = formOnceUrl();
const ask = askFor();
const buy = buyFor();
// pre-open only: the one no-JS route that does what the page says (see above)
const native = !ask.registerUrl;
---
<!-- ============ GET IT: the one ask + the buy side (src/data/widebeam.ts askFor / buyFor) ============ -->
<section class="wb-get" id="wb-get" aria-label="Get WIDE BEAM">
  <div class="wb-get-plate wb-plate wb-plate--badge" data-reveal="fade">
    <div class="wb-get-trial" data-wb-ask>
      <p class="wb-get-label">{ask.label}</p>
      <form
        class="wb-get-form" data-wb-trial data-wb-cta novalidate
        action={native ? onceUrl + '?form=newsletter' : undefined} method="POST"
        data-wb-needs-script={native ? undefined : ''}
        data-once-url={onceUrl}
        data-register-url={ask.registerUrl ?? undefined}
        data-plugin={widebeam.gateId}
        data-msg-ok={ask.ok}
        data-msg-already={ask.already}
      >
        <label class="sr-only" for="wb-trial-email">Your email</label>
        <input id="wb-trial-email" type="email" name="email" inputmode="email" autocomplete="email" enterkeyhint="go" spellcheck="false" placeholder="your@email.com" required aria-describedby="wb-get-micro wb-get-consent" />
        <input type="hidden" name="source" value={ask.source} />
        <input type="text" name="_gotcha" class="wb-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button type="submit" class="rv-btn" disabled={!native}><span data-face>{ask.key.replace(/ ▸$/, '')} <span aria-hidden="true">&#9656;</span></span></button>
      </form>
      {!native && ask.nojs && <noscript><p class="wb-get-status err">{ask.nojs}</p></noscript>}
      <p class="wb-get-status" id="wb-get-status" data-wb-trial-status role="status" aria-live="polite" tabindex="-1"></p>
      <p class="wb-get-micro wb-plate-label" id="wb-get-micro">{ask.micro}</p>
      <p class="wb-get-notice" id="wb-get-consent">{ask.consent} &middot; <a href="/privacy" data-open-legal="privacy">Privacy</a></p>
    </div>
    <div class="wb-get-or" aria-hidden="true"></div>
    <div class="wb-get-buy">
      <p class="wb-get-price"><b>{buy.title}</b><span class="wb-plate-label">{buy.sub}</span></p>
      {buy.key && (
        <button
          type="button" class="rv-btn rv-btn--lg wb-buy"
          data-add-to-cart data-cart-open
          data-slug={widebeam.slug} data-name={widebeam.name} data-price={widebeam.priceUsd}
        >{buy.key}</button>
      )}
      <p class="wb-get-micro wb-get-formats wb-plate-label">{formatsLine()}</p>
      {buy.trust && <p class="wb-get-notice wb-get-trust">{buy.trust}</p>}
    </div>
  </div>
</section>
