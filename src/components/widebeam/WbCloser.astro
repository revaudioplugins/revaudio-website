---
/**
 * /widebeam closer, "Runs on your setup." (lane A, D4 C): one plate cut from the plugin's photo (.wb-plate--badge)
 * with the plugin's two headlamps (parts kit), the MAC / WINDOWS rows (compatRows), the same one ask as the plate under
 * the hero (askFor), the buy side (buyFor: the trust line only once buyable), one odometer and the folds (FOLDS; the
 * Specs fold holds the trip computer on the plugin's owner's-card stock). Every word from src/data/widebeam.ts.
 *
 * Ids the gate kit and links read: #wb-notify (this section, the ask's section), #wb-specs (the Specs fold), #wb-email,
 * [data-wb-form], [data-wb-status], [data-odo] (the real numbers), .wb-dr (the spec rows).
 * The lamps (.wb-closer-lamp) are driven by furniture.ts (the store: WIDTH, POWER, MONO, HIGH BEAM; full beam on a
 * sign-up). The odometer's drums by odometer.ts.
 * Without JS: pre-open the form posts itself to the worker's /form-once?form=newsletter (the house forms' no-JS route);
 * once the trial is open it has no action and its key waits for capture.ts, like the plate's (WbGet.astro explains why).
 */
import { widebeam, askFor, buyFor, compatRows, SPECS, SPECS_TITLE, ODOMETER, FOLDS, onceUrl as formOnceUrl } from '../../data/widebeam';

const onceUrl = formOnceUrl();
const ask = askFor();
const buy = buyFor();
const native = !ask.registerUrl; // pre-open only: the one no-JS route that does what the page says (WbGet.astro)
// a drum strip holds 0-9 twice, so a roll can turn each drum a full revolution; at rest (and with no JS) the first set
const STRIP = [...'01234567890123456789'];
---
<!-- ============ THE CLOSER: runs on your setup + the one ask ============ -->
<section class="wb-closer" id="wb-notify" aria-labelledby="wb-closer-h">
  <div class="wb-closer-plate wb-plate wb-plate--badge" data-reveal="fade">
    <i class="wb-closer-lamp wb-part-lamp-l" aria-hidden="true"></i>
    <i class="wb-closer-lamp wb-closer-lamp--r wb-part-lamp-r" aria-hidden="true"></i>
    <header class="wb-closer-top">
      <p class="wb-eyebrow">{ask.closerEyebrow}</p>
      <h2 id="wb-closer-h">Runs on your setup.</h2>
    </header>

    <div class="wb-closer-grid">
      <div class="wb-closer-main">
        <dl class="wb-closer-compat">
          {compatRows().map((r) => (
            <div><dt class="wb-plate-label">{r.k}</dt><dd><b>{r.v}</b>{r.d && <span>{r.d}</span>}</dd></div>
          ))}
        </dl>

        <div class="wb-closer-ask" data-wb-ask>
          <p class="wb-closer-ask-l">{ask.label}</p>
          <form
            class="wb-get-form wb-form" data-wb-form data-wb-cta novalidate
            action={native ? onceUrl + '?form=newsletter' : undefined} method="POST"
            data-wb-needs-script={native ? undefined : ''}
            data-once-url={onceUrl}
            data-register-url={ask.registerUrl ?? undefined}
            data-plugin={widebeam.gateId}
            data-msg-ok={ask.ok}
            data-msg-already={ask.already}
          >
            <label class="sr-only" for="wb-email">Your email</label>
            <input id="wb-email" type="email" name="email" inputmode="email" autocomplete="email" enterkeyhint="go" spellcheck="false" placeholder="your@email.com" required aria-describedby="wb-notify-consent" />
            <input type="hidden" name="source" value={ask.source} />
            <input type="text" name="_gotcha" class="wb-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <button type="submit" class="rv-btn" disabled={!native}><span data-face>{ask.key.replace(/ ▸$/, '')} <span aria-hidden="true">&#9656;</span></span></button>
          </form>
          {!native && ask.nojs && <noscript><p class="wb-get-status err">{ask.nojs}</p></noscript>}
          <p class="wb-get-status" id="wb-notify-status" data-wb-status role="status" aria-live="polite" tabindex="-1"></p>
          <p class="wb-get-notice" id="wb-notify-consent">{ask.consent} &middot; <a href="/privacy" data-open-legal="privacy">Privacy</a></p>
        </div>

        <div class="wb-closer-own">
          <p class="wb-closer-price"><b>{buy.title}</b> <span class="wb-plate-label">&middot; {buy.sub}</span></p>
          {buy.key && (
            <button
              type="button" class="rv-btn wb-buy"
              data-add-to-cart data-cart-open
              data-slug={widebeam.slug} data-name={widebeam.name} data-price={widebeam.priceUsd}
            >{buy.key}</button>
          )}
          {buy.trust && <p class="wb-get-notice wb-get-trust">{buy.trust}</p>}
          {ask.closerNote && <p class="wb-get-notice">{ask.closerNote}</p>}
        </div>
      </div>

      <div class="wb-closer-side">
        <!-- one odometer: the real numbers are the text ([data-odo]); the drums beside them are decoration -->
        <ul class="wb-odo" role="list">
          {ODOMETER.map((o) => (
            <li class="wb-odo-cell">
              <span class="sr-only" data-odo={o.value}>{o.value}</span>
              <span class="wb-odo-drums" aria-hidden="true">
                {[...String(o.value)].map((d) => (
                  <span class="wb-odo-drum" data-d={d} style={`--d:${d}`}><span class="wb-odo-strip">{STRIP.map((n) => <span>{n}</span>)}</span></span>
                ))}
              </span>
              <span class="wb-odo-unit wb-plate-label">{o.unit}</span>
            </li>
          ))}
        </ul>

        <div class="wb-folds">
          {FOLDS.map((f) => (
            f.id === 'specs' ? (
              <details class="wb-fold wb-fold--specs" id="wb-specs">
                <summary class="wb-plate-label">{f.title}</summary>
                <div class="wb-spec-card">
                  <p class="wb-spec-card-title">{SPECS_TITLE}</p>
                  <dl>
                    {SPECS.map(([k, v, d]) => (<div class="wb-dr"><dt>{k}</dt><dd><b>{v}</b>{d && <span>{d}</span>}</dd></div>))}
                  </dl>
                </div>
              </details>
            ) : (
              <details class="wb-fold" id={`wb-fold-${f.id}`}>
                <summary class="wb-plate-label">{f.title}</summary>
                {f.body.map((line) => <p>{line}</p>)}
              </details>
            )
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
