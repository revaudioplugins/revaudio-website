---
/** /widebeam Owner's Manual (lane S), stand-by (P4 A): the title and the stand-by line only, words from manual in
 *  src/data/widebeam.ts. No play icon, length, poster, date or email promise until a film exists. #manual is where the
 *  plugin's MANUAL button lands (D14). data-wb-manual: never starts sound; data-wb-watch: the SOUND key steps aside. */
import { manual } from '../../data/widebeam';
---
<!-- ============ THE OWNER'S MANUAL (stand-by) ============ -->
<section id="manual" class="wb-manual" data-wb-manual data-wb-watch aria-labelledby="wb-manual-h">
  <div class="wb-manual-inner" data-reveal="fade">
    <h2 id="wb-manual-h">{manual.title}</h2>
    <p class="wb-manual-standby">{manual.standby}</p>
  </div>
</section>
